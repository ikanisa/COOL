# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/build
/build_stale_*/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── Secrets & credentials (NEVER commit) ─────────────────────
.env
.env.*
!.env.example
supabase/functions/.env
supabase/functions/.env.*
!supabase/functions/.env.example
supabase/.temp/

# Signing credentials
android/key.properties
android/local.properties
**/*.jks
**/*.keystore

# Firebase service configs (contain API keys)
**/google-services.json
**/GoogleService-Info.plist
**/GoogleService-Info-*.plist
**/ios/Flutter/MapsKeys.xcconfig

# Firebase & build logs
firebase-debug.log
flutter_*.log
*.log
.env.json

# Google Play service account key
output/play_store/play-store-sa-key.json

# Cloudflare Wrangler local cache
.wrangler/

# Scratch / analysis output
analysis_output*.txt
update_profile.dart
package-lock.json
.firebase/
.agent/

# ── Production hygiene (NEVER commit) ─────────────────────────
# Backup / stale suffixes
*.bak
*.old
*.orig

# Kotlin build error logs
android/.kotlin/errors/

# Design tool exports & operator output
stitch_exports/
stitch.json
test/features/partners/failures/

# Local release output
output/

# third-party local.properties (generated, machine-specific)
third_party/**/local.properties
third_party/**/example/

# Gradle build caches (third-party modules)
**/.gradle/
