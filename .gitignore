# ── Production hygiene (NEVER commit) ─────────────────────────
# Backup / stale suffixes
*.bak
*.old
*.orig
*.tar.gz

# Kotlin build error logs
android/.kotlin/errors/

# Design tool exports & operator output
stitch_exports/
stitch.json
test/shared/failures/
test/features/partners/failures/
test/goldens/failures/

# Local release output
output/

# third-party local.properties (generated, machine-specific)
third_party/**/local.properties
third_party/**/example/

# Gradle build caches (third-party modules)
**/.gradle/
third_party/**/build/
.bundle/
vendor/bundle/
fastlane/report.xml

# Reproducible release builds and compiler caches remain local. Review reports,
# source snapshots and the publication inventory retain their provenance.
