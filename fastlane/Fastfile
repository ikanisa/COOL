default_platform(:android)

require "shellwords"
require "json"
require "fileutils"
require "tempfile"
require "digest"
require "open3"

COLLECT_IOS_APP_IDENTIFIER = "app.cool.mobile"
COLLECT_IOS_APPLE_ID = "6783960331"
COLLECT_IOS_TEAM_ID = "63STJ5N27W"
COLLECT_PACKAGE_VERSION = File.read(File.expand_path("../pubspec.yaml", __dir__))[/^version:\s*([^\s]+)/, 1]
UI.user_error!("pubspec.yaml version is missing") if COLLECT_PACKAGE_VERSION.to_s.empty?
COLLECT_IOS_VERSION, COLLECT_IOS_BUILD_NUMBER = COLLECT_PACKAGE_VERSION.split("+", 2)
UI.user_error!("pubspec.yaml version must include a build number") if COLLECT_IOS_BUILD_NUMBER.to_s.empty?

def collect_required_env(name)
  value = ENV[name].to_s.strip
  UI.user_error!("#{name} is required") if value.empty?
  value
end

def collect_review_phone
  collect_required_env("COLLECT_REVIEW_PHONE")
end

def collect_review_otp
  collect_required_env("COLLECT_REVIEW_OTP")
end

# The reviewed public profile is shared with both native store wrappers and the
# approval hash guard. App Review account credentials never enter this file.
def collect_native_public_defines
  root = File.expand_path("..", __dir__)
  file = Tempfile.new(["collect-app-review-defines", ".json"])
  _output, _error, result = Open3.capture3(
    "python3", File.join(root, "scripts/qa/native_build_config.py"), "ios",
    "--defines-output", file.path,
  )
  UI.user_error!("Invalid public Supabase native build configuration") unless result.success?
  file.close
  file
rescue StandardError
  file&.close!
  raise
end


def collect_app_store_connect_api_key
  key_id = ENV["ASC_KEY_ID"].to_s.strip
  issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
  key_path = ENV["ASC_PRIVATE_KEY_PATH"].to_s.strip
  key_content = ENV["ASC_PRIVATE_KEY"].to_s.strip

  UI.user_error!("ASC_KEY_ID is required") if key_id.empty?
  UI.user_error!("ASC_ISSUER_ID is required") if issuer_id.empty?
  UI.user_error!("ASC_PRIVATE_KEY_PATH or ASC_PRIVATE_KEY is required") if key_path.empty? && key_content.empty?

  options = {
    key_id: key_id,
    issuer_id: issuer_id,
    duration: 1200,
    in_house: false
  }

  if !key_content.empty?
    options[:key_content] = key_content.gsub("\\n", "\n")
  else
    options[:key_filepath] = key_path
  end

  app_store_connect_api_key(**options)
end

def collect_unbundled_sh(command)
  if defined?(Bundler) && Bundler.respond_to?(:with_unbundled_env)
    Bundler.with_unbundled_env do
      sh(command)
    end
  elsif defined?(Bundler) && Bundler.respond_to?(:with_clean_env)
    Bundler.with_clean_env do
      sh(command)
    end
  else
    sh(command)
  end
end

platform :android do
  desc "Validate Google Play metadata and AAB paths without submitting to Play"
  lane :play_validate_local do
    sh("./scripts/google_play_console_audit_packet.sh --phase prepare --json")
    sh("./scripts/google_play_metadata_export.sh --json")
    sh("./scripts/google_play_optimization_gate.sh --phase prepare --json || test $? -eq 99")
    sh("./scripts/google_play_production_upload.sh --phase prepare --json")
  end

  desc "Run an explicit gated Play upload, review or rollout phase; default to draft upload"
  lane :play_production_submit do |options|
    UI.user_error!("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON is required") if ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"].to_s.empty?
    phase = options.fetch(:phase, "upload").to_s
    UI.user_error!("phase must be upload, review or rollout") unless %w[upload review rollout].include?(phase)
    full_rollout = options[:full_rollout].to_s == "true"
    UI.user_error!("full_rollout is only valid with phase:rollout") if full_rollout && phase != "rollout"
    sh("./scripts/google_play_metadata_export.sh --json")
    command = "./scripts/google_play_production_upload.sh --submit --phase #{phase.shellescape} --json"
    command += " --full-rollout" if full_rollout
    # One submission implementation owns preflight, artifact binding and phase
    # controls. Listing export is preparation; verify the real Console listing.
    sh(command)
  end
end

def collect_ios_delivery_guard(operation)
  root = File.expand_path("..", __dir__)
  UI.user_error!("Fastlane must execute in the reviewed iOS working copy") unless ENV["COLLECT_IOS_WORKDIR"].to_s == root
  sh("python3 #{File.join(root, 'scripts/qa/ios_delivery_guard.py').shellescape} check --operation #{operation.shellescape}")
  sh("python3 #{File.join(root, 'scripts/qa/ios_delivery_guard.py').shellescape} verify-environment --operation #{operation.shellescape}")
end

platform :ios do
  desc "Stage Collect App Store screenshots into Fastlane's upload layout"
  lane :prepare_app_store_assets do
    iphone_sources = Dir["../output/app_store/ios_screenshots/final/iphone65/*.png"].sort
    ipad_sources = Dir["../output/app_store/ios_screenshots/final/ipadPro129/*.png"].sort

    if iphone_sources.empty? && ipad_sources.empty?
      iphone_sources = Dir["screenshots/en-GB/iphone65-*.png"].sort
      ipad_sources = Dir["screenshots/en-GB/ipadPro129-*.png"].sort
      UI.message("Using the reviewed App Store screenshots committed to the repository.")
    elsif iphone_sources.empty? || ipad_sources.empty?
      UI.user_error!("The generated App Store screenshot set is incomplete. Run scripts/app_store_ios_capture_assets.sh again.")
    else
      FileUtils.rm_rf("screenshots/en-GB")
      FileUtils.mkdir_p("screenshots/en-GB")

      iphone_sources.each do |source|
        basename = File.basename(source)
        iphone_target = "screenshots/en-GB/iphone65-#{basename}"

        FileUtils.cp(source, iphone_target)
      end

      ipad_sources.each do |source|
        basename = File.basename(source)
        ipad_target = "screenshots/en-GB/ipadPro129-#{basename}"

        FileUtils.cp(source, ipad_target)
      end
    end

    UI.user_error!("Expected exactly 5 iPhone 6.5-inch screenshots.") unless iphone_sources.length == 5
    UI.user_error!("Expected exactly 5 13-inch iPad screenshots.") unless ipad_sources.length == 5
    sh("sips -g pixelWidth -g pixelHeight screenshots/en-GB/*.png >/dev/null")
  end

  desc "Upload Collect App Store metadata and screenshots without a binary or review submission"
  lane :upload_metadata_screenshots do
    collect_ios_delivery_guard("metadata")
    sh("#{File.expand_path("../scripts/ios_app_store_readiness_gate.sh", __dir__).shellescape} --json")
    collect_ios_delivery_guard("metadata")
    api_key = collect_app_store_connect_api_key
    review_phone = collect_review_phone
    review_otp = collect_review_otp

    review_notes = File.read("metadata/en-GB/review_notes.txt").strip

    deliver(
      api_key: api_key,
      app_identifier: COLLECT_IOS_APP_IDENTIFIER,
      app: COLLECT_IOS_APPLE_ID,
      app_version: COLLECT_IOS_VERSION,
      metadata_path: "metadata",
      screenshots_path: "screenshots",
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
      run_precheck_before_submit: false,
      overwrite_screenshots: true,
      automatic_release: false,
      force: true,
      app_review_information: {
        first_name: "IKANISA",
        last_name: "Support",
        phone_number: review_phone,
        email_address: "info@ikanisa.com",
        demo_user: review_phone,
        demo_password: review_otp,
        notes: review_notes
      }
    )
  end

  desc "Replace App Store screenshots with the already-reviewed repository assets"
  lane :upload_existing_app_store_screenshots do
    collect_ios_delivery_guard("screenshots")
    sh("#{File.expand_path("../scripts/ios_app_store_readiness_gate.sh", __dir__).shellescape} --json")
    collect_ios_delivery_guard("screenshots")
    api_key = collect_app_store_connect_api_key
    iphone_sources = Dir["screenshots/en-GB/iphone65-*.png"].sort
    ipad_sources = Dir["screenshots/en-GB/ipadPro129-*.png"].sort
    UI.user_error!("Expected exactly 5 reviewed iPhone screenshots.") unless iphone_sources.length == 5
    UI.user_error!("Expected exactly 5 reviewed iPad screenshots.") unless ipad_sources.length == 5

    deliver(
      api_key: api_key,
      app_identifier: COLLECT_IOS_APP_IDENTIFIER,
      app: COLLECT_IOS_APPLE_ID,
      app_version: COLLECT_IOS_VERSION,
      screenshots_path: "screenshots",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      submit_for_review: false,
      run_precheck_before_submit: false,
      overwrite_screenshots: true,
      automatic_release: false,
      force: true
    )
  end

  desc "Build the production IPA without embedding App Review credentials"
  lane :build_review_ipa do
    collect_ios_delivery_guard("signed_candidate")
    review_defines = collect_native_public_defines

    begin
      collect_unbundled_sh("cd .. && flutter pub get --enforce-lockfile")
      collect_ios_delivery_guard("signed_candidate")
      collect_unbundled_sh([
        "cd .. &&",
        "flutter build ipa",
        "--flavor production",
        "--release",
        "--no-pub",
        "--export-options-plist=ios/ExportOptionsAppStore.plist",
        "--dart-define-from-file=#{review_defines.path.shellescape}"
      ].join(" "))
      collect_ios_delivery_guard("signed_candidate")
      ipa_files = Dir[File.expand_path("../build/ios/ipa/*.ipa", __dir__)]
      UI.user_error!("Expected one signed IPA") unless ipa_files.length == 1
      ENV["COLLECT_IOS_IPA"] = ipa_files.fetch(0)
      inspection = collect_required_env("COLLECT_IOS_INSPECTION")
      sh("python3 #{File.expand_path("../scripts/qa/ios_delivery_guard.py", __dir__).shellescape} inspect --output #{inspection.shellescape}")
    ensure
      review_defines.unlink
    end
  end

  desc "Upload the latest signed IPA to TestFlight without submitting for App Review"
  lane :upload_review_build do
    collect_ios_delivery_guard("testflight_internal")
    sh("#{File.expand_path("../scripts/ios_app_store_readiness_gate.sh", __dir__).shellescape} --json")
    collect_ios_delivery_guard("testflight_internal")
    ipa_path = collect_required_env("COLLECT_IOS_IPA")
    before_sha256 = Digest::SHA256.file(ipa_path).hexdigest
    api_key = collect_app_store_connect_api_key
    release_notes = File.read("metadata/en-GB/release_notes.txt").strip
    collect_ios_delivery_guard("testflight_internal")
    UI.user_error!("Approved IPA changed before upload") unless Digest::SHA256.file(ipa_path).hexdigest == before_sha256

    pilot(
      api_key: api_key,
      app_identifier: COLLECT_IOS_APP_IDENTIFIER,
      app_platform: "ios",
      ipa: ipa_path,
      changelog: release_notes,
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )
    UI.user_error!("Approved IPA changed during upload; reconcile Apple state before retry") unless Digest::SHA256.file(ipa_path).hexdigest == before_sha256
  end

  desc "Upload App Privacy details using an Apple ID web session and a reviewed JSON answers file"
  lane :upload_app_privacy_details do
    collect_ios_delivery_guard("privacy_public")
    UI.user_error!("FASTLANE_USER must be the Apple ID email for App Store Connect") if ENV["FASTLANE_USER"].to_s.strip.empty?
    privacy_details_path = File.expand_path("app_privacy_details.json", __dir__)
    UI.user_error!("fastlane/app_privacy_details.json is required") unless File.exist?(privacy_details_path)

    collect_ios_delivery_guard("privacy_public")
    upload_app_privacy_details_to_app_store(
      app_identifier: COLLECT_IOS_APP_IDENTIFIER,
      team_id: COLLECT_IOS_TEAM_ID,
      json_path: privacy_details_path,
      skip_publish: false
    )
  end
end
