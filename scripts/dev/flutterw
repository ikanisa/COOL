#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
readonly ROOT_DIR

_parse_pinned_flutter_version() {
  local fvmrc_path="$ROOT_DIR/.fvmrc"
  if [[ ! -f "$fvmrc_path" ]]; then
    return 0
  fi

  sed -nE 's/.*"flutter"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' "$fvmrc_path"
}

_flutter_version() {
  local flutter_bin="${1:?}"

  "$flutter_bin" --version --machine 2>/dev/null |
    sed -nE 's/.*"frameworkVersion"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p'
}

_add_candidate() {
  local candidate="${1:-}"
  if [[ -z "$candidate" || ! -x "$candidate" ]]; then
    return 0
  fi

  local existing
  for existing in "${FLUTTER_CANDIDATES[@]:-}"; do
    if [[ "$existing" == "$candidate" ]]; then
      return 0
    fi
  done

  FLUTTER_CANDIDATES+=("$candidate")
}

declare -a FLUTTER_CANDIDATES=()

if [[ -n "${FLUTTER_BIN:-}" ]]; then
  _add_candidate "$FLUTTER_BIN"
fi

if [[ -n "${FLUTTER_ROOT:-}" ]]; then
  _add_candidate "$FLUTTER_ROOT/bin/flutter"
fi

_add_candidate "$ROOT_DIR/.fvm/flutter_sdk/bin/flutter"
_add_candidate "$ROOT_DIR/../Apps/SDKs/flutter/bin/flutter"
_add_candidate "$ROOT_DIR/../SDKs/flutter/bin/flutter"
_add_candidate "$HOME/fvm/default/bin/flutter"
_add_candidate "$HOME/.fvm/default/bin/flutter"

if command -v flutter >/dev/null 2>&1; then
  _add_candidate "$(command -v flutter)"
fi

EXPECTED_FLUTTER_VERSION="$(_parse_pinned_flutter_version)"
readonly EXPECTED_FLUTTER_VERSION

SELECTED_FLUTTER_BIN=""
SELECTED_FLUTTER_VERSION=""

for candidate in "${FLUTTER_CANDIDATES[@]}"; do
  version="$(_flutter_version "$candidate")"
  if [[ -z "$version" ]]; then
    continue
  fi

  if [[ -z "$SELECTED_FLUTTER_BIN" ]]; then
    SELECTED_FLUTTER_BIN="$candidate"
    SELECTED_FLUTTER_VERSION="$version"
  fi

  if [[ -z "$EXPECTED_FLUTTER_VERSION" || "$version" == "$EXPECTED_FLUTTER_VERSION" ]]; then
    SELECTED_FLUTTER_BIN="$candidate"
    SELECTED_FLUTTER_VERSION="$version"
    break
  fi
done

if [[ -z "$SELECTED_FLUTTER_BIN" ]]; then
  echo "Unable to locate a usable Flutter SDK." >&2
  echo "Set FLUTTER_BIN or FLUTTER_ROOT, or install the version pinned in .fvmrc." >&2
  exit 1
fi

if [[ -n "$EXPECTED_FLUTTER_VERSION" && "$SELECTED_FLUTTER_VERSION" != "$EXPECTED_FLUTTER_VERSION" ]]; then
  echo "Flutter $EXPECTED_FLUTTER_VERSION is required by $ROOT_DIR/.fvmrc, but $SELECTED_FLUTTER_VERSION is active at $SELECTED_FLUTTER_BIN." >&2
  echo "Set FLUTTER_BIN to a matching SDK or install the pinned version locally." >&2
  exit 1
fi

if [[ "${1:-}" == "--print-bin" ]]; then
  printf '%s\n' "$SELECTED_FLUTTER_BIN"
  exit 0
fi

exec "$SELECTED_FLUTTER_BIN" "$@"
