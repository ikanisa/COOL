{
  "name": "@collect/supabase-migration-tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": "24.19.0"},
  "scripts": {
    "test:data": "node --test data_stage.test.mjs data_promote.test.mjs",
    "test:schema": "node test_schema.mjs",
    "test:gate": "cd ../.. && python3 -m unittest scripts.supabase.test_cutover_gate scripts.supabase.test_admin_build_config",
    "inventory": "node inventory.mjs ../..",
