# Cool App - Supabase Edge Function secrets
# Copy to `supabase/functions/.env` for local `supabase functions serve`.
# For remote deployment, set these with `supabase secrets set` or Dashboard.
# Prefer the standard `SUPABASE_*` names. The linked Supabase project is the
# source of truth for deployed secrets, functions, and migrations.

SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token

AI_SMS_PARSE_PROVIDER=gemini
OPENAI_API_KEY=your_openai_api_key
OPENAI_SMS_PARSE_MODEL=gpt-4.1-mini
# Shared Google credential. `maps-gateway` and `translate-content` can use this.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_SMS_PARSE_MODEL=gemini-3.1-pro
# Preferred server-side Google Maps/Places/Routes credential for maps-gateway.
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_api_key
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# Wallet issuer secrets are only required once Google Wallet goes live in
# production. Keep them unset until that phase if wallet support is deferred.
GOOGLE_WALLET_ISSUER_ID=your_google_wallet_issuer_id
# Set with: supabase secrets set GOOGLE_WALLET_SERVICE_ACCOUNT_JSON="$(cat service-account.json)"
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"wallet-service@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
GOOGLE_WALLET_ISSUER_NAME=Cool
GOOGLE_WALLET_ALLOWED_ORIGINS=https://cool.ikanisa.com
COOL_PUBLIC_APP_BASE_URL=https://cool.ikanisa.com
TICKET_QR_HMAC_SECRET=your_private_ticket_qr_hmac_secret

OTP_CODE_HASH_SECRET=your_private_otp_hash_secret
AUTH_PHONE_PASSWORD_SECRET=your_private_phone_auth_secret

# Optional Play review / QA bypass for WhatsApp OTP.
# Leave unset in normal production operation.
OTP_TEST_PHONE=+250788767816
OTP_TEST_CODE=123456

# ── Push Notifications (FCM HTTP v1) ──
# Required by the `send-notification` Edge Function and any function that
# calls `sendToUser()` / `sendToTopic()` from `_shared/fcm.ts`.
# Also used by BioPay App Check verification; the service account needs the
# Firebase App Check Token Verifier permission when attestation is enforced.
# Set with: supabase secrets set FIREBASE_SERVICE_ACCOUNT_JSON="$(cat firebase-sa.json)"
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"firebase-adminsdk@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","project_id":"your-firebase-project-id"}
# Optional override (auto-derived from the service account JSON if omitted).
FIREBASE_PROJECT_ID=your-firebase-project-id
