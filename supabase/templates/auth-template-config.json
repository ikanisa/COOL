{
  "mailer_subjects_invite": "Your invitation to Collect",
  "mailer_templates_invite_content": "<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\"><title>Join Collect</title>\n<style>\n@media only screen and (max-width:600px){.shell{padding:24px 12px!important}.card{padding:32px 24px!important}.heading{font-size:28px!important;line-height:34px!important}.code{font-size:28px!important;letter-spacing:3px!important}}\n@media(prefers-color-scheme:dark){.background{background:#000000!important}.surface{background:#161618!important}.ink{color:#f4f4f4!important}.muted{color:#a1a1a3!important}.button{background:#f4f4f4!important;color:#191c1f!important}.code-surface{background:#000000!important}}\n</style></head>\n<body class=\"background\" style=\"margin:0;padding:0;background:#f7f7f7;color:#191c1f;font-family:Inter,Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all\">You have been invited to Collect.</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td class=\"shell\" align=\"center\" style=\"padding:48px 20px\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:560px\"><tr><td class=\"surface card\" style=\"padding:40px;background:#ffffff;border-radius:24px\">\n<p class=\"ink\" style=\"margin:0 0 40px;font-size:28px;line-height:34px;letter-spacing:-1px;font-weight:700;color:#191c1f\">Collect</p>\n<p class=\"muted\" style=\"margin:0 0 12px;font-size:12px;line-height:18px;letter-spacing:1px;font-weight:500;color:#717173;text-transform:uppercase\">Your invitation</p>\n<h1 class=\"ink heading\" style=\"margin:0 0 20px;font-size:32px;line-height:38px;letter-spacing:-0.7px;font-weight:700;color:#191c1f\">Join Collect</h1>\n<p class=\"ink\" style=\"margin:0 0 16px;font-size:16px;line-height:26px;color:#191c1f\">You have been invited to Collect.</p><p class=\"ink\" style=\"margin:0 0 16px;font-size:16px;line-height:26px;color:#191c1f\">Open Collect and sign in with the email address that received this invitation. We will send you a one-time code.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px 0 0\"><tr><td class=\"button\" align=\"center\" bgcolor=\"#191c1f\" style=\"background:#191c1f;border-radius:9999px;mso-padding-alt:16px 28px\"><a class=\"button\" href=\"{{ .SiteURL }}/#/admin/login\" style=\"display:inline-block;padding:16px 28px;border-radius:9999px;background:#191c1f;color:#ffffff;font-size:16px;line-height:20px;font-weight:700;text-decoration:none;text-align:center\">Open Collect</a></td></tr></table>\n<p class=\"muted\" style=\"margin:28px 0 0;font-size:14px;line-height:22px;color:#717173\">This invitation does not sign you in. If you were not expecting it, contact your super admin.</p>\n<p class=\"muted\" style=\"margin:40px 0 0;font-size:13px;line-height:20px;color:#717173\">Collect<br><a class=\"muted\" href=\"mailto:info@ikanisa.com\" style=\"color:#717173;text-decoration:underline\">info@ikanisa.com</a></p>\n</td></tr></table></td></tr></table>\n</body></html>\n",
  "mailer_subjects_magic_link": "Your Collect sign-in code",
  "mailer_templates_magic_link_content": "<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\"><title>Your sign-in code</title>\n<style>\n@media only screen and (max-width:600px){.shell{padding:24px 12px!important}.card{padding:32px 24px!important}.heading{font-size:28px!important;line-height:34px!important}.code{font-size:28px!important;letter-spacing:3px!important}}\n@media(prefers-color-scheme:dark){.background{background:#000000!important}.surface{background:#161618!important}.ink{color:#f4f4f4!important}.muted{color:#a1a1a3!important}.button{background:#f4f4f4!important;color:#191c1f!important}.code-surface{background:#000000!important}}\n</style></head>\n<body class=\"background\" style=\"margin:0;padding:0;background:#f7f7f7;color:#191c1f;font-family:Inter,Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all\">Your one-time sign-in code expires in 5 minutes.</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td class=\"shell\" align=\"center\" style=\"padding:48px 20px\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:560px\"><tr><td class=\"surface card\" style=\"padding:40px;background:#ffffff;border-radius:24px\">\n<p class=\"ink\" style=\"margin:0 0 40px;font-size:28px;line-height:34px;letter-spacing:-1px;font-weight:700;color:#191c1f\">Collect</p>\n<p class=\"muted\" style=\"margin:0 0 12px;font-size:12px;line-height:18px;letter-spacing:1px;font-weight:500;color:#717173;text-transform:uppercase\">Account security</p>\n<h1 class=\"ink heading\" style=\"margin:0 0 20px;font-size:32px;line-height:38px;letter-spacing:-0.7px;font-weight:700;color:#191c1f\">Your sign-in code</h1>\n<p class=\"ink\" style=\"margin:0 0 16px;font-size:16px;line-height:26px;color:#191c1f\">Enter this code in Collect to continue.</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:24px 0\"><tr><td class=\"code-surface\" align=\"center\" style=\"padding:20px 12px;background:#f7f7f7;border-radius:16px\"><p class=\"ink code\" style=\"margin:0;font-size:32px;line-height:40px;font-weight:700;letter-spacing:4px;font-variant-numeric:tabular-nums;color:#191c1f\">{{ .Token }}</p></td></tr></table><p class=\"ink\" style=\"margin:0 0 16px;font-size:16px;line-height:26px;color:#191c1f\">This code expires in 5 minutes and can be used once.</p>\n<p class=\"muted\" style=\"margin:28px 0 0;font-size:14px;line-height:22px;color:#717173\">Never share your code. If you did not request it, you can ignore this email.</p>\n<p class=\"muted\" style=\"margin:40px 0 0;font-size:13px;line-height:20px;color:#717173\">Collect<br><a class=\"muted\" href=\"mailto:info@ikanisa.com\" style=\"color:#717173;text-decoration:underline\">info@ikanisa.com</a></p>\n</td></tr></table></td></tr></table>\n</body></html>\n",
  "mailer_subjects_confirmation": "Your Collect sign-in code",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\"><title>Your sign-in code</title>\n<style>\n@media only screen and (max-width:600px){.shell{padding:24px 12px!important}.card{padding:32px 24px!important}.heading{font-size:28px!important;line-height:34px!important}.code{font-size:28px!important;letter-spacing:3px!important}}\n@media(prefers-color-scheme:dark){.background{background:#000000!important}.surface{background:#161618!important}.ink{color:#f4f4f4!important}.muted{color:#a1a1a3!important}.button{background:#f4f4f4!important;color:#191c1f!important}.code-surface{background:#000000!important}}\n</style></head>\n<body class=\"background\" style=\"margin:0;padding:0;background:#f7f7f7;color:#191c1f;font-family:Inter,Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all\">Confirm your email to continue to Collect. Your code expires in 5 minutes.</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td class=\"shell\" align=\"center\" style=\"padding:48px 20px\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:560px\"><tr><td class=\"surface card\" style=\"padding:40px;background:#ffffff;border-radius:24px\">\n<p class=\"ink\" style=\"margin:0 0 40px;font-size:28px;line-height:34px;letter-spacing:-1px;font-weight:700;color:#191c1f\">Collect</p>\n<p class=\"muted\" style=\"margin:0 0 12px;font-size:12px;line-height:18px;letter-spacing:1px;font-weight:500;color:#717173;text-transform:uppercase\">Account security</p>\n<h1 class=\"ink heading\" style=\"margin:0 0 20px;font-size:32px;line-height:38px;letter-spacing:-0.7px;font-weight:700;color:#191c1f\">Your sign-in code</h1>\n<p class=\"ink\" style=\"margin:0 0 16px;font-size:16px;line-height:26px;color:#191c1f\">Enter this code in Collect to confirm your email and continue.</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:24px 0\"><tr><td class=\"code-surface\" align=\"center\" style=\"padding:20px 12px;background:#f7f7f7;border-radius:16px\"><p class=\"ink code\" style=\"margin:0;font-size:32px;line-height:40px;font-weight:700;letter-spacing:4px;font-variant-numeric:tabular-nums;color:#191c1f\">{{ .Token }}</p></td></tr></table><p class=\"ink\" style=\"margin:0 0 16px;font-size:16px;line-height:26px;color:#191c1f\">This code expires in 5 minutes and can be used once.</p>\n<p class=\"muted\" style=\"margin:28px 0 0;font-size:14px;line-height:22px;color:#717173\">Never share your code. If you did not request it, you can ignore this email.</p>\n<p class=\"muted\" style=\"margin:40px 0 0;font-size:13px;line-height:20px;color:#717173\">Collect<br><a class=\"muted\" href=\"mailto:info@ikanisa.com\" style=\"color:#717173;text-decoration:underline\">info@ikanisa.com</a></p>\n</td></tr></table></td></tr></table>\n</body></html>\n",
  "mailer_subjects_recovery": "Reset your Collect password",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\"><title>Reset your password</title>\n<style>\n@media only screen and (max-width:600px){.shell{padding:24px 12px!important}.card{padding:32px 24px!important}.heading{font-size:28px!important;line-height:34px!important}.code{font-size:28px!important;letter-spacing:3px!important}}\n@media(prefers-color-scheme:dark){.background{background:#000000!important}.surface{background:#161618!important}.ink{color:#f4f4f4!important}.muted{color:#a1a1a3!important}.button{background:#f4f4f4!important;color:#191c1f!important}.code-surface{background:#000000!important}}\n</style></head>\n<body class=\"background\" style=\"margin:0;padding:0;background:#f7f7f7;color:#191c1f;font-family:Inter,Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all\">Choose a new password for your Collect account.</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td class=\"shell\" align=\"center\" style=\"padding:48px 20px\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:560px\"><tr><td class=\"surface card\" style=\"padding:40px;background:#ffffff;border-radius:24px\">\n<p class=\"ink\" style=\"margin:0 0 40px;font-size:28px;line-height:34px;letter-spacing:-1px;font-weight:700;color:#191c1f\">Collect</p>\n<p class=\"muted\" style=\"margin:0 0 12px;font-size:12px;line-height:18px;letter-spacing:1px;font-weight:500;color:#717173;text-transform:uppercase\">Account security</p>\n<h1 class=\"ink heading\" style=\"margin:0 0 20px;font-size:32px;line-height:38px;letter-spacing:-0.7px;font-weight:700;color:#191c1f\">Reset your password</h1>\n<p class=\"ink\" style=\"margin:0 0 16px;font-size:16px;line-height:26px;color:#191c1f\">A password reset was requested for your Collect account.</p><p class=\"ink\" style=\"margin:0 0 16px;font-size:16px;line-height:26px;color:#191c1f\">Use the button below to choose a new password.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px 0 0\"><tr><td class=\"button\" align=\"center\" bgcolor=\"#191c1f\" style=\"background:#191c1f;border-radius:9999px;mso-padding-alt:16px 28px\"><a class=\"button\" href=\"{{ .SiteURL }}/#/admin/setup?token={{ .TokenHash }}&amp;invite=false\" style=\"display:inline-block;padding:16px 28px;border-radius:9999px;background:#191c1f;color:#ffffff;font-size:16px;line-height:20px;font-weight:700;text-decoration:none;text-align:center\">Reset password</a></td></tr></table>\n<p class=\"muted\" style=\"margin:28px 0 0;font-size:14px;line-height:22px;color:#717173\">If you did not request this, you can ignore this email. Your password will stay the same.</p>\n<p class=\"muted\" style=\"margin:40px 0 0;font-size:13px;line-height:20px;color:#717173\">Collect<br><a class=\"muted\" href=\"mailto:info@ikanisa.com\" style=\"color:#717173;text-decoration:underline\">info@ikanisa.com</a></p>\n</td></tr></table></td></tr></table>\n</body></html>\n"
}
