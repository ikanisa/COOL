{
  "id": "/admin/",
  "name": "COOL Admin Console",
  "short_name": "COOL Admin",
  "description": "Installable admin workspace for COOL platform operations, release control, user management, app configuration, analytics, audit, and backend recovery.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/admin/?source=pwa",
  "scope": "/admin/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait-primary",
  "background_color": "#F1EEFF",
  "theme_color": "#0D0A27",
  "categories": [
    "business"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+cool-admin",
      "url": "/admin/platform/?intent=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "Platform Command",
      "short_name": "Command",
      "description": "Open the admin command dashboard.",
      "url": "/admin/platform/",
      "icons": [
        {
          "src": "/assets/icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Users",
      "short_name": "Users",
      "description": "Open user administration and access workflows.",
      "url": "/admin/users/",
      "icons": [
        {
          "src": "/assets/icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Operations",
      "short_name": "Ops",
      "description": "Open release health, incident, and alert workflows.",
      "url": "/admin/operations/",
      "icons": [
        {
          "src": "/assets/icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "App Config",
      "short_name": "Config",
      "description": "Open rollout, payment route, and feature controls.",
      "url": "/admin/app-config/",
      "icons": [
        {
          "src": "/assets/icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Audit Log",
      "short_name": "Audit",
      "description": "Open audit evidence and admin action history.",
      "url": "/admin/audit-log/",
      "icons": [
        {
          "src": "/assets/icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/assets/screenshots/home.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "COOL admin workspace selector"
    },
    {
      "src": "/assets/screenshots/shop.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "COOL platform command dashboard"
    },
    {
      "src": "/assets/screenshots/settings.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "COOL admin configuration and audit tools"
    }
  ],
  "icons": [
    {
      "src": "/assets/icons/Icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/icons/Icon-256.png",
      "sizes": "256x256",
      "type": "image/png"
    },
    {
      "src": "/assets/icons/Icon-384.png",
      "sizes": "384x384",
      "type": "image/png"
    },
    {
      "src": "/assets/icons/Icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/assets/icons/Icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png"
    },
    {
      "src": "/assets/icons/Icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/icons/Icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
