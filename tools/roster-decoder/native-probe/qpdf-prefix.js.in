const diagnostics=[];let diagnosticBytes=0;const record=(...values)=>{const value=values.map(String).join(' ');diagnosticBytes+=value.length;if(diagnosticBytes>65536)throw Error('qpdf_diagnostic_limit');diagnostics.push(value);};const console={log:record,error:record,warn:record};const process=undefined;const window=globalThis;const module={exports:{}};const exports=module.exports;
