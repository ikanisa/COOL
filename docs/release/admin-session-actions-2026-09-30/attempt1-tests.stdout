              '              crossAxisAlignment: CrossAxisAlignment.start,\n'
              '              children: [\n'
              '                const InfoSecurityBanner(\n'
              '                  title: \'Private group · review every row\',\n'
              '                  message:\n'
              '                      \'A preview adds no members. Save your review, confirm every row, then submit the complete roster together.\',\n'
              '                ),\n'
              '                const SizedBox(height: CollectSpacing.x4),\n'
              '                if (draft.mode == \'create\') ...[\n'
              '                  TextFormField(\n'
              '                    key: const Key(\'roster-title\'),\n'
              '                    controller: _title,\n'
              '                    enabled: !locked && !draft.commitPending,\n'
              '                    decoration: const InputDecoration(\n'
              '                      labelText: \'Group name\',\n'
              '                      errorMaxLines: 3,\n'
              '                    ),\n'
              '                    validator: (value) =>\n'
              '                        (value?.trim().length ?? 0) < 3 ||\n'
              '                            (value?.trim().length ?? 0) > 120\n'
              '                        ? \'Use 3 to 120 characters.\'\n'
              '                        : null,\n'
              '                  ),\n'
              '                  const SizedBox(height: CollectSpacing.x4),\n'
              '                ],\n'
              '                TextFormField(\n'
              '                  key: const Key(\'roster-reason\'),\n'
              '                  controller: _reason,\n'
              '                  enabled:\n'
              '                      !locked && !draft.reviewPending && !draft.commitPending,\n'
              '                  minLines: 2,\n'
              '                  maxLines: 4,\n'
              '                  decoration: const InputDecoration(\n'
              '                    labelText: \'Reason\',\n'
              '                    errorMaxLines: 3,\n'
              '                    helperMaxLines: 4,\n'
              '                    helperText: \'Required for the review and audit trail.\',\n'
              '                  ),\n'
              '                  validator: (value) =>\n'
              '                      (value?.trim().length ?? 0) < 8 ||\n'
              '                          (value?.trim().length ?? 0) > 500\n'
              '                      ? \'Use 8 to 500 characters.\'\n'
              '                      : null,\n'
              '                ),\n'
              '                const SizedBox(height: CollectSpacing.x4),\n'
              '                if (receipt == null) ...[\n'
              '                  TextFormField(\n'
              '                    key: const Key(\'roster-source\'),\n'
              '                    controller: _text,\n'
              '                    enabled: !locked && !draft.sourceLocked && _file == null,\n'
              '                    minLines: 5,\n'
              '                    maxLines: 9,\n'
              '                    decoration: const InputDecoration(\n'
              '                      labelText: \'Member roster\',\n'
              '                      errorMaxLines: 3,\n'
              '                      helperMaxLines: 5,\n'
              '                      helperText:\n'
              '                          \'Member name, registered MoMo name, MoMo number. Up to 500 rows.\',\n'
              '                    ),\n'
              '                  ),\n'
              '                  const SizedBox(height: CollectSpacing.x3),\n'
              '                  Wrap(\n'
              '                    spacing: CollectSpacing.x2,\n'
              '                    runSpacing: CollectSpacing.x2,\n'
              '                    children: [\n'
              '                      OutlinedButton.icon(\n'
              '                        onPressed: locked || draft.sourceLocked ? null : _pick,\n'
              '                        icon: const Icon(Icons.upload_file_outlined),\n'
              '                        label: const Text(\'Choose roster file\'),\n'
              '                      ),\n'
              '                      if (_file != null)\n'
              '                        TextButton(\n'
              '                          onPressed: locked || draft.sourceLocked\n'
              '                              ? null\n'
              '                              : () => setState(() {\n'
              '                                  _file = null;\n'
              '                                  _consent = false;\n'
              '                                }),\n'
              '                          child: const Text(\'Use pasted list\'),\n'
              '                        ),\n'
              '                    ],\n'
              '                  ),\n'
              '                  if (_file != null)\n'
              '                    Padding(\n'
              '                      padding: const EdgeInsets.only(top: CollectSpacing.x2),\n'
              '                      child: Text(_file!.name),\n'
              '                    ),\n'
              '                  if (_ai)\n'
              '                    CheckboxListTile(\n'
              '                      contentPadding: EdgeInsets.zero,\n'
              '                      value: _consent,\n'
              '                      onChanged: locked || draft.sourceLocked\n'
              '                          ? null\n'
              '                          : (value) =>\n'
              '                                setState(() => _consent = value ?? false),\n'
              '                      title: const Text(\'Use OpenAI for this file\'),\n'
              '                      subtitle: const Text(\n'
              '                        \'Send this PDF or image for extraction. Collect retains a source and consent receipt plus extracted and reviewed rows; it does not retain the original file. Review all results before adding members.\',\n'
              '                      ),\n'
              '                    ),\n'
              '                  if (_file?.extension?.toLowerCase() == \'xlsx\')\n'
              '                    const Text(\n'
              '                      \'The workbook is retained only for this request. Its original bytes and the text derived by this browser are identified separately; the server does not verify the text against workbook cells.\',\n'
              '                    ),\n'
              '                ],\n'
              '                if (receipt != null) ...[\n'
              '                  _sourceReceipt(context),\n'
              '                  const SizedBox(height: CollectSpacing.x4),\n'
              '                  Semantics(\n'
              '                    liveRegion: true,\n'
              '                    child: Text(\n'
              '                      \'${receipt.rowCount} rows · ${receipt.readyCount} ready · ${receipt.errorCount} requiring correction\',\n'
              '                      style: Theme.of(context).textTheme.titleSmall,\n'
              '                    ),\n'
              '                  ),\n'
              '                  Text(\n'
              '                    draft.edited\n'
              '                        ? \'Unsaved corrections · save a new review before submitting.\'\n'
              '                        : receipt.isHumanReview\n'
              '                        ? receipt.canSubmit\n'
              '                              ? \'Human review saved · revision ${receipt.revisionNumber}\'\n'
              '                              : \'Saved review is unavailable for submission. Discard this draft and start a new import.\'\n'
              '                        : \'Initial preview · human review required\',\n'
              '                  ),\n'
              '                  const SizedBox(height: CollectSpacing.x3),\n'
              '                  for (\n'
              '                    var index = _page * 25;\n'
              '                    index < draft.rows.length && index < (_page + 1) * 25;\n'
              '                    index++\n'
              '                  )\n'
              '                    _row(context, index),\n'
              '                  Wrap(\n'
              '                    spacing: CollectSpacing.x2,\n'
              '                    crossAxisAlignment: WrapCrossAlignment.center,\n'
              '                    children: [\n'
              '                      OutlinedButton(\n'
              '                        onPressed: locked || _page == 0\n'
              '                            ? null\n'
              '                            : () => setState(() {\n'
              '                                _page--;\n'
              '                                _visited.add(_page);\n'
              '                              }),\n'
              '                        child: const Text(\'Previous rows\'),\n'
              '                      ),\n'
              '                      Semantics(\n'
              '                        liveRegion: true,\n'
              '                        child: Text(\'Page ${_page + 1} of $pages\'),\n'
              '                      ),\n'
              '                      OutlinedButton(\n'
              '                        onPressed: locked || _page + 1 >= pages\n'
              '                            ? null\n'
              '                            : () => setState(() {\n'
              '                                _page++;\n'
              '                                _visited.add(_page);\n'
              '                              }),\n'
              '                        child: const Text(\'Next rows\'),\n'
              '                      ),\n'
              '                    ],\n'
              '                  ),\n'
              '                  const SizedBox(height: CollectSpacing.x3),\n'
              '                  CheckboxListTile(\n'
              '                    key: const Key(\'roster-affirm\'),\n'
              '                    contentPadding: EdgeInsets.zero,\n'
              '                    value: draft.affirmed,\n'
              '                    onChanged: canAffirm\n'
              '                        ? (value) => draft.affirm(value ?? false)\n'
              '                        : null,\n'
              '                    title: Text(\n'
              '                      \'I have reviewed all ${draft.rows.length} rows and confirm these members and MoMo identities.\',\n'
              '                    ),\n'
              '                    subtitle: Text(\n'
              '                      _visited.length < pages\n'
              '                          ? \'Visit every page before confirming.\'\n'
              '                          : \'Save the review before confirming. Editing a row requires a new saved review.\',\n'
              '                    ),\n'
              '                  ),\n'
              '                ],\n'
              '                if (draft.error != null)\n'
              '                  Padding(\n'
              '                    padding: const EdgeInsets.only(top: CollectSpacing.x3),\n'
              '                    child: Semantics(\n'
              '                      liveRegion: true,\n'
              '                      child: Text(\n'
              '                        draft.error!,\n'
              '                        style: TextStyle(\n'
              '                          color: Theme.of(context).colorScheme.error,\n'
              '                        ),\n'
              '                      ),\n'
              '                    ),\n'
              '                  ),\n'
              '                if (locked)\n'
              '                  Padding(\n'
              '                    padding: const EdgeInsets.only(top: CollectSpacing.x3),\n'
              '                    child: Semantics(\n'
              '                      liveRegion: true,\n'
              '                      label: \'Roster request in progress\',\n'
              '                      child: const LinearProgressIndicator(),\n'
              '                    ),\n'
              '                  ),\n'
              '              ],\n'
              '            ),\n'
              '          ),\n'
              '        ),\n'
              '        actions: [\n'
              '          TextButton(\n'
              '            onPressed: locked ? null : () => Navigator.of(context).pop(),\n'
              '            child: Text(\n'
              '              draft.commitPending\n'
              '                  ? \'Discard draft · outcome may be unknown\'\n'
              '                  : \'Discard draft\',\n'
              '            ),\n'
              '          ),\n'
              '          if (receipt == null)\n'
              '            OutlinedButton(\n'
              '              onPressed: locked || draft.terminalUploadFailure\n'
              '                  ? null\n'
              '                  : _prepare,\n'
              '              child: Text(\n'
              '                draft.sourceLocked ? \'Retry preview\' : \'Prepare preview\',\n'
              '              ),\n'
              '            ),\n'
              '          if (draft.canDiscardPendingReview)\n'
              '            TextButton(\n'
              '              onPressed: draft.discardRejectedReview,\n'
              '              child: const Text(\'Discard rejected review request\'),\n'
              '            ),\n'
              '          if (draft.statusRequired)\n'
              '            OutlinedButton(\n'
              '              onPressed: draft.canCheckStatus ? _checkStatus : null,\n'
              '              child: const Text(\'Check saved import status\'),\n'
              '            ),\n'
              '          if (receipt != null && !draft.commitPending)\n'
              '            OutlinedButton(\n'
              '              onPressed: locked || !draft.canSaveReview\n'
              '                  ? null\n'
              '                  : () async {\n'
              '                      if (_valid()) await draft.saveReview(_reason.text);\n'
              '                      if (mounted && draft.reviewIssues.isNotEmpty) {\n'
              '                        setState(\n'
              '                          () => _page = draft.reviewIssues.keys.first ~/ 25,\n'
              '                        );\n'
              '                      }\n'
              '                    },\n'
              '              child: Text(\n'
              '                draft.reviewPending\n'
              '                    ? \'Retry saved review\'\n'
              '                    : \'Save reviewed rows\',\n'
              '              ),\n'
              '            ),\n'
              '          if (receipt != null)\n'
              '            FilledButton(\n'
              '              onPressed: !locked && (draft.canCommit || draft.canRetryCommit)\n'
              '                  ? _commit\n'
              '                  : null,\n'
              '              child: Text(\n'
              '                draft.commitPending\n'
              '                    ? \'Retry same submission\'\n'
              '                    : draft.mode == \'create\'\n'
              '                    ? \'Create group and add members\'\n'
              '                    : \'Add members\',\n'
              '              ),\n'
              '            ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget _sourceReceipt(BuildContext context) {\n'
              '    final initial = draft.initialPreview!;\n'
              '    final source = initial.raw[\'source_receipt\'] as Map;\n'
              '    return ExpansionTile(\n'
              '      title: Text(\n'
              '        initial.processingMethod == \'openai_structured_extraction\'\n'
              '            ? \'Original AI extraction receipt\'\n'
              '            : \'Original source receipt\',\n'
              '      ),\n'
              '      subtitle: Text(\'${source[\'client_filename\']} · ${initial.sourceKind}\'),\n'
              '      childrenPadding: const EdgeInsets.all(CollectSpacing.x3),\n'
              '      children: [\n'
              '        SelectableText(\n'
              '          \'Source SHA-256: ${initial.sourceSha256}\\nImport: ${initial.importId}\\nInitial revision: ${initial.revisionId}\\nCurrent revision: ${draft.preview!.revisionId}\\nParent revision: ${draft.preview!.parentRevisionId ?? \'Initial preview\'}\\nExpires: ${initial.expiresAt.toLocal()}\',\n'
              '        ),\n'
              '        if (initial.model != null)\n'
              '          Text(\n'
              '            \'Extraction model: ${initial.model}\\nConsent receipt: ${source[\'consent_version\']}\\nExtraction: ${source[\'extraction_id\']}\',\n'
              '          ),\n'
              '        if (initial.sourceKind == \'xlsx\')\n'
              '          const Text(\n'
              '            \'Workbook bytes recorded; TSV was derived by this browser, not verified against workbook cells by the server.\',\n'
              '          ),\n'
              '      ],\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget _row(BuildContext context, int index) {\n'
              '    final current = draft.preview!.rows[index];\n'
              '    final initial = draft.initialPreview!.rows[index];\n'
              '    return Padding(\n'
              '      key: ValueKey(\'roster-row-$index\'),\n'
              '      padding: const EdgeInsets.symmetric(vertical: CollectSpacing.x3),\n'
              '      child: Column(\n'
              '        crossAxisAlignment: CrossAxisAlignment.start,\n'
              '        children: [\n'
              '          Text(\n'
              '            \'Row ${index + 1}\',\n'
              '            style: Theme.of(context).textTheme.titleSmall,\n'
              '          ),\n'
              '          if (draft.initialPreview!.processingMethod ==\n'
              '              \'openai_structured_extraction\')\n'
              '            Text(\n'
              '              \'Initial extraction confidence: ${(initial.confidence * 100).toStringAsFixed(0)}% · verify against the source\',\n'
              '            ),\n'
              '          for (final entry in const {\n'
              '            \'member_name\': \'Member name\',\n'
              '            \'momo_name\': \'Registered MoMo name\',\n'
              '            \'momo_number\': \'MoMo number\',\n'
              '          }.entries)\n'
              '            Padding(\n'
              '              padding: const EdgeInsets.only(top: CollectSpacing.x2),\n'
              '              child: TextFormField(\n'
              '                key: ValueKey(\n'
              '                  \'roster-${draft.preview!.revisionId}-$index-${entry.key}\',\n'
              '                ),\n'
              '                initialValue: draft.rows[index][entry.key] as String,\n'
              '                enabled: draft.canEdit,\n'
              '                decoration: InputDecoration(\n'
              '                  labelText: \'${entry.value} · row ${index + 1}\',\n'
              '                ),\n'
              '                keyboardType: entry.key == \'momo_number\'\n'
              '                    ? TextInputType.phone\n'
              '                    : TextInputType.text,\n'
              '                onChanged: (value) => draft.edit(index, entry.key, value),\n'
              '              ),\n'
              '            ),\n'
              '          if (draft.reviewIssues[index] != null)\n'
              '            Text(\n'
              '              draft.reviewIssues[index]!,\n'
              '              style: TextStyle(color: Theme.of(context).colorScheme.error),\n'
              '            ),\n'
              '          if (current.issues.isNotEmpty && !draft.edited)\n'
              '            Text(\n'
              '              current.issues.join(\' · \'),\n'
              '              style: TextStyle(color: Theme.of(context).colorScheme.error),\n'
              '            ),\n'
              '          const Divider(),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'Future<AdminRosterCommit?> showAdminRosterImport(\n'
              '  BuildContext context,\n'
              '  AdminRosterDraft draft,\n'
              ') async {\n'
              '  final previousFocus = FocusManager.instance.primaryFocus;\n'
              '  final result = await showDialog<AdminRosterCommit>(\n'
              '    context: context,\n'
              '    barrierDismissible: false,\n'
              '    animationStyle: CollectMotion.animationStyle(context),\n'
              '    builder: (_) => AdminRosterImportDialog(draft: draft),\n'
              '  );\n'
              '  if (previousFocus?.context != null && previousFocus!.canRequestFocus) {\n'
              '    previousFocus.requestFocus();\n'
              '  }\n'
              '  return result;\n'
              '}\n'
              ''
