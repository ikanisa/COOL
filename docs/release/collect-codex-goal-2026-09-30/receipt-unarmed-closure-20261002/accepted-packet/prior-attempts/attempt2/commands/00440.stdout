f not c.enabled or c.revision<>j.configuration_revision then raise exception 'receipt_worker_authority_lost'using errcode='42501';end if;\n if j.expires_at<=clock_timestamp()or exists(select 1 from collect_ops.receipt_worker_expirations where request_id=j.request_id)\n  then raise exception 'receipt_worker_expired'using errcode='55000';end if;\n -- The escalation pump takes roster before workflow. Acquire both before\n -- the scanner so the combined transaction preserves that same lock order.\n perform pg_advisory_xact_lock(hashtext('collect_admin_combined_roster'));\n perform pg_advisory_xact_lock(hashtext('collect-ops-workflow'));\n if j.expires_at<=clock_timestamp()then raise exception 'receipt_worker_expired'using errcode='55000';end if;\n scan:=public.process_receipt_deferral_exceptions_v1(j.request_id,j.scan_limit,j.expires_at);\n if scan->>'status'='processed'then escalation:=public.process_exception_escalations_v1(j.escalation_limit);\n else escalation:=jsonb_build_object('contract_version',1,'channel','admin_inbox','delivered',0,'obsolete',0,'recipient_unavailable',0,'external_send',false);end if;\n t:=clock_timestamp();if j.expires_at<=t then raise exception 'receipt_worker_expired'using errcode='55000';end if;\n -- Scan, source observations, inbox delivery and this receipt commit together.\n result:=jsonb_build_object('contract_version',1,'request_id',j.request_id,'configuration_revision',j.configuration_revision,\n  'recorded_at',collect_ops.utc(t),'expires_at',collect_ops.utc(j.expires_at),'status',case when scan->>'status'='busy'then 'busy'else 'completed'end,\n  'scan',scan,'escalation',escalation,'financial_action',false,'send_action',false,'external_send',false);\n insert into collect_ops.receipt_worker_receipts values(j.request_id,t,result,j.request_id);\n return jsonb_build_object('contract_version',1,'request_id',p_request_id,'status','recorded','receipt',result);\nend$function$\n", "oid": "23352", "owner": "16384", "config": ["search_path=\"\"", "lock_timeout=200ms"]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.get_receipt_exception_worker_request_v1(p_request_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare j collect_ops.receipt_worker_jobs;r collect_ops.receipt_worker_receipts;acquired boolean;t timestamptz;begin\n perform collect_ops.receipt_exception_service();if p_request_id is null then raise exception 'receipt_worker_request_invalid'using errcode='22023';end if;\n acquired:=pg_try_advisory_xact_lock(hashtextextended('collect-receipt-worker-job:'||p_request_id::text,0));\n if acquired then\n  select * into j from collect_ops.receipt_worker_jobs where request_id=p_request_id;\n  select * into r from collect_ops.receipt_worker_receipts where request_id=p_request_id;\n end if;\n t:=clock_timestamp();return jsonb_build_object('contract_version',1,'request_id',p_request_id,'checked_at',collect_ops.utc(t),\n  'sample_valid_until',collect_ops.utc(t+interval '60 seconds'),'status',case when not acquired then 'in_progress'when r.request_id is not null then 'recorded'else 'not_recorded'end,\n  'expires_at',case when j.request_id is null then null else collect_ops.utc(j.expires_at)end,'receipt',r.result);\nend$function$\n", "oid": "23353", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.configure_receipt_exception_schedule_v1(p_expected_revision bigint, p_enabled boolean, p_scan_limit integer, p_escalation_limit integer, p_day_jobs integer, p_day_scan_sources integer, p_day_escalations integer)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET lock_timeout TO '2s'\nAS $function$\ndeclare c collect_ops.receipt_worker_configuration;job bigint;begin\n if p_expected_revision is null or p_enabled is null or p_scan_limit is null or p_scan_limit not between 1 and 25\n  or p_escalation_limit is null or p_escalation_limit not between 1 and 20 or p_day_jobs is null or p_day_jobs not between 1 and 1440\n  or p_day_scan_sources is null or p_day_scan_sources not between p_scan_limit and 36000\n  or p_day_escalations is null or p_day_escalations not between p_escalation_limit and 28800 then\n  raise exception 'receipt_worker_configuration_invalid'using errcode='22023';end if;\n perform pg_advisory_xact_lock(hashtext('collect-receipt-trusted-worker'));\n select * into c from collect_ops.receipt_worker_configuration where singleton for update;\n if c.revision<>p_expected_revision or c.revision=1000000000 then raise exception 'receipt_worker_configuration_changed'using errcode='55000';end if;\n if p_enabled then perform collect_ops.receipt_worker_transport();end if;\n update collect_ops.receipt_worker_configuration set revision=revision+1,enabled=p_enabled,scan_limit=p_scan_limit,escalation_limit=p_escalation_limit,\n  day_jobs=p_day_jobs,day_scan_sources=p_day_scan_sources,day_escalations=p_day_escalations,updated_at=clock_timestamp()where singleton returning * into c;\n insert into collect_ops.receipt_worker_configuration_history values(c.revision,to_jsonb(c)-'singleton',clock_timestamp());\n for job in select jobid from cron.job where jobname='collect-receipt-exceptions'loop perform cron.unschedule(job);end loop;\n job:=cron.schedule('collect-receipt-exceptions','* * * * *','select collect_ops.run_receipt_exception_schedule();');\n perform cron.alter_job(job,active:=p_enabled);\n return to_jsonb(c)-'singleton';\nend$function$\n", "oid": "23355", "owner": "16384", "config": ["search_path=\"\"", "lock_timeout=2s"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_receipt_exception_worker_health_v1()\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare c collect_ops.receipt_worker_configuration;j collect_ops.receipt_worker_jobs;r collect_ops.receipt_worker_receipts;\n t timestamptz;state text;alerts jsonb:='[]'::jsonb;pending bigint;refused integer;transport_ready boolean:=false;\n day_count integer;scan_reserved integer;escalation_reserved integer;begin\n perform collect_ops.actor(false);t:=clock_timestamp();select * into c from collect_ops.receipt_worker_configuration where singleton;\n select * into j from collect_ops.receipt_worker_jobs order by created_at desc,request_id desc limit 1;\n select * into r from collect_ops.receipt_worker_receipts order by recorded_at desc,request_id desc limit 1;\n state:=case when not c.enabled then 'inactive'when j.request_id is null then 'unobserved'\n  when exists(select 1 from collect_ops.receipt_worker_receipts where request_id=j.request_id)then 'observed'\n  when exists(select 1 from collect_ops.receipt_worker_expirations where request_id=j.request_id)then 'expired_without_receipt'\n  when j.expires_at<=t then 'unknown'else 'pending'end;\n select count(*)into pending from collect_ops.receipt_exception_work where processed_at is null;\n select count(*),coalesce(sum(scan_limit),0),coalesce(sum(escalation_limit),0)into day_count,scan_reserved,escalation_reserved\n  from collect_ops.receipt_worker_jobs where reserved_day=(t at time zone 'UTC')::date;\n begin perform collect_ops.receipt_worker_transport();transport_ready:=true;\n exception when object_not_in_prerequisite_state then transport_ready:=false;end;\n refused:=coalesce((r.result->'scan'->>'refused')::integer,0);\n if c.enabled and(r.recorded_at is null or r.recorded_at<t-interval '180 seconds')then alerts:=alerts||jsonb_build_array('WORKER_STALE');end if;\n if state='unknown'then alerts:=alerts||jsonb_build_array('ORIGINAL_OUTCOME_UNKNOWN');end if;\n if state='expired_without_receipt'then alerts:=alerts||jsonb_build_array('ORIGINAL_EXPIRED_UNHANDLED');end if;\n if pending>c.scan_limit*10 then alerts:=alerts||jsonb_build_array('DEFERRAL_BACKLOG');end if;\n if refused>0 then alerts:=alerts||jsonb_build_array('SOURCE_REFUSALS');end if;\n if c.enabled and not transport_ready then alerts:=alerts||jsonb_build_array('TRANSPORT_UNCONFIGURED');end if;\n if c.enabled and(day_count>=c.day_jobs or scan_reserved+c.scan_limit>c.day_scan_sources or escalation_reserved+c.escalation_limit>c.day_escalations)\n  then alerts:=alerts||jsonb_build_array('WORKER_QUOTA_EXHAUSTED');end if;\n return jsonb_build_object('contract_version',1,'checked_at',collect_ops.utc(t),'sample_valid_until',collect_ops.utc(t+interval '60 seconds'),\n  'configuration_revision',c.revision,'enabled',c.enabled,'state',state,'last_request_id',j.request_id,'last_created_at',collect_ops.utc(j.created_at),\n  'last_expires_at',collect_ops.utc(j.expires_at),'last_recorded_at',collect_ops.utc(r.recorded_at),'last_outcome',r.result->'status',\n  'pending_sources',pending,'alerts',alerts,'transport_configured',transport_ready,\n  'day_jobs_reserved',day_count,'day_scan_sources_reserved',scan_reserved,'day_escalations_reserved',escalation_reserved,\n  'day_jobs_cap',c.day_jobs,'day_scan_sources_cap',c.day_scan_sources,'day_escalations_cap',c.day_escalations,\n  'source_scan_complete',false,'financial_action',false,'send_action',false,'external_send',false);\nend$function$\n", "oid": "23356", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.gateway_archive_attempt_v3(p_device_id uuid, p_request_id uuid, p_request_sha256 text, p_payload jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare a collect_gateway_dispatch.attempts;arm collect_gateway_dispatch.arms;prior collect_gateway_archive.requests;\n refs jsonb;x jsonb;cb collect_gateway_dispatch.callbacks;r collect_gateway_dispatch.requests;\n t timestamptz;idx integer:=0;n integer;reason text;ack uuid;result jsonb;ref_callback uuid;ref_request uuid;digest text;begin\n perform collect_gateway_archive.require_request(p_device_id,p_request_id,p_request_sha256);\n perform collect_gateway.payload_keys(p_payload,array['attempt_id','fence_version','body_sha256','destination_sha256','callback_requests']);\n if not pg_try_advisory_xact_lock(hashtextextended('gateway-dispatch-request:'||p_request_id::text,0))then raise exception 'gateway_archive_request_busy'using errcode='55000';end if;\n if exists(select 1 from collect_gateway.requests where request_id=p_request_id)or exists(select 1 from collect_gateway_dispatch.requests where request_id=p_request_id)then raise exception 'gateway_archive_request_conflict'using errcode='22023';end if;\n refs:=p_payload->'callback_requests';\n if jsonb_typeof(refs)is distinct from 'array'or jsonb_array_length(refs)not between 2 and 20\n  or jsonb_typeof(p_payload->'body_sha256')is distinct from 'string'or(p_payload->>'body_sha256')!~'^[0-9a-f]{64}$'\n  or jsonb_typeof(p_payload->'destination_sha256')is distinct from 'string'or(p_payload->>'destination_sha256')!~'^[0-9a-f]{64}$'then raise exception 'gateway_payload_invalid'using errcode='22023';end if;\n select * into a from collect_gateway_dispatch.attempts where id=collect_gateway.payload_uuid(p_payload,'attempt_id')and device_id=p_device_id;\n if a.id is null or a.fence_version<>collect_gateway.payload_int(p_payload,'fence_version',1,1000000000)then raise exception 'gateway_dispatch_attempt_unavailable'using errcode='42501';end if;\n -- Callback folds use this receipt -> attempt order. Pause/revocation never\n -- reopens dispatch, but must not discard already signed prior-arm evidence.\n perform 1 from collect_hybrid.sms_notification_outbox where id=a.outbox_id for update;\n select * into a from collect_gateway_dispatch.attempts where id=a.id for update;\n perform 1 from collect_gateway.devices where id=p_device_id for share;\n select * into prior from collect_gateway_archive.requests where request_id=p_request_id;\n if prior.request_id is not null then\n  if prior.device_id<>p_device_id or prior.request_sha256<>p_request_sha256 or prior.payload is distinct from p_payload then raise exception 'gateway_archive_request_conflict'using errcode='22023';end if;\n  return prior.result||jsonb_build_object('replay',true);\n end if;\n select * into arm from collect_gateway_dispatch.arms where attempt_id=a.id;\n if arm.attempt_id is null or a.body_sha256 is distinct from(p_payload->>'body_sha256')or a.destination_sha256 is distinct from(p_payload->>'destination_sha256')\n  or jsonb_array_length(refs)<>a.segment_count*2 then raise exception 'gateway_archive_binding_invalid'using errcode='22023';end if;\n for x in select value from jsonb_array_elements(refs)loop\n  perform collect_gateway.payload_keys(x,array['callback_id','request_id','request_sha256']);\n  ref_callback:=collect_gateway.payload_uuid(x,'callback_id');ref_request:=collect_gateway.payload_uuid(x,'request_id');digest:=x->>'request_sha256';\n  if jsonb_typeof(x->'request_sha256')is distinct from 'string'or digest!~'^[0-9a-f]{64}$'or ref_request=p_request_id\n   or ref_callback is distinct from((arm.callback_plan->(idx/2))->>case when idx%2=0 then 'sent_callback_id'else 'delivery_callback_id'end)::uuid then raise exception 'gateway_archive_binding_invalid'using errcode='22023';end if;\n  select * into r from collect_gateway_dispatch.requests where request_id=ref_request and device_id=p_device_id and action='callback';\n  select * into cb from collect_gateway_dispatch.callbacks where request_id=ref_request and attempt_id=a.id and callback_id=ref_callback;\n  if r.request_id is null or cb.request_id is null then reason:=coalesce(reason,'CALLBACK_EVIDENCE_INCOMPLETE');\n  elsif r.request_sha256<>digest or cb.segment_index<>idx/2 or cb.callback_kind<>(case when idx%2=0 then 'sent'else 'delivery'end) then raise exception 'gateway_archive_binding_invalid'using errcode='22023';\n  end if;idx:=idx+1;\n end loop;\n if(select count(distinct value->>'request_id')from jsonb_array_elements(refs))<>jsonb_array_length(refs)then raise exception 'gateway_archive_binding_invalid'using errcode='22023';end if;\n select count(*)into n from collect_gateway_dispatch.callback_bindings b where b.attempt_id=a.id;\n if n<>a.segment_count*2 then reason:='CALLBACK_EVIDENCE_INCOMPLETE';end if;\n if a.state='uncertain'or exists(select 1 from collect_gateway_dispatch.callbacks where attempt_id=a.id and result_code<>-1)\n  or exists(select 1 from collect_gateway_dispatch.callbacks where attempt_id=a.id group by callback_id having count(distinct jsonb_build_array(result_code,tp_status))>1)then reason:='CALLBACK_EVIDENCE_UNCERTAIN';\n elsif a.state<>'observed_sent'or(select count(distinct callback_id)from collect_gateway_dispatch.callbacks where attempt_id=a.id)<>a.segment_count*2 then reason:=coalesce(reason,'CALLBACK_EVIDENCE_INCOMPLETE');end if;\n if exists(select 1 from collect_gateway_archive.acknowledgements where attempt_id=a.id)then reason:='ATTEMPT_ALREADY_ACKNOWLEDGED';end if;\n t:=clock_timestamp();\n if reason is null then\n  ack:=gen_random_uuid();insert into collect_gateway_archive.acknowledgements values(ack,a.id,p_request_id,p_device_id,refs,t);\n end if;\n result:=jsonb_build_object('request_id',p_request_id,'device_id',p_device_id,'attempt_id',a.id,'fence_version',a.fence_version,\n  'ok',reason is null,'code',reason,'archive_ack_id',ack,'receipt_id',case when reason is null then a.outbox_id end,\n  'body_sha256',a.body_sha256,'destination_sha256',a.destination_sha256,'segment_count',a.segment_count,\n  'callback_requests',case when reason is null then refs end,'recorded_at',collect_gateway.utc(t),'replay',false,\n  'evidence_kind',case when reason is null then 'complete_framework_callback_observations'end,\n  'carrier_proof',false,'delivery_proven',false,'send_authority',false);\n insert into collect_gateway_archive.requests values(p_request_id,p_device_id,p_request_sha256,p_payload,result,t);return result;\nend$function$\n", "oid": "23406", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.gateway_archive_lookup_v3(p_device_id uuid, p_request_id uuid, p_request_sha256 text, p_payload jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$declare target uuid;r collect_gateway_archive.requests;begin\n perform collect_gateway_archive.require_request(p_device_id,p_request_id,p_request_sha256);\n perform collect_gateway.payload_keys(p_payload,array['target_request_id']);target:=collect_gateway.payload_uuid(p_payload,'target_request_id');\n if target=p_request_id then raise exception 'gateway_payload_invalid'using errcode='22023';end if;\n select * into r from collect_gateway_archive.requests where request_id=target and device_id=p_device_id;\n return jsonb_build_object('target_request_id',target,'outcome',case when r.request_id is null then 'unknown'else 'recorded'end,'recorded_result',r.result);\nend$function$\n", "oid": "23408", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.guard_runtime_control_request_v2()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$begin\n raise exception 'runtime_control_request_immutable' using errcode='55000';end$function$\n", "oid": "23454", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_v2_spec(p_family text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$declare spec jsonb:=collect_security.runtime_control_spec(p_family);begin\n if p_family is null or not p_family=any(array['account_request_reason_options','admin_navigation_items','admin_queue_filter_options','admin_queue_signals','admin_queue_sla_policies','admin_queue_specs','brand_entities','collection_category_subtypes','collection_purpose_templates','collection_type_catalog','collection_type_country_rules','feature_flags','notification_channels','notification_event_types','notification_template_versions','notification_templates','otp_policy','payment_entrypoints','policy_document_sections','policy_documents','roster_resource_policy','sms_receipt_member_consents','sms_receipt_policies','support_channels','system_settings'])\n  or spec is null or coalesce((spec->>'user_owned')::boolean,false) then\n  raise exception 'runtime_control_family_invalid' using errcode='22023';end if;\n return spec;\nend$function$\n", "oid": "23457", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_v2_utc(p_at timestamp with time zone)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE STRICT\n SET search_path TO ''\nAS $function$\n select to_char(p_at at time zone 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"')\n$function$\n", "oid": "23458", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_v2_deadline(p_expires_at timestamp with time zone, p_initial boolean DEFAULT false)\n RETURNS void\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$declare at_time timestamptz:=clock_timestamp();begin\n if p_expires_at is null or not isfinite(p_expires_at) or p_expires_at<=at_time\n  or p_initial and p_expires_at>at_time+interval '120 seconds' then\n  raise exception 'runtime_control_request_expired' using errcode='22023';end if;\n if current_setting('transaction_isolation')<>'read committed' then\n  raise exception 'runtime_control_read_committed_required' using errcode='25001';end if;\nend$function$\n", "oid": "23459", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_v2_observe(p_family text, p_audit boolean DEFAULT false)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare spec jsonb:=collect_security.runtime_control_v2_spec(p_family);sid uuid;u auth.users;s auth.sessions;\n role_uuid uuid;mode_value text;approval_time timestamptz;approval_expiry timestamptz;permission text;required text[];manage text[];can_manage boolean:=true;\nbegin\n if current_setting('transaction_isolation')<>'read committed' then raise exception 'runtime_control_read_committed_required' using errcode='25001';end if;\n if not pg_try_advisory_xact_lock_shared(193517,141) then raise exception 'runtime_control_authority_unavailable' using errcode='42501';end if;\n begin\n  lock table collect_admin_access.operator_auth_policy,collect_admin_access.email_approvals,collect_admin_access.whatsapp_approvals,\n   public.admin_user_roles,public.admin_roles,public.admin_role_permissions,public.admin_permissions in share mode nowait;\n exception when lock_not_available then raise exception 'runtime_control_authority_unavailable' using errcode='42501';end;\n sid:=public._lock_notification_registration_session();\n required:=array[case when p_audit then 'audit.read' else spec->>'read_permission' end];\n manage:=array[spec->>'permission'];\n if spec ? 'additional_permission' then manage:=array_append(manage,spec->>'additional_permission');end if;\n if exists(select 1 from unnest(required||manage)n where n is null or n !~ '^[a-z_]+(\\.[a-z_]+)+$')\n  or exists(select 1 from unnest(required||manage)n where not exists(select 1 from public.admin_permissions p where p.name=n)) then\n  raise exception 'runtime_control_registry_invalid' using errcode='55000';end if;\n select mode into mode_value from collect_admin_access.operator_auth_policy where id for share;\n if mode_value is null or mode_value not in('email','transition') then raise exception 'runtime_control_authority_invalid' using errcode='55000';end if;\n select * into u from auth.users where id=auth.uid() for share;\n select * into s from auth.sessions where id=sid and user_id=auth.uid() for share;\n if u.id is null or s.id is null or s.created_at is null or not isfinite(s.created_at)\n  or s.created_at>clock_timestamp() or s.aal::text not in('aal1','aal2') or s.aal is null\n  or s.not_after is not null and (not isfinite(s.not_after) or s.not_after<=clock_timestamp())\n  or u.deleted_at is not null or coalesce(u.is_anonymous,false) or u.banned_until>clock_timestamp() then\n  raise exception 'runtime_control_session_required' using errcode='42501';end if;\n if u.email_confirmed_at is not null then\n  select approved_at,expires_at into approval_time,approval_expiry from collect_admin_access.email_approvals a\n   where a.user_id=auth.uid() and a.email=lower(btrim(u.email)) and a.revoked_at is null\n    and (a.expires_at is null or a.expires_at>clock_timestamp()) for share;\n end if;\n if approval_time is null and mode_value='transition' and u.phone_confirmed_at is not null\n  and not exists(select 1 from collect_admin_access.email_approvals where user_id=auth.uid()) then\n  select approved_at,expires_at into approval_time,approval_expiry from collect_admin_access.whatsapp_approvals a\n   where a.user_id=auth.uid() and a.phone_e164='+'||ltrim(u.phone,'+') and a.revoked_at is null\n    and (a.expires_at is null or a.expires_at>clock_timestamp()) for share;\n end if;\n select r.id into role_uuid from public.admin_user_roles ur join public.admin_roles r on r.id=ur.role_id and r.name='platform_owner'\n  where ur.user_id=auth.uid() and ur.revoked_at is null and s.created_at>=ur.created_at\n   and approval_time is not null and s.created_at>=approval_time order by ur.created_at for share of ur,r;\n if role_uuid is null then raise exception 'runtime_control_permission_required' using errcode='42501';end if;\n for permission in select distinct n from unnest(required||manage)n order by n loop\n  perform 1 from public.admin_role_permissions where role_id=role_uuid and permission_name=permission for share;\n  if not found then\n   if permission=any(required) then raise exception 'runtime_control_permission_required' using errcode='42501';end if;\n   can_manage:=false;\n  end if;\n end loop;\n -- Authority times can elapse during a real row wait. Revalidate every clock\n -- predicate after the last permission lock, preserving the locked evidence.\n if approval_expiry is not null and approval_expiry<=clock_timestamp()\n  or not public._notification_session_is_live(sid,auth.uid())\n  or not collect_admin_access.approved_identity(auth.uid()) then raise exception 'runtime_control_session_required' using errcode='42501';end if;\n return jsonb_build_object('session_id',sid,'can_manage',can_manage);\nend$function$\n", "oid": "23460", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_v2_fingerprint(p_request_id uuid, p_family text, p_identity jsonb, p_patch_json text, p_expected_revision bigint, p_reason_sha256 text, p_expires_at timestamp with time zone)\n RETURNS text\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare spec jsonb:=collect_security.runtime_control_v2_spec(p_family);lines text[];field text;begin\n perform collect_security.runtime_control_check_identity(p_family,p_identity);\n lines:=array['collect-runtime-control-request-v2',p_request_id::text,p_family];\n for field in select jsonb_array_elements_text(spec->'identity') loop lines:=array_append(lines,field||'='||(p_identity->>field));end loop;\n lines:=lines||array[p_expected_revision::text,collect_security.runtime_control_v2_utc(p_expires_at),\n  encode(extensions.digest(convert_to(p_patch_json,'UTF8'),'sha256'),'hex'),p_reason_sha256];\n return encode(extensions.digest(convert_to(array_to_string(lines,E'\\n'),'UTF8'),'sha256'),'hex');\nend$function$\n", "oid": "23462", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_v2_project(p_family text, p_value jsonb)\n RETURNS jsonb\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$\n select case when p_value is null or p_value='null'::jsonb then null else\n (select coalesce(jsonb_object_agg(k,v),'{}'::jsonb) from jsonb_each(p_value)e(k,v)\n  where (collect_security.runtime_control_spec(p_family)->'identity')?k or (collect_security.runtime_control_spec(p_family)->'writable')?k) end\n$function$\n", "oid": "23463", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_runtime_control_v2(p_family text, p_identity jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare observed jsonb;value jsonb;at_time timestamptz;begin\n perform collect_security.runtime_control_v2_spec(p_family);\n observed:=collect_security.runtime_control_v2_observe(p_family);\n value:=public.admin_get_runtime_control_v1(p_family,p_identity);\n perform collect_security.runtime_control_actor(p_family,true);\n observed:=collect_security.runtime_control_v2_observe(p_family);at_time:=clock_timestamp();\n return (value-'contract_version')||jsonb_build_object('contract_version',2,'scope','runtime_controls',\n  'value',collect_security.runtime_control_v2_project(p_family,value->'value'),'checked_at',collect_security.runtime_control_v2_utc(at_time),\n  'sample_valid_until',collect_security.runtime_control_v2_utc(at_time+interval '60 seconds'),'can_manage',observed->'can_manage');\nend$function$\n", "oid": "23464", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_list_runtime_controls_v2(p_family text, p_limit integer DEFAULT 25, p_after_identity jsonb DEFAULT NULL::jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare spec jsonb:=collect_security.runtime_control_v2_spec(p_family);observed jsonb;head record;value jsonb;rows jsonb:='[]';cursor jsonb;counted integer:=0;at_time timestamptz;types jsonb;begin\n observed:=collect_security.runtime_control_v2_observe(p_family);\n if p_limit is null or p_limit not between 1 and 25 then raise exception 'runtime_control_query_invalid' using errcode='22023';end if;\n if p_after_identity is not null then perform collect_security.runtime_control_check_identity(p_family,p_after_identity);end if;\n for head in select h.identity from collect_security.runtime_control_heads h\n  where h.family=p_family and (p_after_identity is null or h.identity>p_after_identity) order by h.identity limit p_limit+1 loop\n  counted:=counted+1;if counted>p_limit then exit;end if;\n  value:=public.admin_get_runtime_control_v1(p_family,head.identity);\n  rows:=rows||jsonb_build_array((value-array['contract_version','ok','family'])||jsonb_build_object('value',collect_security.runtime_control_v2_project(p_family,value->'value')));\n  cursor:=head.identity;\n end loop;\n if counted<=p_limit then cursor:=null;end if;\n perform collect_security.runtime_control_actor(p_family,true);\n observed:=collect_security.runtime_control_v2_observe(p_family);at_time:=clock_timestamp();\n select coalesce(jsonb_object_agg(k,v),'{}') into types from jsonb_each(spec->'types')e(k,v) where (spec->'identity')?k or (spec->'writable')?k;\n return jsonb_build_object('contract_version',2,'scope','runtime_controls','family',p_family,'checked_at',collect_security.runtime_control_v2_utc(at_time),\n  'sample_valid_until',collect_security.runtime_control_v2_utc(at_time+interval '60 seconds'),'limit',p_limit,\n  'descriptor',jsonb_build_object('identity_fields',spec->'identity','writable_fields',spec->'writable','immutable_fields',coalesce(spec->'immutable_after_create','[]'),\n   'nullable_fields',(select coalesce(jsonb_agg(k),'[]') from jsonb_array_elements_text(spec->'nullable')k where (spec->'identity')?k or (spec->'writable')?k),'field_types',types,'create_allowed',(spec->>'create_allowed')::boolean,'can_manage',observed->'can_manage'),\n  'rows',rows,'next_cursor',cursor);\nend$function$\n", "oid": "23465", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_update_runtime_control_v2(p_request_id uuid, p_family text, p_identity jsonb, p_patch_json text, p_expected_revision bigint, p_reason text, p_expires_at timestamp with time zone)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid;reason_text text:=collect_admin_access.normalized_operator_reason(p_reason);reason_hash text;fingerprint text;\n prior collect_security.runtime_control_requests;patch jsonb;changed_receipt jsonb;receipt jsonb;at_time timestamptz;event_uuid uuid;begin\n perform collect_security.runtime_control_v2_spec(p_family);\n perform collect_security.runtime_control_v2_deadline(p_expires_at,true);\n sid:=collect_security.runtime_control_actor(p_family);\n perform collect_security.runtime_control_v2_deadline(p_expires_at);\n if p_request_id is null or p_expected_revision is null or p_expected_revision not between 0 and 1000000000\n  or p_patch_json is null or octet_length(p_patch_json) not between 2 and 65536\n  or char_length(reason_text) not between 8 and 500 or regexp_replace(reason_text,E'[\\n\\r\\t]','','g') ~ '[[:cntrl:]]' then\n  raise exception 'runtime_control_request_invalid' using errcode='22023';end if;\n perform collect_security.runtime_control_check_identity(p_family,p_identity);\n reason_hash:=encode(extensions.digest(convert_to(reason_text,'UTF8'),'sha256'),'hex');\n fingerprint:=collect_security.runtime_control_v2_fingerprint(p_request_id,p_family,p_identity,p_patch_json,p_expected_revision,reason_hash,p_expires_at);\n -- The actor marker distinguishes the original actor while its uncommitted\n -- request row is invisible. It never creates or extends mutation authority.\n perform pg_advisory_xact_lock(hashtextextended('collect-runtime-control-request-actor:'||p_request_id::text||':'||auth.uid()::text,0));\n perform pg_advisory_xact_lock(hashtextextended('collect-runtime-control-request:'||p_request_id::text,0));\n if sid is distinct from collect_security.runtime_control_actor(p_family) then raise exception 'runtime_control_session_required' using errcode='42501';end if;\n perform collect_security.runtime_control_v2_deadline(p_expires_at);\n select * into prior from collect_security.runtime_control_requests where request_id=p_request_id;\n if prior.request_id is not null then\n  if prior.actor_id is distinct from auth.uid() or prior.session_id is distinct from sid then raise exception 'runtime_control_request_owner_required' using errcode='42501';end if;\n  if prior.family is distinct from p_family or prior.identity is distinct from p_identity or prior.expected_revision is distinct from p_expected_revision\n   or prior.patch_json is distinct from p_patch_json or prior.reason_sha256 is distinct from reason_hash or prior.reason_characters is distinct from char_length(reason_text)\n   or prior.expires_at is distinct from p_expires_at or prior.request_fingerprint is distinct from fingerprint then raise exception 'runtime_control_request_conflict' using errcode='22023';end if;\n  return prior.receipt;\n end if;\n begin patch:=p_patch_json::jsonb;exception when invalid_text_representation then raise exception 'runtime_control_patch_invalid' using errcode='22023';end;\n changed_receipt:=public.admin_update_runtime_control_v1(p_family,p_identity,patch,p_expected_revision,reason_text);\n if sid is distinct from collect_security.runtime_control_actor(p_family) then raise exception 'runtime_control_session_required' using errcode='42501';end if;\n perform collect_security.runtime_control_v2_deadline(p_expires_at);\n if (changed_receipt->>'changed')::boolean then\n  select e.id into strict event_uuid from collect_security.runtime_control_events e where e.family=p_family\n   and e.identity_sha256=collect_security.runtime_control_hash(p_identity) and e.revision=(changed_receipt->>'revision')::bigint\n   and e.actor_id=auth.uid() and e.session_id=sid and e.authority='live_operator';\n end if;\n at_time:=clock_timestamp();\n receipt:=jsonb_build_object('contract_version',2,'scope','runtime_controls','request_id',p_request_id,'request_fingerprint',fingerprint,\n  'family',p_family,'identity',p_identity,'previous_revision',changed_receipt->'previous_revision','revision',changed_receipt->'revision','changed',changed_receipt->'changed',\n  'updated_at',collect_security.runtime_control_v2_utc((changed_receipt->>'updated_at')::timestamptz),'content_sha256',changed_receipt->'content_sha256',\n  'recorded_at',collect_security.runtime_control_v2_utc(at_time),'expires_at',collect_security.runtime_control_v2_utc(p_expires_at));\n insert into collect_security.runtime_control_requests values(p_request_id,auth.uid(),sid,p_family,p_identity,p_expected_revision,p_patch_json,reason_hash,char_length(reason_text),fingerprint,p_expires_at,at_time,receipt,event_uuid);\n perform collect_security.runtime_control_actor(p_family);\n perform collect_security.runtime_control_v2_deadline(p_expires_at);\n return receipt;\nend$function$\n", "oid": "23466", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_runtime_control_request_v2(p_request_id uuid, p_family text, p_identity jsonb, p_request_fingerprint text, p_expires_at timestamp with time zone)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare prior collect_security.runtime_control_requests;status text;receipt jsonb;at_time timestamptz;begin\n perform collect_security.runtime_control_v2_spec(p_family);\n perform collect_security.runtime_control_check_identity(p_family,p_identity);\n if p_request_id is null or p_request_fingerprint is null or p_request_fingerprint !~ '^[a-f0-9]{64}$' or p_expires_at is null or not isfinite(p_expires_at) then\n  raise exception 'runtime_control_request_invalid' using errcode='22023';end if;\n perform collect_security.runtime_control_v2_observe(p_family);\n if not pg_try_advisory_xact_lock(hashtextextended('collect-runtime-control-request:'||p_request_id::text,0)) then\n  select * into prior from collect_security.runtime_control_requests where request_id=p_request_id;\n  if prior.request_id is not null then\n   if prior.actor_id is distinct from auth.uid() then raise exception 'runtime_control_request_owner_required' using errcode='42501';end if;\n   if prior.family is distinct from p_family or prior.identity is distinct from p_identity or prior.request_fingerprint is distinct from p_request_fingerprint or prior.expires_at is distinct from p_expires_at then\n    raise exception 'runtime_control_request_conflict' using errcode='22023';end if;\n  elsif pg_try_advisory_xact_lock(hashtextextended('collect-runtime-control-request-actor:'||p_request_id::text||':'||auth.uid()::text,0)) then\n   raise exception 'runtime_control_request_owner_required' using errcode='42501';\n  end if;\n  status:='in_progress';\n else\n  select * into prior from collect_security.runtime_control_requests where request_id=p_request_id;\n  if prior.request_id is null then status:='not_recorded';\n  else\n   if prior.actor_id is distinct from auth.uid() then raise exception 'runtime_control_request_owner_required' using errcode='42501';end if;\n   if prior.family is distinct from p_family or prior.identity is distinct from p_identity or prior.request_fingerprint is distinct from p_request_fingerprint or prior.expires_at is distinct from p_expires_at then\n    raise exception 'runtime_control_request_conflict' using errcode='22023';end if;\n   status:='recorded';receipt:=prior.receipt;\n  end if;\n end if;\n perform collect_security.runtime_control_v2_observe(p_family);at_time:=clock_timestamp();\n return jsonb_build_object('contract_version',2,'scope','runtime_controls','request_id',p_request_id,'request_fingerprint',p_request_fingerprint,\n  'family',p_family,'identity',p_identity,'expires_at',collect_security.runtime_control_v2_utc(p_expires_at),'checked_at',collect_security.runtime_control_v2_utc(at_time),\n  'sample_valid_until',collect_security.runtime_control_v2_utc(at_time+interval '60 seconds'),'status',status,'receipt',receipt);\nend$function$\n", "oid": "23468", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_list_runtime_control_history_v2(p_family text, p_identity jsonb, p_limit integer DEFAULT 20, p_before_at timestamp with time zone DEFAULT NULL::timestamp with time zone, p_before_event_id uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare event record;rows jsonb:='[]';cursor jsonb;counted integer:=0;at_time timestamptz;begin\n perform collect_security.runtime_control_v2_spec(p_family);\n perform collect_security.runtime_control_check_identity(p_family,p_identity);\n perform collect_security.runtime_control_v2_observe(p_family,true);at_time:=clock_timestamp();\n if p_limit is null or p_limit not between 1 and 25 or (p_before_at is null)<>(p_before_event_id is null)\n  or p_before_at is not null and not isfinite(p_before_at) then raise exception 'runtime_control_query_invalid' using errcode='22023';end if;\n for event in select e.*,r.request_id from collect_security.runtime_control_events e left join collect_security.runtime_control_requests r on r.event_id=e.id\n  where e.family=p_family and e.identity_sha256=collect_security.runtime_control_hash(p_identity) and e.recorded_at<=at_time\n   and (p_before_at is null or (e.recorded_at,e.id)<(p_before_at,p_before_event_id)) order by e.recorded_at desc,e.id desc limit p_limit+1 loop\n  counted:=counted+1;if counted>p_limit then exit;end if;\n  rows:=rows||jsonb_build_array(jsonb_build_object('event_id',event.id,'request_id',event.request_id,'operation',event.operation,'previous_revision',event.previous_revision,\n   'revision',event.revision,'recorded_at',collect_security.runtime_control_v2_utc(event.recorded_at),'actor_id',event.actor_id,'authority',event.authority,\n   'changed_fields',event.changed_fields,'old_sha256',event.old_sha256,'new_sha256',event.new_sha256,'reason_sha256',event.reason_sha256,\n   'reason_characters',event.reason_characters,'redacted',event.redacted));\n  cursor:=jsonb_build_object('recorded_at',collect_security.runtime_control_v2_utc(event.recorded_at),'event_id',event.id);\n end loop;\n if counted<=p_limit then cursor:=null;end if;\n perform collect_security.runtime_control_v2_observe(p_family,true);\n return jsonb_build_object('contract_version',2,'scope','runtime_controls','family',p_family,'identity',p_identity,'checked_at',collect_security.runtime_control_v2_utc(at_time),\n  'sample_valid_until',collect_security.runtime_control_v2_utc(at_time+interval '60 seconds'),'limit',p_limit,'history_complete',false,'changes_only',true,'rows',rows,'next_cursor',cursor);\nend$function$\n", "oid": "23469", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.require_assisted_sms_actor_v2(p_actor uuid, p_session uuid, p_permission text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n -- EXECUTE is service-only; also require the actual calling role and its JWT\n -- identity. SECURITY DEFINER changes current_user, not the caller's role GUC.\n if current_setting('role',true) is distinct from 'service_role'\n  or auth.jwt()->>'role' is distinct from 'service_role'\n  or p_permission not in ('notifications.read','notifications.manage')\n  or p_permission is null then\n  raise exception 'assisted_sms_service_required' using errcode='42501';\n end if;\n -- A pre-established snapshot must never retain revoked session/role evidence.\n if current_setting('transaction_isolation')<>'read committed' then\n  raise exception 'assisted_sms_snapshot_retry' using errcode='40001';\n end if;\n -- Same authority and lock order as roster/reconciliation: shared Auth gate,\n -- combined-roster gate, policy, Auth user/session, approval, role/permissions.\n -- Locks last through the legacy operation and the transaction's commit.\n perform collect_hybrid.require_roster_actor_authority(\n  p_actor,p_session,'platform_owner',array[p_permission]);\nend $function$\n", "oid": "23473", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.immutable_assisted_sms_session_evidence_v2()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$begin\n raise exception 'assisted_sms_session_evidence_immutable'using errcode='55000';end$function$\n", "oid": "23486", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.require_assisted_sms_capability_v2(p_actor uuid, p_session uuid, p_kind text, p_capability uuid, p_outbox uuid DEFAULT NULL::uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare evidence collect_security.assisted_sms_session_evidence;\nbegin\n select item.* into evidence from collect_security.assisted_sms_session_evidence item\n where item.capability_kind=p_kind and item.capability_id=p_capability;\n if evidence.capability_id is null or evidence.operator_user_id is distinct from p_actor\n  or evidence.originating_session_id is distinct from p_session\n  or(p_outbox is not null and evidence.outbox_id is distinct from p_outbox)then\n  raise exception 'assisted_sms_originating_capability_required'using errcode='42501';\n end if;\nend$function$\n", "oid": "23489", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.record_assisted_sms_capability_v2(p_actor uuid, p_session uuid, p_kind text, p_capability uuid, p_outbox uuid, p_claim uuid, p_fence integer, p_body text DEFAULT NULL::text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare evidence collect_security.assisted_sms_session_evidence;\nbegin\n insert into collect_security.assisted_sms_session_evidence(\n  capability_kind,capability_id,operator_user_id,originating_session_id,outbox_id,claim_token,fence_version,body_sha256)\n values(p_kind,p_capability,p_actor,p_session,p_outbox,p_claim,p_fence,p_body)\n on conflict(capability_kind,capability_id)do nothing;\n perform collect_security.require_assisted_sms_capability_v2(p_actor,p_session,p_kind,p_capability,p_outbox);\n select item.* into evidence from collect_security.assisted_sms_session_evidence item\n where item.capability_kind=p_kind and item.capability_id=p_capability;\n if evidence.claim_token is distinct from p_claim or evidence.fence_version is distinct from p_fence\n  or evidence.body_sha256 is distinct from p_body then\n  raise exception 'assisted_sms_session_evidence_conflict'using errcode='42501';\n end if;\nend$function$\n", "oid": "23490", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.collect_notification_health_v2(p_operator_user_id uuid, p_operator_session_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare result jsonb;\nbegin\n perform collect_security.require_assisted_sms_actor_v2(\n  p_operator_user_id,p_operator_session_id,'notifications.read');\n result:=public.collect_notification_health(p_operator_user_id);\n -- The legacy operation/audit can wait on its own rows. Recheck live\n -- expiry after those waits; r