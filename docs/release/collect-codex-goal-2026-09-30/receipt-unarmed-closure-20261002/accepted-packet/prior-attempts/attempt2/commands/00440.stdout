"recorded_by\":\"uuid\",\"revision\":\"integer\"},\"writable\":[\"enabled\",\"capture_method\"]},\"sms_receipt_policies\":{\"additional_permission\":\"collections.moderate\",\"create_allowed\":true,\"identity\":[\"collection_id\"],\"immutable_after_create\":[],\"nullable\":[],\"permission\":\"notifications.manage\",\"read_permission\":\"notifications.read\",\"relation\":\"collect_hybrid.sms_receipt_policies\",\"types\":{\"collection_id\":\"uuid\",\"enabled\":\"boolean\",\"reason\":\"text\",\"revision\":\"integer\",\"template_key\":\"text\",\"template_version\":\"integer\",\"updated_at\":\"timestamp with time zone\",\"updated_by\":\"uuid\",\"receipt_language\":\"text\"},\"writable\":[\"enabled\",\"receipt_language\"]},\"support_channels\":{\"create_allowed\":true,\"identity\":[\"key\"],\"immutable_after_create\":[],\"nullable\":[\"display_value\",\"updated_by\",\"updated_reason\"],\"permission\":\"settings.manage\",\"read_permission\":\"settings.read\",\"relation\":\"public.support_channels\",\"types\":{\"channel_type\":\"text\",\"created_at\":\"timestamp with time zone\",\"display_value\":\"text\",\"is_active\":\"boolean\",\"key\":\"text\",\"label\":\"text\",\"metadata\":\"jsonb\",\"sort_order\":\"integer\",\"updated_at\":\"timestamp with time zone\",\"updated_by\":\"uuid\",\"updated_reason\":\"text\",\"value\":\"text\"},\"writable\":[\"channel_type\",\"label\",\"value\",\"display_value\",\"sort_order\",\"metadata\",\"is_active\"]},\"system_settings\":{\"create_allowed\":true,\"identity\":[\"key\"],\"immutable_after_create\":[],\"nullable\":[\"updated_by\",\"updated_reason\"],\"permission\":\"settings.manage\",\"read_permission\":\"settings.read\",\"relation\":\"public.system_settings\",\"types\":{\"created_at\":\"timestamp with time zone\",\"description\":\"text\",\"is_sensitive\":\"boolean\",\"key\":\"text\",\"updated_at\":\"timestamp with time zone\",\"updated_by\":\"uuid\",\"updated_reason\":\"text\",\"value\":\"jsonb\"},\"writable\":[\"value\",\"description\"]}}'::jsonb -> p_family;\n$function$\n", "oid": "21591", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_hash(p_row jsonb)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select encode(extensions.digest(convert_to((p_row-array['updated_at','updated_by','updated_reason','recorded_at','recorded_by','reason'])::text,'UTF8'),'sha256'),'hex');\n$function$\n", "oid": "21593", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_identity(p_family text, p_row jsonb)\n RETURNS jsonb\n LANGUAGE sql\n IMMUTABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select jsonb_object_agg(k,p_row->k) from jsonb_array_elements_text(collect_security.runtime_control_spec(p_family)->'identity') k;\n$function$\n", "oid": "21594", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_bound_json(p_value jsonb, p_depth integer DEFAULT 0)\n RETURNS void\n LANGUAGE plpgsql\n IMMUTABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare item record; text_value text;\nbegin\n if p_value is null or p_depth>5 or octet_length(p_value::text)>65536 then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n if jsonb_typeof(p_value)='object' then\n  if (select count(*) from jsonb_object_keys(p_value))>50 then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n  for item in select * from jsonb_each(p_value) loop\n   if char_length(item.key) not between 1 and 80 or item.key !~ '^[A-Za-z_][A-Za-z0-9_.:-]*$'\n      or item.key ~* '(secret|password|credential|api[_-]?key|authorization|access[_-]?token|refresh[_-]?token|private[_-]?key)' then\n    raise exception 'runtime_control_sensitive_field' using errcode='22023';end if;\n   perform collect_security.runtime_control_bound_json(item.value,p_depth+1);\n  end loop;\n elsif jsonb_typeof(p_value)='array' then\n  if jsonb_array_length(p_value)>50 then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n  for item in select value from jsonb_array_elements(p_value) loop perform collect_security.runtime_control_bound_json(item.value,p_depth+1);end loop;\n elsif jsonb_typeof(p_value)='string' then\n  text_value:=p_value#>>'{}';\n  if char_length(text_value)>32768 or regexp_replace(text_value,E'[\\n\\r\\t]','','g') ~ '[[:cntrl:]]' then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n elsif jsonb_typeof(p_value)='number' then\n  if (p_value#>>'{}')::numeric not between -100000000000 and 100000000000 then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n end if;\nend $function$\n", "oid": "21595", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_https(p_value text)\n RETURNS boolean\n LANGUAGE sql\n IMMUTABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select p_value is not null and char_length(p_value) between 10 and 2048\n  and p_value ~ '^https://[A-Za-z0-9][A-Za-z0-9.-]*\\.[A-Za-z]{2,63}(:443)?([/?][^[:space:]@]*)?$'\n  and p_value !~ '[[:cntrl:]]' and p_value !~ '^https://[0-9.]+';\n$function$\n", "oid": "21596", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_check_values(p_family text, p_values jsonb)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare spec jsonb:=collect_security.runtime_control_spec(p_family); field record; typ text; value_type text; clean text; limit_chars integer; numeric_value numeric;\nbegin\n if spec is null or p_values is null or jsonb_typeof(p_values)<>'object' or octet_length(p_values::text)>65536 then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n for field in select * from jsonb_each(p_values) loop\n  typ:=spec->'types'->>field.key;value_type:=jsonb_typeof(field.value);clean:=field.value#>>'{}';\n  if typ is null then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n  if value_type='null' then\n   if not (spec->'nullable') ? field.key then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n   continue;\n  end if;\n  if typ='boolean' and value_type<>'boolean' or typ in ('integer','bigint') and (value_type<>'number' or clean !~ '^-?[0-9]+$')\n    or typ in ('text','uuid','timestamp with time zone') and value_type<>'string' then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n  if typ in ('integer','bigint') then\n   numeric_value:=clean::numeric;\n   if typ='integer' and numeric_value not between -2147483648 and 2147483647 or typ='bigint' and numeric_value not between -100000000000 and 100000000000 then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n  end if;\n  if typ='jsonb' then perform collect_security.runtime_control_bound_json(field.value);end if;\n  if typ='uuid' and clean !~ '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n  if typ='timestamp with time zone' then\n   if char_length(clean) not between 20 and 35 or clean !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$' then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n   begin\n    if not isfinite(clean::timestamptz) or clean::timestamptz>clock_timestamp()+interval '2 years' or clean::timestamptz<'2000-01-01'::timestamptz then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n   exception when invalid_datetime_format or datetime_field_overflow then raise exception 'runtime_control_invalid' using errcode='22023';end;\n  end if;\n  if p_family='sms_receipt_policies'and field.key='receipt_language'and clean not in('rw','en','fr')then\n   raise exception 'receipt_language_invalid'using errcode='22023';end if;\n  if typ='text' then\n   limit_chars:=case when field.key in ('body','body_template','instructions','regulatory_footer_note') then 24000 when field.key in ('description','subtitle','summary','short_purpose','target','owner','escalation') then 2000 when field.key like '%url' then 2048 else 500 end;\n   if char_length(clean)>limit_chars or regexp_replace(clean,E'[\\n\\r\\t]','','g') ~ '[[:cntrl:]]' then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n   if field.key in ('key','queue_key','rpc_name','section_key','icon_key','version','locale','network','currency','country_code','required_permission','template_key','event_type_key','preference_key','collection_type_key','default_category_subtype','default_purpose_template_key')\n    and (char_length(clean) not between 1 and 128 or clean !~ '^[A-Za-z0-9_.:-]+$') then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n   if field.key in ('label','display_name','legal_name','title','title_template','body_template','body','target','owner','escalation') and char_length(btrim(clean))=0 then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n   if field.key like '%url' and not collect_security.runtime_control_https(clean) then raise exception 'runtime_control_invalid_url' using errcode='22023';end if;\n   if field.key in ('title_template','body_template') and regexp_replace(clean,'\\{\\{[a-z][a-z0-9_]{0,63}\\}\\}','','g') ~ '(\\{\\{|\\}\\})' then raise exception 'runtime_control_invalid_template' using errcode='22023';end if;\n  end if;\n  if field.key in ('display_order','sort_order') and numeric_value not between 0 and 10000 then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n end loop;\nend $function$\n", "oid": "21597", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_check_identity(p_family text, p_identity jsonb)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare spec jsonb:=collect_security.runtime_control_spec(p_family); field record; typ text; clean text;\nbegin\n if spec is null or p_identity is null or jsonb_typeof(p_identity)<>'object' or octet_length(p_identity::text)>2048 then raise exception 'runtime_control_identity_invalid' using errcode='22023';end if;\n if (select array_agg(key order by key) from jsonb_object_keys(p_identity) key) is distinct from (select array_agg(key order by key) from jsonb_array_elements_text(spec->'identity') key) then raise exception 'runtime_control_identity_invalid' using errcode='22023';end if;\n if coalesce((spec->>'user_owned')::boolean,false) and p_identity->>'user_id' is distinct from auth.uid()::text then raise exception 'runtime_control_owner_required' using errcode='42501';end if;\n for field in select * from jsonb_each(p_identity) loop\n  typ:=spec->'types'->>field.key;clean:=field.value#>>'{}';\n  if field.value='null'::jsonb\n   or typ='uuid' and (jsonb_typeof(field.value)<>'string' or clean !~ '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$')\n   or typ='boolean' and field.value is distinct from 'true'::jsonb\n   or typ='text' and (jsonb_typeof(field.value)<>'string' or char_length(clean) not between 1 and 128 or clean !~ '^[A-Za-z0-9_.:-]+$') then raise exception 'runtime_control_identity_invalid' using errcode='22023';end if;\n end loop;\nend $function$\n", "oid": "21598", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_lock_parent(p_family text, p_new jsonb, p_old jsonb, p_delete boolean DEFAULT false)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare parent_id uuid; template_key_text text; parent public.policy_documents;\nbegin\n if p_family='policy_documents' then\n  perform 1 from public.policy_documents where id=(p_new->>'id')::uuid for update;\n elsif p_family='policy_document_sections' then\n  if p_old is not null and p_old->>'policy_document_id' is distinct from p_new->>'policy_document_id' then raise exception 'runtime_control_wiring_immutable' using errcode='55000';end if;\n  parent_id:=(p_new->>'policy_document_id')::uuid;\n  -- Physical parent fencing also prevents stale repeatable-read publication\n  -- after a committed section edit. Governance no-op keeps its version intact.\n  update public.policy_documents set status=status where id=parent_id returning * into parent;\n  if parent.id is null and p_delete and pg_trigger_depth()>1 then return;end if;\n  if parent.id is null or parent.status<>'draft' or parent.published_at is not null then raise exception 'runtime_control_published_immutable' using errcode='55000';end if;\n elsif p_family='notification_template_versions' then\n  template_key_text:=p_new->>'template_key';\n  update public.notification_templates set enabled=enabled where key=template_key_text;\n  if not found and p_delete and pg_trigger_depth()>1 then return;end if;\n  if not found then raise exception 'runtime_control_template_required' using errcode='22023';end if;\n end if;\nend $function$\n", "oid": "21599", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_validate(p_family text, p_new jsonb, p_old jsonb DEFAULT NULL::jsonb)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare spec jsonb:=collect_security.runtime_control_spec(p_family); field record; typ text; value_type text; clean text; limit_chars integer;\n parent public.policy_documents; amount_text text;\nbegin\n if spec is null or p_new is null or jsonb_typeof(p_new)<>'object' then raise exception 'runtime_control_invalid' using errcode='22023';end if;\n perform collect_security.runtime_control_check_values(p_family,case when p_old is null then p_new else\n  coalesce((select jsonb_object_agg(key,value) from jsonb_each(p_new) where p_old->key is distinct from value),'{}'::jsonb) end);\n if p_old is not null and exists(select 1 from jsonb_array_elements_text(spec->'immutable_after_create') k where p_new->k is distinct from p_old->k) then\n  raise exception 'runtime_control_wiring_immutable' using errcode='55000';end if;\n if p_family='support_channels' then\n  if p_new->>'channel_type' in ('phone','whatsapp') and (char_length(p_new->>'value') not between 8 and 16 or p_new->>'value' !~ '^\\+?[1-9][0-9]+$')\n   or p_new->>'channel_type'='email' and (char_length(p_new->>'value')>254 or p_new->>'value' !~ '^[A-Za-z0-9.!#$%&''*+/=?^_`{|}~-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,63}$')\n   or p_new->>'channel_type'='url' and not collect_security.runtime_control_https(p_new->>'value') then raise exception 'runtime_control_invalid_support' using errcode='22023';end if;\n end if;\n if p_family='payment_entrypoints' and (p_new->>'is_active')::boolean then\n  if p_new->>'country_code' is distinct from 'RW' or p_new->>'currency' is distinct from 'RWF' or p_new->>'network' is distinct from 'mtn_momo'\n    or p_new->>'code' is null or p_new->>'code' !~ '^\\*182\\*8\\*1\\*41258\\*[1-9][0-9]{0,8}#$' then raise exception 'runtime_control_rwanda_route_required' using errcode='22023';end if;\n  amount_text:=split_part(p_new->>'code','*',6);amount_text:=replace(amount_text,'#','');\n  if p_new->'metadata'->>'amount_rwf' is distinct from amount_text then raise exception 'runtime_control_payment_amount_mismatch' using errcode='22023';end if;\n end if;\n if p_family='collection_type_country_rules' and (p_new->>'enabled')::boolean and p_new->>'country_code' is distinct from 'RW' then raise exception 'runtime_control_rwanda_route_required' using errcode='22023';end if;\n if p_family='feature_flags' and (p_new->>'enabled')::boolean and p_new->>'key' ~* '(bank_transfer|stripe|diaspora|international|foreign)' then raise exception 'runtime_control_rwanda_route_required' using errcode='22023';end if;\n if p_family='system_settings' then\n  if p_new->>'key' ~* '(secret|password|credential|api[_-]?key|token|private[_-]?key)' then raise exception 'runtime_control_sensitive_field' using errcode='22023';end if;\n  if p_new->>'key'='payments.mode' and p_new->'value' is distinct from '{\"rwanda\":{\"provider\":\"momo_ussd_sms\",\"currency\":\"RWF\"}}'::jsonb then raise exception 'runtime_control_rwanda_route_required' using errcode='22023';end if;\n  if p_new->>'key'='sms.parser.schema_version' and p_new->'value' is distinct from '\"collect.sms_parser.v1\"'::jsonb then raise exception 'runtime_control_unsupported_parser' using errcode='22023';end if;\n end if;\n if p_old is not null and p_family in ('policy_documents','notification_template_versions') and (p_old->>'status'<>'draft' or p_old->>'published_at' is not null) then\n  if (p_new-array['status','updated_at','updated_by','updated_reason']) is distinct from (p_old-array['status','updated_at','updated_by','updated_reason'])\n    or p_new->>'status' not in ('published','archived') or (p_old->>'status'='archived' and p_new->>'status'<>'archived') then raise exception 'runtime_control_published_immutable' using errcode='55000';end if;\n end if;\n if p_family='policy_document_sections' then\n  select * into parent from public.policy_documents where id=(p_new->>'policy_document_id')::uuid;\n  if parent.id is null or parent.status<>'draft' or parent.published_at is not null then raise exception 'runtime_control_published_immutable' using errcode='55000';end if;\n end if;\n if p_family='notification_templates' and p_old is not null and exists(select 1 from public.notification_template_versions where template_key=p_old->>'key' and (status<>'draft' or published_at is not null))\n  and (p_new-array['enabled','updated_at','updated_by','updated_reason']) is distinct from (p_old-array['enabled','updated_at','updated_by','updated_reason']) then\n  raise exception 'runtime_control_published_immutable' using errcode='55000';end if;\n if p_family='policy_documents' and p_new->>'status'='published' and (p_old is null or p_old->>'status'='draft') then\n  if not exists(select 1 from public.policy_document_sections where policy_document_id=(p_new->>'id')::uuid) then raise exception 'runtime_control_policy_sections_required' using errcode='22023';end if;\n end if;\n if p_family='sms_receipt_policies' and not exists(select 1 from public.collections c where c.id=(p_new->>'collection_id')::uuid and c.collection_type='ikimina' and c.archived_at is null) then raise exception 'runtime_control_collection_required' using errcode='22023';end if;\n if p_family='sms_receipt_member_consents' and not exists(select 1 from collect_hybrid.member_records m join collect_hybrid.member_momo_identities i on i.member_id=m.id where m.id=(p_new->>'member_record_id')::uuid and m.lifecycle='active' and m.linked_user_id is null) then raise exception 'runtime_control_member_required' using errcode='22023';end if;\n if p_family='roster_resource_policy' and ((p_new->>'actor_active')::integer>(p_new->>'global_active')::integer\n   or (p_new->>'actor_daily_requests')::integer>(p_new->>'global_daily_requests')::integer\n   or (p_new->>'actor_daily_bytes')::bigint>(p_new->>'global_daily_bytes')::bigint\n   or (p_new->>'actor_daily_cost_units')::bigint>(p_new->>'global_daily_cost_units')::bigint\n   or (p_new->>'ai_attempt_cost_units')::bigint>(p_new->>'actor_daily_cost_units')::bigint) then raise exception 'runtime_control_quota_order_invalid' using errcode='22023';end if;\n if p_family='otp_policy' and (p_new->>'global_hourly_limit')::integer>(p_new->>'global_daily_limit')::integer then raise exception 'runtime_control_quota_order_invalid' using errcode='22023';end if;\nend $function$\n", "oid": "21600", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.runtime_control_actor(p_family text, p_read boolean DEFAULT false)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare spec jsonb:=collect_security.runtime_control_spec(p_family);\n session_id uuid; permissions text[];\nbegin\n if spec is null then raise exception 'runtime_control_family_invalid' using errcode='22023';end if;\n begin session_id:=public._lock_notification_registration_session();\n exception when sqlstate '42501' then\n  raise exception 'runtime_control_session_required' using errcode='42501';end;\n if coalesce((spec->>'user_owned')::boolean,false) then return session_id;end if;\n permissions:=array[case when p_read then spec->>'read_permission' else spec->>'permission' end];\n if not p_read and spec ? 'additional_permission' then\n  permissions:=array_append(permissions,spec->>'additional_permission');end if;\n begin\n  perform collect_hybrid.require_roster_actor_authority(auth.uid(),session_id,'platform_owner',permissions);\n exception when sqlstate '42501' then\n  raise exception 'runtime_control_permission_required' using errcode='42501';end;\n return session_id;\nend $function$\n", "oid": "21602", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.guard_runtime_control_event()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin raise exception 'runtime_control_history_immutable' using errcode='55000';end $function$\n", "oid": "21603", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.govern_runtime_control()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare control_family text:=tg_table_name; spec jsonb:=collect_security.runtime_control_spec(control_family); prior jsonb; next_row jsonb; identity_row jsonb;\n head collect_security.runtime_control_heads; context jsonb; owner_maintenance boolean;\n actor uuid; sid uuid; audit_redacted boolean; reason_hash text; reason_length integer; changed text[]; content_hash text; target_revision bigint;\nbegin\n if spec is null or spec->>'relation'<>(tg_table_schema||'.'||tg_table_name) then raise exception 'runtime_control_family_invalid' using errcode='55000';end if;\n prior:=case when tg_op='INSERT' then null else to_jsonb(old) end;\n next_row:=case when tg_op='DELETE' then null else to_jsonb(new) end;\n owner_maintenance:=session_user='postgres' and current_setting('role') in ('none','postgres');\n if control_family='notification_preferences' and not owner_maintenance and coalesce(next_row,prior)->>'user_id' is distinct from auth.uid()::text then raise exception 'runtime_control_owner_required' using errcode='42501';end if;\n -- Crucial: preserve the145/146 physical same-value UPDATE serialization\n -- fence. Returning NEW still writes the row; governance state remains untouched.\n if tg_op='UPDATE' and collect_security.runtime_control_hash(prior)=collect_security.runtime_control_hash(next_row) then return new;end if;\n identity_row:=collect_security.runtime_control_identity(control_family,coalesce(next_row,prior));\n if tg_op='UPDATE' and identity_row is distinct from collect_security.runtime_control_identity(control_family,prior) then raise exception 'runtime_control_identity_immutable' using errcode='55000';end if;\n if tg_op='DELETE' and (control_family in ('policy_documents','notification_template_versions') and (prior->>'status'<>'draft' or prior->>'published_at' is not null)\n    or control_family='notification_templates' and exists(select 1 from public.notification_template_versions where template_key=prior->>'key' and (status<>'draft' or published_at is not null))\n    or control_family='policy_document_sections' and exists(select 1 from public.policy_documents where id=(prior->>'policy_document_id')::uuid and (status<>'draft' or published_at is not null))) then raise exception 'runtime_control_published_immutable' using errcode='55000';end if;\n perform collect_security.runtime_control_lock_parent(control_family,coalesce(next_row,prior),prior,tg_op='DELETE');\n if owner_maintenance then\n  actor:=null;sid:=null;reason_hash:=encode(extensions.digest(convert_to('database_owner_maintenance','UTF8'),'sha256'),'hex');reason_length:=26;\n else\n  begin context:=current_setting('collect.runtime_control_context',true)::jsonb;exception when others then context:=null;end;\n  if context is null or jsonb_typeof(context) is distinct from 'object' or octet_length(context::text)>4096 then raise exception 'runtime_control_revision_required' using errcode='42501';end if;\n  if (select array_agg(key order by key) from jsonb_object_keys(context) key) is distinct from\n   array['actor_id','expected_revision','family','identity','reason_characters','reason_sha256','session_id']::text[]\n   or jsonb_typeof(context->'family') is distinct from 'string' or context->>'family' is distinct from control_family\n   or jsonb_typeof(context->'identity') is distinct from 'object' or context->'identity' is distinct from identity_row\n   or jsonb_typeof(context->'actor_id') is distinct from 'string' or context->>'actor_id' is distinct from auth.uid()::text\n   or jsonb_typeof(context->'session_id') is distinct from 'string' or context->>'session_id' is distinct from auth.jwt()->>'session_id'\n   or jsonb_typeof(context->'expected_revision') is distinct from 'number' or char_length(context->>'expected_revision') not between 1 and 10\n   or context->>'expected_revision' !~ '^(0|[1-9][0-9]*)$'\n   or jsonb_typeof(context->'reason_characters') is distinct from 'number' or char_length(context->>'reason_characters') not between 1 and 3\n   or context->>'reason_characters' !~ '^[1-9][0-9]*$'\n   or jsonb_typeof(context->'reason_sha256') is distinct from 'string' or context->>'reason_sha256' !~ '^[a-f0-9]{64}$' then\n   raise exception 'runtime_control_revision_required' using errcode='42501';end if;\n  if (context->>'expected_revision')::bigint not between 0 and 1000000000 or (context->>'reason_characters')::integer not between 8 and 500 then\n   raise exception 'runtime_control_revision_required' using errcode='42501';end if;\n  actor:=auth.uid();sid:=collect_security.runtime_control_actor(control_family);\n  reason_hash:=context->>'reason_sha256';reason_length:=(context->>'reason_characters')::integer;\n end if;\n select * into head from collect_security.runtime_control_heads where runtime_control_heads.family=control_family and identity=identity_row for update;\n if not owner_maintenance and coalesce(head.revision,0) is distinct from (context->>'expected_revision')::bigint then raise exception 'runtime_control_conflict' using errcode='40001';end if;\n if head.family is not null and prior is not null and head.content_sha256 is distinct from collect_security.runtime_control_hash(prior) then raise exception 'runtime_control_head_invalid' using errcode='55000';end if;\n if tg_op<>'DELETE' then\n  if control_family in ('policy_documents','notification_template_versions') and next_row->>'status'='published' and (prior is null or prior->>'status'='draft') then next_row:=next_row||jsonb_build_object('published_at',clock_timestamp());end if;\n  if control_family in ('sms_receipt_policies','sms_receipt_member_consents') then\n   next_row:=next_row||jsonb_build_object('reason','runtime_control:'||reason_hash,'revision',coalesce((prior->>'revision')::integer,0)+1);\n   if control_family='sms_receipt_policies' then next_row:=next_row||jsonb_build_object('updated_by',actor);else next_row:=next_row||jsonb_build_object('recorded_by',actor,'recorded_at',clock_timestamp());end if;\n   -- Database-owner fixtures must explicitly carry the accountable profile.\n   if actor is null then next_row:=next_row||jsonb_build_object(case when control_family='sms_receipt_policies' then 'updated_by' else 'recorded_by' end,coalesce(to_jsonb(new)->case when control_family='sms_receipt_policies' then 'updated_by' else 'recorded_by' end,prior->case when control_family='sms_receipt_policies' then 'updated_by' else 'recorded_by' end));end if;\n  end if;\n  perform collect_security.runtime_control_validate(control_family,next_row,prior);\n  if next_row ? 'updated_at' then next_row:=next_row||jsonb_build_object('updated_at',clock_timestamp());end if;\n  if next_row ? 'updated_by' and not (control_family='sms_receipt_policies' and actor is null) then next_row:=next_row||jsonb_build_object('updated_by',actor);end if;\n  if next_row ? 'updated_reason' then next_row:=next_row||jsonb_build_object('updated_reason','runtime_control:'||reason_hash);end if;\n  if control_family='roster_resource_policy' and prior is not null then next_row:=next_row||jsonb_build_object('version',(prior->>'version')::integer+1);end if;\n  new:=jsonb_populate_record(new,next_row);\n end if;\n select coalesce(array_agg(key order by key),'{}') into changed from jsonb_each(coalesce(next_row,prior)) field\n where field.key not in ('created_at','updated_at','updated_by','updated_reason','recorded_by','recorded_at','reason') and (tg_op<>'UPDATE' or prior->field.key is distinct from field.value);\n target_revision:=coalesce(head.revision,0)+1;\n content_hash:=case when tg_op='DELETE' then collect_security.runtime_control_hash(jsonb_build_object('deleted',true)) else collect_security.runtime_control_hash(next_row) end;\n insert into collect_security.runtime_control_heads(family,identity,revision,content_sha256,updated_at) values(control_family,identity_row,target_revision,content_hash,clock_timestamp())\n on conflict on constraint runtime_control_heads_pkey do update set revision=excluded.revision,content_sha256=excluded.content_sha256,updated_at=excluded.updated_at;\n audit_redacted:=control_family='notification_preferences' or control_family='system_settings' and coalesce((coalesce(next_row,prior)->>'is_sensitive')::boolean,false);\n insert into collect_security.runtime_control_events(family,identity_sha256,previous_revision,revision,operation,old_sha256,new_sha256,changed_fields,actor_id,session_id,authority,reason_sha256,redacted,reason_characters)\n values(control_family,collect_security.runtime_control_hash(identity_row),target_revision-1,target_revision,lower(tg_op),case when prior is null or audit_redacted then null else collect_security.runtime_control_hash(prior) end,\n case when next_row is null or audit_redacted then null else content_hash end,changed,actor,sid,case when owner_maintenance then 'database_owner' else 'live_operator' end,reason_hash,audit_redacted,reason_length);\n if tg_op='DELETE' then return old;end if;return new;\nend $function$\n", "oid": "21605", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_runtime_control_v1(p_family text, p_identity jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare spec jsonb:=collect_security.runtime_control_spec(p_family); value_row jsonb; head collect_security.runtime_control_heads; sid uuid; redacted boolean:=false;\nbegin\n sid:=collect_security.runtime_control_actor(p_family,true);\n perform collect_security.runtime_control_check_identity(p_family,p_identity);\n if coalesce((spec->>'user_owned')::boolean,false) and p_identity->>'user_id' is distinct from auth.uid()::text then raise exception 'runtime_control_owner_required' using errcode='42501';end if;\n execute format('select to_jsonb(t) from %s t where to_jsonb(t) @> $1',spec->>'relation') into value_row using p_identity;\n select * into head from collect_security.runtime_control_heads h where h.family=p_family and h.identity=p_identity;\n if value_row is not null and (head.family is null or head.content_sha256 is distinct from collect_security.runtime_control_hash(value_row)) then raise exception 'runtime_control_head_invalid' using errcode='55000';end if;\n if value_row is not null then\n  redacted:=p_family='system_settings' and coalesce((value_row->>'is_sensitive')::boolean,false);\n  value_row:=value_row-array['updated_by','updated_reason','reason','recorded_by'];\n  if redacted then value_row:=value_row-'value';end if;\n end if;\n return jsonb_build_object('contract_version',1,'ok',true,'family',p_family,'identity',p_identity,'revision',coalesce(head.revision,0),'exists',value_row is not null,\n  'value',value_row,'redacted',redacted,'content_sha256',case when redacted then null else head.content_sha256 end);\nend $function$\n", "oid": "21633", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_update_runtime_control_v1(p_family text, p_identity jsonb, p_patch jsonb, p_expected_revision bigint, p_reason text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare spec jsonb:=collect_security.runtime_control_spec(p_family); sid uuid; old_row jsonb; desired jsonb; head collect_security.runtime_control_heads;\n reason_text text:=collect_admin_access.normalized_operator_reason(p_reason); columns_sql text; values_sql text; assignments_sql text; result_row jsonb; context jsonb; prior_context text; changed boolean;\n parent_id uuid; identifier record;\nbegin\n sid:=collect_security.runtime_control_actor(p_family);\n if p_expected_revision is null or p_expected_revision not between 0 and 1000000000 or char_length(reason_text) not between 8 and 500\n  or regexp_replace(reason_text,E'[\\n\\r\\t]','','g') ~ '[[:cntrl:]]' then raise exception 'runtime_control_revision_reason_required' using errcode='22023';end if;\n perform collect_security.runtime_control_check_identity(p_family,p_identity);\n if coalesce((spec->>'user_owned')::boolean,false) and p_identity->>'user_id' is distinct from auth.uid()::text then raise exception 'runtime_control_owner_required' using errcode='42501';end if;\n if p_patch is null or jsonb_typeof(p_patch)<>'object' or octet_length(p_patch::text)>65536 or p_patch='{}'::jsonb\n  or exists(select 1 from jsonb_object_keys(p_patch) field where not (spec->'writable') ? field) then raise exception 'runtime_control_patch_invalid' using errcode='22023';end if;\n perform collect_security.runtime_control_check_values(p_family,p_patch);\n -- Parent publication locks precede child/head locks, preventing a late section\n -- edit from racing publication. Wiring identifiers stay immutable after create.\n execute format('select to_jsonb(t) from %s t where to_jsonb(t) @> $1',spec->>'relation') into old_row using p_identity;\n if old_row is not null and exists(select 1 from jsonb_array_elements_text(spec->'immutable_after_create') k where p_patch ? k and old_row->k is distinct from p_patch->k) then\n  raise exception 'runtime_control_wiring_immutable' using errcode='55000';end if;\n if old_row is null and not (spec->>'create_allowed')::boolean then raise exception 'runtime_control_create_owner_only' using errcode='42501';end if;\n perform collect_security.runtime_control_lock_parent(p_family,coalesce(old_row,p_identity)||p_patch,old_row);\n select * into head from collect_security.runtime_control_heads h where h.family=p_family and h.identity=p_identity for update;\n if coalesce(head.revision,0) is distinct from p_expected_revision then raise exception 'runtime_control_conflict' using errcode='40001';end if;\n execute format('select to_jsonb(t) from %s t where to_jsonb(t) @> $1 for update',spec->>'relation') into old_row using p_identity;\n if old_row is not null and head.content_sha256 is distinct from collect_security.runtime_control_hash(old_row) then raise exception 'runtime_control_head_invalid' using errcode='55000';end if;\n -- Recheck effective authority after every possible row wait, under the shared\n -- Auth/roster gates also used by revocation; stale JWT fields confer no rights.\n perform collect_security.runtime_control_actor(p_family);\n if p_family='system_settings' and coalesce((old_row->>'is_sensitive')::boolean,false) then raise exception 'runtime_control_sensitive_setting_owner_only' using errcode='42501';end if;\n desired:=coalesce(old_row,p_identity)||p_patch;\n perform collect_security.runtime_control_validate(p_family,desired,old_row);\n changed:=old_row is null or collect_security.runtime_control_hash(desired) is distinct from collect_security.runtime_control_hash(old_row);\n if not changed then return jsonb_build_object('contract_version',1,'ok',true,'family',p_family,'identity',p_identity,'previous_revision',head.revision,'revision',head.revision,'changed',false,'updated_at',head.updated_at,'content_sha256',head.content_sha256);end if;\n context:=jsonb_build_object('family',p_family,'identity',p_identity,'expected_revision',p_expected_revision,'actor_id',auth.uid(),'session_id',sid,\n  'reason_sha256',encode(extensions.digest(convert_to(reason_text,'UTF8'),'sha256'),'hex'),'reason_characters',char_length(reason_text));\n prior_context:=current_setting('collect.runtime_control_context',true);\n perform set_config('collect.runtime_control_context',context::text,true);\n begin\n  if old_row is null then\n   select string_agg(format('%I',key),',' order by key),string_agg(format('(jsonb_populate_record(null::%s,$1)).%I',spec->>'relation',key),',' order by key)\n   into columns_sql,values_sql from jsonb_object_keys(p_identity||p_patch) key;\n   execute format('insert into %s (%s) select %s returning to_jsonb(%s.*)',spec->>'relation',columns_sql,values_sql,split_part(spec->>'relation','.',2)) into result_row using p_identity||p_patch;\n  else\n   select string_agg(format('%I=(jsonb_populate_record(null::%s,$1)).%I',key,spec->>'relation',key),',' order by key) into assignments_sql from jsonb_object_keys(p_patch) key;\n   execute format('update %s t set %s where to_jsonb(t) @> $2 returning to_jsonb(t)',spec->>'relation',assignments_sql) into result_row using p_patch,p_identity;\n  end if;\n exception\n when unique_violation then perform set_config('collect.runtime_control_context',coalesce(prior_context,''),true);raise exception 'runtime_control_conflict' using errcode='40001';\n when not_null_violation or check_violation or foreign_key_violation or invalid_text_representation or datetime_field_overflow or numeric_value_out_of_range then\n  perform set_config('collect.runtime_control_context',coalesce(prior_context,''),true);raise exception 'runtime_control_invalid' using errcode='22023';\n when others then perform set_config('collect.runtime_control_context',coalesce(prior_context,''),true);raise;end;\n perform set_config('collect.runtime_control_context',coalesce(prior_context,''),true);\n select * into strict head from collect_security.runtime_control_heads h where h.family=p_family and h.identity=p_identity;\n return jsonb_build_object('contract_version',1,'ok',true,'family',p_family,'identity',p_identity,'previous_revision',p_expected_revision,'revision',head.revision,'changed',true,'updated_at',head.updated_at,'content_sha256',head.content_sha256);\nend $function$\n", "oid": "21634", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_set_feature_flag_v2(p_key text, p_enabled boolean, p_expected_revision bigint, p_reason text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare receipt jsonb; key_text text:=btrim(coalesce(p_key,''));begin\n if p_enabled is null then raise exception 'runtime_control_patch_invalid' using errcode='22023';end if;\n receipt:=public.admin_update_runtime_control_v1('feature_flags',jsonb_build_object('key',key_text),jsonb_build_object('enabled',p_enabled),p_expected_revision,p_reason);\n return (receipt-array['family','identity','content_sha256'])||jsonb_build_object('contract_version',2,'key',key_text,'enabled',p_enabled);\nend $function$\n", "oid": "21636", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.get_notification_preferences_v2()\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare receipt jsonb; preferences jsonb;begin\n receipt:=public.admin_get_runtime_control_v1('notification_preferences',jsonb_build_object('user_id',auth.uid()));\n preferences:=case when (receipt->>'exists')::boolean then (receipt->'value')-array['user_id','created_at','updated_at']\n  else '{\"contribution_confirmations\":true,\"payment_reminders\":true,\"group_updates\":true,\"security_notices\":true}'::jsonb end;\n return jsonb_build_object('contract_version',2,'ok',true,'user_id',auth.uid(),'revision',receipt->'revision','exists',receipt->'exists','preferences',preferences);\nend $function$\n", "oid": "21637", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.set_notification_preferences_v2(p_preferences jsonb, p_expected_revision bigint)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare receipt jsonb;begin\n perform collect_security.runtime_control_actor('notification_preferences');\n if p_preferences is null or jsonb_typeof(p_preferences)<>'object' then raise exception 'runtime_control_patch_invalid' using errcode='22023';end if;\n if (select array_agg(key order by key) from jsonb_object_keys(p_preferences) key) is distinct from\n  array['contribution_confirmations','group_updates','payment_reminders','security_notices']::text[] then raise exception 'runtime_control_patch_invalid' using errcode='22023';end if;\n receipt:=public.admin_update_runtime_control_v1('notification_preferences',jsonb_build_object('user_id',auth.uid()),p_preferences,p_expected_revision,'User notification preferences update');\n return (receipt-array['family','identity','content_sha256'])||jsonb_build_object('contract_version',2,'user_id',auth.uid());\nend $function$\n", "oid": "21638", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_list_runtime_control_events_v1(p_family text DEFAULT NULL::text, p_limit integer DEFAULT 50)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare session_id uuid;\nbegin\n session_id:=public._lock_notification_registration_session();\n begin\n  perform collect_hybrid.require_roster_actor_authority(auth.uid(),session_id,'platform_owner',array['audit.read']);\n exception when sqlstate '42501' then\n  raise exception 'runtime_control_permission_required' using errcode='42501';end;\n if p_limit is null or p_limit not between 1 and 100\n  or p_family is not null and collect_security.runtime_control_spec(p_family) is null then\n  raise exception 'runtime_control_query_invalid' using errcode='22023';end if;\n return jsonb_build_object('contract_version',1,'events',coalesce((\n  select jsonb_agg(to_jsonb(event)-'session_id' order by event.recorded_at desc,event.id)\n  from(select * from collect_security.runtime_control_events\n   where p_family is null or family=p_family order by recorded_at desc,id limit p_limit) event),'[]'::jsonb));\nend $function$\n", "oid": "21639", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.record_operational_metric_v1(p_event_code text, p_duration_ms integer DEFAULT NULL::integer)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare bucket timestamptz:=date_trunc('minute',clock_timestamp());\nbegin\n if auth.role() is distinct from 'service_role' then\n  raise exception 'operational_metric_service_required' using errcode='42501'; end if;\n if p_event_code is null or p_event_code not in ('receipt_ack_generated','receipt_rejected',\n   'receipt_processing_accepted','receipt_processing_deferred')\n   or p_duration_ms<0 or p_duration_ms>120000 then\n  raise exception 'operational_metric_invalid' using errcode='22023';end if;\n insert into collect_security.operational_metric_buckets as b\n   (bucket_at,event_code,event_count,measured_count,duration_total_ms,duration_max_ms)\n values(bucket,p_event_code,1,case when p_duration_ms is null then 0 else 1 end,\n   coalesce(p_duration_ms,0),coalesce(p_duration_ms,0))\n on conflict(bucket_at,event_code) do update set event_count=b.event_count+1,\n   measured_count=b.measured_count+excluded.measured_count,\n   duration_total_ms=b.duration_total_ms+excluded.duration_total_ms,\n   duration_max_ms=greatest(b.duration_max_ms,excluded.duration_max_ms);\n return true;\nend $function$\n", "oid": "21659", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.purge_operational_metrics(p_limit integer DEFAULT 1000)\n RETURNS integer\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare removed integer;\nbegin\n if p_limit is null or p_limit not between 1 and 10000 then\n  raise exception 'operational_metric_limit_invalid' using errcode='22023';end if;\n with old as (select bucket_at,event_code from collect_security.operational_metric_buckets\n   where bucket_at<clock_timestamp()-interval '90 days' order by bucket_at,event_code\n   for update skip locked limit p_limit), gone as (\n   delete from collect_security.operational_metric_buckets b using old\n   where b.bucket_at=old.bucket_at and b.event_code=old.event_code returning 1)\n select count(*) into removed from gone;\n return removed;\nend $function$\n", "oid": "21660", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.operational_health_alerts(p_metrics jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n IMMUTABLE\n SET search_path TO ''\nAS $function$\ndeclare rule record; value jsonb; number_value numeric; state text;\n alerts jsonb:='[]';\nbegin\n if p_metrics is null or jsonb_typeof(p_metrics)<>'object' then\n  raise exception 'operational_health_invalid' using errcode='22023';end if;\n for rule in select * from (values\n  ('receipt_parse_backlog','sms_pending',100::numeric,null::text),\n  ('receipt_parse_age','sms_pending_age_seconds',300::numeric,'sms_pending'),\n  ('receipt_parse_failure','sms_failed_24h',1::numeric,null::text),\n  ('receipt_parser_lease_expired','sms_expired_parse_leases',1::numeric,null::text),\n  ('payment_unmatched','unallocated_events',1::numeric,null::text),\n  ('payment_review_age','payment_review_age_seconds',3600::numeric,'payments_review'),\n  ('reconciliation_exception','reconciliation_open',1::numeric,null::text),\n  ('push_queue_age','push_due_age_seconds',120::numeric,'push_due'),\n  ('push_expired_lease','push_expired_leases',1::numeric,null::text),\n  ('push_missing_lease','push_missing_leases',1::numeric,null::text),\n  ('push_attempt_failure','push_failed_24h',5::numeric,null::text),\n  ('receipt_telemetry_stale','receipt_telemetry_age_seconds',300::numeric,'durable_receipts_24h'),\n  ('push_scheduler_stale','push_scheduler_age_seconds',180::numeric,'push_due')\n ) rules(code,metric,threshold,queue) loop\n  value:=p_metrics->rule.metric;\n  if rule.queue is not null and p_metrics->rule.queue='0'::jsonb then state:='not_applicable';\n  elsif value is null or value='null'::jsonb then state:='unknown';\n  elsif jsonb_typeof(value)<>'number' or (value#>>'{}') !~ '^[0-9]+$'\n     or (value#>>'{}')::numeric>9007199254740991 then\n   raise exception 'operational_health_invalid' using errcode='22023';\n  else number_value:=(value#>>'{}')::numeric;\n   state:=case when number_value>=rule.threshold then 'attention' else 'ok' end;\n  end if;\n  alerts:=alerts||jsonb_build_array(jsonb_build_object('code',rule.code,'metric',rule.metric,\n   'threshold',rule.threshold,'state',state));\n end loop;\n return alerts;\nend $function$\n", "oid": "21661", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.require_roster_actor_authority(p_actor uuid, p_session uuid, p_role_name text, p_permission_names text[])\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare u auth.users;s auth.sessions;role_uuid uuid;permission text;mode_value text;approval_time timestamptz;\nbegin\n perform public._lock_notification_session_gate();\n perform pg_advisory_xact_lock(hashtext('collect_admin_combined_roster'));\n if p_actor is null or p_session is null or p_role_name is null or p_role_name !~ '^[a-z_]+$'\n  or p_permission_names is null or cardinality(p_permission_names) not between 1 and 30\n  or exists(select 1 from unnest(p_permission_names)n where n is null or n !~ '^[a-z_]+(\\.[a-z_]+)+$') then\n  raise exception 'roster_actor_unavailable' using errcode='42501';end if;\n select mode into mode_value from collect_admin_access.operator_auth_policy where id for share;\n select * into u from auth.users where id=p_actor for share;\n select * into s from auth.sessions where id=p_session and user_id=p_actor for share;\n if u.id is null or s.id is null or s.created_at is null or not isfinite(s.created_at)\n  or s.created_at>clock_timestamp() or s.aal::text not in ('aal1','aal2') or s.aal is null\n  or (s.not_after is not null and (not isfinite(s.not_after) or s.not_after<=clock_timestamp()))\n  or u.deleted_at is not null or coalesce(u.is_anonymous,false)\n  or (u.banned_until is not null and u.banned_until>clock_timestamp()) then\n  raise exception 'roster_actor_unavailable' using errcode='42501';end if;\n if u.email_confirmed_at is not null then\n  select approved_at into approval_time from collect_admin_access.email_approvals a\n   where a.user_id=p_actor and a.email=lower(btrim(u.email)) and a.revoked_at is null\n    and (a.expires_at is null or a.expires_at>clock_timestamp()) for share;\n end if;\n if approval_time is null and mode_value='transition' and u.phone_confirmed_at is not null\n  and not exists(select 1 from collect_admin_access.email_approvals where user_id=p_actor) then\n  select approved_at into approval_time from collect_admin_access.whatsapp_approvals a\n   where a.user_id=p_actor and a.phone_e164='+'||ltrim(u.phone,'+') and a.revoked_at is null\n    and (a.expires_at is null or a.expires_at>clock_timestamp()) for share;\n end if;\n select r.id into role_uuid from public.admin_user_roles ur\n  join public.admin_roles r on r.id=ur.role_id and r.name=p_role_name\n  where ur.user_id=p_actor and ur.revoked_at is null and s.created_at>=ur.created_at\n   and approval_time is not null and s.created_at>=approval_time\n  order by ur.created_at for share of ur,r;\n if role_uuid is null then raise exception 'roster_actor_unavailable' using errcode='42501';end if;\n for permission in select distinct n from unnest(p_permission_names)n order by n loop\n  perform 1 from public.admin_role_permissions where role_id=role_uuid and permission_name=permission for share;\n  if not found then raise exception 'roster_actor_unavailable' using errcode='42501';end if;\n end loop;\nend $function$\n", "oid": "21666", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.lock_roster_recovery_budget()\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$ begin\n perform public._lock_notification_session_gate();\n perform pg_advisory_xact_lock(hashtext('collect_admin_combined_roster'));\n update collect_hybrid.roster_recovery_budget set version=version where id;\n if not found then raise exception 'roster_recovery_budget_unavailable' using errcode='55000'; end if;\nend $function$\n", "oid": "21675", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.roster_recovery_root(p_import uuid)\n RETURNS uuid\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$\n select coalesce((select root_import_id from collect_hybrid.roster_recovery_transfers where to_import_id=p_import),p_import)\n$function$\n", "oid": "21722", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.roster_recovery_sha(p_text text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE STRICT\n SET search_path TO ''\nAS $function$\n select encode(extensions.digest(convert_to(p_text,'UTF8'),'sha256'),'hex')\n$function$\n", "oid": "21723", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.require_fresh_roster_auth()\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid; s auth.sessions; exp_epoch numeric; begin\n sid:=collect_hybrid.require_roster_caller();\n select * into s from auth.sessions where id=sid and user_id=auth.uid() for share;\n if s.id is null or s.created_at<clock_timestamp()-interval '10 minutes' or s.created_at>clock_timestamp()\n  or jsonb_typeof(auth.jwt()->'exp') is distinct from 'number' then\n  raise exception 'roster_fresh_auth_required' using errcode='42501'; end if;\n begin exp_epoch:=(auth.jwt()->>'exp')::numeric; exception when others then\n  raise exception 'roster_fresh_auth_required' using errcode='42501'; end;\n if exp_epoch<=extract(epoch from clock_timestamp()) or exp_epoch>253402300799 then\n  raise exception 'roster_fresh_auth_required' using errcode='42501'; end if;\n return sid;\nend $function$\n", "oid": "21724", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.roster_recovery_leaf(p_import uuid, p_mutation boolean DEFAULT false)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare s collect_hybrid.roster_import_sources; root_source collect_hybrid.roster_import_sources; begin\n perform public._lock_notification_session_gate();\n perform pg_advisory_xact_lock(hashtext('collect_admin_combined_roster'));\n select * into s from collect_hybrid.roster_import_sources where id=p_import;\n if s.id is null then return; end if; -- Frozen entrypoint preserves its missing-source contract.\n if auth.role()='authenticated' and s.actor_id is distinct from auth.uid() then\n  raise exception 'roster_import_unavailable' using errcode='42501'; end if;\n if exists(select 1 from collect_hybrid.roster_recovery_transfers where from_import_id=s.id) then\n  raise exception 'roster_recovery_transferred' using errcode='55000'; end if;\n select * into root_source from collect_hybrid.roster_import_sources where id=collect_hybrid.roster_recovery_root(s.id);\n if s.id<>root_source.id then\n  -- Logout may legitimately delete the issued source session. Immutable\n  -- provenance records that issuance; current verified authority authorizes\n  -- this branch. The original SID never becomes a credential/dependency.\n  if auth.role()='authenticated' then\n   perform collect_hybrid.require_roster_actor(root_source.actor_id,(auth.jwt()->>'session_id')::uuid);\n  end if;\n  if s.actor_id<>root_source.actor_id or s.expires_at<>root_source.expires_at then\n   raise exception 'roster_recovery_lineage_invalid' using errcode='55000'; end if;\n end if;\n if p_mutation and s.expires_at<=clock_timestamp() then raise exception 'roster_import_expired' using errcode='55000'; end if;\nend $function$\n", "oid": "21725", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.roster_original_proof(p_root uuid)\n RETURNS text\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select jsonb_build_object('contract_version',1,'root_import_id',s.id,'upload_request_id',s.request_id,\n  'actor_id',s.actor_id,'session_id',s.session_id,'source_kind',s.source_kind,'source_sha256',s.source_sha256,\n  'input_sha256',s.input_sha256,'expires_at',to_char(s.expires_at at time zone 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"'),\n  'source_receipt',collect_hybrid.roster_revision_receipt_v149_frozen(r.id)->'source_receipt',\n  'resource_reservation_id',res.id,'decoder_receipt_sha256',v.decoder_receipt_sha256,\n  'decoder_build_sha256',v.decoder_build_sha256)::text\n from collect_hybrid.roster_import_sources s\n join collect_hybrid.roster_import_revisions r on r.import_id=s.id and r.revision_number=1\n left join collect_hybrid.roster_resource_reservations res on res.request_id=s.request_id\n left join collect_hybrid.roster_source_verifications v on v.reservation_id=res.id where s.id=p_root\n$function$\n", "oid": "21726", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.roster_revision_receipt(p_revision uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare answer jsonb; t collect_hybrid.roster_recovery_transfers; r collect_hybrid.roster_import_revisions;\n proof text; begin\n select * into r from collect_hybrid.roster_import_revisions where id=p_revision;\n if r.id is null then return null; end if;\n answer:=collect_hybrid.roster_revision_receipt_v149_frozen(r.id);\n if exists(select 1 from collect_hybrid.roster_recovery_transfers where from_import_id=r.import_id) then\n  answer:=answer||jsonb_build_object('can_submit',false);\n end if;\n select * into t from collect_hybrid.roster_recovery_transfers where to_import_id=r.import_id;\n if t.request_id is null then return answer; end if;\n proof:=collect_hybrid.roster_original_proof(t.root_import_id);\n if proof is null or collect_hybrid.roster_recovery_sha(proof)<>t.original_proof_sha256 then\n  raise exception 'roster_recovery_lineage_invalid' using errcode='55000'; end if;\n return answer||jsonb_build_object('source_receipt',proof::jsonb->'source_receipt',\n  'recovery_lineage',jsonb_build_object('contract_version',1,'transfer_request_id',t.request_id,\n   'root_import_id',t.root_import_id,'from_import_id',t.from_import_id,'to_import_id',t.to_import_id,\n   'actor_id',t.actor_id,'destination_session_id',t.to_session_id,'destination_reference_id',t.destination_reference_id,\n   'initial_revision_id',t.initial_revision_id,'original_proof',proof,'original_proof_sha256',t.original_proof_sha256));\nend $function$\n", "oid": "21727", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.roster_interrupted_etag(p_import uuid, p_destination_session uuid)\n RETURNS text\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select collect_hybrid.roster_digest(jsonb_build_object('actor',s.actor_id,'destination_session',p_destination_session,\n  'root',collect_hybrid.roster_recovery_root(s.id),'leaf',s.id,'input_sha256',s.input_sha256,'expiry',extract(epoch from s.expires_at),\n  'revision',(select id from collect_hybrid.roster_import_revisions where import_id=s.id order by revision_number desc limit 1),\n  'draft',(select jsonb_build_array(checkpoint_id,payload_sha256) from collect_hybrid.roster_import_editor_drafts where import_id=s.id),\n  'intents',(select coalesce(jsonb_agg(jsonb_build_array(request_id,kind,payload_sha256,expires_at) order by request_id),'[]')\n    from collect_hybrid.roster_import_recovery_intents where import_id=s.id),\n  'commit',(select request_id from collect_hybrid.roster_import_commits where import_id=s.id),\n  'transfer',(select request_id from collect_hybrid.roster_recovery_transfers where from_import_id=s.id)))\n from collect_hybrid.roster_import_sources s where s.id=p_import\n$function$\n", "oid": "21728", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.require_interrupted_roster(p_import uuid, p_destination uuid, p_etag text DEFAULT NULL::text)\n RETURNS collect_hybrid.roster_import_sources\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare s collect_hybrid.roster_import_sources; new_auth auth.sessions;\n root_source collect_hybrid.roster_import_sources; begin\n select * into s from collect_hybrid.roster_import_sources where id=p_import for update;\n if s.id is null or s.actor_id<>auth.uid() or s.session_id=p_destination then\n  raise exception 'roster_import_unavailable' using errcode='42501'; end if;\n perform collect_hybrid.roster_recovery_leaf(s.id,true);\n perform collect_hybrid.require_roster_actor(s.actor_id,p_destination);\n select * into root_source from collect_hybrid.roster_import_sources where id=collect_hybrid.roster_recovery_root(s.id);\n select * into new_auth from auth.sessions where id=p_destination and user_id=s.actor_id;\n if new_auth.id is null or new_auth.created_at<=s.created_at or new_auth.created_at<=root_source.created_at then\n  raise exception 'roster_fresh_auth_required' using errcode='42501'; end if;\n if exists(select 1 from collect_hybrid.roster_import_commits where import_id=s.id) then\n  raise exception 'roster_import_committed' using errcode='55000'; end if;\n if not exists(select 1 from collect_hybrid.roster_import_revisions where import_id=s.id and revision_number=1) then\n  raise exception 'roster_preview_unacknowledged' using errcode='55000'; end if;\n if p_etag is not null and (p_etag !~ '^[a-f0-9]{64}$' or p_etag<>collect_hybrid.roster_interrupted_etag(s.id,p_destination)) then\n  raise exception 'roster_draft_superseded' using errcode='55000'; end if;\n return s;\nend $function$\n", "oid": "21729", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_list_interrupted_roster_imports()\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid; s collect_hybrid.roster_import_sources; answer jsonb:='[]'; begin\n sid:=collect_hybrid.require_fresh_roster_auth();\n -- A bounded authenticated server lookup; browser references confer no access.\n for s in select * from collect_hybrid.roster_import_sources where actor_id=auth.uid() and session_id<>sid\n  and expires_at>clock_timestamp() and not exists(select 1 from collect_hybrid.roster_recovery_transfers where from_import_id=id)\n  order by created_at desc,id limit 100 loop\n  begin\n   if exists(select 1 from collect_hybrid.roster_import_commits where import_id=s.id) then\n    answer:=answer||jsonb_build_array(jsonb_build_object('import_id',s.id,'source_sha256',s.source_sha256,\n     'source_kind',s.source_kind,'created_at',s.created_at,'expires_at',s.expires_at,'state','committed','etag',null));\n   else\n    perform collect_hybrid.require_interrupted_roster(s.id,sid);\n    answer:=answer||jsonb_build_array(jsonb_build_object('import_id',s.id,'source_sha256',s.source_sha256,\n     'source_kind',s.source_kind,'created_at',s.created_at,'expires_at',s.expires_at,'state','interrupted',\n     'etag',collect_hybrid.roster_interrupted_etag(s.id,sid)));\n   end if;\n  exception when sqlstate '42501' or sqlstate '55000' then null;\n  end;\n end loop;\n return jsonb_build_object('contract_version',1,'ok',true,'actor_id',auth.uid(),'destination_session_id',sid,'items',answer);\nend $function$\n", "oid": "21730", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.roster_compact_recovery_draft(p_value jsonb, p_parent uuid)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE STRICT\n SET search_path TO ''\nAS $function$\n select '{\"parent_revision_id\":'||to_json(p_parent::text)::text||',\"rows\":['||\n  (select string_agg('{\"member_name\":'||to_json(x->>'member_name')::text||\n    ',\"momo_name\":'||to_json(x->>'momo_name')::text||\n    ',\"momo_number\":'||to_json(x->>'momo_number')::text||'}',',' order by ord)\n   from jsonb_array_elements(p_value->'rows') with ordinality a(x,ord))||\n  '],\"title\":'||to_json(p_value->>'title')::text||',\"reason\":'||to_json(p_value->>'reason')::text||'}'\n$function$\n", "oid": "21731", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.roster_interrupted_draft(p_import uuid, p_parent uuid)\n RETURNS text\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare d collect_hybrid.roster_import_editor_drafts; r collect_hybrid.roster_import_revisions; v jsonb; begin\n select * into r from collect_hybrid.roster_import_revisions where import_id=p_import order by revision_number desc limit 1;\n select * into d from collect_hybrid.roster_import_editor_drafts where import_id=p_import and expires_at>statement_timestamp();\n if d.import_id is not null then\n  v:=collect_hybrid.roster_recovery_payload(d.payload,d.payload_sha256,'draft');\n  if not exists(select 1 from collect_hybrid.roster_import_revisions where import_id=p_import\n   and id=(v->>'parent_revision_id')::uuid) then\n   raise exception 'roster_recovery_lineage_invalid' using errcode='55000'; end if;\n  if v->>'parent_revision_id'=r.id::text then\n   if p_parent=r.id then return d.payload; end if; -- Inspection preserves exact acknowledged bytes/SHA.\n   return collect_hybrid.roster_compact_recovery_draft(v,p_parent);\n  end if;\n else v:=jsonb_build_object('title','','reason',''); end if;\n -- An acknowledged review supersedes stale editor rows. Preserve its saved\n -- title/reason, but never reapply those older rows or their approval state.\n v:=v||jsonb_build_object('rows',(select jsonb_agg(jsonb_build_object('member_name',x->>'member_name',\n  'momo_name',x->>'momo_name','momo_number',x->>'momo_number') order by ord)\n  from jsonb_array_elements(r.preview->'rows') with ordinality a(x,ord)));\n return collect_hybrid.roster_compact_recovery_draft(v,p_parent);\nend $function$\n", "oid": "21732", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_inspect_interrupted_roster_import(p_import_id uuid, p_etag text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid; s collect_hybrid.roster_import_sources; initial uuid; latest uuid; payload text; begin\n sid:=collect_hybrid.require_fresh_roster_auth();\n if p_etag is null or p_etag !~ '^[a-f0-9]{64}$' then\n  raise exception 'roster_draft_superseded' using errcode='55000'; end if;\n s:=collect_hybrid.require_interrupted_roster(p_import_id,sid,p_etag);\n select id into initial from collect_hybrid.roster_import_revisions where import_id=s.id and revision_number=1;\n select id into latest from collect_hybrid.roster_import_revisions where import_id=s.id order by revision_number desc limit 1;\n payload:=collect_hybrid.roster_interrupted_draft(s.id,latest);\n perform collect_hybrid.roster_recovery_payload(payload,collect_hybrid.roster_recovery_sha(payload),'draft');\n if s.expires_at<=clock_timestamp() then raise exception 'roster_import_expired' using errcode='55000'; end if;\n return jsonb_build_object('contract_version',1,'ok',true,'import_id',s.id,'actor_id',auth.uid(),\n  'destination_session_id',sid,'etag',p_etag,'initial_preview',collect_hybrid.roster_revision_receipt(initial),\n  'latest_preview',collect_hybrid.roster_revision_receipt(latest),'draft_payload',payload,\n  'draft_sha256',collect_hybrid.roster_recovery_sha(payload),'expires_at',s.expires_at);\nend $function$\n", "oid": "21733", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.roster_transfer_ack(p_request uuid)\n RETURNS jsonb\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select jsonb_build_object('contract_version',1,'ok',true,'state','transferred','request_id',t.request_id,\n  'from_import_id',t.from_import_id,'root_import_id',t.root_import_id,'to_import_id',t.to_import_id,\n  'actor_id',t.actor_id,'destination_session_id',t.to_session_id,'destination_reference_id',t.destination_reference_id,\n  'initial_revision_id',t.initial_revision_id,'checkpoint_id',t.checkpoint_id,'draft_sha256',t.draft_sha256,\n  'source_etag',t.source_etag,'original_proof_sha256',t.original_proof_sha256,'expires_at',t.expires_at)\n from collect_hybrid.roster_recovery_transfers t where t.request_id=p_request\n$function$\n", "oid": "21734", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_transfer_interrupted_roster_import(p_request_id uuid, p_import_id uuid, p_etag text, p_human_affirmed boolean)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid; s collect_hybrid.roster_import_sources; root_source collect_hybrid.roster_import_sources;\n prior collect_hybrid.roster_recovery_transfers; base collect_hybrid.roster_import_revisions;\n old_draft collect_hybrid.roster_import_editor_drafts; old_revision uuid; intents_sha text;\n proof text; fingerprint text; destination uuid:=gen_random_uuid(); lookup_ref uuid:=gen_random_uuid();\n revision uuid:=gen_random_uuid(); checkpoint uuid:=gen_random_uuid(); payload text; preview jsonb; candidates jsonb; begin\n sid:=collect_hybrid.require_fresh_roster_auth();\n perform collect_hybrid.lock_roster_recovery_budget();\n if p_request_id is null or p_import_id is null or p_etag is null or p_etag !~ '^[a-f0-9]{64}$' or p_human_affirmed is distinct from true then\n  raise exception 'roster_confirmation_required' using errcode='22023'; end if;\n fingerprint:=collect_hybrid.roster_digest(jsonb_build_array(p_request_id,p_import_id,p_etag,true,auth.uid(),sid));\n select * into prior from collect_hybrid.roster_recovery_transfers where request_id=p_request_id;\n if prior.request_id is not null then\n  if prior.actor_id<>auth.uid() or prior.to_session_id<>sid or prior.request_sha256<>fingerprint then\n   raise exception 'roster_request_conflict' using errcode='55000'; end if;\n  perform collect_hybrid.roster_recovery_leaf(prior.to_import_id,true);\n  return collect_hybrid.roster_transfer_ack(prior.request_id);\n end if;\n s:=collect_hybrid.require_interrupted_roster(p_import_id,sid,p_etag);\n select * into root_source from collect_hybrid.roster_import_sources where id=collect_hybrid.roster_recovery_root(s.id);\n if (select count(*) from collect_hybrid.roster_recovery_transfers where root_import_id=root_source.id)>=8\n  or (select count(*) from collect_hybrid.roster_import_sources where actor_id=auth.uid() and created_at>clock_timestamp()-interval '24 hours')>=100\n  or (select count(*) from collect_hybrid.roster_import_editor_drafts where actor_id=auth.uid() and expires_at>clock_timestamp())>=40\n  or (select count(*) from collect_hybrid.roster_import_editor_drafts where session_id=sid and expires_at>clock_timestamp())>=20 then\n  raise exception 'roster_recovery_limit' using errcode='55000'; end if;\n select * into base from collect_hybrid.roster_import_revisions where import_id=root_source.id and revision_number=1;\n select jsonb_agg(jsonb_build_object('source_row',x->'source_row','member_name',x->'member_name',\n  'momo_name',x->'momo_name','momo_number',x->'momo_number','confidence',x->'confidence') order by ord)\n into candidates from jsonb_array_elements(base.preview->'rows') with ordinality a(x,ord);\n preview:=collect_hybrid.roster_preview(candidates,false);\n select id into old_revision from collect_hybrid.roster_import_revisions where import_id=s.id order by revision_number desc limit 1;\n select * into old_draft from collect_hybrid.roster_import_editor_drafts where import_id=s.id;\n select collect_hybrid.roster_digest(coalesce(jsonb_agg(jsonb_build_array(request_id,kind,payload_sha256,expires_at) order by request_id),'[]')) into intents_sha\n  from collect_hybrid.roster_import_recovery_intents where import_id=s.id;\n proof:=collect_hybrid.roster_original_proof(root_source.id);\n if proof is null then raise exception 'roster_recovery_lineage_invalid' using errcode='55000'; end if;\n payload:=collect_hybrid.roster_interrupted_draft(s.id,revision);\n perform collect_hybrid.roster_recovery_payload(payload,collect_hybrid.roster_recovery_sha(payload),'draft');\n -- Audit comes first with a deferred destination FK. Triggers validate the\n -- exact copy against this immutable lineage, never a caller-supplied flag/GUC.\n insert into collect_hybrid.roster_recovery_transfers(request_id,root_import_id,from_import_id,to_import_id,\n  actor_id,from_session_id,to_session_id,destination_reference_id,initial_revision_id,checkpoint_id,draft_sha256,\n  from_revision_id,from_checkpoint_id,from_draft_sha256,from_intents_sha256,source_etag,request_sha256,original_proof_sha256,expires_at)\n values(p_request_id,root_source.id,s.id,destination,auth.uid(),s.session_id,sid,lookup_ref,revision,checkpoint,\n  collect_hybrid.roster_recovery_sha(payload),old_revision,old_draft.checkpoint_id,old_draft.payload_sha256,intents_sha,p_etag,fingerprint,collect_hybrid.roster_recovery_sha(proof),root_source.expires_at);\n insert into collect_hybrid.roster_import_sources(id,request_id,actor_id,session_id,source_kind,source_sha256,source_size,\n  client_filename,declared_mime,detected_type,deri