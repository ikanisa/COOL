nual_evidence_review_no_blind_retry','dispatch_authority_created',false,\n  'legacy_new_authority_reason','CONTENT_POLICY_REVIEW_REQUIRED');\nexception when lock_not_available then raise exception 'receipt_policy_authority_busy'using errcode='55P03';end$function$\n", "oid": "22572", "owner": "16384", "config": ["search_path=\"\"", "lock_timeout=100ms"]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_receipt_operations.base(p_principal uuid, p_request uuid, p_action text, p_at timestamp with time zone)\n RETURNS jsonb\n LANGUAGE sql\n IMMUTABLE\n SET search_path TO ''\nAS $function$\n select jsonb_build_object('contract_version',2,'principal_id',p_principal,'request_id',p_request,'action',p_action,'observed_at',collect_gateway.utc(p_at))\n$function$\n", "oid": "22790", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_receipt_operations.owner_replay(p_request uuid, p_action text, p_input jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$declare r collect_receipt_operations.owner_requests;begin\n select * into r from collect_receipt_operations.owner_requests where request_id=p_request;\n if r.request_id is null then return null;end if;\n if r.actor_id<>auth.uid()or r.action<>p_action or r.input is distinct from p_input then\n  raise exception 'operations_owner_request_conflict'using errcode='22023';end if;return r.result;end$function$\n", "oid": "22791", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_enroll_receipt_operations_identity_v2(p_request_id uuid, p_public_key_spki_base64 text, p_key_sha256 text, p_expires_at timestamp with time zone)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid;prior jsonb;input jsonb;result jsonb;principal uuid;t timestamptz;begin