TY DEFINER\n SET search_path TO ''\nAS $function$\n   begin perform collect_hybrid.guard_roster_service_recovery((select id from collect_hybrid.roster_import_sources where request_id=p_request_id)); return collect_hybrid.reserve_roster_resources_guarded_149(p_actor_id,p_session_id,p_request_id,p_source_sha256,p_source_kind,p_source_bytes,p_derived_sha256); end $function$\n", "oid": "21777", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.verify_roster_source_integrity(p_reservation_id uuid, p_actor_id uuid, p_session_id uuid, p_decoder_receipt_sha256 text, p_decoder_build_sha256 text, p_policy_version text, p_toolchain jsonb, p_summary jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n   begin perform collect_hybrid.guard_roster_service_recovery((select s.id from collect_hybrid.roster_import_sources s join collect_hybrid.roster_resource_reservations r on r.request_id=s.request_id where r.id=p_reservation_id)); return collect_hybrid.verify_roster_source_integrity_guarded_149(p_reservation_id,p_actor_id,p_session_id,p_decoder_receipt_sha256,p_decoder_build_sha256,p_policy_version,p_toolchain,p_summary); end $function$\n", "oid": "21778", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.require_shadow_actor()\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid;\nbegin\n  begin sid:=public._lock_notification_registration_session();\n  exception when sqlstate '42501' then\n    raise exception 'shadow_session_required' using errcode='42501';end;\n  -- Match150: Auth/session -> roster serialization -> authority rows -> lease.\n  perform pg_advisory_xact_lock(hashtext('collect_admin_combined_roster'));\n  begin\n    perform collect_hybrid.require_roster_actor_authority(auth.uid(),sid,\n      'platform_owner',array['system_health.read','notifications.read']);\n  exception when sqlstate '42501' then\n    raise exception 'shadow_permission_required' using errcode='42501';end;\n  return sid;\nend $function$\n", "oid": "21842", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.guard_shadow_sample()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin raise exception 'shadow_history_immutable' using errcode='55000';end $function$\n", "oid": "21843", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.guard_shadow_run()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  if tg_op='DELETE' or old.status<>'running'\n    or new.status not in ('completed','expired')\n    or (to_jsonb(new)-array['status','completed_at']) is distinct from\n       (to_jsonb(old)-array['status','completed_at']) then\n    raise exception 'shadow_history_immutable' using errcode='55000';end if;\n  return new;\nend $function$\n", "oid": "21845", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.shadow_run_json(p_run_id uuid, p_observed_at timestamp with time zone DEFAULT clock_timestamp())\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET \"TimeZone\" TO 'UTC'\nAS $function$\ndeclare r collect_security.shadow_supervisor_runs;\n  s collect_security.shadow_supervisor_samples;\nbegin\n  select * into r from collect_security.shadow_supervisor_runs where id=p_run_id;\n  if r.id is null then return null;end if;\n  select * into s from collect_security.shadow_supervisor_samples where run_id=r.id;\n  if s.id is not null and s.content_sha256 is distinct from\n    encode(extensions.digest(convert_to(s.body::text,'UTF8'),'sha256'),'hex') then\n    raise exception 'shadow_integrity_unavailable' using errcode='55000';end if;\n  return jsonb_build_object('run_id',r.id,'request_id',r.request_id,\n    'fence_version',r.fence_version,'status',case when r.status='running'\n      and r.lease_expires_at<=p_observed_at then 'expired' else r.status end,\n    'started_at',r.started_at,'lease_expires_at',r.lease_expires_at,\n    'sampled_at',s.checked_at,'completed_at',r.completed_at,'summary',s.body->'summary');\nend $function$\n", "oid": "21847", "owner": "16384", "config": ["search_path=\"\"", "TimeZone=UTC"]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.require_shadow_health(p_health jsonb, p_started_at timestamp with time zone, p_observed_at timestamp with time zone)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare checked timestamptz; expires timestamptz; canonical_alerts jsonb;\n  allowed_keys text[]:=array['id','contract_version','database','auth','parser_pending_sms',\n    'failed_sms_parse','unallocated_events','queued_notifications','processing_notifications',\n    'failed_notifications','checked_at','metrics','alerts','health_status','sample_valid_until',\n    'window_seconds','threshold_version','scheduler','evidence_limits'];\n  metric_keys text[]:=array['push_due','push_failed','push_queued','sms_pending','reversals_24h',\n    'push_retry_24h','sms_failed_24h','sms_parsed_24h','payments_review','push_failed_24h',\n    'push_processing','push_attempts_24h','unallocated_events','finality_processing',\n    'payments_posted_24h','push_expired_leases','push_latency_p95_ms','push_missing_leases',\n    'reconciliation_open','durable_receipts_24h','push_due_age_seconds','receipt_rejected_24h',\n    'finality_processed_24h','sms_pending_age_seconds','sms_expired_parse_leases',\n    'push_provider_accepts_24h','receipt_ack_generated_24h','payment_review_age_seconds',\n    'push_scheduler_age_seconds','receipt_ack_latency_mean_ms','receipt_telemetry_age_seconds'];\n  nullable_metric_keys text[]:=array['push_latency_p95_ms','push_due_age_seconds',\n    'sms_pending_age_seconds','payment_review_age_seconds','push_scheduler_age_seconds',\n    'receipt_ack_latency_mean_ms','receipt_telemetry_age_seconds'];\n  metric record;\nbegin\n  if p_health is null or jsonb_typeof(p_health) is distinct from 'object'\n    or p_health->'contract_version' is distinct from '1'::jsonb\n    or jsonb_typeof(p_health->'alerts') is distinct from 'array'\n    or jsonb_typeof(p_health->'metrics') is distinct from 'object'\n    or jsonb_typeof(p_health->'checked_at') is distinct from 'string'\n    or jsonb_typeof(p_health->'sample_valid_until') is distinct from 'string'\n    or p_health->>'health_status' is null\n    or p_health->>'health_status' not in ('ok','unknown','attention') then\n    raise exception 'shadow_integrity_unavailable' using errcode='55000';end if;\n  if not (p_health->'metrics' ?& metric_keys)\n    or (p_health->'metrics')-metric_keys<>'{}'::jsonb then\n    raise exception 'shadow_integrity_unavailable' using errcode='55000';end if;\n  for metric in select key,value from jsonb_each(p_health->'metrics') loop\n    if metric.value='null'::jsonb and metric.key=any(nullable_metric_keys) then continue;end if;\n    if jsonb_typeof(metric.value) is distinct from 'number' then\n      raise exception 'shadow_integrity_unavailable' using errcode='55000';end if;\n    if metric.value::text !~ '^[0-9]+$' or metric.value::text::numeric>9007199254740991 then\n      raise exception 'shadow_integrity_unavailable' using errcode='55000';end if;\n  end loop;\n  if p_health->'parser_pending_sms' is distinct from p_health->'metrics'->'sms_pending'\n    or p_health->'failed_sms_parse' is distinct from p_health->'metrics'->'sms_failed_24h'\n    or p_health->'unallocated_events' is distinct from p_health->'metrics'->'unallocated_events'\n    or p_health->'queued_notifications' is distinct from p_health->'metrics'->'push_queued'\n    or p_health->'processing_notifications' is distinct from p_health->'metrics'->'push_processing'\n    or p_health->'failed_notifications' is distinct from p_health->'metrics'->'push_failed' then\n    raise exception 'shadow_integrity_unavailable' using errcode='55000';end if;\n  -- Enforce the existing redacted v1 surface before making durable evidence.\n  -- Future accidental source fields must not become a receipt-data export.\n  if not (p_health ?& allowed_keys) or p_health-allowed_keys<>'{}'::jsonb\n    or p_health->>'id' is distinct from 'system'\n    or p_health->>'database' is distinct from 'reachable'\n    or p_health->>'auth' is distinct from 'authenticated'\n    or p_health->'window_seconds' is distinct from '86400'::jsonb\n    or p_health->'threshold_version' is distinct from '1'::jsonb\n    or jsonb_typeof(p_health->'metrics') is distinct from 'object'\n    or jsonb_typeof(p_health->'scheduler') is distinct from 'object'\n    or (p_health->'scheduler')-array['state','configuration_verified']<>'{}'::jsonb\n    or p_health->'scheduler'->'configuration_verified' is distinct from 'false'::jsonb\n    or p_health->'scheduler'->>'state' is null\n    or p_health->'scheduler'->>'state' not in ('unknown','enabled','disabled')\n    or p_health->'evidence_limits' is distinct from jsonb_build_array(\n      'ACK generation does not prove device receipt.',\n      'Provider acceptance does not prove user delivery.',\n      'Scheduler activation does not prove provider configuration.') then\n    raise exception 'shadow_integrity_unavailable' using errcode='55000';end if;\n  if jsonb_array_length(p_health->'alerts')<>13 or exists(\n    select 1 from jsonb_array_elements(p_health->'alerts') a\n    where jsonb_typeof(a) is distinct from 'object' or a->>'state' is null\n      or a->>'state' not in ('ok','unknown','attention','not_applicable')) then\n    raise exception 'shadow_integrity_unavailable' using errcode='55000';end if;\n  begin canonical_alerts:=collect_security.operational_health_alerts(p_health->'metrics');\n  exception when others then\n    raise exception 'shadow_integrity_unavailable' using errcode='55000';end;\n  if p_health->'alerts' is distinct from canonical_alerts\n    or p_health->>'health_status' is distinct from (case\n      when exists(select 1 from jsonb_array_elements(canonical_alerts) a where a->>'state'='attention') then 'attention'\n      when exists(select 1 from jsonb_array_elements(canonical_alerts) a where a->>'state'='unknown') then 'unknown'\n      else 'ok' end) then\n    raise exception 'shadow_integrity_unavailable' using errcode='55000';end if;\n  begin\n    checked:=(p_health->>'checked_at')::timestamptz;\n    expires:=(p_health->>'sample_valid_until')::timestamptz;\n  exception when others then\n    raise exception 'shadow_integrity_unavailable' using errcode='55000';end;\n  if checked is null or expires is null or not isfinite(checked) or not isfinite(expires)\n    or expires<>checked+interval '60 seconds' or checked<p_started_at or checked>p_observed_at then\n    raise exception 'shadow_integrity_unavailable' using errcode='55000';end if;\n  if expires<=p_observed_at then\n    raise exception 'shadow_health_stale' using errcode='55000';end if;\nend $function$\n", "oid": "21848", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.begin_collect_shadow_run_v1(p_request_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET \"TimeZone\" TO 'UTC'\nAS $function$\ndeclare sid uuid; l collect_security.shadow_supervisor_lease;\n  r collect_security.shadow_supervisor_runs; t timestamptz;\nbegin\n  sid:=collect_security.require_shadow_actor();\n  if p_request_id is null then raise exception 'shadow_request_invalid' using errcode='22023';end if;\n  -- A physical same-value write serializes quota/idempotency decisions, including\n  -- established Repeatable Read snapshots, which receive40001 after a writer.\n  update collect_security.shadow_supervisor_lease set fence_version=fence_version\n    where id returning * into l;\n  if l.id is null then raise exception 'shadow_integrity_unavailable' using errcode='55000';end if;\n  t:=clock_timestamp();\n  select * into r from collect_security.shadow_supervisor_runs where request_id=p_request_id;\n  if r.id is not null then\n    if r.actor_id is distinct from auth.uid() or r.session_id is distinct from sid then\n      raise exception 'shadow_request_conflict' using errcode='40001';end if;\n    return jsonb_build_object('contract_version',1,'mode','shadow','scope','collect_platform',\n      'ok',true,'outcome','replayed','replayed',true,'run',collect_security.shadow_run_json(r.id));\n  end if;\n  if l.active_run_id is not null and l.lease_expires_at>t then\n    return jsonb_build_object('contract_version',1,'mode','shadow','scope','collect_platform',\n      'ok',false,'outcome','busy','reason_code','shadow_run_busy','request_id',p_request_id,\n      'retry_after_seconds',greatest(1,least(120,ceil(extract(epoch from l.lease_expires_at-t))::integer)));\n  end if;\n  if (select count(*) from collect_security.shadow_supervisor_runs\n      where started_at>t-interval '1 hour')>=60 then\n    raise exception 'shadow_limit_reached' using errcode='55000';end if;\n  if l.fence_version>=1000000000 then raise exception 'shadow_limit_reached' using errcode='55000';end if;\n  if l.active_run_id is not null then\n    update collect_security.shadow_supervisor_runs set status='expired'\n      where id=l.active_run_id and status='running';\n  end if;\n  insert into collect_security.shadow_supervisor_runs(request_id,actor_id,session_id,\n    fence_version,started_at,lease_expires_at)\n  values(p_request_id,auth.uid(),sid,l.fence_version+1,t,t+interval '120 seconds')\n  returning * into r;\n  update collect_security.shadow_supervisor_lease set fence_version=r.fence_version,\n    active_run_id=r.id,lease_expires_at=r.lease_expires_at where id;\n  return jsonb_build_object('contract_version',1,'mode','shadow','scope','collect_platform',\n    'ok',true,'outcome','started','replayed',false,'run',collect_security.shadow_run_json(r.id));\nend $function$\n", "oid": "21850", "owner": "16384", "config": ["search_path=\"\"", "TimeZone=UTC"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.sample_collect_shadow_run_v1(p_run_id uuid, p_fence_version bigint)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET \"TimeZone\" TO 'UTC'\nAS $function$\ndeclare sid uuid; l collect_security.shadow_supervisor_lease;\n  r collect_security.shadow_supervisor_runs; s collect_security.shadow_supervisor_samples;\n  t timestamptz; health jsonb; sms jsonb; counts jsonb; summary jsonb; body jsonb;\nbegin\n  sid:=collect_security.require_shadow_actor();\n  if p_run_id is null or p_fence_version is null or p_fence_version not between 1 and 1000000000 then\n    raise exception 'shadow_request_invalid' using errcode='22023';end if;\n  -- A manual health sample must use current statement snapshots, not an older\n  -- caller-created Repeatable Read view presented with a fresh checked_at.\n  if current_setting('transaction_isolation')<>'read committed' then\n    raise exception 'shadow_snapshot_retry' using errcode='40001';end if;\n  select * into l from collect_security.shadow_supervisor_lease where id for update;\n  select * into r from collect_security.shadow_supervisor_runs where id=p_run_id for update;\n  if r.id is null or r.actor_id is distinct from auth.uid() or r.session_id is distinct from sid then\n    raise exception 'shadow_run_unavailable' using errcode='42501';end if;\n  if r.fence_version<>p_fence_version or l.active_run_id is distinct from r.id\n    or l.fence_version<>p_fence_version or r.status<>'running' then\n    raise exception 'shadow_fence_lost' using errcode='40001';end if;\n  if r.lease_expires_at<=clock_timestamp() or l.lease_expires_at<=clock_timestamp() then\n    raise exception 'shadow_lease_expired' using errcode='55000';end if;\n  select * into s from collect_security.shadow_supervisor_samples where run_id=r.id;\n  if s.id is not null then\n    perform collect_security.shadow_run_json(r.id);\n    perform collect_security.require_shadow_health(s.body->'system_health',r.started_at,clock_timestamp());\n    return jsonb_build_object('contract_version',1,'mode','shadow','scope','collect_platform',\n      'ok',true,'outcome','sampled','replayed',true,'run_id',r.id,'fence_version',r.fence_version,\n      'sample',s.body||jsonb_build_object('sample_id',s.id,'content_sha256',s.content_sha256));\n  end if;\n  health:=public.admin_system_health('system');\n  t:=clock_timestamp();\n  perform collect_security.require_shadow_health(health,r.started_at,t);\n  -- Same aggregate semantics as the assisted operator's health, without its\n  -- service-only identity wrapper, full destinations, bodies or receipt IDs.\n  select jsonb_build_object('enabled',coalesce((select enabled from public.feature_flags\n    where key='hybrid_sms_notifications'),false),\n    'queued',count(*) filter(where state='queued'),\n    'awaiting_confirmation',count(*) filter(where state='awaiting_confirmation'),\n    'send_started',count(*) filter(where state='send_started'),\n    'uncertain',count(*) filter(where state='uncertain'),\n    'suppressed',count(*) filter(where state='suppressed'),\n    'oldest_queued_at',min(created_at) filter(where state='queued'),\n    'active_workers',(select count(*) from collect_hybrid.sms_operator_heartbeats\n      where observed_at>t-interval '3 minutes'),'observed_at',t)\n  into sms from collect_hybrid.sms_notification_outbox;\n  select jsonb_build_object('ok',count(*) filter(where a->>'state'='ok'),\n    'unknown',count(*) filter(where a->>'state'='unknown'),\n    'attention',count(*) filter(where a->>'state'='attention'),\n    'not_applicable',count(*) filter(where a->>'state'='not_applicable'))\n  into counts from jsonb_array_elements(health->'alerts') a;\n  summary:=jsonb_build_object('health_status',case when health->>'health_status'='attention'\n    or (sms->>'uncertain')::bigint>0 or (sms->>'send_started')::bigint>0 then 'attention'\n    else health->>'health_status' end,'alert_counts',counts,\n    'sms_queue',sms-array['oldest_queued_at','observed_at'],\n    'checks_recorded',13,'samples_recorded',1,'business_mutations',0,'provider_sends',0);\n  t:=clock_timestamp();\n  if r.lease_expires_at<=t or l.lease_expires_at<=t then\n    raise exception 'shadow_lease_expired' using errcode='55000';end if;\n  perform collect_security.require_shadow_health(health,r.started_at,t);\n  body:=jsonb_build_object('checked_at',t,'system_health',health,'sms_queue',sms,'summary',summary);\n  insert into collect_security.shadow_supervisor_samples(run_id,checked_at,body,content_sha256)\n  values(r.id,t,body,encode(extensions.digest(convert_to(body::text,'UTF8'),'sha256'),'hex'))\n  returning * into s;\n  return jsonb_build_object('contract_version',1,'mode','shadow','scope','collect_platform',\n    'ok',true,'outcome','sampled','replayed',false,'run_id',r.id,'fence_version',r.fence_version,\n    'sample',s.body||jsonb_build_object('sample_id',s.id,'content_sha256',s.content_sha256));\nend $function$\n", "oid": "21851", "owner": "16384", "config": ["search_path=\"\"", "TimeZone=UTC"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.finish_collect_shadow_run_v1(p_run_id uuid, p_fence_version bigint)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET \"TimeZone\" TO 'UTC'\nAS $function$\ndeclare sid uuid; l collect_security.shadow_supervisor_lease;\n  r collect_security.shadow_supervisor_runs; s collect_security.shadow_supervisor_samples; t timestamptz;\nbegin\n  sid:=collect_security.require_shadow_actor();\n  if p_run_id is null or p_fence_version is null or p_fence_version not between 1 and 1000000000 then\n    raise exception 'shadow_request_invalid' using errcode='22023';end if;\n  select * into l from collect_security.shadow_supervisor_lease where id for update;\n  select * into r from collect_security.shadow_supervisor_runs where id=p_run_id for update;\n  if r.id is null or r.actor_id is distinct from auth.uid() or r.session_id is distinct from sid then\n    raise exception 'shadow_run_unavailable' using errcode='42501';end if;\n  if r.fence_version<>p_fence_version then raise exception 'shadow_fence_lost' using errcode='40001';end if;\n  if r.status='completed' then\n    return jsonb_build_object('contract_version',1,'mode','shadow','scope','collect_platform',\n      'ok',true,'outcome','completed','replayed',true,'run',collect_security.shadow_run_json(r.id));\n  end if;\n  if l.active_run_id is distinct from r.id or l.fence_version<>p_fence_version or r.status<>'running' then\n    raise exception 'shadow_fence_lost' using errcode='40001';end if;\n  t:=clock_timestamp();\n  if r.lease_expires_at<=t or l.lease_expires_at<=t then\n    raise exception 'shadow_lease_expired' using errcode='55000';end if;\n  select * into s from collect_security.shadow_supervisor_samples where run_id=r.id;\n  if s.id is null then\n    raise exception 'shadow_sample_required' using errcode='55000';end if;\n  perform collect_security.shadow_run_json(r.id);\n  perform collect_security.require_shadow_health(s.body->'system_health',r.started_at,t);\n  update collect_security.shadow_supervisor_runs set status='completed',completed_at=t where id=r.id;\n  update collect_security.shadow_supervisor_lease set active_run_id=null,lease_expires_at=null where id;\n  return jsonb_build_object('contract_version',1,'mode','shadow','scope','collect_platform',\n    'ok',true,'outcome','completed','replayed',false,'run',collect_security.shadow_run_json(r.id));\nend $function$\n", "oid": "21853", "owner": "16384", "config": ["search_path=\"\"", "TimeZone=UTC"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.get_collect_shadow_run_v1(p_request_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET \"TimeZone\" TO 'UTC'\nAS $function$\ndeclare r collect_security.shadow_supervisor_runs;\nbegin\n  perform collect_security.require_shadow_actor();\n  if p_request_id is null then raise exception 'shadow_request_invalid' using errcode='22023';end if;\n  -- Read-only reconciliation after normal reauthentication never resumes the\n  -- previous session's lease. Only the original actor sees this request lookup.\n  select * into r from collect_security.shadow_supervisor_runs\n    where request_id=p_request_id and actor_id=auth.uid();\n  return jsonb_build_object('contract_version',1,'mode','shadow','scope','collect_platform',\n    'found',r.id is not null,'run',collect_security.shadow_run_json(r.id));\nend $function$\n", "oid": "21854", "owner": "16384", "config": ["search_path=\"\"", "TimeZone=UTC"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.list_collect_shadow_runs_v1(p_limit integer DEFAULT 20, p_before_started_at timestamp with time zone DEFAULT NULL::timestamp with time zone, p_before_run_id uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET \"TimeZone\" TO 'UTC'\nAS $function$\ndeclare l collect_security.shadow_supervisor_lease; t timestamptz;\n  rows jsonb; cursor jsonb; more boolean; total bigint;\nbegin\n  perform collect_security.require_shadow_actor();\n  if p_limit is null or p_limit not between 1 and 50\n    or (p_before_started_at is null)<>(p_before_run_id is null)\n    or p_before_started_at is not null and not isfinite(p_before_started_at) then\n    raise exception 'shadow_request_invalid' using errcode='22023';end if;\n  select * into l from collect_security.shadow_supervisor_lease where id for share;\n  if l.id is null then raise exception 'shadow_integrity_unavailable' using errcode='55000';end if;\n  t:=clock_timestamp();\n  select count(*) into total from collect_security.shadow_supervisor_runs;\n  with candidates as materialized (\n    select id,started_at from collect_security.shadow_supervisor_runs\n    where p_before_started_at is null or (started_at,id)<(p_before_started_at,p_before_run_id)\n    order by started_at desc,id desc limit p_limit+1\n  ), page as materialized (\n    select * from candidates order by started_at desc,id desc limit p_limit\n  ) select coalesce((select jsonb_agg(collect_security.shadow_run_json(id,t)\n      order by started_at desc,id desc) from page),'[]'::jsonb),\n    (select count(*)>p_limit from candidates),\n    (select jsonb_build_object('started_at',started_at,'run_id',id)\n      from page order by started_at,id limit 1)\n  into rows,more,cursor;\n  return jsonb_build_object('contract_version',1,'mode','shadow','scope','collect_platform',\n    'checked_at',t,'lease',jsonb_build_object('state',case when l.active_run_id is null\n      then 'idle' when l.lease_expires_at<=t then 'expired' else 'active' end,\n      'fence_version',l.fence_version,'active_run_id',l.active_run_id,'lease_expires_at',l.lease_expires_at),\n    'rows',rows,'total',total,'next_cursor',case when more then cursor else null end);\nend $function$\n", "oid": "21855", "owner": "16384", "config": ["search_path=\"\"", "TimeZone=UTC"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_enroll_gateway_device_v1(p_request_id uuid, p_installation_id uuid, p_public_key_spki_base64 text, p_key_sha256 text, p_signing_certificate_sha256 text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare actor uuid;der bytea;i jsonb;r jsonb;d uuid;t timestamptz;\n x numeric:=0;y numeric:=0;point_byte integer;\n prime numeric:=115792089210356248762697446949407573530086143415290314195533631308867097853951;\n curve_b numeric:=41058363725152142129326129780047268409114441015993725554835256314039467401291;\nbegin\n actor:=collect_gateway.owner_actor();\n if p_request_id is null or p_installation_id is null or p_key_sha256 is null or p_key_sha256 !~ '^[0-9a-f]{64}$'\n  or p_signing_certificate_sha256 is null or p_signing_certificate_sha256 !~ '^[0-9a-f]{64}$'\n  or p_public_key_spki_base64 is null or p_public_key_spki_base64 !~ '^[A-Za-z0-9+/]{122}==$' then\n  raise exception 'gateway_enrollment_invalid' using errcode='22023';end if;\n der:=decode(p_public_key_spki_base64,'base64');\n if octet_length(der)<>91 or encode(substring(der from 1 for 27),'hex')<>'3059301306072a8648ce3d020106082a8648ce3d03010703420004'\n  or replace(encode(der,'base64'),E'\\n','')<>p_public_key_spki_base64\n  or encode(extensions.digest(der,'sha256'),'hex')<>p_key_sha256 then\n  raise exception 'gateway_enrollment_invalid' using errcode='22023';end if;\n for point_byte in 0..31 loop\n  x:=x*256+get_byte(der,27+point_byte);y:=y*256+get_byte(der,59+point_byte);\n end loop;\n if x>=prime or y>=prime or mod(y*y-(x*x*x-3*x+curve_b),prime)<>0 then\n  raise exception 'gateway_enrollment_invalid' using errcode='22023';end if;\n -- DER, SHA and the actual P-256 curve point are checked here. Recent key\n -- possession still depends on the separately verified Edge signature.\n i:=jsonb_build_array(p_installation_id,p_public_key_spki_base64,p_key_sha256,p_signing_certificate_sha256);\n r:=collect_gateway.owner_replay(actor,p_request_id,'enroll',i);if r is not null then return r;end if;\n if exists(select 1 from collect_gateway.devices where installation_id=p_installation_id or key_sha256=p_key_sha256) then\n  raise exception 'gateway_installation_already_enrolled' using errcode='22023';end if;\n t:=clock_timestamp();\n insert into collect_gateway.devices(enrollment_request_id,owner_actor_id,owner_session_id,installation_id,public_key_spki_base64,key_sha256,signing_certificate_sha256,created_at)\n values(p_request_id,actor,(auth.jwt()->>'session_id')::uuid,p_installation_id,p_public_key_spki_base64,p_key_sha256,p_signing_certificate_sha256,t) returning id into d;\n r:=jsonb_build_object('device_id',d,'request_id',p_request_id,'state_at_action','pending','recorded_at',collect_gateway.utc(t),'replay',false);\n insert into collect_gateway.admin_requests(request_id,actor_id,action,input,result,recorded_at) values(p_request_id,actor,'enroll',i,r,t);\n return r;\nend$function$\n", "oid": "22003", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_activate_gateway_device_v1(p_device_id uuid, p_request_id uuid, p_expected_key_sha256 text, p_expected_signing_certificate_sha256 text)\n RETURNS jsonb\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select collect_gateway.change_device(p_device_id,p_request_id,p_expected_key_sha256,p_expected_signing_certificate_sha256,'activate')$function$\n", "oid": "22005", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_revoke_gateway_device_v1(p_device_id uuid, p_request_id uuid, p_expected_key_sha256 text, p_expected_signing_certificate_sha256 text)\n RETURNS jsonb\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select collect_gateway.change_device(p_device_id,p_request_id,p_expected_key_sha256,p_expected_signing_certificate_sha256,'revoke')$function$\n", "oid": "22006", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.gateway_device_key_v1(p_device_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare d collect_gateway.devices;begin\n if auth.role() is distinct from 'service_role' then raise exception 'gateway_service_required' using errcode='42501';end if;\n select * into d from collect_gateway.devices where id=p_device_id;\n if d.id is null then raise exception 'gateway_device_not_found' using errcode='22023';end if;\n return jsonb_build_object('device_id',d.id,'state',d.state,'public_key_spki_base64',d.public_key_spki_base64,'key_sha256',d.key_sha256,'installation_id',d.installation_id,'signing_certificate_sha256',d.signing_certificate_sha256);\nend$function$\n", "oid": "22007", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.gateway_heartbeat_v1(p_device_id uuid, p_request_id uuid, p_request_sha256 text, p_payload jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare d collect_gateway.devices;r jsonb;t timestamptz;observed timestamptz;h uuid;\nbegin\n perform collect_gateway.require_service(p_device_id,p_request_id,p_request_sha256);\n perform collect_gateway.payload_keys(p_payload,array['sms_permission','network','telephony','sim_selected','sim_revision_sha256','local_pause','reported_at']);\n if jsonb_typeof(p_payload->'sms_permission') is distinct from 'boolean'\n  or jsonb_typeof(p_payload->'sim_selected') is distinct from 'boolean'\n  or jsonb_typeof(p_payload->'local_pause') is distinct from 'boolean'\n  or coalesce(p_payload->>'network','') not in('validated','unvalidated','offline','unknown')\n  or coalesce(p_payload->>'telephony','') not in('ready','unavailable','unknown')\n  or ((p_payload->>'sim_selected')::boolean and (jsonb_typeof(p_payload->'sim_revision_sha256') is distinct from 'string' or coalesce(p_payload->>'sim_revision_sha256','') !~ '^[0-9a-f]{64}$'))\n  or (not(p_payload->>'sim_selected')::boolean and jsonb_typeof(p_payload->'sim_revision_sha256') is distinct from 'null') then\n  raise exception 'gateway_payload_invalid' using errcode='22023';end if;\n observed:=collect_gateway.payload_time(p_payload,'reported_at');\n select * into d from collect_gateway.devices where id=p_device_id for update;\n if d.id is null then raise exception 'gateway_device_not_found' using errcode='22023';end if;\n if d.state='revoked' then raise exception 'gateway_device_revoked' using errcode='42501';end if;\n r:=collect_gateway.replay(d.id,p_request_id,'heartbeat',p_request_sha256,p_payload);if r is not null then return r;end if;\n t:=clock_timestamp();if observed<t-interval '120 seconds' or observed>t+interval '30 seconds' then\n  raise exception 'gateway_report_time_invalid' using errcode='22023';end if;\n h:=gen_random_uuid();r:=jsonb_build_object('observation_id',h,'ingested_at',collect_gateway.utc(t),'replay',false,'carrier_proof',false);\n insert into collect_gateway.requests(request_id,device_id,action,request_sha256,payload,result,recorded_at) values(p_request_id,d.id,'heartbeat',p_request_sha256,p_payload,r,t);\n insert into collect_gateway.health_observations(id,device_id,request_id,reported_at,ingested_at,sms_permission,network,telephony,sim_selected,sim_revision_sha256,local_pause)\n values(h,d.id,p_request_id,observed,t,(p_payload->>'sms_permission')::boolean,p_payload->>'network',p_payload->>'telephony',(p_payload->>'sim_selected')::boolean,p_payload->>'sim_revision_sha256',(p_payload->>'local_pause')::boolean);\n return r;\nend$function$\n", "oid": "22008", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.gateway_reconcile_v1(p_device_id uuid, p_request_id uuid, p_request_sha256 text, p_payload jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare target uuid;r collect_gateway.requests;begin\n perform collect_gateway.require_service(p_device_id,p_request_id,p_request_sha256);\n perform collect_gateway.payload_keys(p_payload,array['target_request_id']);target:=collect_gateway.payload_uuid(p_payload,'target_request_id');\n if not exists(select 1 from collect_gateway.devices where id=p_device_id) then raise exception 'gateway_device_not_found' using errcode='22023';end if;\n select * into r from collect_gateway.requests where device_id=p_device_id and request_id=target;\n return jsonb_build_object('target_request_id',target,'outcome',case when r.request_id is null then 'unknown' else 'recorded' end,'recorded_action',r.action,'recorded_result',r.result);\nend$function$\n", "oid": "22009", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.gateway_dispatch_grant_v1(p_device_id uuid, p_request_id uuid, p_request_sha256 text, p_payload jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare d collect_gateway.devices;r jsonb;t timestamptz;begin\n perform collect_gateway.require_service(p_device_id,p_request_id,p_request_sha256);\n perform collect_gateway.payload_keys(p_payload,array[]::text[]);\n select * into d from collect_gateway.devices where id=p_device_id for update;\n if d.id is null then raise exception 'gateway_device_not_found' using errcode='22023';end if;\n if d.state='revoked' then raise exception 'gateway_device_revoked' using errcode='42501';end if;\n r:=collect_gateway.replay(d.id,p_request_id,'dispatch_grant',p_request_sha256,p_payload);if r is not null then return r;end if;\n t:=clock_timestamp();r:=jsonb_build_object('ok',false,'code','GATEWAY_DISPATCH_AUTHORITY_PENDING','device_id',d.id,'request_id',p_request_id,'replay',false);\n insert into collect_gateway.requests(request_id,device_id,action,request_sha256,payload,result,recorded_at) values(p_request_id,d.id,'dispatch_grant',p_request_sha256,p_payload,r,t);\n return r;\nend$function$\n", "oid": "22010", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.gateway_callback_v1(p_device_id uuid, p_request_id uuid, p_request_sha256 text, p_payload jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare d collect_gateway.devices;r jsonb;arm collect_gateway.dispatch_arms;cb uuid;attempt uuid;\n fence integer;idx integer;segments integer;rc integer;tp integer;t timestamptz;occurred timestamptz;\nbegin\n perform collect_gateway.require_service(p_device_id,p_request_id,p_request_sha256);\n perform collect_gateway.payload_keys(p_payload,array['callback_id','attempt_id','fence_version','segment_index','segment_count','body_sha256','destination_sha256','callback_kind','result_code','tp_status','occurred_at']);\n cb:=collect_gateway.payload_uuid(p_payload,'callback_id');attempt:=collect_gateway.payload_uuid(p_payload,'attempt_id');\n if cb=p_request_id then raise exception 'gateway_callback_id_invalid' using errcode='22023';end if;\n fence:=collect_gateway.payload_int(p_payload,'fence_version',1,1000000000);\n idx:=collect_gateway.payload_int(p_payload,'segment_index',0,9);segments:=collect_gateway.payload_int(p_payload,'segment_count',1,10);\n rc:=collect_gateway.payload_int(p_payload,'result_code',-1,200);\n if jsonb_typeof(p_payload->'tp_status') is distinct from 'null' then tp:=collect_gateway.payload_int(p_payload,'tp_status',0,255);end if;\n if jsonb_typeof(p_payload->'body_sha256') is distinct from 'string' or coalesce(p_payload->>'body_sha256','') !~ '^[0-9a-f]{64}$'\n  or jsonb_typeof(p_payload->'destination_sha256') is distinct from 'string' or coalesce(p_payload->>'destination_sha256','') !~ '^[0-9a-f]{64}$'\n  or coalesce(p_payload->>'callback_kind','') not in('sent','delivery') then raise exception 'gateway_payload_invalid' using errcode='22023';end if;\n occurred:=collect_gateway.payload_time(p_payload,'occurred_at');\n select * into d from collect_gateway.devices where id=p_device_id for update;\n if d.id is null then raise exception 'gateway_device_not_found' using errcode='22023';end if;\n r:=collect_gateway.replay(d.id,p_request_id,'callback',p_request_sha256,p_payload);if r is not null then return r;end if;\n select * into arm from collect_gateway.dispatch_arms where device_id=d.id and attempt_id=attempt for share;\n if arm.id is null or arm.fence_version<>fence or arm.body_sha256<>p_payload->>'body_sha256'\n  or arm.destination_sha256<>p_payload->>'destination_sha256' or arm.segment_count<>segments or idx>=segments then\n  raise exception 'gateway_prior_arm_required' using errcode='42501';end if;\n t:=clock_timestamp();if occurred<arm.armed_at-interval '120 seconds' or occurred>t+interval '30 seconds' then raise exception 'gateway_callback_time_invalid' using errcode='22023';end if;\n if exists(select 1 from collect_gateway.segment_callbacks where callback_id=cb or (arm_id=arm.id and segment_index=idx and callback_kind=p_payload->>'callback_kind')) then\n  raise exception 'gateway_callback_conflict' using errcode='22023';end if;\n r:=jsonb_build_object('callback_id',cb,'recorded_at',collect_gateway.utc(t),'replay',false,'carrier_proof',false);\n insert into collect_gateway.requests(request_id,device_id,action,request_sha256,payload,result,recorded_at) values(p_request_id,d.id,'callback',p_request_sha256,p_payload,r,t);\n insert into collect_gateway.segment_callbacks(callback_id,request_id,arm_id,device_id,segment_index,callback_kind,result_code,tp_status,occurred_at,recorded_at)\n values(cb,p_request_id,arm.id,d.id,idx,p_payload->>'callback_kind',rc,tp,occurred,t);\n return r;\nend$function$\n", "oid": "22011", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.bootstrap_collect_email_operator_v1(p_user_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare target auth.users;role_id_value uuid;begin\n if auth.role() is distinct from 'service_role' then\n  raise exception 'email_enrollment_service_required' using errcode='42501';end if;\n perform public._lock_notification_session_gate();\n perform pg_advisory_xact_lock(hashtext('collect_admin_combined_roster'));\n select * into target from auth.users where id=p_user_id for update;\n if target.id is null or lower(btrim(target.email)) is distinct from 'info@ikanisa.com'\n  or target.deleted_at is not null or coalesce(target.is_anonymous,false)\n  or (target.banned_until is not null and target.banned_until>clock_timestamp())\n  or not exists(select 1 from public.profiles where id=p_user_id) then\n  raise exception 'email_enrollment_target_invalid' using errcode='22023';end if;\n if exists(select 1 from collect_admin_access.email_approvals where user_id=p_user_id\n  and (revoked_at is not null or email<>'info@ikanisa.com')) then\n  raise exception 'email_enrollment_previously_revoked' using errcode='42501';end if;\n select id into role_id_value from public.admin_roles where name='platform_owner';\n if role_id_value is null then raise exception 'email_role_unavailable' using errcode='55000';end if;\n insert into collect_admin_access.email_approvals(user_id,email,reason)\n  values(p_user_id,'info@ikanisa.com','Owner-directed operator email migration') on conflict(user_id) do nothing;\n if not exists(select 1 from public.admin_user_roles where user_id=p_user_id and role_id=role_id_value and revoked_at is null) then\n  if exists(select 1 from public.admin_user_roles where user_id=p_user_id and revoked_at is not null) then\n   raise exception 'email_enrollment_previously_revoked' using errcode='42501';end if;\n  insert into public.admin_user_roles(user_id,role_id,reason)\n   values(p_user_id,role_id_value,'Owner-directed operator email migration');\n end if;\n return jsonb_build_object('ok',true,'user_id',p_user_id,'email_verified',target.email_confirmed_at is not null,\n  'fresh_email_sign_in_required',true,'auth_mode',(select mode from collect_admin_access.operator_auth_policy where id));\nend $function$\n", "oid": "22039", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_set_operator_email_mode_v1(p_reason text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid;current_mode text;begin\n sid:=public._lock_notification_registration_session();\n perform collect_hybrid.require_roster_actor_authority(auth.uid(),sid,'platform_owner',array['admin_users.manage']);\n if not collect_admin_access.email_identity(auth.uid()) or length(collect_admin_access.normalized_operator_reason(p_reason)) not between 8 and 500 then\n  raise exception 'current_email_operator_required' using errcode='42501';end if;\n select mode into current_mode from collect_admin_access.operator_auth_policy where id for update;\n if current_mode<>'email' then\n  update collect_admin_access.operator_auth_policy set mode='email',revision=revision+1,updated_at=clock_timestamp() where id;\n  insert into public.audit_logs(actor_user_id,action,entity_type,metadata)\n   values(auth.uid(),'admin.auth.email_cutover','operator_auth_policy',jsonb_build_object('reason',collect_admin_access.normalized_operator_reason(p_reason)));\n end if;\n return jsonb_build_object('ok',true,'mode','email','replay',current_mode='email');\nend $function$\n", "oid": "22040", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_revoke_email_operator_v1(p_user_id uuid, p_reason text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid;changed boolean;begin\n sid:=public._lock_notification_registration_session();\n perform collect_hybrid.require_roster_actor_authority(auth.uid(),sid,'platform_owner',array['admin_users.manage']);\n if p_user_id is null or p_user_id=auth.uid() or length(collect_admin_access.normalized_operator_reason(p_reason)) not between 8 and 500 then\n  raise exception 'email_revoke_invalid' using errcode='22023';end if;\n perform 1 from collect_admin_access.email_approvals where user_id=p_user_id for update;\n if not found then raise exception 'operator_email_approval_unavailable' using errcode='22023';end if;\n update collect_admin_access.email_approvals set revoked_at=clock_timestamp(),revoked_by=auth.uid()\n  where user_id=p_user_id and revoked_at is null;\n changed:=found;\n if changed then insert into public.audit_logs(actor_user_id,action,entity_type,entity_id,metadata)\n  values(auth.uid(),'admin.email.revoked','profile',p_user_id,jsonb_build_object('reason',collect_admin_access.normalized_operator_reason(p_reason)));end if;\n return jsonb_build_object('ok',true,'status','revoked','user_id',p_user_id);\nend $function$\n", "oid": "22041", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_operator_approval_v1(p_user_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid;target auth.users;e collect_admin_access.email_approvals;w collect_admin_access.whatsapp_approvals;\n state jsonb;provider text;status_value text;mode_value text;masked text;\nbegin\n sid:=public._lock_notification_registration_session();\n perform collect_hybrid.require_roster_actor_authority(auth.uid(),sid,'platform_owner',array['admin_users.read']);\n select * into target from auth.users where id=p_user_id for share;\n if target.id is null or not exists(select 1 from public.profiles where id=p_user_id) then\n  raise exception 'operator_account_unavailable' using errcode='22023';end if;\n select * into e from collect_admin_access.email_approvals where user_id=p_user_id for share;\n select * into w from collect_admin_access.whatsapp_approvals where user_id=p_user_id for share;\n select mode into mode_value from collect_admin_access.operator_auth_policy where id;\n state:=collect_admin_access.account_state(p_user_id);status_value:=state->>'status';\n if e.user_id is not null or (w.user_id is null and nullif(btrim(target.email),'') is not null) then\n  provider:='email';\n  masked:=case when nullif(btrim(target.email),'') is not null then left(lower(btrim(target.email)),1)||'***@***' end;\n  if e.user_id is not null and e.revoked_at is null and (e.expires_at is null or e.expires_at>clock_timestamp())\n   and target.email_confirmed_at is null and lower(btrim(target.email))=e.email then status_value:='pending_verification';end if;\n elsif w.user_id is not null then\n  provider:='whatsapp';masked:=state->>'phone_masked';\n  if mode_value='email' and status_value='identity_changed' then status_value:='legacy_disabled';end if;\n else provider:='unapproved';masked:=null;end if;\n return jsonb_build_object('contract_version',1,'user_id',p_user_id,'provider',provider,'mode',mode_value,\n  'identity_masked',masked,'approved_at',state->'approved_at','expires_at',state->'expires_at',\n  'status',status_value,'approved',state->'approved','role_granted',state->'role_granted',\n  'admin_access',state->'admin_access','access_status',state->'access_status');\nend $function$\n", "oid": "22042", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_approve_email_operator_v1(p_user_id uuid, p_email text, p_reason text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid;target auth.users;normalized text:=lower(btrim(p_email));\nbegin\n sid:=public._lock_notification_registration_session();\n perform collect_hybrid.require_roster_actor_authority(auth.uid(),sid,'platform_owner',array['admin_users.manage']);\n if p_user_id is null or p_user_id=auth.uid() or length(collect_admin_access.normalized_operator_reason(p_reason)) not between 8 and 500\n  or normalized is null or length(normalized) not between 3 and 254\n  or normalized !~ '^[^[:space:]@]+@[^[:space:]@]+\\.[^[:space:]@]+$' then\n  raise exception 'operator_email_approval_invalid' using errcode='22023';end if;\n select * into target from auth.users where id=p_user_id for update;\n if target.id is null or target.deleted_at is not null or coalesce(target.is_anonymous,false)\n  or (target.banned_until is not null and target.banned_until>clock_timestamp())\n  or target.email_confirmed_at is null or lower(btrim(target.email)) is distinct from normalized\n  or not exists(select 1 from public.profiles where id=p_user_id) then\n  raise exception 'operator_verified_email_required' using errcode='42501';end if;\n if exists(select 1 from collect_admin_access.email_approvals where user_id=p_user_id\n  and email=normalized and revoked_at is null and (expires_at is null or expires_at>clock_timestamp())) then\n  return jsonb_build_object('ok',true,'status','approved','user_id',p_user_id);end if;\n insert into collect_admin_access.email_approvals(user_id,email,approved_by,reason)\n  values(p_user_id,normalized,auth.uid(),collect_admin_access.normalized_operator_reason(p_reason)) on conflict(user_id) do update\n  set email=excluded.email,approved_at=clock_timestamp(),approved_by=excluded.approved_by,reason=excluded.reason,\n   revoked_at=null,revoked_by=null,expires_at=null;\n insert into public.audit_logs(actor_user_id,action,entity_type,entity_id,metadata)\n  values(auth.uid(),'admin.email.approved','profile',p_user_id,jsonb_build_object('reason',collect_admin_access.normalized_operator_reason(p_reason)));\n return jsonb_build_object('ok',true,'status','approved','user_id',p_user_id);\nend $function$\n", "oid": "22043", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.rotate_group_share_code_v2(p_collection_id uuid, p_request_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid; receipt collect_member_actions.group_share_rotations; code uuid;\nbegin\n  if p_request_id is null then raise exception 'group_share_request_invalid' using errcode='22023';end if;\n  sid:=collect_member_actions.require_group_share_actor(p_collection_id,true);\n  select * into receipt from collect_member_actions.group_share_rotations where request_id=p_request_id;\n  if receipt.request_id is not null then\n    if receipt.actor_id is distinct from auth.uid() or receipt.collection_id is distinct from p_collection_id then\n      raise exception 'group_share_request_conflict' using errcode='40001';end if;\n    select share_code into code from public.collection_share_secrets where collection_id=p_collection_id for share;\n    if code is distinct from receipt.share_code then\n      raise exception 'group_share_rotation_superseded' using errcode='55000';end if;\n    return jsonb_build_object('contract_version',1,'ok',true,'collection_id',receipt.collection_id,\n      'request_id',receipt.request_id,'share_code',receipt.share_code);\n  end if;\n  -- The locked parent serializes this count and its subsequent receipt insert.\n  -- Established snapshots also lock the actual secret row before rotating it.\n  perform 1 from public.collection_share_secrets where collection_id=p_collection_id for update;\n  if (select count(*) from collect_member_actions.group_share_rotations\n      where collection_id=p_collection_id and created_at>clock_timestamp()-interval '1 hour')>=60 then\n    raise exception 'group_share_rate_limited' using errcode='55000';end if;\n  insert into public.collection_share_secrets(collection_id,share_code,rotated_at,rotated_by)\n    values(p_collection_id,gen_random_uuid(),clock_timestamp(),auth.uid())\n    on conflict(collection_id) do update set share_code=excluded.share_code,\n      rotated_at=excluded.rotated_at,rotated_by=excluded.rotated_by\n    returning share_code into code;\n  begin\n    insert into collect_member_actions.group_share_rotations(request_id,collection_id,actor_id,session_id,share_code)\n      values(p_request_id,p_collection_id,auth.uid(),sid,code);\n  exception when unique_violation then\n    raise exception 'group_share_request_conflict' using errcode='40001';end;\n  perform public.create_audit_log('group.share_link_rotated','collection',p_collection_id,\n    jsonb_build_object('request_id',p_request_id,'rotated_at',clock_timestamp()));\n  return jsonb_build_object('contract_version',1,'ok',true,'collection_id',p_collection_id,\n    'request_id',p_request_id,'share_code',code);\nend$function$\n", "oid": "22058", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.guard_receipt_event_evidence()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin raise exception 'receipt_event_evidence_immutable' using errcode='55000';end $function$\n", "oid": "22144", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.emit_receipt_business_event(p_source_kind text, p_source_id uuid, p_kind text, p_collection uuid, p_payment uuid, p_member uuid, p_snapshot uuid, p_outbox uuid, p_state text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare v bigint; signature jsonb;\nbegin\n  signature:=jsonb_build_array(p_kind,p_collection,p_payment,p_member,p_snapshot,p_outbox,p_state);\n  -- A physical row update serializes concurrent transitions. Its version is\n  -- source-local identity only, never a commit-order watermark.\n  insert into collect_hybrid.receipt_business_event_heads(source_kind,source_id,version,signature)\n    values(p_source_kind,p_source_id,1,signature)\n  on conflict(source_kind,source_id) do update\n    set version=receipt_business_event_heads.version+1,signature=excluded.signature\n    where receipt_business_event_heads.signature is distinct from excluded.signature\n  returning version into v;\n  if v is null then return;end if;\n  insert into collect_hybrid.receipt_business_events(source_kind,source_id,source_version,event_kind,\n    collection_id,payment_id,member_record_id,snapshot_id,outbox_id,source_state)\n    values(p_source_kind,p_source_id,v,p_kind,p_collection,p_payment,p_member,p_snapshot,p_outbox,p_state);\nend $function$\n", "oid": "22149", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.capture_receipt_payment_event()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  if new.status in ('posted','reversed') and (tg_op='INSERT' or new.status is distinct from old.status) then\n    perform collect_hybrid.emit_receipt_business_event('payment',new.id,\n      case when new.status='posted' then 'payment_posted' else 'payment_reversed' end,\n      new.collection_id,new.id,new.member_record_id,null,null,new.status);\n  end if;\n  return new;\nend $function$\n", "oid": "22150", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.capture_receipt_allocation_event()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  if tg_op='INSERT' or new.allocation_status is distinct from old.allocation_status\n    or new.collection_id is distinct from old.collection_id then\n    perform collect_hybrid.emit_receipt_business_event('allocation',new.id,'allocation_changed',\n      new.collection_id,null,null,null,null,new.allocation_status::text);\n  end if;\n  return new;\nend $function$\n", "oid": "22152", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.capture_receipt_outbox_event()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare kind text;\nbegin\n  if tg_op='INSERT' then kind:='receipt_created';\n  elsif new.state is distinct from old.state and new.state in ('failed_no_send','uncertain','suppressed') then\n    kind:='receipt_'||new.state;\n  else return new;end if;\n  perform collect_hybrid.emit_receipt_business_event('receipt',new.id,kind,new.collection_id,\n    new.payment_id,new.member_record_id,new.snapshot_id,new.id,new.state);\n  return new;\nend $function$\n", "oid": "22154", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.require_receipt_dispatch_enabled()\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare enabled boolean;\nbegin\n  select f.enabled into enabled from public.feature_flags f\n    where f.key='hybrid_sms_notifications' for share;\n  if enabled is distinct from true then\n    raise exception 'receipt_dispatch_paused' using errcode='55000';end if;\nend $function$\n", "oid": "22156", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.guard_receipt_dispatch_transition()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare job collect_hybrid.sms_notification_outbox;begin\n if tg_table_name='sms_notification_attempts'then\n  perform collect_hybrid.require_receipt_dispatch_enabled();\n  select * into job from collect_hybrid.sms_notification_outbox where id=new.outbox_id;\n  if job.template_version is distinct from 2 then raise exception 'CONTENT_POLICY_REVIEW_REQUIRED'using errcode='55000';end if;\n  if not collect_hybrid.sms_receipt_job_is_current(job.id)then raise exception 'receipt_content_authority_invalid'using errcode='55000';end if;\n elsif new.state in('awaiting_confirmation','send_started')and(tg_op='INSERT'or new.state is distinct from old.state)then\n  perform collect_hybrid.require_receipt_dispatch_enabled();\n  if new.template_version is distinct from 2 then raise exception 'CONTENT_POLICY_REVIEW_REQUIRED'using errcode='55000';end if;\n  if not collect_hybrid.sms_receipt_job_is_current(new.id)then raise exception 'receipt_content_authority_invalid'using errcode='55000';end if;\n end if;return new;end$function$\n", "oid": "22157", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.require_receipt_monitor_actor()\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid;\nbegin\n  sid:=public._lock_notification_registration_session();\n  perform pg_advisory_xact_lock(hashtext('collect_admin_combined_roster'));\n  perform collect_hybrid.require_roster_actor_authority(auth.uid(),sid,'platform_owner',\n    array['system_health.read','notifications.read']);\n  return sid;\nend $function$\n", "oid": "22160", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.require_receipt_monitor_consumer(p_consumer_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  if p_consumer_id is null or not exists(select 1 from collect_hybrid.receipt_monitor_consumers\n    where id=p_consumer_id and actor_id=auth.uid() and scope='collect_platform') then\n    raise exception 'receipt_consumer_scope_denied' using errcode='42501';end if;\nend $function$\n", "oid": "22161", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.register_receipt_monitor_consumer_v1()\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET \"TimeZone\" TO 'UTC'\nAS $function$\ndeclare sid uuid; c collect_hybrid.receipt_monitor_consumers;\nbegin\n  sid:=collect_hybrid.require_receipt_monitor_actor();\n  insert into collect_hybrid.receipt_monitor_consumers(actor_id,created_session_id)\n    values(auth.uid(),sid) on conflict(actor_id) do nothing;\n  select * into c from collect_hybrid.receipt_monitor_consumers where actor_id=auth.uid();\n  return jsonb_build_object('contract_version',1,'consumer_id',c.id,'scope',c.scope,\n    'purpose',c.purpose,'created_at',c.created_at);\nend $function$\n", "oid": "22162", "owner": "16384", "config": ["search_path=\"\"", "TimeZone=UTC"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.list_receipt_monitor_events_v1(p_consumer_id uuid, p_limit integer DEFAULT 20, p_skip_event_ids uuid[] DEFAULT '{}'::uuid[])\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET \"TimeZone\" TO 'UTC'\nAS $function$\ndeclare rows jsonb;\nbegin\n  perform collect_hybrid.require_receipt_monitor_actor();\n  perform collect_hybrid.require_receipt_monitor_consumer(p_consumer_id);\n  if p_limit is null or p_limit not between 1 and 50 or p_skip_event_ids is null\n    or cardinality(p_skip_event_ids)>50 or array_position(p_skip_event_ids,null) is not null then\n    raise exception 'receipt_monitor_request_invalid' using errcode='22023';end if;\n  -- Every invocation rescans committed unobserved UUIDs. Skip IDs are an\n  -- ephemeral bounded batch aid, never persisted progress or an ACK.\n  select coalesce(jsonb_agg(to_jsonb(e) order by e.created_at,e.id),'[]'::jsonb) into rows from (\n    select event.* from collect_hybrid.receipt_business_events event\n    where not(event.id=any(p_skip_event_ids)) and not exists(\n      select 1 from collect_hybrid.receipt_monitor_observed_events observed\n      where observed.consumer_id=p_consumer_id and observed.event_id=event.id)\n    order by event.created_at,event.id limit p_limit\n  ) e;\n  return jsonb_build_object('contract_version',1,'consumer_id',p_consumer_id,\n    'scope','collect_platform','checked_at',clock_timestamp(),'rows',rows,\n    'limit',p_limit,'progress','per_event_observation','delivery_evidence',false);\nend $function$\n", "oid": "22163", "owner": "16384", "config": ["search_path=\"\"", "TimeZone=UTC"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.ack_receipt_monitor_event_v1(p_consumer_id uuid, p_event_id uuid, p_request_id uuid, p_outcome text, p_reason_code text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET \"TimeZone\" TO 'UTC'\nAS $function$\ndeclare sid uuid; a collect_hybrid.receipt_monitor_acknowledgements; terminal boolean;\nbegin\n  sid:=collect_hybrid.require_receipt_monitor_actor();\n  perform collect_hybrid.require_receipt_monitor_consumer(p_consumer_id);\n  if p_request_id is null or p_event_id is null or p_outcome is null\n    or p_outcome not in ('observed','deferred') or p_reason_code is null\n    or p_reason_code not in ('monitoring_only','review_required','policy_pending','dispatch_paused','source_changed') then\n    raise exception 'receipt_monitor_request_invalid' using errcode='22023';end if;\n  perform pg_advisory_xact_lock(hashtextextended('receipt-monitor-ack:'||p_request_id::text,0));\n  select * into a from collect_hybrid.receipt_monitor_acknowledgements where request_id=p_request_id;\n  if a.request_id is not null then\n    if a.actor_id<>auth.uid() or a.consumer_id<>p_consumer_id or a.event_id<>p_event_id\n      or a.outcome<>p_outcome or a.reason_code<>p_reason_code then\n      raise exception 'receipt_monitor_request_conflict' using errcode='22023';end if;\n  else\n    if not exists(select 1 from collect_hybrid.receipt_business_events where id=p_event_id) then\n      raise exception 'receipt_event_not_found' using errcode='22023';end if;\n    insert into collect_hybrid.receipt_monitor_acknowledgements(request_id,consumer_id,event_id,\n      actor_id,session_id,outcome,reason_code)\n      values(p_request_id,p_consumer_id,p_event_id,auth.uid(),sid,p_outcome,p_reason_code) returning * into a;\n    if p_outcome='observed' then\n      insert into collect_hybrid.receipt_monitor_observed_events(consumer_id,event_id,acknowledgement_id)\n        values(p_consumer_id,p_event_id,p_request_id) on conflict(consumer_id,event_id) do nothing;\n    end if;\n  end if;\n  terminal:=exists(select 1 from collect_hybrid.receipt_monitor_observed_events\n    where consumer_id=p_consumer_id and event_id=p_event_id);\n  return jsonb_build_object('contract_version',1,'consumer_id',p_consumer_id,'event_id',p_event_id,\n    'request_id',p_request_id,'outcome',a.outcome,'reason_code',a.reason_code,\n    'acknowledged_at',a.acknowledged_at,'pending',not terminal,'business_handled',false,'delivery_evidence',false);\nend $function$\n", "oid": "22164", "owner": "16384", "config": ["search_path=\"\"", "TimeZone=UTC"]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.receipt_backlog_preview_row(p_snapshot uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET \"TimeZone\" TO 'UTC'\nAS $function$\ndeclare s collect_hybrid.momo_balance_snapshots; p public.payments; m collect_hybrid.member_records;\n  i collect_hybrid.member_momo_identities; policy collect_hybrid.sms_receipt_policies;\n  consent collect_hybrid.sms_receipt_member_consents; code text; body jsonb;\nbegin\n  select * into s from collect_hybrid.momo_balance_snapshots where id=p_snapshot and event_type='receipt';\n  if s.id is null then return null;end if;\n  select * into p from public.payments where id=s.payment_id;\n  select * into m from collect_hybrid.member_records where id=s.member_record_id;\n  select * into i from collect_hybrid.member_momo_identities where member_id=s.member_record_id;\n  select * into policy from collect_hybrid.sms_receipt_policies where collection_id=s.collection_id;\n  select * into consent from collect_hybrid.sms_receipt_member_consents where member_record_id=s.member_record_id;\n  code:=case when s.member_record_id is null or s.member_balance_after_rwf is null then 'MEMBER_SNAPSHOT_MISSING'\n    when p.status is distinct from 'posted' then 'PAYMENT_NOT_POSTED'\n    when m.lifecycle is distinct from 'active' then 'MEMBER_INACTIVE'\n    when m.linked_user_id is not null then 'APP_LINKED_MEMBER'\n    when policy.enabled is distinct from true then 'POLICY_DISABLED'\n    when i.member_id is null then 'IDENTITY_MISSING'\n    when consent.enabled is distinct from true then 'CONSENT_DISABLED'\n    when coalesce(btrim(p.transaction_id),'') !~ '^[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$' then 'UNSAFE_REFERENCE'\n    else 'CURRENTLY_ELIGIBLE_HISTORY_UNPROVEN' end;\n  body:=jsonb_build_object('snapshot_id',s.id,'payment_id',s.payment_id,'collection_id',s.collection_id,\n    'member_record_id',s.member_record_id,'captured_at',s.captured_at,'payment_status',p.status,\n    'eligibility_code',code,'policy_revision',policy.revision,'consent_revision',consent.revision,\n    'destination_revision',i.revision,'catch_up','policy_pending');\n  return body||jsonb_build_object('review_version',encode(extensions.digest(convert_to(body::text,'UTF8'),'sha256'),'hex'));\nend $function$\n", "oid": "22165", "owner": "16384", "config": ["search_path=\"\"", "TimeZone=UTC"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_preview_receipt_backlog_v1(p_limit integer DEFAULT 20, p_before_captured_at timestamp with time zone DEFAULT NULL::timestamp with time zone, p_before_snapshot_id uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET \"TimeZone\" TO 'UTC'\nAS $function$\ndeclare rows jsonb; last_row jsonb; more boolean;\nbegin\n  perform collect_hybrid.require_receipt_monitor_actor();\n  if p_limit is null or p_limit not between 1 and 50\n    or ((p_before_captured_at is null)<>(p_before_snapshot_id is null))\n    or (p_before_captured_at is not null and not isfinite(p_before_captured_at)) then\n    raise exception 'receipt_monitor_request_invalid' using errcode='22023';end if;\n  select coalesce(jsonb_agg(collect_hybrid.receipt_backlog_preview_row(s.id) order by s.captured_at desc,s.id desc),'[]'::jsonb)\n    into rows from (select snapshot.* from collect_hybrid.momo_balance_snapshots snapshot\n      where snapshot.event_type='receipt' and not exists(select 1 from collect_hybrid.sms_notification_outbox o\n        where o.payment_id=snapshot.payment_id and o.template_key='buri_munsi.payment_received')\n      and (p_before_captured_at is null or (snapshot.captured_at,snapshot.id)<(p_before_captured_at,p_before_snapshot_id))\n      order by snapshot.captured_at desc,snapshot.id desc limit p_limit+1) s;\n  more:=jsonb_array_length(rows)>p_limit;\n  if more then rows:=rows-(jsonb_array_length(rows)-1);end if;\n  last_row:=rows->(jsonb_array_length(rows)-1);\n  return jsonb_build_object('contract_version',1,'checked_at',clock_timestamp(),'scope','collect_platform',\n    'catch_up','policy_pending','historical_enqueue_enabled',false,'rows',rows,'limit',p_limit,\n    'next_cursor',case when more then jsonb_build_object('captured_at',last_row->'captured_at','snapshot_id',last_row->'snapshot_id') else null end);\nend $function$\n", "oid": "22166", "owner": "16384", "config": ["search_path=\"\"", "TimeZone=UTC"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_reconcile_receipt_backlog_v1(p_request_id uuid, p_snapshot_ids uuid[], p_review_versions text[])\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  perform collect_hybrid.require_receipt_monitor_actor();\n  if p_request_id is null or p_snapshot_ids is null or p_review_versions is null\n    or cardinality(p_snapshot_ids) not between 1 and 25\n    or cardinality(p_review_versions)<>cardinality(p_snapshot_ids)\n    or array_position(p_snapshot_ids,null) is not null\n    or exists(select 1 from unnest(p_review_versions) v where v is null or v !~ '^[a-f0-9]{64}$') then\n    raise exception 'receipt_monitor_request_invalid' using errcode='22023';end if;\n  -- Historical consent/contact snapshots cannot be reconstructed from current\n  -- revisions. No approved policy exists: refuse without enqueue or mutation.\n  return jsonb_build_object('contract_version',1,'ok',false,'code','CATCHUP_POLICY_PENDING',\n    'request_id',p_request_id,'queued',0,'historical_enqueue_enabled',false);\nend $function$\n", "oid": "22167", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_hybrid.admin_overview_authorized(p_actor uuid, p_session uuid, p_permission text)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  perform collect_hybrid.require_roster_actor_authority(\n    p_actor,p_session,'platform_owner',array[p_permission]);\n  return public.has_admin_permission(p_permission,p_actor);\nexception when sqlstate '42501' then return false;\nend $function$\n", "oid": "22169", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_receipt_overview_v1(p_country text DEFAULT 'RW'::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET \"TimeZone\" TO 'UTC'\nAS $function$\ndeclare session_id uuid; t timestamptz; day_start timestamptz; day_end timestamptz;\n  posted jsonb; receipts jsonb; receipt_access boolean;\nbegin\n  session_id:=public._lock_notification_registration_session();\n  perform pg_advisory_xact_lock(hashtext('collect_admin_combined_roster'));\n  if not collect_hybrid.admin_overview_authorized(auth.uid(),session_id,'overview.read') then\n    raise exception 'overview_permission_required' using errcode='42501';\n  end if;\n  if coalesce(upper(btrim(p_country)),'RW')<>'RW' then\n    raise exception 'overview_country_invalid' using errcode='22023';\n  end if;\n  receipt_access:=collect_hybrid.admin_overview_authorized(auth.uid(),session_id,'notifications.read');\n  t:=clock_timestamp();\n  day_start:=date_trunc('day',t at time zone 'Africa/Kigali') at time zone 'Africa/Kigali';\n  day_end:=day_start+interval '24 hours';\n  -- public.payments is the canonical Rwanda RWF posting source. Reversed\n  -- payments are excluded; this is currently-posted value, not gross turnover,\n  -- a wallet balance or bank/diaspora rail aggregation.\n  -- Both subqueries use the same SQL statement snapshot. The read timestamp\n  -- is captured after evaluation; crossing midnight fails closed for refresh.\n  select\n    (select jsonb_build_object('count',count(*),\n      'value_rwf',coalesce(sum(p.amount_rwf),0)::text)\n     from public.payments p where p.status='posted' and p.currency='RWF'\n       and p.provider_network in ('mtn_momo','airtel_money')\n       and p.posted_at>=day_start and p.posted_at<day_end and p.posted_at<=t),\n    case when receipt_access then\n      (select jsonb_build_object('queued',count(*) filter(where state='queued'),\n        'awaiting_confirmation',count(*) filter(where state='awaiting_confirmation'),\n        'oldest_pending_at',min(created_at) filter(where state in ('queued','awaiting_confirmation')),\n        'failed_no_send',count(*) filter(where state='failed_no_send'),\n        'uncertain',count(*) filter(where state='uncertain'),\n        'send_started',count(*) filter(where state='send_started'))\n       from collect_hybrid.sms_notification_outbox)\n      else null end into posted,receipts;\n  t:=clock_timestamp();\n  if t>=day_end then\n    raise exception 'overview_day_changed' using errcode='40001';\n  end if;\n  return jsonb_build_object('contract_version',1,'scope','rwanda_momo','country_code','RW',\n    'timezone','Africa/Kigali','checked_at',t,'sample_valid_until',t+interval '60 seconds',\n    'day_start',day_start,'day_end',day_end,'posted',posted,\n    'receipts_state',case when receipt_access then 'available' else 'denied' end,\n    'receipts',receipts);\nend $function$\n", "oid": "22170", "owner": "16384", "config": ["search_path=\"\"", "TimeZone=UTC"]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.transaction_read_authority(p_permission text)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid;\nbegin\n if p_permission not in ('payments.read','notifications.read') or p_permission is null then\n  raise exception 'transaction_permission_invalid' using errcode='22023';end if;\n sid:=public._lock_notification_registration_session();\n perform pg_advisory_xact_lock(hashtext('collect_admin_combined_roster'));\n -- Match installed Admin authority: approved current platform_owner only.\n -- Lock Auth, approval, grant, role and permission proof rows against revoke.\n begin\n  perform collect_hybrid.require_roster_actor_authority(auth.uid(),sid,\n   'platform_owner',array[p_permission]);\n  return true;\n exception when sqlstate '42501' then return false;end;\nend $function$\n", "oid": "22172", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.rwanda_sms_scope(p_sms_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select exists(\n  select 1 from public.raw_payment_sms sms\n  left join public.parsed_payment_events e on e.raw_sms_id=sms.id\n  where sms.id=p_sms_id\n   and (e.id is null or (e.is_mobile_money_payment and e.currency='RWF'\n    and e.network in ('mtn_momo','airtel_money') and e.direction='incoming'\n    and e.receiver_user_id=sms.receiver_user_id\n    and (e.receiver_phone_hash is null or e.receiver_phone_hash=sms.receiver_momo_number_hash)))\n   and (exists(select 1 from public.collection_receivers r\n     where r.collection_id=sms.collection_id and r.receiver_user_id=sms.receiver_user_id\n      and r.momo_number_hash=sms.receiver_momo_number_hash\n      and (e.id is null or e.network=r.network)\n      and ((r.network='mtn_momo' and r.momo_number ~ '^(\\+250|0)7[89][0-9]{7}$')\n       or (r.network='airtel_money' and r.momo_number ~ '^(\\+250|0)7[23][0-9]{7}$')))\n    or exists(select 1 from public.profiles profile where profile.id=sms.receiver_user_id\n     and profile.country_code='RW' and profile.currency_code='RWF'\n     and profile.momo_number_verified_at is not null\n     and profile.momo_number_hash=sms.receiver_momo_number_hash\n     and (e.id is null or e.network=profile.momo_provider)\n     and ((profile.momo_provider='mtn_momo' and profile.momo_number ~ '^(\\+250|0)7[89][0-9]{7}$')\n      or (profile.momo_provider='airtel_money' and profile.momo_number ~ '^(\\+250|0)7[23][0-9]{7}$'))))\n )\n$function$\n", "oid": "22173", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_security.transaction_lifecycle(p_sms_id uuid, p_notifications boolean)\n RETURNS jsonb\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n with evidence as (\n  select sms.id,sms.parse_status,e.allocation_status,p.id payment_id,p.status,\n   p.amount_rwf,p.collection_id,p.member_record_id,\n   pc.id confirmation_id,pr.payment_id rejection_id,\n   pc.amount_rwf confirmation_amount,pc.provider_network confirmation_network,\n   p.provider_network,pc.transaction_id confirmation_reference,p.transaction_id,\n   exists(select 1 from collect_hybrid.momo_journal_entries j\n    join collect_hybrid.momo_balance_snapshots s on s.journal_entry_id=j.id\n    where j.payment_id=p.id and j.entry_type='receipt' and j.amount_rwf=p.amount_rwf\n     and j.collection_id=p.collection_id and j.member_record_id is not distinct from p.member_record_id\n     and s.payment_id=p.id and s.collection_id=p.collection_id\n     and s.member_record_id is not distinct from p.member_record_id\n     and s.event_type='receipt' and s.delta_rwf=p.amount_rwf\n     and (select count(*)=2 and count(*) filter(where\n      (l.account_code='momo_receiving_asset:RWF' and l.direction='debit') or\n      (l.account_code='member_savings_liability:RWF' and l.direction='credit'))=2\n      and min(l.amount_rwf)=p.amount_rwf and max(l.amount_rwf)=p.amount_rwf\n      from collect_hybrid.momo_journal_lines l where l.journal_entry_id=j.id)) receipt_posted,\n   exists(select 1 from collect_hybrid.momo_journal_entries j\n    join collect_hybrid.momo_balance_snapshots s on s.journal_entry_id=j.id\n    where j.payment_id=p.id and j.entry_type='reversal' and j.amount_rwf=p.amount_rwf\n     and j.collection_id=p.collection_id and j.member_record_id is not distinct from p.member_record_id\n     and s.payment_id=p.id and s.collection_id=p.collection_id\n     and s.member_record_id is not distinct from p.member_record_id\n     and s.event_type='reversal' and s.delta_rwf=-p.amount_rwf\n     and (select count(*)=2 and count(*) filter(where\n      (l.account_code='momo_receiving_asset:RWF' and l.direction='credit') or\n      (l.account_code='member_savings_liability:RWF' and l.direction='debit'))=2\n      and min(l.amount_rwf)=p.amount_rwf and max(l.amount_rwf)=p.amount_rwf\n      from collect_hybrid.momo_journal_lines l where l.journal_entry_id=j.id)) reversal_posted,\n   case when p_notifications then (select o.state from collect_hybrid.sms_notification_outbox o\n    where o.payment_id=p.id and o.template_key='buri_munsi.payment_received') else null end notification\n  from public.raw_payment_sms sms\n  left join public.parsed_payment_events e on e.raw_sms_id=sms.id\n  left join public.payments p on p.parsed_event_id=e.id\n  left join public.payment_provider_confirmations pc on pc.payment_id=p.id\n  left join collect_hybrid.payment_provider_rejections pr on pr.payment_id=p.id\n  where sms.id=p_sms_id\n ) select jsonb_build_object('contract_version',1,\n  'verification',case\n   when confirmation_id is not null and (rejection_id is not null or confirmation_amount<>amount_rwf\n    or confirmation_network is distinct from provider_network\n    or upper(btrim(confirmation_reference)) is distinct from upper(btrim(transaction_id))) then 'evidence_conflict'\n   when rejection_id is not null then 'rejection_recorded'\n   when confirmation_id is not null then 'confirmation_recorded' else 'pending' end,\n  'allocation',coalesce(allocation_status::text,case parse_status\n   when 'pending' then 'pending_parse' when 'failed' then 'parse_failed' else 'unavailable' end),\n  'ledger',case when status='reversed' and receipt_posted and reversal_posted then 'reversed'\n   when status='posted' and receipt_posted and not reversal_posted then 'posted'\n   when status in ('posted','reversed') or receipt_posted or reversal_posted then 'evidence_missing'\n   else 'not_posted' end,\n  'notification',case when not p_notifications then 'access_required'\n   else coalesce(notification,'not_created') end,\n  'evidence_limit','confirmation_record_is_not_external_settlement_proof') from evidence\n$function$\n", "oid": "22174", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_collect_investigation_v1(p_kind text, p_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET \"TimeZone\" TO 'UTC'\nAS $function$\ndeclare payment_access boolean; receipt_access boolean; result jsonb; checked timestamptz;\nbegin\n if p_kind is null or p_kind not in ('transaction','receipt') or p_id is null then\n  raise exception 'investigation_target_invalid' using errcode='22023';end if;\n payment_access:=collect_security.transaction_read_authority('payments.read');\n receipt_access:=collect_security.transaction_read_authority('notifications.read');\n if (p_kind='transaction' and not payment_access) or (p_kind='receipt' and not receipt_access) then\n  raise exception 'investigation_permission_required' using errcode='42501';end if;\n\n -- Every section shares one statement snapshot. checked_at is captured after\n -- this read; it is measurement time, never a substituted business timestamp.\n with target as (\n  select sms.id sms_id,e.id event_id,p.id payment_id,\n   coalesce(p.collection_id,e.collection_id,sms.collection_id) collection_id,\n   p.member_record_id,o.id outbox_id,\n   collect_security.rwanda_sms_scope(sms.id) supported\n  from public.raw_payment_sms sms\n  left join public.parsed_payment_events e on e.raw_sms_id=sms.id\n  left join public.payments p on p.parsed_event_id=e.id\n  left join collect_hybrid.sms_notification_outbox o on o.payment_id=p.id\n   and o.template_key='buri_munsi.payment_received'\n  where p_kind='transaction' and sms.id=p_id\n  union all\n  select sms.id,e.id,p.id,o.collection_id,o.member_record_id,o.id,\n   coalesce(collect_security.rwanda_sms_scope(sms.id),false)\n  from collect_hybrid.sms_notification_outbox o\n  join public.payments p on p.id=o.payment_id\n  left join public.parsed_payment_events e on e.id=p.parsed_event_id\n  left join public.raw_payment_sms sms on sms.id=e.raw_sms_id\n  where p_kind='receipt' and o.id=p_id\n ), payment_section as (\n  select jsonb_build_object(\n   'payment_id',t.payment_id,'raw_sms_id',t.sms_id,'event_id',t.event_id,\n   'collection_id',t.collection_id,'member_record_id',t.member_record_id,\n   'lifecycle',case when t.sms_id is not null then\n    collect_security.transaction_lifecycle(t.sms_id,receipt_access) else null end,\n   'times',jsonb_build_object('received_at_device',sms.received_at_device,\n    'ingested_at',sms.ingested_at,'parsed_recorded_at',e.created_at,\n    'allocation_recorded_at',a.created_at,'provider_confirmed_at',pc.confirmed_at,\n    'confirmation_recorded_at',pc.recorded_at,'rejection_occurred_at',pr.occurred_at,\n    'rejection_recorded_at',pr.recorded_at,\n    'payment_posted_at',case when p.status in ('posted','reversed') then p.posted_at else null end),\n   'journals',coalesce((select jsonb_agg(jsonb_build_object(\n    'id',j.id,'entry_type',j.entry_type,'amount_rwf',j.amount_rwf::text,'posted_at',j.posted_at,\n    'snapshot',case when s.id is null then null else jsonb_build_object(\n     'id',s.id,'captured_at',s.captured_at,'delta_rwf',s.delta_rwf::text,\n     'member_balance_rwf',s.member_balance_after_rwf::text,\n     'group_balance_rwf',s.group_balance_after_rwf::text) end)\n    order by j.posted_at,j.id) from collect_hybrid.momo_journal_entries j\n    left join collect_hybrid.momo_balance_snapshots s on s.journal_entry_id=j.id\n    where j.payment_id=t.payment_id),'[]'::jsonb),\n   'current_balances',jsonb_build_object(\n    'member_rwf',mb.confirmed_rwf::text,'member_updated_at',mb.updated_at,\n    'group_rwf',gb.confirmed_rwf::text,'group_updated_at',gb.updated_at)) value\n  from target t left join public.raw_payment_sms sms on sms.id=t.sms_id\n  left join public.parsed_payment_events e on e.id=t.event_id\n  left join public.payments p on p.id=t.payment_id\n  left join public.payment_allocations a on a.payment_id=t.payment_id\n   and a.parsed_event_id=t.event_id\n  left join public.payment_provider_confirmations pc on pc.payment_id=t.payment_id\n  left join collect_hybrid.payment_provider_rejections pr on pr.payment_id=t.payment_id\n  left join collect_hybrid.member_balances mb on mb.collection_id=t.collection_id\n   and mb.member_record_id=t.member_record_id\n  left join collect_hybrid.collection_balances gb on gb.collection_id=t.collection_id\n  where payment_access and t.supported\n ), receipt_section as (\n  select jsonb_build_object('id',o.id,'payment_id',o.payment_id,'snapshot_id',o.snapshot_id,\n   'collection_id',o.collection_id,'member_record_id',o.member_record_id,'state',o.state,\n   'template_key',o.template_key,'template_version',o.template_version,\n   'created_at',o.created_at,'updated_at',o.updated_at,'observed_sent_at',o.observed_sent_at,\n   'masked_destination','+250•••'||right(o.destination_e164,3),\n   'amount_rwf',o.amount_rwf::text,'member_balance_rwf',o.member_balance_rwf::text,\n   'group_balance_rwf',o.group_balance_rwf::text,\n   'snapshot_captured_at',s.captured_at,\n   'preview_source',case when s.id is not null then 'immutable_posting_snapshot' else 'snapshot_unavailable' end,\n   'masked_snapshot_preview',case when s.id is not null then\n    collect_receipt_policy.render_snapshot(s,o.template_version,'snapshot-'||right(s.id::text,8),collect_receipt_policy.language_for_job(o)) else null end,\n   'approvals',coalesce((select jsonb_agg(jsonb_build_object('id',c.id,\n    'approved_at',c.approved_at,'expires_at',c.expires_at,'consumed_at',c.consumed_at)\n    order by c.approved_at desc,c.id desc) from (select *\n     from collect_hybrid.sms_notification_confirmations where outbox_id=o.id\n     order by approved_at desc,id desc limit 50)c),'[]'::jsonb),\n   'approval_total',(select count(*) from collect_hybrid.sms_notification_confirmations where outbox_id=o.id),\n   'attempts',coalesce((select jsonb_agg(jsonb_build_object('id',a.id,\n    'attempt_number',a.attempt_number,'state',a.state,'send_started_at',a.send_started_at,\n    'outcome_at',a.outcome_at) order by a.attempt_number desc) from\n     (select * from collect_hybrid.sms_notification_attempts where outbox_id=o.id\n      order by attempt_number desc limit 50)a),'[]'::jsonb),\n   'attempt_total',(select count(*) from collect_hybrid.sms_notification_attempts where outbox_id=o.id)) value\n  from target t join collect_hybrid.sms_notification_outbox o on o.id=t.outbox_id\n  -- Reconstruction is allowed only from the matching immutable receipt snapshot.\n  left join collect_hybrid.momo_balance_snapshots s on s.id=o.snapshot_id\n   and s.payment_id=o.payment_id and s.collection_id=o.collection_id\n   and s.member_record_id=o.member_record_id and s.event_type='receipt'\n   and s.delta_rwf=o.amount_rwf and s.member_balance_after_rwf=o.member_balance_rwf\n   and s.group_balance_after_rwf=o.group_balance_rwf\n   and exists(select 1 from collect_hybrid.momo_journal_entries j\n    where j.id=s.journal_entry_id and j.payment_id=o.payment_id\n     and j.collection_id=o.collection_id and j.member_record_id=o.member_record_id\n     and j.entry_type='receipt' and j.amount_rwf=o.amount_rwf)\n  where receipt_access and t.supported\n ) select jsonb_build_object(\n  'contract_version',1,'scope',case when exists(select 1 from target where supported)\n   then 'rwanda_momo' else 'unclassified' end,'kind',p_kind,'target_id',p_id,'history_limit',50,\n  'payment_state',case when not payment_access then 'denied'\n   when not exists(select 1 from target) then 'missing'\n   when not exists(select 1 from target where supported) then 'unsupported' else 'available' end,\n  'payment',(select value from payment_section limit 1),\n  'receipt_state',case when not receipt_access then 'denied'\n   when exists(select 1 from target) and not exists(select 1 from target where supported) then 'unsupported'\n   when exists(select 1 from receipt_section) then 'available' else 'missing' end,\n  'receipt',(select value from receipt_section limit 1)) into result;\n checked:=clock_timestamp();\n return result||jsonb_build_object('checked_at',checked,'sample_valid_until',checked+interval '60 seconds');\nend $function$\n", "oid": "22179", "owner": "16384", "config": ["search_path=\"\"", "TimeZone=UTC"]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.refresh_operational_exception_sources_v1(p_source_kind text, p_source_ids uuid[])\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare source uuid;\nbegin\n if auth.role() is distinct from 'service_role' then raise exception 'operational_exception_service_required' using errcode='42501';end if;\n if current_setting('transaction_isolation')<>'read committed' then\n  raise exception 'operational_exception_snapshot_retry' using errcode='40001';end if;\n if p_source_kind is null or p_source_kind not in('raw_sms','allocation','payment','receipt','gateway')\n  or p_source_ids is null or cardinality(p_source_ids) not between 1 and 25\n  or array_position(p_source_ids,null) is not null\n  or(select count(distinct id) from unnest(p_source_ids) id)<>cardinality(p_source_ids) then\n  raise exception 'operational_exception_source_invalid' using errcode='22023';end if;\n for source in select ids.id from unnest(p_source_ids)as ids(id)order by ids.id loop\n  perform collect_ops.refresh_source(p_source_kind,source);end loop;\n return jsonb_build_object('contract_version',1,'source_kind',p_source_kind,'checked',cardinality(p_source_ids),\n  'financial_action',false,'send_action',false);\nend$function$\n", "oid": "22270", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_list_operational_exceptions_v1(p_active boolean DEFAULT true, p_limit integer DEFAULT 20, p_before_changed_at timestamp with time zone DEFAULT NULL::timestamp with time zone, p_before_id uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare rows jsonb;last jsonb;more boolean;\nbegin\n perform collect_ops.actor(false);\n if p_active is null or p_limit is null or p_limit not between 1 and 50\n  or((p_before_changed_at is null)<>(p_before_id is null))\n  or(p_before_changed_at is not null and not isfinite(p_before_changed_at)) then\n  raise exception 'operational_exception_query_invalid' using errcode='22023';end if;\n select coalesce(jsonb_agg(jsonb_build_object('id',e.id,'source_kind',e.source_kind,'source_id',e.source_id,\n  'reason_code',e.reason_code,'active',e.active,'revision',e.revision,'source_sha256',e.source_sha256,\n  'first_observed_at',collect_ops.utc(e.first_observed_at),'last_changed_at',collect_ops.utc(e.last_changed_at),\n  'acknowledged',exists(select 1 from collect_ops.exception_actions a where a.exception_id=e.id and a.expected_revision=e.revision and a.action='acknowledge'),\n  'escalation_requested',exists(select 1 from collect_ops.exception_actions a where a.exception_id=e.id and a.expected_revision=e.revision and a.action='escalate'))\n  order by e.last_changed_at desc,e.id desc),'[]'::jsonb) into rows\n from(select * from collect_ops.exceptions where active=p_active and\n  (p_before_changed_at is null or(last_changed_at,id)<(p_before_changed_at,p_before_id))\n  order by last_changed_at desc,id desc limit p_limit+1)e;\n more:=jsonb_array_length(rows)>p_limit;if more then rows:=rows-(jsonb_array_length(rows)-1);end if;\n last:=rows->(jsonb_array_length(rows)-1);\n return jsonb_build_object('contract_version',1,'checked_at',collect_ops.utc(clock_timestamp()),\n  'rows',rows,'active',p_active,'limit',p_limit,\n  'next_cursor',case when more then jsonb_build_object('changed_at',last->'last_changed_at','id',last->'id')else null end,\n  'escalation_delivery_verified',false,'source_scan_complete',false);\nend$function$\n", "oid": "22271", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_act_operational_exception_v1(p_request_id uuid, p_exception_id uuid, p_expected_revision bigint, p_action text, p_reason_code text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid;prior collect_ops.exception_actions;item collect_ops.exceptions;at timestamptz;result jsonb;\nbegin\n sid:=collect_ops.actor(true);\n if p_request_id is null or p_exception_id is null or p_expected_revision is null or p_expected_revision not between 1 and 1000000000\n  or p_action is null or p_action not in('acknowledge','escalate') or p_reason_code is null\n  or p_reason_code not in('review_started','owner_review_required','uncertain_send_review','contact_review') then\n  raise exception 'operational_exception_action_invalid' using errcode='22023';end if;\n perform pg_advisory_xact_lock(hashtextextended('collect-ops-action:'||p_request_id::text,0));\n select * into prior from collect_ops.exception_actions where request_id=p_request_id;\n if prior.request_id is not null then\n  if prior.actor_id<>auth.uid() or prior.exception_id<>p_exception_id or prior.expected_revision<>p_expected_revision\n   or prior.action<>p_action or prior.reason_code<>p_reason_code then\n   raise exception 'operational_exception_request_conflict' using errcode='22023';end if;\n  return prior.result;\n end if;\n select * into item from collect_ops.exceptions where id=p_exception_id;\n if item.id is null then raise exception 'operational_exception_unavailable' using errcode='22023';end if;\n -- Re-check the actual source before recording review. This may update only\n -- derived operational evidence; it cannot clear or retry a financial/send source.\n perform collect_ops.refresh_source(item.source_kind,item.source_id);\n select * into item from collect_ops.exceptions where id=p_exception_id for share;\n if not item.active or item.revision<>p_expected_revision then raise exception 'operational_exception_source_changed' using errcode='55000';end if;\n at:=clock_timestamp();result:=jsonb_build_object('contract_version',1,'request_id',p_request_id,'exception_id',item.id,\n  'revision',item.revision,'action',p_action,'recorded_at',collect_ops.utc(at),'source_resolved',false,\n  'financial_action',false,'send_action',false,'escalation_delivery_verified',false);\n insert into collect_ops.exception_actions(request_id,exception_id,expected_revision,action,reason_code,actor_id,session_id,recorded_at,result)\n  values(p_request_id,item.id,item.revision,p_action,p_reason_code,auth.uid(),sid,at,result);\n perform public.create_audit_log('operations.exception.'||p_action,'operational_exception',item.id,\n  jsonb_build_object('request_id',p_request_id,'revision',item.revision,'reason_code',p_reason_code,\n   'financial_action',false,'send_action',false),null);\n return result;\nend$function$\n", "oid": "22272", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_operational_exception_action_v1(p_request_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare prior collect_ops.exception_actions;\nbegin\n perform collect_ops.actor(false);\n if p_request_id is null then raise exception 'operational_exception_action_invalid' using errcode='22023';end if;\n if not pg_try_advisory_xact_lock(hashtextextended('collect-ops-action:'||p_request_id::text,0))then\n  return jsonb_build_object('contract_version',1,'request_id',p_request_id,'status','in_progress','receipt',null);end if;\n select * into prior from collect_ops.exception_actions where request_id=p_request_id and actor_id=auth.uid();\n return jsonb_build_object('contract_version',1,'request_id',p_request_id,\n  'status',case when prior.request_id is null then 'not_recorded' else 'recorded' end,'receipt',prior.result);\nend$function$\n", "oid": "22273", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_list_gateway_devices_v1(p_limit integer DEFAULT 20, p_before_enrolled_at timestamp with time zone DEFAULT NULL::timestamp with time zone, p_before_device_id uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare result jsonb;\nbegin\n perform collect_gateway.read_actor();\n if p_limit is null or p_limit not between 1 and 50\n  or ((p_before_enrolled_at is null)<>(p_before_device_id is null))\n  or (p_before_enrolled_at is not null and not isfinite(p_before_enrolled_at)) then\n  raise exception 'gateway_read_query_invalid' using errcode='22023';end if;\n -- One Read Committed statement sees a coherent committed source snapshot.\n -- Capture its clock inside that statement, after its snapshot is acquired;\n -- a concurrently committed heartbeat/action cannot be newer than this clock\n -- yet visible in only one of the separate projections.\n with read_time as materialized(select clock_timestamp() checked_at),\n candidates as materialized(\n  select d.* from collect_gateway.devices d\n  where p_before_enrolled_at is null or (d.created_at,d.id)<(p_before_enrolled_at,p_before_device_id)\n  order by d.created_at desc,d.id desc limit p_limit+1\n ),page as materialized(select * from candidates order by created_at desc,id desc limit p_limit),\n projected as (\n  select d.created_at,d.id,\n   collect_gateway.public_identity(d::collect_gateway.devices)||jsonb_build_object(\n    'state',d.state,'enrolled_at',collect_gateway.utc(d.created_at),\n    'activated_at',collect_gateway.utc(d.activated_at),'revoked_at',collect_gateway.utc(d.revoked_at),\n    'dispatch_authority','pending','dispatch_available',false,\n    'health',case when h.id is null then null else jsonb_build_object(\n     'observation_id',h.id,'reported_at',collect_gateway.utc(h.reported_at),\n     'ingested_at',collect_gateway.utc(h.ingested_at),\n     'observation_valid_until',collect_gateway.utc(least(h.reported_at,h.ingested_at)+interval '120 seconds'),\n     'freshness',case when t.checked_at<least(h.reported_at,h.ingested_at)+interval '120 seconds'\n       then 'fresh' else 'stale' end,\n     'sms_permission',h.sms_permission,'network',h.network,'telephony',h.telephony,\n     'sim_selected',h.sim_selected,'local_pause',h.local_pause,'carrier_proof',false) end,\n    'callback_observations',jsonb_build_object('total',collect_gateway.read_count(cb.total),\n     'sent',collect_gateway.read_count(cb.sent),'delivery',collect_gateway.read_count(cb.delivery)),\n    'last_owner_action',case when a.request_id is null then null else\n     jsonb_build_object('action',a.action,'receipt',collect_gateway.public_owner_receipt(a.result)) end) value\n  from page d cross join read_time t\n  left join lateral(select o.* from collect_gateway.health_observations o where o.device_id=d.id\n    order by o.ingested_at desc,o.id desc limit 1)h on true\n  left join lateral(select r.action,r.request_id,r.result from collect_gateway.admin_requests r\n    where r.result->>'device_id'=d.id::text order by r.recorded_at desc,r.request_id desc limit 1)a on true\n  cross join lateral(select count(*) total,count(*) filter(where c.callback_kind='sent')sent,\n    count(*) filter(where c.callback_kind='delivery')delivery\n    from collect_gateway.segment_callbacks c where c.device_id=d.id)cb\n )\n select jsonb_build_object('contract_version',1,'scope','platform_global',\n  'checked_at',collect_gateway.utc(t.checked_at),\n  'sample_valid_until',collect_gateway.utc(t.checked_at+interval '60 seconds'),\n  'limit',p_limit,'total',collect_gateway.read_count((select count(*) from collect_gateway.devices)),\n  'next_cursor',case when (select count(*) from candidates)>p_limit then\n   (select jsonb_build_object('enrolled_at',collect_gateway.utc(p.created_at),'device_id',p.id)\n    from page p order by p.created_at,p.id limit 1) else null end,\n  'rows',coalesce((select jsonb_agg(p.value order by p.created_at desc,p.id desc)from projected p),'[]'::jsonb))\n into result from read_time t;\n return result;\nend$function$\n", "oid": "22283", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_gateway_owner_request_v1(p_request_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare actor uuid;result jsonb;\nbegin\n actor:=collect_gateway.read_actor();\n if p_request_id is null then raise exception 'gateway_owner_request_invalid' using errcode='22023';end if;\n -- Original-actor reconciliation only. An absent or other-actor request is\n -- unknown, never an instruction to retry an uncertain mutation. Identity\n -- fields are public immutable pairing data; original key bytes stay private.\n with read_time as materialized(select clock_timestamp() checked_at),\n evidence as materialized(\n  select r.action,r.result,d.* from collect_gateway.admin_requests r\n  join collect_gateway.devices d on r.result->>'device_id'=d.id::text\n  where r.request_id=p_request_id and r.actor_id=actor\n )\n select jsonb_build_object('contract_version',1,'scope','platform_global',\n  'checked_at',collect_gateway.utc(t.checked_at),\n  'sample_valid_until',collect_gateway.utc(t.checked_at+interval '60 seconds'),\n  'request_id',p_request_id,'outcome',case when e.id is null then 'unknown' else 'recorded' end,\n  'action',e.action,'receipt',case when e.id is null then null else collect_gateway.public_owner_receipt(e.result) end,\n  'identity',case when e.id is null then null else\n   jsonb_build_object('device_id',e.id,'installation_id',e.installation_id,\n    'key_sha256',e.key_sha256,'signing_certificate_sha256',e.signing_certificate_sha256) end)\n into result from read_time t left join evidence e on true;\n return result;\nend$function$\n", "oid": "22285", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_list_operational_exceptions_v2(p_active boolean DEFAULT true, p_limit integer DEFAULT 20, p_before_changed_at timestamp with time zone DEFAULT NULL::timestamp with time zone, p_before_id uuid DEFAULT NULL::uuid, p_source_kind text DEFAULT NULL::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare result jsonb;\nbegin\n perform collect_ops.actor(false);\n if p_active is null or p_limit is null or p_limit not between 1 and 50\n  or((p_before_changed_at is null)<>(p_before_id is null))\n  or(p_before_changed_at is not null and not isfinite(p_before_changed_at))\n  or(p_source_kind is not null and p_source_kind not in('raw_sms','allocation','payment','receipt','gateway','receipt_event','receipt_backlog')) then\n  raise exception 'operational_exception_query_invalid' using errcode='22023';end if;\n -- One committed statement supplies time, category, page and review flags.\n -- Read freshness is independent of the retained source observation's age.\n with sample as materialized(select clock_timestamp() at),\n candidates as materialized(select e.* from collect_ops.exceptions e\n  where e.active=p_active and(p_source_kind is null or e.source_kind=p_source_kind)\n   and(p_before_changed_at is null or(e.last_changed_at,e.id)<(p_before_changed_at,p_before_id))\n  order by e.last_changed_at desc,e.id desc limit p_limit+1),\n page as materialized(select * from candidates order by last_changed_at desc,id desc limit p_limit),\n projected as(select e.last_changed_at,e.id,jsonb_build_object('id',e.id,\n  'source_kind',e.source_kind,'source_id',e.source_id,'reason_code',e.reason_code,\n  'active',e.active,'revision',e.revision,'source_sha256',e.source_sha256,\n  'first_observed_at',collect_ops.utc(e.first_observed_at),\n  'last_changed_at',collect_ops.utc(e.last_changed_at),\n  'transaction_sms_id',collect_ops.transaction_sms_id(e.source_kind,e.source_id),\n  'acknowledged',exists(select 1 from collect_ops.exception_actions a\n   where a.exception_id=e.id and a.expected_revision=e.revision and a.action='acknowledge'),\n  'escalation_requested',exists(select 1 from collect_ops.exception_actions a\n   where a.exception_id=e.id and a.expected_revision=e.revision and a.action='escalate'))value from page e)\n select jsonb_build_object('contract_version',2,'scope','platform_global',\n  'checked_at',collect_ops.utc(sample.at),'sample_valid_until',collect_ops.utc(sample.at+interval '60 seconds'),\n  'active',p_active,'source_kind',p_source_kind,'limit',p_limit,\n  'rows',coalesce((select jsonb_agg(value order by last_changed_at desc,id desc)from projected),'[]'::jsonb),\n  'next_cursor',case when(select count(*)from candidates)>p_limit then\n   (select jsonb_build_object('changed_at',collect_ops.utc(last_changed_at),'id',id)\n    from page order by last_changed_at,id limit 1)else null end,\n  'escalation_delivery_verified',false,'source_scan_complete',false)\n into result from sample;\n return result;\nend$function$\n", "oid": "22299", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_operational_exception_action_v2(p_request_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET lock_timeout TO '100ms'\nAS $function$\ndeclare result jsonb;acquired boolean;\nbegin\n -- The original action holds the roster authority lock until commit. Timeout\n -- means current authority could not be established, without outcome leakage.\n perform collect_ops.actor(false);\n if p_request_id is null then raise exception 'operational_exception_action_invalid' using errcode='22023';end if;\n acquired:=pg_try_advisory_xact_lock(hashtextextended('collect-ops-action:'||p_request_id::text,0));\n with sample as materialized(select clock_timestamp() at),\n prior as materialized(select a.* from collect_ops.exception_actions a\n  where acquired and a.request_id=p_request_id and a.actor_id=auth.uid())\n select jsonb_build_object('contract_version',2,'scope','platform_global',\n  'checked_at',collect_ops.utc(sample.at),'sample_valid_until',collect_ops.utc(sample.at+interval '60 seconds'),\n  'request_id',p_request_id,'status',case when not acquired then 'in_progress'\n   when exists(select 1 from prior)then 'recorded'else 'not_recorded'end,\n  'receipt',(select collect_ops.public_action_receipt(p)from prior p))\n into result from sample;\n return result;\nexception when lock_not_available then\n raise exception 'operational_exception_authority_busy' using errcode='55P03';\nend$function$\n", "oid": "22300", "owner": "16384", "config": ["search_path=\"\"", "lock_timeout=100ms"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_enroll_receipt_supervisor_v1(p_request_id uuid, p_public_key_spki_base64 text, p_key_sha256 text, p_expires_at timestamp with time zone)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid;prior jsonb;input jsonb;result jsonb;principal uuid;t timestamptz;begin\n sid:=collect_supervisor.owner_actor();\n if p_request_id is null or p_expires_at is null or not isfinite(p_expires_at)then\n  raise exception 'supervisor_enrollment_invalid'using errcode='22023';end if;\n perform collect_supervisor.validate_key(p_public_key_spki_base64,p_key_sha256);\n input:=jsonb_build_array(p_public_key_spki_base64,p_key_sha256,p_expires_at);\n perform pg_advisory_xact_lock(hashtextextended('collect-supervisor-owner:'||p_request_id::text,0));\n prior:=collect_supervisor.owner_replay(p_request_id,auth.uid(),'enroll',input);\n if prior is not null then return prior;end if;\n t:=clock_timestamp();\n if p_expires_at<t+interval '10 minutes'or p_expires_at>t+interval '30 days'\n  or exists(select 1 from collect_gateway.devices where key_sha256=p_key_sha256)then\n  raise exception 'supervisor_enrollment_invalid'using errcode='22023';end if;\n insert into collect_supervisor.identities(enrollment_request_id,owner_actor_id,owner_session_id,\n  public_key_spki_base64,key_sha256,created_at,expires_at)\n values(p_request_id,auth.uid(),sid,p_public_key_spki_base64,p_key_sha256,t,p_expires_at)returning identities.id into principal;\n result:=jsonb_build_object('contract_version',1,'principal_id',principal,'request_id',p_request_id,\n  'state_at_action','pending','scope','rw_receipt_shadow','key_sha256',p_key_sha256,\n  'expires_at',collect_gateway.utc(p_expires_at),'recorded_at',collect_gateway.utc(t));\n insert into collect_supervisor.owner_requests values(p_request_id,auth.uid(),sid,'enroll',input,result,t);\n perform public.create_audit_log('supervisor.identity.enroll','receipt_supervisor',principal,\n  jsonb_build_object('request_id',p_request_id,'scope','rw_receipt_shadow','expires_at',p_expires_at),null);\n return result;\nend$function$\n", "oid": "22367", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_activate_receipt_supervisor_v1(p_principal_id uuid, p_request_id uuid, p_expected_key_sha256 text)\n RETURNS jsonb\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select collect_supervisor.change_identity(p_principal_id,p_request_id,p_expected_key_sha256,'activate')$function$\n", "oid": "22369", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_revoke_receipt_supervisor_v1(p_principal_id uuid, p_request_id uuid, p_expected_key_sha256 text)\n RETURNS jsonb\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select collect_supervisor.change_identity(p_principal_id,p_request_id,p_expected_key_sha256,'revoke')$function$\n", "oid": "22370", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_receipt_supervisor_owner_request_v1(p_request_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET lock_timeout TO '100ms'\nAS $function$\ndeclare prior collect_supervisor.owner_requests;begin\n perform collect_supervisor.owner_actor();\n if p_request_id is null then raise exception 'supervisor_action_invalid'using errcode='22023';end if;\n select * into prior from collect_supervisor.owner_requests where request_id=p_request_id and actor_id=auth.uid();\n return jsonb_build_object('contract_version',1,'request_id',p_request_id,\n  'status',case when prior.request_id is null then 'not_recorded'else 'recorded'end,'receipt',prior.result);\nexception when lock_not_available then raise exception 'supervisor_authority_busy'using errcode='55P03';\nend$function$\n", "oid": "22371", "owner": "16384", "config": ["search_path=\"\"", "lock_timeout=100ms"]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.receipt_supervisor_key_v1(p_principal_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare item collect_supervisor.identities;begin\n if auth.role()is distinct from 'service_role'then raise exception 'supervisor_service_required'using errcode='42501';end if;\n if current_setting('transaction_isolation')<>'read committed'then\n  raise exception 'supervisor_snapshot_retry'using errcode='40001';end if;\n select * into item from collect_supervisor.identities where id=p_principal_id for share;\n if item.id is null or item.state='revoked'or item.expires_at<=clock_timestamp()then\n  raise exception 'supervisor_credential_unavailable'using errcode='42501';end if;\n return jsonb_build_object('contract_version',1,'principal_id',item.id,'state',item.state,'scope',item.scope,\n  'public_key_spki_base64',item.public_key_spki_base64,'key_sha256',item.key_sha256,\n  'expires_at',collect_gateway.utc(item.expires_at));\nend$function$\n", "oid": "22373", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.receipt_supervisor_observe_v1(p_principal_id uuid, p_request_id uuid, p_key_sha256 text, p_request_sha256 text, p_issued_at timestamp with time zone, p_action text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare item collect_supervisor.identities;prior collect_supervisor.requests;result jsonb;t timestamptz;\n queue bigint;unknowns bigint;failures bigint;begin\n item:=collect_supervisor.require_service_identity(p_principal_id,p_key_sha256,p_request_id,p_request_sha256,p_issued_at,p_action);\n if p_action not in('prove_key','shadow_health')then raise exception 'supervisor_request_invalid'using errcode='22023';end if;\n perform pg_advisory_xact_lock(hashtextextended('collect-supervisor-request:'||p_request_id::text,0));\n -- Authority and the signed-request window are checked again after a lock wait.\n item:=collect_supervisor.require_service_identity(p_principal_id,p_key_sha256,p_request_id,p_request_sha256,p_issued_at,p_action);\n select * into prior from collect_supervisor.requests where request_id=p_request_id;\n if prior.request_id is not null then\n  if prior.principal_id<>p_principal_id or prior.key_sha256<>p_key_sha256 or prior.action<>p_action\n   or prior.request_sha256<>p_request_sha256 or prior.issued_at<>p_issued_at then\n   raise exception 'supervisor_request_conflict'using errcode='22023';end if;\n  return prior.result;\n end if;\n t:=clock_timestamp();\n if p_action='prove_key'then\n  result:=jsonb_build_object('contract_version',1,'principal_id',item.id,'request_id',p_request_id,\n   'action',p_action,'observed_at',collect_gateway.utc(t),'expires_at',collect_gateway.utc(item.expires_at),\n   'scope',item.scope,'mode','Shadow','business_handled',false,'financial_action',false,'send_action',false);\n else\n  select count(*)filter(where o.state in('queued','awaiting_confirmation')),\n   count(*)filter(where o.state in('uncertain','send_started')),\n   count(*)filter(where o.state='failed_no_send')into queue,unknowns,failures\n   from collect_hybrid.sms_notification_outbox o where collect_ops.payment_scope(o.payment_id);\n  if greatest(queue,unknowns,failures)>1000000000 then\n   raise exception 'supervisor_snapshot_unavailable'using errcode='55000';end if;\n  result:=jsonb_build_object('contract_version',1,'principal_id',item.id,'request_id',p_request_id,\n   'action',p_action,'observed_at',collect_gateway.utc(t),'sample_valid_until',collect_gateway.utc(least(t+interval '60 seconds',item.expires_at)),\n   'expires_at',collect_gateway.utc(item.expires_at),'scope',item.scope,'mode','Shadow',\n   'queued_count',queue,'unknown_count',unknowns,'failed_no_send_count',failures,\n   'dispatch_enabled',coalesce((select enabled from public.feature_flags where key='hybrid_sms_notifications'),false),\n   'business_handled',false,'financial_action',false,'send_action',false);\n end if;\n insert into collect_supervisor.requests values(p_request_id,item.id,p_action,p_key_sha256,p_request_sha256,p_issued_at,t,result);\n return result;\nend$function$\n", "oid": "22374", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "service_role=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.receipt_supervisor_reconcile_v1(p_principal_id uuid, p_request_id uuid, p_key_sha256 text, p_request_sha256 text, p_issued_at timestamp with time zone, p_target_request_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET lock_timeout TO '100ms'\nAS $function$\ndeclare item collect_supervisor.identities;prior collect_supervisor.requests;begin\n item:=collect_supervisor.require_service_identity(p_principal_id,p_key_sha256,p_request_id,p_request_sha256,p_issued_at,'reconcile');\n if p_target_request_id is null then raise exception 'supervisor_request_invalid'using errcode='22023';end if;\n if not pg_try_advisory_xact_lock(hashtextextended('collect-supervisor-request:'||p_target_request_id::text,0))then\n  return jsonb_build_object('contract_version',1,'target_request_id',p_target_request_id,'status','in_progress','receipt',null);end if;\n select * into prior from collect_supervisor.requests where request_id=p_target_request_id and principal_id=item.id;\n return jsonb_build_object('contract_version',1,'target_request_id',p_target_request_id,\n  'status',case when prior.request_id is null then 'not_recorded'else 'recorded'end,'receipt',prior.result);\nexception when lock_not_available then raise exception 'supervisor_authority_busy'using errcode='55P03';\nend$function$\n", "oid": "22375", "owner": "16384", "config": ["search_path=\"\"", "lock_timeout=100ms"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_inspect_unstarted_receipt_v1(p_outbox_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET lock_timeout TO '100ms'\nAS $function$\ndeclare job collect_hybrid.sms_notification_outbox;result jsonb;begin\n perform collect_receipt_actions.actor(false);\n if p_outbox_id is null then raise exception 'receipt_action_input_invalid'using errcode='22023';end if;\n -- The same actual outbox lock protects the source/head pair used by cancel.\n select * into job from collect_hybrid.sms_notification_outbox where id=p_outbox_id for share;\n with sample as materialized(select clock_timestamp()at),\n source as materialized(select coalesce((select revision from collect_receipt_actions.revisions where outbox_id=job.id),1)revision,\n  collect_receipt_actions.ineligible_reason(job)reason\n  where job.id is not null and collect_receipt_actions.rwanda_source(job)),\n data as materialized(select revision,case when revision=1000000000 then 'revision_exhausted'else reason end reason from source)\n select jsonb_build_object('contract_version',1,'scope','rw_receipt_manual_cancel',\n  'checked_at',collect_ops.utc(sample.at),'sample_valid_until',collect_ops.utc(sample.at+interval '60 seconds'),\n  'outbox_id',p_outbox_id,'status',case when exists(select 1 from data)then 'available'else 'unavailable'end,\n  'receipt',(select jsonb_build_object('outbox_id',job.id,'revision',data.revision,'state',job.state,\n    'can_cancel',data.reason='eligible','reason_code',data.reason)from data))into result from sample;\n return result;\nexception when lock_not_available then raise exception 'receipt_action_authority_busy'using errcode='55P03';end$function$\n", "oid": "22419", "owner": "16384", "config": ["search_path=\"\"", "lock_timeout=100ms"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_cancel_unstarted_receipt_v1(p_request_id uuid, p_outbox_id uuid, p_expected_revision bigint, p_reason_code text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid;job collect_hybrid.sms_notification_outbox;prior collect_receipt_actions.cancellations;\n before_revision bigint;after_revision bigint;at timestamptz;begin\n sid:=collect_receipt_actions.actor(true);\n if p_request_id is null or p_outbox_id is null or p_expected_revision is null\n  or p_expected_revision not between 1 and 999999999 or p_reason_code is null\n  or p_reason_code not in('operator_cancelled','recipient_review_required','content_review_required')then\n  raise exception 'receipt_action_input_invalid'using errcode='22023';end if;\n perform pg_advisory_xact_lock(hashtextextended('collect-receipt-cancel-request:'||p_request_id::text,0));\n select * into prior from collect_receipt_actions.cancellations where request_id=p_request_id;\n if prior.request_id is not null then\n  if prior.actor_id<>auth.uid()or prior.outbox_id<>p_outbox_id or prior.expected_revision<>p_expected_revision\n   or prior.reason_code<>p_reason_code then raise exception 'receipt_action_request_conflict'using errcode='22023';end if;\n  perform collect_receipt_actions.actor(true);\n  return collect_receipt_actions.receipt(prior);\n end if;\n select * into job from collect_hybrid.sms_notification_outbox where id=p_outbox_id for update;\n -- Revalidate natural expiry after waiting, without changing the lock order:\n -- all authority proof locks were already held before the request/outbox lock.\n perform collect_receipt_actions.actor(true);\n select coalesce((select revision from collect_receipt_actions.revisions where outbox_id=job.id),1)into before_revision;\n if job.id is null or not collect_receipt_actions.rwanda_source(job)then\n  raise exception 'receipt_action_unavailable'using errcode='55000';end if;\n if before_revision<>p_expected_revision then raise exception 'receipt_action_source_changed'using errcode='55000';end if;\n if collect_receipt_actions.ineligible_reason(job)is distinct from 'eligible'then\n  raise exception 'receipt_not_cancellable'using errcode='55000';end if;\n update collect_hybrid.sms_notification_outbox set state='suppressed',suppression_reason='manual_pre_send_cancel'\n  where id=job.id;\n select revision into after_revision from collect_receipt_actions.revisions where outbox_id=job.id;\n if after_revision is distinct from before_revision+1 then\n  raise exception 'receipt_action_revision_invalid'using errcode='55000';end if;\n at:=clock_timestamp();\n insert into collect_receipt_actions.cancellations(request_id,outbox_id,expected_revision,revision,\n  reason_code,actor_id,session_id,recorded_at)\n values(p_request_id,job.id,before_revision,after_revision,p_reason_code,auth.uid(),sid,at)returning * into prior;\n perform public.create_audit_log('notification.sms.cancelled_unstarted','sms_notification_outbox',job.id,\n  jsonb_build_object('request_id',p_request_id,'expected_revision',before_revision,'revision',after_revision,\n   'reason_code',p_reason_code,'financial_action',false,'send_action',false),auth.uid());\n return collect_receipt_actions.receipt(prior);\nend$function$\n", "oid": "22420", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_unstarted_receipt_action_v1(p_request_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET lock_timeout TO '100ms'\nAS $function$\ndeclare result jsonb;acquired boolean;begin\n perform collect_receipt_actions.actor(false);\n if p_request_id is null then raise exception 'receipt_action_input_invalid'using errcode='22023';end if;\n acquired:=pg_try_advisory_xact_lock(hashtextextended('collect-receipt-cancel-request:'||p_request_id::text,0));\n with sample as materialized(select clock_timestamp()at),\n prior as materialized(select * from collect_receipt_actions.cancellations\n  where acquired and request_id=p_request_id and actor_id=auth.uid())\n select jsonb_build_object('contract_version',1,'scope','rw_receipt_manual_cancel',\n  'checked_at',collect_ops.utc(sample.at),'sample_valid_until',collect_ops.utc(sample.at+interval '60 seconds'),\n  'request_id',p_request_id,'status',case when not acquired then 'in_progress'\n    when exists(select 1 from prior)then 'recorded'else 'not_recorded'end,\n  'receipt',(select collect_receipt_actions.receipt(p)from prior p))into result from sample;\n return result;\nexception when lock_not_available then raise exception 'receipt_action_authority_busy'using errcode='55P03';end$function$\n", "oid": "22421", "owner": "16384", "config": ["search_path=\"\"", "lock_timeout=100ms"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_operator_entity_audit_v1(p_entity_kind text, p_entity_id uuid, p_limit integer DEFAULT 20, p_before_at timestamp with time zone DEFAULT NULL::timestamp with time zone, p_before_event_id uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET lock_timeout TO '100ms'\nAS $function$\ndeclare available boolean;result jsonb;sample timestamptz;begin\n perform collect_operator_audit.actor(p_entity_kind);\n if p_entity_kind is null or p_entity_kind not in('shadow_run','gateway_device','exception','supervisor_identity','receipt')\n  or p_entity_id is null or p_limit is null or p_limit not between 1 and 50\n  or(p_before_at is null)is distinct from(p_before_event_id is null)\n  or(p_before_at is not null and not isfinite(p_before_at))then\n  raise exception 'operator_audit_input_invalid'using errcode='22023';end if;\n available:=case p_entity_kind\n  when 'shadow_run'then exists(select 1 from collect_security.shadow_supervisor_runs where id=p_entity_id)\n  when 'gateway_device'then exists(select 1 from collect_gateway.devices where id=p_entity_id)\n  when 'supervisor_identity'then exists(select 1 from collect_supervisor.identities where id=p_entity_id)\n  when 'receipt'then exists(select 1 from collect_hybrid.sms_notification_outbox j\n   where j.id=p_entity_id and collect_operator_audit.payment_scope(j.payment_id))\n  when 'exception'then exists(select 1 from collect_ops.exceptions e where e.id=p_entity_id and\n   case e.source_kind\n    when 'gateway'then exists(select 1 from collect_gateway.devices d where d.id=e.source_id)\n    when 'receipt'then exists(select 1 from collect_hybrid.sms_notification_outbox j\n     where j.id=e.source_id and collect_operator_audit.payment_scope(j.payment_id))\n    when 'payment'then collect_operator_audit.payment_scope(e.source_id)\n    when 'raw_sms'then collect_ops.transaction_sms_id('raw_sms',e.source_id) is not null\n    when 'allocation'then collect_ops.transaction_sms_id('allocation',e.source_id) is not null\n    else false end)\n  else false end;\n sample:=clock_timestamp();\n -- Permit cursor predicates to reach the entity/order indexes rather than\n -- materializing an entity's entire retained history before selecting a page.\n with events as not materialized(\n  select e.event_id,'shadow_audit_event'::text source,e.action,e.recorded_at,e.actor_id,e.request_id,\n   null::bigint revision,e.fence_version,null::text reason_code\n   from collect_operator_audit.shadow_events e where p_entity_kind='shadow_run'and e.run_id=p_entity_id\n  union all\n  select e.request_id,'gateway_admin_request','gateway.'||e.action,e.recorded_at,e.actor_id,e.request_id,\n   null::bigint,null::bigint,null::text from collect_gateway.admin_requests e\n   where p_entity_kind='gateway_device'and collect_operator_audit.safe_uuid(e.result->>'device_id')=p_entity_id\n  union all\n  select e.request_id,'supervisor_owner_request','supervisor.'||e.action,e.recorded_at,e.actor_id,e.request_id,\n   null::bigint,null::bigint,null::text from collect_supervisor.owner_requests e\n   where p_entity_kind='supervisor_identity'and collect_operator_audit.safe_uuid(e.result->>'principal_id')=p_entity_id\n  union all\n  select e.request_id,'exception_action','exception.'||e.action,e.recorded_at,e.actor_id,e.request_id,\n   e.expected_revision,null::bigint,e.reason_code from collect_ops.exception_actions e\n   where p_entity_kind='exception'and e.exception_id=p_entity_id\n  union all\n  select e.request_id,'receipt_cancellation','receipt.cancel_unstarted',e.recorded_at,e.actor_id,e.request_id,\n   e.revision,null::bigint,e.reason_code from collect_receipt_actions.cancellations e\n   where p_entity_kind='receipt'and e.outbox_id=p_entity_id\n ), page as materialized(\n  select * from events where available and isfinite(recorded_at)and recorded_at<=sample\n   and(p_before_at is null or(recorded_at,event_id)<(p_before_at,p_before_event_id))\n   order by recorded_at desc,event_id desc limit p_limit+1\n ), shown as materialized(select * from page order by recorded_at desc,event_id desc limit p_limit)\n select jsonb_build_object('contract_version',1,'scope','rw_operator_entity_audit',\n  'entity_kind',p_entity_kind,'entity_id',p_entity_id,'status',case when available then 'available'else 'unavailable'end,\n  'checked_at',collect_ops.utc(sample),'sample_valid_until',collect_ops.utc(sample+interval '60 seconds'),\n  'limit',p_limit,'history_complete',false,'historical_shadow_audit_backfilled',false,\n  'financial_action',false,'send_action',false,\n  'rows',coalesce((select jsonb_agg(jsonb_build_object('event_id',event_id,'source',source,'action',action,\n   'recorded_at',collect_ops.utc(recorded_at),'actor_id',actor_id,'request_id',request_id,\n   'revision',revision,'fence_version',fence_version,'reason_code',reason_code)\n   order by recorded_at desc,event_id desc)from shown),'[]'::jsonb),\n  'next_cursor',case when(select count(*)from page)>p_limit then\n   (select jsonb_build_object('recorded_at',collect_ops.utc(recorded_at),'event_id',event_id)\n    from shown order by recorded_at,event_id limit 1)else null end)into result;\n -- Natural expiry remains relevant even while row locks prevent revocation.\n perform collect_operator_audit.actor(p_entity_kind);\n return result;\nexception when lock_not_available then raise exception 'operator_audit_authority_busy'using errcode='55P03';end$function$\n", "oid": "22453", "owner": "16384", "config": ["search_path=\"\"", "lock_timeout=100ms"]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_unattended_operating_policy_v1()\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET lock_timeout TO '100ms'\nAS $function$\ndeclare p collect_automation.operating_policy;result jsonb;begin\n perform collect_automation.actor(false);\n select * into p from collect_automation.operating_policy where singleton for share;\n perform collect_automation.actor(false);\n if p.id is null then raise exception 'operating_policy_unavailable'using errcode='55000';end if;\n with sample as materialized(select clock_timestamp()at),\n assisted as materialized(select enabled from public.feature_flags where key='hybrid_sms_notifications')\n select jsonb_build_object('contract_version',1,'scope','platform_global','purpose','unattended_policy_preparation',\n  'checked_at',collect_ops.utc(sample.at),'sample_valid_until',collect_ops.utc(sample.at+interval '60 seconds'),\n  'policy_id',p.id,'revision',p.revision,'configured_mode',p.configured_mode,\n  'effective_mode',case when p.emergency_stop then 'Paused'else p.configured_mode end,\n  'emergency_stop',p.emergency_stop,'initialized_at',collect_ops.utc(p.initialized_at),\n  'updated_at',collect_ops.utc(p.updated_at),'last_change_request_id',p.last_change_request_id,\n  'modes',jsonb_build_array(\n   jsonb_build_object('mode','Shadow','selectable',true,'unavailable_reason',null),\n   jsonb_build_object('mode','Dry-run','selectable',true,'unavailable_reason',null),\n   jsonb_build_object('mode','Live-limited','selectable',false,'unavailable_reason','OPERATING_POLICY_LIVE_AUTHORITY_PENDING'),\n   jsonb_build_object('mode','Live','selectable',false,'unavailable_reason','OPERATING_POLICY_LIVE_AUTHORITY_PENDING'),\n   jsonb_build_object('mode','Paused','selectable',true,'unavailable_reason',null)),\n  'limits',jsonb_build_object('run_actions',null,'group_actions',null,'device_actions',null,'global_actions',null,\n   'run_sms',null,'group_sms',null,'device_sms',null,'global_sms',null,'enforcement',false,\n   'unavailable_reason','OPERATING_POLICY_LIMIT_AUTHORITY_PENDING'),\n  'schedule',jsonb_build_object('owner',null,'kind',null,'cadence_seconds',null,'next_run_at',null,\n   'configuration_available',false,'unavailable_reason','OPERATING_POLICY_SCHEDULE_AUTHORITY_UNAVAILABLE'),\n  'approvals',jsonb_build_object('financial',null,'recipient',null,'template',null,'pilot',null),\n  'execution',jsonb_build_object('unattended_dispatch_available',false,'grant_authority_pending',true,\n   'unavailable_reason','OPERATING_POLICY_DISPATCH_AUTHORITY_PENDING'),\n  'boundaries',jsonb_build_object('assisted_dispatch',case when not exists(select 1 from assisted)then 'unavailable'\n    when(select enabled from assisted)then 'enabled'else 'paused'end,\n   'policy_changes_assisted_dispatch',false,'policy_changes_signed_shadow_observation',false,\n   'policy_changes_carrier_work',false))into result from sample;\n return result;\nexception when lock_not_available then raise exception 'operating_policy_authority_busy'using errcode='55P03';end$function$\n", "oid": "22516", "owner": "16384", "config": ["search_path=\"\"", "lock_timeout=100ms"]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.collect_operations_legacy_configure_policy_v1(p_request_id uuid, p_expected_revision bigint, p_mode text, p_emergency_stop boolean, p_reason_code text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare sid uuid;p collect_automation.operating_policy;prior collect_automation.policy_requests;\n changed boolean;at timestamptz;next_revision bigint;begin\n sid:=collect_automation.actor(true);\n if p_request_id is null or p_expected_revision is null or p_expected_revision not between 1 and 1000000000\n  or p_mode is null or p_mode not in('Shadow','Dry-run','Live-limited','Live','Paused')\n  or p_emergency_stop is null or p_reason_code is null\n  or p_reason_code not in('operator_reviewed_configuration','operator_emergency_stop','operator_clear_future_stop')\n  or(p_mode='Paused'and not p_emergency_stop)\n  or(p_reason_code='operator_emergency_stop'and not p_emergency_stop)\n  or(p_reason_code='operator_clear_future_stop'and p_emergency_stop)then\n  raise exception 'operating_policy_input_invalid'using errcode='22023';end if;\n if p_mode in('Live-limited','Live')then\n  raise exception 'OPERATING_POLICY_LIVE_AUTHORITY_PENDING'using errcode='55000';end if;\n perform pg_advisory_xact_lock(hashtextextended('collect-operating-policy-request:'||p_request_id::text,0));\n select * into prior from collect_automation.policy_requests where request_id=p_request_id;\n if prior.request_id is not null then\n  if prior.actor_id<>auth.uid()or prior.expected_revision<>p_expected_revision or prior.mode_after<>p_mode\n   or prior.stop_after<>p_emergency_stop or prior.reason_code<>p_reason_code then\n   raise exception 'operating_policy_request_conflict'using errcode='22023';end if;\n  perform collect_automation.actor(true);\n  return collect_automation.receipt(prior);\n end if;\n select * into p from collect_automation.operating_policy where singleton for update;\n perform collect_automation.actor(true);\n if p.id is null then raise exception 'operating_policy_unavailable'using errcode='55000';end if;\n if p.revision<>p_expected_revision then raise exception 'operating_policy_source_changed'using errcode='55000';end if;\n changed:=p.configured_mode<>p_mode or p.emergency_stop<>p_emergency_stop;\n if changed and p.revision=1000000000 then raise exception 'operating_policy_revision_exhausted'using errcode='55000';end if;\n next_revision:=p.revision+case when changed then 1 else 0 end;\n at:=greatest(p.updated_at,clock_timestamp());\n if changed then update collect_automation.operating_policy set configured_mode=p_mode,emergency_stop=p_emergency_stop,\n  revision=next_revision,updated_at=at,last_change_request_id=p_request_id where id=p.id;end if;\n insert into collect_automation.policy_requests(request_id,policy_id,actor_id,session_id,expected_revision,revision,\n  mode_before,mode_after,stop_before,stop_after,changed,reason_code,recorded_at)\n values(p_request_id,p.id,auth.uid(),sid,p.revision,next_revision,p.configured_mode,p_mode,p.emergency_stop,\n  p_emergency_stop,changed,p_reason_code,at)returning * into prior;\n perform public.create_audit_log('automation.operating_policy.configured','unattended_operating_policy',p.id,\n  jsonb_build_object('request_id',p_request_id,'expected_revision',p_expected_revision,'revision',next_revision,\n   'changed',changed,'mode',p_mode,'emergency_stop',p_emergency_stop,'reason_code',p_reason_code,\n   'financial_action',false,'send_action',false,'approval_granted',false,'schedule_changed',false),auth.uid());\n return collect_automation.receipt(prior);\nend$function$\n", "oid": "22517", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres", "authenticated=X/postgres"], "def": "CREATE OR REPLACE FUNCTION public.admin_get_unattended_policy_request_v1(p_request_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\n SET lock_timeout TO '100ms'\nAS $function$\ndeclare acquired boolean;result jsonb;begin\n perform collect_automation.actor(false);\n if p_request_id is null then raise exception 'operating_policy_input_invalid'using errcode='22023';end if;\n acquired:=pg_try_advisory_xact_lock(hashtextextended('collect-operating-policy-request:'||p_request_id::text,0));\n with sample as materialized(select clock_timestamp()at),\n prior as materialized(select * from collect_automation.policy_requests\n  where acquired and request_id=p_request_id and actor_id=auth.uid())\n select jsonb_build_object('contract_version',1,'scope','platform_global',\n  'checked_at',collect_ops.utc(sample.at),'sample_valid_until',collect_ops.utc(sample.at+interval '60 seconds'),\n  'request_id',p_request_id,'status',case when not acquired then 'in_progress'\n   when exists(select 1 from prior)then 'recorded'else 'not_recorded'end,\n  'receipt',(select collect_automation.receipt(r)from prior r))into result from sample;\n return result;\nexception when lock_not_available then raise exception 'operating_policy_authority_busy'using errcode='55P03';end$function$\n", "oid": "22518", "owner": "16384", "config": ["search_path=\"\"", "lock_timeout=100ms"]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_receipt_policy.immutable_evidence()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$begin\n raise exception 'receipt_content_evidence_immutable'using errcode='55000';end$function$\n", "oid": "22558", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_receipt_policy.render_v2(p_amount_rwf bigint, p_member_balance_rwf bigint, p_recorded_at timestamp with time zone, p_reference text, p_language text DEFAULT 'rw'::text)\n RETURNS text\n LANGUAGE plpgsql\n IMMUTABLE\n SET search_path TO ''\nAS $function$\ndeclare ref text:=btrim(coalesce(p_reference,''));at_text text;amount text;balance text;begin\n if p_amount_rwf is null or p_amount_rwf<=0 or p_member_balance_rwf is null or p_member_balance_rwf<0\n  or p_recorded_at is null or not isfinite(p_recorded_at)\n  or ref!~'^[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$'or p_language is null or p_language not in('rw','en','fr')then\n  raise exception 'receipt_content_input_invalid'using errcode='22023';end if;\n at_text:=to_char(p_recorded_at at time zone 'Africa/Kigali','YYYY-MM-DD HH24:MI')||' CAT';\n amount:=to_char(p_amount_rwf,'FM9,999,999,999,999,999,990');\n balance:=to_char(p_member_balance_rwf,'FM9,999,999,999,999,999,990');\n return case p_language\n  when 'rw'then 'BuriMunsi: Ubwizigame bwa '||amount||' RWF bwanditswe. Igiteranyo cyawe cyanditswe muri iri tsinda ku '||at_text||': '||balance||' RWF. Ref: '||ref||'.'\n  when 'en'then 'BuriMunsi: Savings recorded: '||amount||' RWF. Your recorded savings in this group at '||at_text||': '||balance||' RWF. Ref: '||ref||'.'\n  when 'fr'then 'BuriMunsi: Épargne enregistrée: '||amount||' RWF. Votre épargne enregistrée dans ce groupe au '||at_text||': '||balance||' RWF. Réf: '||ref||'.'end;\nend$function$\n", "oid": "22562", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_receipt_policy.render_snapshot(p_snapshot collect_hybrid.momo_balance_snapshots, p_version integer, p_reference text)\n RETURNS text\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select case p_version when 1 then collect_hybrid.render_buri_munsi_receipt(p_snapshot.delta_rwf,\n  p_snapshot.member_balance_after_rwf,p_snapshot.group_balance_after_rwf,p_reference)\n when 2 then collect_receipt_policy.render_v2(p_snapshot.delta_rwf,p_snapshot.member_balance_after_rwf,\n  p_snapshot.captured_at,p_reference,'rw')else null end\n$function$\n", "oid": "22563", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_receipt_policy.body_for_job(p_job collect_hybrid.sms_notification_outbox)\n RETURNS text\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select collect_receipt_policy.render_snapshot(s,p_job.template_version,p_job.reference,collect_receipt_policy.language_for_job(p_job))\n from collect_hybrid.momo_balance_snapshots s where s.id=p_job.snapshot_id\n$function$\n", "oid": "22564", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_receipt_policy.snapshot_is_eligible(p_snapshot collect_hybrid.momo_balance_snapshots)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select exists(select 1 from public.payments p\n join public.collections c on c.id=p.collection_id\n join collect_hybrid.member_records m on m.id=p.member_record_id\n join collect_hybrid.momo_journal_entries j on j.id=p_snapshot.journal_entry_id\n join public.payment_provider_confirmations pc on pc.payment_id=p.id\n where p.id=p_snapshot.payment_id and p.status='posted'and p.currency='RWF'\n  and p.amount_rwf>0 and p_snapshot.event_type='receipt'\n  and p.collection_id=p_snapshot.collection_id and p.member_record_id=p_snapshot.member_record_id\n  and p_snapshot.delta_rwf=p.amount_rwf and p_snapshot.member_balance_after_rwf is not null\n  and isfinite(p_snapshot.captured_at)\n  and c.collection_type='ikimina'and c.archived_at is null\n  and m.lifecycle='active'and not collect_hybrid.member_record_has_account(m.id)\n  and exists(select 1 from public.collection_members cm where cm.collection_id=p.collection_id\n   and cm.member_record_id=p.member_record_id and cm.status='active')\n  and collect_ops.payment_scope(p.id)\n  and(p.parsed_event_id is null or collect_ops.transaction_sms_id('payment',p.id)is not null)\n  and pc.provider_network=p.provider_network and upper(btrim(pc.transaction_id))=upper(btrim(p.transaction_id))\n  and pc.receiver_momo_number_hash=p.receiver_momo_number_hash and pc.amount_rwf=p.amount_rwf and pc.currency='RWF'\n  and j.payment_id=p.id and j.collection_id=p.collection_id and j.member_record_id=p.member_record_id\n  and j.entry_type='receipt'and j.amount_rwf=p.amount_rwf\n  and not exists(select 1 from collect_hybrid.momo_journal_entries r where r.payment_id=p.id and r.entry_type='reversal')\n  and(select count(*)=2 and count(*)filter(where l.account_code='momo_receiving_asset:RWF'and l.direction='debit')=1\n   and count(*)filter(where l.account_code='member_savings_liability:RWF'and l.direction='credit')=1\n   and min(l.amount_rwf)=p.amount_rwf and max(l.amount_rwf)=p.amount_rwf\n   from collect_hybrid.momo_journal_lines l where l.journal_entry_id=j.id))\n$function$\n", "oid": "22565", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CREATE OR REPLACE FUNCTION collect_receipt_policy.content_is_valid(p_job collect_hybrid.sms_notification_outbox)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select coalesce(p_job.template_version=2 and exists(select 1 from collect_receipt_policy.content_evidence e\n join collect_hybrid.momo_balance_snapshots s on s.id=p_job.snapshot_id\n where e.outbox_id=p_job.id and e.content_version=2 and e.language in('rw','en','fr')\n  and e.snapshot_recorded_at=s.captured_at and e.body_sha256=p_job.body_sha256\n  and p_job.message_body=collect_receipt_policy.render_snapshot(s,2,p_job.reference,e.language)\n  and p_job.body_sha256=encode(extensions.digest(p_job.message_body,'sha256'),'hex')),false)\n$function$\n", "oid": "22566", "owner": "16384", "config": ["search_path=\"\""]}, {"acl": ["postgres=X/postgres"], "def": "CR