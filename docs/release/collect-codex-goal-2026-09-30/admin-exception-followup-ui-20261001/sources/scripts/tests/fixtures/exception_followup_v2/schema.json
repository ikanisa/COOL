{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collect:exception-followup:v2",
  "title": "Collect exception follow-up v2 strict result shapes",
  "description": "CONTRACT.md defines semantic ordering, exact60-second TTL and request/input/expiry binding in addition to these strict structural constraints.",
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "request_id",
        "exception_id",
        "source_revision",
        "workflow_revision",
        "action",
        "escalation_id",
        "source_resolved",
        "financial_action",
        "send_action",
        "recorded_at",
        "request_fingerprint"
      ],
      "properties": {
        "contract_version": {
          "const": 2
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "exception_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "workflow_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "action": {
          "enum": [
            "assign",
            "escalate",
            "resolve"
          ]
        },
        "escalation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_resolved": {
          "type": "boolean"
        },
        "financial_action": {
          "const": false
        },
        "send_action": {
          "const": false
        },
        "recorded_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "request_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "resolve"
              }
            }
          },
          "then": {
            "properties": {
              "source_resolved": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "source_resolved": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "escalate"
              }
            }
          },
          "then": {
            "properties": {
              "escalation_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
              }
            }
          },
          "else": {
            "properties": {
              "escalation_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "scope",
        "checked_at",
        "sample_valid_until",
        "limit",
        "rows",
        "next_cursor"
      ],
      "properties": {
        "contract_version": {
          "const": 2
        },
        "scope": {
          "const": "platform_global"
        },
        "checked_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "sample_valid_until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "rows": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operator_id",
              "display_label",
              "created_at"
            ],
            "properties": {
              "operator_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
              },
              "display_label": {
                "type": "string",
                "pattern": "^Collect ID [0-9]{6}$"
              },
              "created_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
              }
            }
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "created_at",
                "operator_id"
              ],
              "properties": {
                "created_at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
                },
                "operator_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "request_id",
        "request_fingerprint",
        "expires_at",
        "checked_at",
        "sample_valid_until",
        "status",
        "receipt"
      ],
      "properties": {
        "contract_version": {
          "const": 2
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "request_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "checked_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "sample_valid_until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "status": {
          "enum": [
            "recorded",
            "not_recorded",
            "in_progress"
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "recorded"
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "$ref": "#/$defs/receipt"
              }
            }
          },
          "else": {
            "properties": {
              "receipt": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/directory"
    },
    {
      "$ref": "#/$defs/lookup"
    }
  ]
}
