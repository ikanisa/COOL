+          executionBinding: f.executionBinding, now: () => tickClock,
+          ...(window === "admission" ? {storage: {io: {...filesystem, statfs: async (path: string) => {entered(); await held; return await filesystem.statfs(path);}}}} : {}),
+          tick: async () => {calls++; return {status: "SCHEDULER_BACKOFF", business_handled: false};},
+        });
+        await reached;
