+for (const window of ["admission", "diagnostic-setup"] as const) {
+  for (const invalidation of ["disable", "identity-expiry"] as const) {
+    test(`${invalidation} during ${window} prevents dispatch and closes known non-invoked diagnostics`, async () => {
+      const f = await fixture();
+      let release!: () => void, entered!: () => void;
+      const held = new Promise<void>(resolve => {release = resolve;});
+      const reached = new Promise<void>(resolve => {entered = resolve;});
+      let calls = 0, tickClock = at;
+      const publish = UnattendedStore.prototype.publish;
+      if (window === "diagnostic-setup") {
+        UnattendedStore.prototype.publish = async function(this: UnattendedStore, name: string, value: unknown) {
+          await publish.call(this, name, value);
+          if (this.directory === join(f.directory, "diagnostics") && name.endsWith(".run.json")) {entered(); await held;}
+        };
+      }
+      try {
+        assert.equal((await controlScheduler("activate", f.directory, id(1), undefined, f.dependencies)).status, "SCHEDULER_ACTIVATION_OBSERVED");
