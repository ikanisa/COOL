+/// A navigation departure remains invalid even when the router returns to the
+/// same URI before a delayed response or dialog transition completes.
+class _ExceptionNavigationOrigin {
+  _ExceptionNavigationOrigin(BuildContext context)
+    : _context = context,
+      _route = ModalRoute.of(context),
+      _router = GoRouter.maybeOf(context) {
+    _configuration = _router?.routerDelegate.currentConfiguration;
+    _router?.routerDelegate.addListener(_observe);
+  }
+
+  final BuildContext _context;
+  final ModalRoute<dynamic>? _route;
+  final GoRouter? _router;
+  Object? _configuration;
+  bool _departed = false;
+
+  void _observe() {
+    if (_router?.routerDelegate.currentConfiguration != _configuration ||
+        _route?.isActive == false) {
+      _departed = true;
+    }
+  }
+
+  bool get isRetained {
+    _observe();
+    return !_departed && _context.mounted && _route?.isActive != false;
+  }
+
+  bool get isCurrent => isRetained && _route?.isCurrent != false;
+
+  void dispose() => _router?.routerDelegate.removeListener(_observe);
+}
 
