{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collect:unattended-operating-policy:v1",
  "title": "Collect unattended operating-policy preparation v1",
  "oneOf": [
    {
      "$ref": "#/$defs/current"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/lookup"
    }
  ],
  "$defs": {
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "scope",
        "checked_at",
        "sample_valid_until",
        "purpose",
        "policy_id",
        "revision",
        "configured_mode",
        "effective_mode",
        "emergency_stop",
        "initialized_at",
        "updated_at",
        "last_change_request_id",
        "modes",
        "limits",
        "schedule",
        "approvals",
        "execution",
        "boundaries"
      ],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "scope": {
          "const": "platform_global"
        },
        "checked_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "sample_valid_until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "purpose": {
          "const": "unattended_policy_preparation"
        },
        "policy_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "configured_mode": {
          "enum": [
            "Shadow",
            "Dry-run",
            "Paused"
          ]
        },
        "effective_mode": {
          "enum": [
            "Shadow",
            "Dry-run",
            "Paused"
          ]
        },
        "emergency_stop": {
          "type": "boolean"
        },
        "initialized_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "updated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "last_change_request_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          ]
        },
        "modes": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "selectable",
                "unavailable_reason"
              ],
              "properties": {
                "mode": {
                  "const": "Shadow"
                },
                "selectable": {
                  "const": true
                },
                "unavailable_reason": {
                  "const": null
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "selectable",
                "unavailable_reason"
              ],
              "properties": {
                "mode": {
                  "const": "Dry-run"
                },
                "selectable": {
                  "const": true
                },
                "unavailable_reason": {
                  "const": null
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "selectable",
                "unavailable_reason"
              ],
              "properties": {
                "mode": {
                  "const": "Live-limited"
                },
                "selectable": {
                  "const": false
                },
                "unavailable_reason": {
                  "const": "OPERATING_POLICY_LIVE_AUTHORITY_PENDING"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "selectable",
                "unavailable_reason"
              ],
              "properties": {
                "mode": {
                  "const": "Live"
                },
                "selectable": {
                  "const": false
                },
                "unavailable_reason": {
                  "const": "OPERATING_POLICY_LIVE_AUTHORITY_PENDING"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "selectable",
                "unavailable_reason"
              ],
              "properties": {
                "mode": {
                  "const": "Paused"
                },
                "selectable": {
                  "const": true
                },
                "unavailable_reason": {
                  "const": null
                }
              }
            }
          ],
          "minItems": 5,
          "maxItems": 5,
          "items": false
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_actions",
            "group_actions",
            "device_actions",
            "global_actions",
            "run_sms",
            "group_sms",
            "device_sms",
            "global_sms",
            "enforcement",
            "unavailable_reason"
          ],
          "properties": {
            "run_actions": {
              "const": null
            },
            "group_actions": {
              "const": null
            },
            "device_actions": {
              "const": null
            },
            "global_actions": {
              "const": null
            },
            "run_sms": {
              "const": null
            },
            "group_sms": {
              "const": null
            },
            "device_sms": {
              "const": null
            },
            "global_sms": {
              "const": null
            },
            "enforcement": {
              "const": false
            },
            "unavailable_reason": {
              "const": "OPERATING_POLICY_LIMIT_AUTHORITY_PENDING"
            }
          }
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "kind",
            "cadence_seconds",
            "next_run_at",
            "configuration_available",
            "unavailable_reason"
          ],
          "properties": {
            "owner": {
              "const": null
            },
            "kind": {
              "const": null
            },
            "cadence_seconds": {
              "const": null
            },
            "next_run_at": {
              "const": null
            },
            "configuration_available": {
              "const": false
            },
            "unavailable_reason": {
              "const": "OPERATING_POLICY_SCHEDULE_AUTHORITY_UNAVAILABLE"
            }
          }
        },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "financial",
            "recipient",
            "template",
            "pilot"
          ],
          "properties": {
            "financial": {
              "const": null
            },
            "recipient": {
              "const": null
            },
            "template": {
              "const": null
            },
            "pilot": {
              "const": null
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unattended_dispatch_available",
            "grant_authority_pending",
            "unavailable_reason"
          ],
          "properties": {
            "unattended_dispatch_available": {
              "const": false
            },
            "grant_authority_pending": {
              "const": true
            },
            "unavailable_reason": {
              "const": "OPERATING_POLICY_DISPATCH_AUTHORITY_PENDING"
            }
          }
        },
        "boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assisted_dispatch",
            "policy_changes_assisted_dispatch",
            "policy_changes_signed_shadow_observation",
            "policy_changes_carrier_work"
          ],
          "properties": {
            "assisted_dispatch": {
              "enum": [
                "paused",
                "enabled",
                "unavailable"
              ]
            },
            "policy_changes_assisted_dispatch": {
              "const": false
            },
            "policy_changes_signed_shadow_observation": {
              "const": false
            },
            "policy_changes_carrier_work": {
              "const": false
            }
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "scope",
        "request_id",
        "policy_id",
        "action",
        "expected_revision",
        "revision",
        "changed",
        "mode_before",
        "mode_after",
        "emergency_stop_before",
        "emergency_stop_after",
        "reason_code",
        "recorded_at",
        "unattended_dispatch_available",
        "financial_action",
        "send_action",
        "approval_granted",
        "schedule_changed",
        "assisted_dispatch_changed",
        "signed_shadow_observation_changed",
        "carrier_work_changed"
      ],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "scope": {
          "const": "platform_global"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "policy_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "action": {
          "const": "configure_unattended_policy"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "changed": {
          "type": "boolean"
        },
        "mode_before": {
          "enum": [
            "Shadow",
            "Dry-run",
            "Paused"
          ]
        },
        "mode_after": {
          "enum": [
            "Shadow",
            "Dry-run",
            "Paused"
          ]
        },
        "emergency_stop_before": {
          "type": "boolean"
        },
        "emergency_stop_after": {
          "type": "boolean"
        },
        "reason_code": {
          "enum": [
            "operator_reviewed_configuration",
            "operator_emergency_stop",
            "operator_clear_future_stop"
          ]
        },
        "recorded_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "unattended_dispatch_available": {
          "const": false
        },
        "financial_action": {
          "const": false
        },
        "send_action": {
          "const": false
        },
        "approval_granted": {
          "const": false
        },
        "schedule_changed": {
          "const": false
        },
        "assisted_dispatch_changed": {
          "const": false
        },
        "signed_shadow_observation_changed": {
          "const": false
        },
        "carrier_work_changed": {
          "const": false
        }
      }
    },
    "lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "scope",
        "checked_at",
        "sample_valid_until",
        "request_id",
        "status",
        "receipt"
      ],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "scope": {
          "const": "platform_global"
        },
        "checked_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "sample_valid_until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "status": {
          "enum": [
            "recorded",
            "not_recorded",
            "in_progress"
          ]
        },
        "receipt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/receipt"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "recorded"
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "$ref": "#/$defs/receipt"
              }
            }
          },
          "else": {
            "properties": {
              "receipt": {
                "const": null
              }
            }
          }
        }
      ]
    }
  }
}
