{"sha":"17edfbf4423b83211b075acc23a7d8640da63449","node_id":"C_kwDOAA5HjtoAKDE3ZWRmYmY0NDIzYjgzMjExYjA3NWFjYzIzYTdkODY0MGRhNjM0NDk","commit":{"author":{"name":"Robert Haines","email":"rhaines@manchester.ac.uk","date":"2026-06-12T17:47:54Z"},"committer":{"name":"Robert Haines","email":"rhaines@manchester.ac.uk","date":"2026-06-13T08:50:58Z"},"message":"Prevent entries from being extracted outside specified directory.\n\nCrafted zips could be made to cause files to extracted outside the\nspecified destination directory. This commit tests final output\nlocation more robustly.\n\nFixes #664.","tree":{"sha":"6b84598a7d033d2dada2eac80f96a4e40896b73e","url":"https://api.github.com/repos/rubyzip/rubyzip/git/trees/6b84598a7d033d2dada2eac80f96a4e40896b73e"},"url":"https://api.github.com/repos/rubyzip/rubyzip/git/commits/17edfbf4423b83211b075acc23a7d8640da63449","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/rubyzip/rubyzip/commits/17edfbf4423b83211b075acc23a7d8640da63449","html_url":"https://github.com/rubyzip/rubyzip/commit/17edfbf4423b83211b075acc23a7d8640da63449","comments_url":"https://api.github.com/repos/rubyzip/rubyzip/commits/17edfbf4423b83211b075acc23a7d8640da63449/comments","author":{"login":"hainesr","id":143558,"node_id":"MDQ6VXNlcjE0MzU1OA==","avatar_url":"https://avatars.githubusercontent.com/u/143558?v=4","gravatar_id":"","url":"https://api.github.com/users/hainesr","html_url":"https://github.com/hainesr","followers_url":"https://api.github.com/users/hainesr/followers","following_url":"https://api.github.com/users/hainesr/following{/other_user}","gists_url":"https://api.github.com/users/hainesr/gists{/gist_id}","starred_url":"https://api.github.com/users/hainesr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hainesr/subscriptions","organizations_url":"https://api.github.com/users/hainesr/orgs","repos_url":"https://api.github.com/users/hainesr/repos","events_url":"https://api.github.com/users/hainesr/events{/privacy}","received_events_url":"https://api.github.com/users/hainesr/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"hainesr","id":143558,"node_id":"MDQ6VXNlcjE0MzU1OA==","avatar_url":"https://avatars.githubusercontent.com/u/143558?v=4","gravatar_id":"","url":"https://api.github.com/users/hainesr","html_url":"https://github.com/hainesr","followers_url":"https://api.github.com/users/hainesr/followers","following_url":"https://api.github.com/users/hainesr/following{/other_user}","gists_url":"https://api.github.com/users/hainesr/gists{/gist_id}","starred_url":"https://api.github.com/users/hainesr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hainesr/subscriptions","organizations_url":"https://api.github.com/users/hainesr/orgs","repos_url":"https://api.github.com/users/hainesr/repos","events_url":"https://api.github.com/users/hainesr/events{/privacy}","received_events_url":"https://api.github.com/users/hainesr/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c5909168af5f0fe3688f2cec8c2f43d997e5dc63","url":"https://api.github.com/repos/rubyzip/rubyzip/commits/c5909168af5f0fe3688f2cec8c2f43d997e5dc63","html_url":"https://github.com/rubyzip/rubyzip/commit/c5909168af5f0fe3688f2cec8c2f43d997e5dc63"}],"stats":{"total":19,"additions":18,"deletions":1},"files":[{"sha":"c2c3e3a18b5994453b0179d44d4dd7701551b1ab","filename":"lib/zip/entry.rb","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/rubyzip/rubyzip/blob/17edfbf4423b83211b075acc23a7d8640da63449/lib%2Fzip%2Fentry.rb","raw_url":"https://github.com/rubyzip/rubyzip/raw/17edfbf4423b83211b075acc23a7d8640da63449/lib%2Fzip%2Fentry.rb","contents_url":"https://api.github.com/repos/rubyzip/rubyzip/contents/lib%2Fzip%2Fentry.rb?ref=17edfbf4423b83211b075acc23a7d8640da63449","patch":"@@ -290,7 +290,7 @@ def extract(entry_path = @name, destination_directory: '.', &block)\n       dest_dir = ::File.absolute_path(destination_directory || '.')\n       extract_path = ::File.absolute_path(::File.join(dest_dir, entry_path))\n \n-      unless extract_path.start_with?(dest_dir)\n+      unless extract_path.start_with?(dest_dir + ::File::SEPARATOR) || dest_dir == ::File::SEPARATOR\n         warn \"WARNING: skipped extracting '#{@name}' to '#{extract_path}' as unsafe.\"\n         return self\n       end"},{"sha":"e99f4d92dcc8b6d619f2b4b81d6ddb18f0d175aa","filename":"test/data/path_traversal/out_evil.zip","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/rubyzip/rubyzip/blob/17edfbf4423b83211b075acc23a7d8640da63449/test%2Fdata%2Fpath_traversal%2Fout_evil.zip","raw_url":"https://github.com/rubyzip/rubyzip/raw/17edfbf4423b83211b075acc23a7d8640da63449/test%2Fdata%2Fpath_traversal%2Fout_evil.zip","contents_url":"https://api.github.com/repos/rubyzip/rubyzip/contents/test%2Fdata%2Fpath_traversal%2Fout_evil.zip?ref=17edfbf4423b83211b075acc23a7d8640da63449"},{"sha":"f475279c136de155751f19299ce643962a215706","filename":"test/path_traversal_test.rb","status":"modified","additions":17,"deletions":0,"changes":17,"blob_url":"https://github.com/rubyzip/rubyzip/blob/17edfbf4423b83211b075acc23a7d8640da63449/test%2Fpath_traversal_test.rb","raw_url":"https://github.com/rubyzip/rubyzip/raw/17edfbf4423b83211b075acc23a7d8640da63449/test%2Fpath_traversal_test.rb","contents_url":"https://api.github.com/repos/rubyzip/rubyzip/contents/test%2Fpath_traversal_test.rb?ref=17edfbf4423b83211b075acc23a7d8640da63449","patch":"@@ -199,4 +199,21 @@ def test_entry_name_with_tilde\n       assert File.exist?('~tilde~')\n     end\n   end\n+\n+  def test_prevent_breakout_of_declared_destination_directory\n+    dest_dir = 'out'\n+    in_tmpdir do |test_path|\n+      Dir.mkdir(dest_dir)\n+      Zip::File.open(File.join(TEST_FILE_ROOT, 'out_evil.zip')) do |zf|\n+        zf.each do |e|\n+          assert_output('', /WARNING: skipped extracting '\\.\\.\\/out_evil\\//) do\n+            e.extract(destination_directory: dest_dir)\n+          end\n+        end\n+      end\n+\n+      escaped = File.join(test_path, 'out_evil', 'breakout.txt')\n+      refute File.exist?(escaped)\n+    end\n+  end\n end"}]}