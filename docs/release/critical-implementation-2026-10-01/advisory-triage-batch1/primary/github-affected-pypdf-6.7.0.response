efan6419846/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"analyst"}],"cvss":{"vector_string":null,"score":null},"epss":{"percentage":0.00182,"percentile":0.06912}},{"ghsa_id":"GHSA-fwg2-594c-jp42","cve_id":"CVE-2026-71852","url":"https://api.github.com/advisories/GHSA-fwg2-594c-jp42","html_url":"https://github.com/advisories/GHSA-fwg2-594c-jp42","summary":"pypdf: Possible long runtimes/large memory usage for large CID font width ranges","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to long runtimes and large memory consumption. This requires parsing the font width entries of a font with unusually large values, for example during text extraction.\n\n### Patches\n\nThis has been fixed in [pypdf==6.15.0](https://github.com/py-pdf/pypdf/releases/tag/6.15.0).\n\n### Workarounds\n\nIf you cannot upgrade yet, consider applying the changes from PR [#3946](https://github.com/py-pdf/pypdf/pull/3946).","type":"reviewed","severity":"medium","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-fwg2-594c-jp42","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-fwg2-594c-jp42","type":"GHSA"},{"value":"CVE-2026-71852","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-fwg2-594c-jp42","https://github.com/py-pdf/pypdf/pull/3946","https://github.com/py-pdf/pypdf/commit/51cb6acf9e8a35b77e90b4d87d28fe3e1416d7d7","https://github.com/py-pdf/pypdf/releases/tag/6.15.0","https://github.com/advisories/GHSA-fwg2-594c-jp42"],"published_at":"2026-08-07T18:54:00Z","updated_at":"2026-08-07T18:54:00Z","github_reviewed_at":"2026-08-07T18:54:00Z","nvd_published_at":null,"withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pypdf"},"vulnerable_version_range":"< 6.15.0","first_patched_version":"6.15.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,