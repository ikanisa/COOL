op55555/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter"}],"cvss":{"vector_string":null,"score":null}},{"ghsa_id":"GHSA-w23x-9jrw-r45c","cve_id":"CVE-2026-103000","url":"https://api.github.com/advisories/GHSA-w23x-9jrw-r45c","html_url":"https://github.com/advisories/GHSA-w23x-9jrw-r45c","summary":"pypdf: Possible large memory usage when retrieving alphabetical page labels","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to large memory consumption. This requires accessing the page labels of a document with large alphabetical labels.\n\n### Patches\n\nThis has been fixed in [pypdf==6.19.0](https://github.com/py-pdf/pypdf/releases/tag/6.19.0).\n\n### Workarounds\n\nIf you cannot upgrade yet, consider applying the changes from PR [#4096](https://github.com/py-pdf/pypdf/pull/4096).","type":"reviewed","severity":"high","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-w23x-9jrw-r45c","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-w23x-9jrw-r45c","type":"GHSA"},{"value":"CVE-2026-103000","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-w23x-9jrw-r45c","https://nvd.nist.gov/vuln/detail/CVE-2026-103000","https://github.com/py-pdf/pypdf/pull/4096","https://github.com/py-pdf/pypdf/commit/0d8b5a8832cde1ba308b5c27567b879b7b7eed4a","https://github.com/py-pdf/pypdf/releases/tag/6.19.0","https://github.com/advisories/GHSA-w23x-9jrw-r45c"],"published_at":"2026-10-01T15:07:08Z","updated_at":"2026-10-01T15:07:09Z","github_reviewed_at":"2026-10-01T15:07:08Z","nvd_published_at":"2026-09-30T21:17:07Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pypdf"},"vulnerable_version_range":"< 6.19.0","first_patched_version":"6.19.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"C