://api.github.com/users/stefan6419846/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefan6419846/subscriptions","organizations_url":"https://api.github.com/users/stefan6419846/orgs","repos_url":"https://api.github.com/users/stefan6419846/repos","events_url":"https://api.github.com/users/stefan6419846/events{/privacy}","received_events_url":"https://api.github.com/users/stefan6419846/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"analyst"}],"cvss":{"vector_string":null,"score":null}},{"ghsa_id":"GHSA-fp3h-c4fm-7vvf","cve_id":"CVE-2026-102995","url":"https://api.github.com/advisories/GHSA-fp3h-c4fm-7vvf","html_url":"https://github.com/advisories/GHSA-fp3h-c4fm-7vvf","summary":"pypdf: Possible large memory usage for large /ToUnicode streams (Follow-up 2)","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to large memory consumption. This requires parsing the `/ToUnicode` entry of a font with unusually large values, for example during text extraction.\n\n### Patches\n\nThis has been fixed in [pypdf==6.18.1](https://github.com/py-pdf/pypdf/releases/tag/6.18.1).\n\n### Workarounds\n\nIf you cannot upgrade yet, consider applying the changes from PR [#4071](https://github.com/py-pdf/pypdf/pull/4071).","type":"reviewed","severity":"high","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-fp3h-c4fm-7vvf","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-fp3h-c4fm-7vvf","type":"GHSA"},{"value":"CVE-2026-102995","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-fp3h-c4fm-7vvf","https://nvd.nist.gov/vuln/detail/CVE-2026-102995","https://github.com/py-pdf/pypdf/pull/4071","https://github.com/py-pdf/pypdf/commit/319d0b823ce2c311a2435e9fd93c13994d32bb51","https://github.com/py-pdf/pypdf/releases/tag/6.18.1","https://github.com/advisories/GHSA-fp3h-c4fm-7v