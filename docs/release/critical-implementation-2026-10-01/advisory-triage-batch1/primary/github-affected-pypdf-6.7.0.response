inefficient decoding of ASCIIHexDecode streams","description":"### Impact\nAn attacker who uses this vulnerability can craft a PDF which leads to long runtimes. This requires accessing a stream which uses the `/ASCIIHexDecode` filter.\n\n### Patches\nThis has been fixed in [pypdf==6.7.5](https://github.com/py-pdf/pypdf/releases/tag/6.7.5).\n\n### Workarounds\nIf you cannot upgrade yet, consider applying the changes from PR [#3666](https://github.com/py-pdf/pypdf/pull/3666).","type":"reviewed","severity":"medium","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-9m86-7pmv-2852","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-9m86-7pmv-2852","type":"GHSA"},{"value":"CVE-2026-28804","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-9m86-7pmv-2852","https://github.com/py-pdf/pypdf/pull/3666","https://github.com/py-pdf/pypdf/releases/tag/6.7.5","https://nvd.nist.gov/vuln/detail/CVE-2026-28804","https://github.com/py-pdf/pypdf/commit/648c627d2657447dfb1773412af05a0a5103b98f","https://github.com/advisories/GHSA-9m86-7pmv-2852"],"published_at":"2026-03-02T22:03:45Z","updated_at":"2026-03-06T21:56:41Z","github_reviewed_at":"2026-03-02T22:03:45Z","nvd_published_at":"2026-03-06T07:16:01Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pypdf"},"vulnerable_version_range":"< 6.7.5","first_patched_version":"6.7.5","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N","score":6.9}},"cwes":[{"cwe_id":"CWE-407","name":"Inefficient Algorithmic Complexity"}],"credits":[{"user":{"login":"kule500","id":251544121,"node_id":"U_kgDODv5COQ","avatar_url":"https://avatars.githubusercontent.com/u/251544121?v=4","gravatar_id":"","url":"https://api.github.com/users/kule500","html_url":"https://github.com/kule500","follow