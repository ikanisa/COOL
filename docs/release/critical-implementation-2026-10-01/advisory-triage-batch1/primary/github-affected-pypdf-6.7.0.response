tps://api.github.com/users/stefan6419846/following{/other_user}","gists_url":"https://api.github.com/users/stefan6419846/gists{/gist_id}","starred_url":"https://api.github.com/users/stefan6419846/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefan6419846/subscriptions","organizations_url":"https://api.github.com/users/stefan6419846/orgs","repos_url":"https://api.github.com/users/stefan6419846/repos","events_url":"https://api.github.com/users/stefan6419846/events{/privacy}","received_events_url":"https://api.github.com/users/stefan6419846/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"analyst"}],"cvss":{"vector_string":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:H","score":6.5},"epss":{"percentage":0.00406,"percentile":0.32059}},{"ghsa_id":"GHSA-4pxv-j86v-mhcw","cve_id":"CVE-2026-41313","url":"https://api.github.com/advisories/GHSA-4pxv-j86v-mhcw","html_url":"https://github.com/advisories/GHSA-4pxv-j86v-mhcw","summary":"pypdf: Possible long runtimes for wrong size values in incremental mode","description":"### Impact\nAn attacker who uses this vulnerability can craft a PDF which leads to long runtimes. This requires loading a PDF with a large trailer `/Size` value in incremental mode.\n\n### Patches\nThis has been fixed in [pypdf==6.10.2](https://github.com/py-pdf/pypdf/releases/tag/6.10.2).\n\n### Workarounds\nIf you cannot upgrade yet, consider applying the changes from PR [#3735](https://github.com/py-pdf/pypdf/pull/3735).","type":"reviewed","severity":"medium","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-4pxv-j86v-mhcw","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-4pxv-j86v-mhcw","type":"GHSA"},{"value":"CVE-2026-41313","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-4pxv-j86v-mhcw","https://github.com/py-pdf/pypdf/pull/3735","https://github.com/py-pdf/pypdf/releases/tag/6.10.2","https://nvd.nist.gov/vuln/detail/CVE-2026-41313","https://github.com/py-pdf/pypdf/commit/c50a0104cf083356f7c7f5d61410466a57f5c88a","https://github.com/advisories/GHSA-4pxv-j86v-mhcw"],"published_at":"2026-04-16T21:30:12Z","updated_at":"2026-05-05T15:44:21Z","github_reviewed_at":"2026-04-16T21:30:12Z","nvd_published_at":"2026-04-22T22:16:32Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pypdf"},"vulnerable_version_range":"< 6.10.2","first_patched_version":"6.10.2","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:H","score":6.5},"cvss_v4":{"vector_string":"CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:P/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N","score":6.8}},"cwes":[{"cwe_id":"CWE-834","name":"Excessive Iteration"}],"credits":[{"user":{"login":"l3b4nk4","id":225318593,"node_id":"U_kgDODW4WwQ","avatar_url":"https://avatars.githubusercontent.com/u/225318593?v=4","gravatar_id":"","url":"https://api.github.com/users/l3b4nk4","html_url":"https://github.com/l3b4nk4","followers_url":"https://api.github.com/users/l3b4nk4/followers","following_url":"https://api.github.com/users/l3b4nk4/following{/other_user}","gists_url":"https://api.github.com/users/l3b4nk4/gists{/gist_id}","starred_url":"https://api.github.com/users/l3b4nk4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/l3b4nk4/subscriptions","organizations_url":"https://api.github.com/users/l3b4nk4/orgs","repos_url":"https://api.github.com/users/l3b4nk4/repos","events_url":"https://api.github.com/users/l3b4nk4/events{/privacy}","received_events_url":"https://api.github.com/users/l3b4nk4/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter"},{"user":{"login":"stefan6419846","id":96178532,"node_id":"U_kgDOBbuRZA","avatar_url":"https://avatars.githubusercontent.com/u/96178532?v=4","gravatar_id":"","url":"https://api.github.com/users/stefan6419846","html_url":"https://github.com/stefan6419846","followers_url":"https://api.github.com/users/stefan6419846/followers","following_url":"https://api.github.com/users/stefan6419846/following{/other_user}","gists_url":"https://api.github.com/users/stefan6419846/gists{/gist_id}","starred_url":"https://api.github.com/users/stefan6419846/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefan6419846/subscriptions","organizations_url":"https://api.github.com/users/stefan6419846/orgs","repos_url":"https://api.github.com/users/stefan6419846/repos","events_url":"https://api.github.com/users/stefan6419846/events{/privacy}","received_events_url":"https://api.github.com/users/stefan6419846/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"analyst"}],"cvss":{"vector_string":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:H","score":6.5},"epss":{"percentage":0.00384,"percentile":0.29599}},{"ghsa_id":"GHSA-7gw9-cf7v-778f","cve_id":"CVE-2026-41312","url":"https://api.github.com/advisories/GHSA-7gw9-cf7v-778f","html_url":"https://github.com/advisories/GHSA-7gw9-cf7v-778f","summary":"pypdf: Manipulated FlateDecode predictor parameters can exhaust RAM","description":"### Impact\nAn attacker who uses this vulnerability can craft a PDF which leads to the RAM being exhausted. This requires accessing a stream compressed using `/FlateDecode` with a `/Predictor` unequal 1 and large predictor parameters.\n\n### Patches\nThis has been fixed in [pypdf==6.10.2](https://github.com/py-pdf/pypdf/releases/tag/6.10.2).\n\n### Workarounds\nIf you cannot upgrade yet, consider applying the changes from PR [#3734](https://github.com/py-pdf/pypdf/pull/3734).","type":"reviewed","severity":"medium","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-7gw9-cf7v-778f","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-7gw9-cf7v-778f","type":"GHSA"},{"value":"CVE-2026-41312","type":"CVE"}],"references":["htt