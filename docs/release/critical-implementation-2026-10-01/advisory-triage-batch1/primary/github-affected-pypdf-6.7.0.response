t_id}","starred_url":"https://api.github.com/users/stefan6419846/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefan6419846/subscriptions","organizations_url":"https://api.github.com/users/stefan6419846/orgs","repos_url":"https://api.github.com/users/stefan6419846/repos","events_url":"https://api.github.com/users/stefan6419846/events{/privacy}","received_events_url":"https://api.github.com/users/stefan6419846/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"analyst"}],"cvss":{"vector_string":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:L","score":3.3},"epss":{"percentage":0.00172,"percentile":0.05799}},{"ghsa_id":"GHSA-cj93-chg6-vgv8","cve_id":"CVE-2026-48155","url":"https://api.github.com/advisories/GHSA-cj93-chg6-vgv8","html_url":"https://github.com/advisories/GHSA-cj93-chg6-vgv8","summary":"pypdf: Possible large memory usage for large offsets for layout mode text","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to large memory usage. This requires extracting text in layout mode with large character offsets.\n\n### Patches\n\nThis has been fixed in [pypdf==6.12.0](https://github.com/py-pdf/pypdf/releases/tag/6.12.0).\n\n### Workarounds\n\nIf developers are unable to immediately upgrade, they should consider applying the changes from PR [#3790](https://github.com/py-pdf/pypdf/pull/3790).","type":"reviewed","severity":"medium","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-cj93-chg6-vgv8","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-cj93-chg6-vgv8","type":"GHSA"},{"value":"CVE-2026-48155","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-cj93-chg6-vgv8","https://nvd.nist.gov/vuln/detail/CVE-2026-48155","https://github.com/py-pdf/pypdf/pull/3790","https://github.com/py-pdf/pypdf/releases/tag/6.12.0","https://github.com/advisories/GHSA-cj93-chg6-vgv8"],"published_at":"2026-06-12T18:29:15Z","updated_at":"2026-06-12T18:29:16Z","github_reviewed_at":"2026-06-12T18:29:15Z","nvd_published_at":"2026-05-28T16:16:28Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pypdf"},"vulnerable_version_range":"< 6.12.0","first_patched_version":"6.12.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:P/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N","score":4.8}},"cwes":[{"cwe_id":"CWE-400","name":"Uncontrolled Resource Consumption"}],"credits":[{"user":{"login":"sondt99","id":87920408,"node_id":"MDQ6VXNlcjg3OTIwNDA4","avatar_url":"https://avatars.githubusercontent.com/u/87920408?v=4","gravatar_id":"","url":"https://api.github.com/users/sondt99","html_url":"https://github.com/sondt99","followers_url":"https://api.github.com/users/sondt99/followers","following_url":"https://api.github.com/users/sondt99/following{/other_user}","gists_url":"https://api.github.com/users/sondt99/gists{/gist_id}","starred_url":"https://api.github.com/users/sondt99/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sondt99/subscriptions","organizations_url":"https://api.github.com/users/sondt99/orgs","repos_url":"https://api.github.com/users/sondt99/repos","events_url":"https://api.github.com/users/sondt99/events{/privacy}","received_events_url":"https://api.github.com/users/sondt99/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter"},{"user":{"login":"stefan6419846","id":96178532,"node_id":"U_kgDOBbuRZA","avatar_url":"https://avatars.githubusercontent.com/u/96178532?v=4","gravatar_id":"","url":"https://api.github.com/users/stefan6419846","html_url":"https://github.com/stefan6419846","followers_url":"https://api.github.com/users/stefan6419846/followers","following_url":"https://api.github.com/users/stefan6419846/following{/other_user}","gists_url":"https://ap