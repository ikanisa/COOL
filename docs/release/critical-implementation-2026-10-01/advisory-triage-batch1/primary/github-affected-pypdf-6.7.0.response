ercentage":0.00644,"percentile":0.48698}},{"ghsa_id":"GHSA-2rw7-x74f-jg35","cve_id":"CVE-2026-27628","url":"https://api.github.com/advisories/GHSA-2rw7-x74f-jg35","html_url":"https://github.com/advisories/GHSA-2rw7-x74f-jg35","summary":"pypdf has a possible infinite loop when loading circular /Prev entries in cross-reference streams","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to an infinite loop. This requires reading the file.\n\n### Patches\n\nThis has been fixed in [pypdf==6.7.2](https://github.com/py-pdf/pypdf/releases/tag/6.7.2).\n\n### Workarounds\n\nIf users cannot upgrade yet, consider applying the changes from PR [#3655](https://github.com/py-pdf/pypdf/pull/3655).","type":"reviewed","severity":"low","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-2rw7-x74f-jg35","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-2rw7-x74f-jg35","type":"GHSA"},{"value":"CVE-2026-27628","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-2rw7-x74f-jg35","https://nvd.nist.gov/vuln/detail/CVE-2026-27628","https://github.com/py-pdf/pypdf/issues/3654","https://github.com/py-pdf/pypdf/commit/f0a462d36971cf077d74492a348d0d06fd60ea4d","https://github.com/advisories/GHSA-2rw7-x74f-jg35"],"published_at":"2026-02-25T16:09:03Z","updated_at":"2026-02-25T16:09:03Z","github_reviewed_at":"2026-02-25T16:09:03Z","nvd_published_at":"2026-02-25T03:16:06Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pypdf"},"vulnerable_version_range":"< 6.7.2","first_patched_version":"6.7.2","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:A/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N/E:U","score":1.2}},"cwes":[{"cwe_id":"CWE-835","name":"Loop with Unreachable Exit Condition ('Infinite Loop')"}],"credits":[{"user":{"login":"rampageservices","id":20424586,"node_id":"MDQ6VXNlcjIwNDI0NTg2","avatar_url":"https://avatars.githubusercontent.com/u/20424586?v=4","gravatar_id":"","url":"https://api.github.com/users/rampageservices","html_url":"https://github.com/rampageservices","followers_url":"https://api.github.com/users/rampageservices/followers","following_url":"https://api.github.com/users/rampageservices/following{/other_user}","gists_url":"https://api.github.com/users/rampageservices/gists{/gist_id}","starred_url":"https://api.github.com/users/rampageservices/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rampageservices/subscriptions","organizations_url":"https://api.github.com/users/rampageservices/orgs","repos_url":"https://api.github.com/users/rampageservices/repos","events_url":"https://api.github.com/users/rampageservices/events{/privacy}","received_events_url":"https://api.github.com/users/rampageservices/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter"}],"cvss":{"vector_string":null,"score":null},"epss":{"percentage":0.00606,"percentile":0.46679}},{"ghsa_id":"GHSA-9mvc-8737-8j8h","cve_id":"CVE-2026-27026","url":"https://api.github.com/advisories/GHSA-9mvc-8737-8j8h","html_url":"https://github.com/advisories/GHSA-9mvc-8737-8j8h","summary":"pypdf possibly has long runtimes for malformed FlateDecode streams","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to long runtimes. This requires a malformed `/FlateDecode` stream, where the byte-by-byte decompression is used.\n\n### Patches\n\nThis has been fixed in [pypdf==6.7.1](https://github.com/py-pdf/pypdf/releases/tag/6.7.1).\n\n### Workarounds\n\nIf you cannot upgrade yet, consider applying the changes from PR [#3644](https://github.com/py-pdf/pypdf/pull/3644).","type":"reviewed","severity":"medium","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-9mvc-8737-8j8h","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-9mvc-8737-8j8h","type":"GHSA"},{"value":"CVE-2026-27026","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-9mvc-8737-8j8h","https://github.com/py-pdf/pypdf/pull/3644","https://github.com/py-pdf/pypdf/commit/7905842d833f899f1d3228af7e7467ad80277016","https://github.com/py-pdf/pypdf/releases/tag/6.7.1","https://nvd.nist.gov/vuln/detail/CVE-2026-27026","https://github.com/advisories/GHSA-9mvc-8737-8j8h"],"published_at":"2026-02-18T22:41:24Z","updated_at":"2026-02-23T22:21:05Z","github_reviewed_at":"2026-02-18T22:41:24Z","nvd_published_at":"2026-02-20T22:16:29Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pypdf"},"vulnerable_version_range":"< 6.7.1","first_patched_version":"6.7.1","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N","score":6.9}},"cwes":[{"cwe_id":"CWE-770","name":"Allocation of Resources Without Limits or Throttling"}],"credits":[{"user":{"login":"CheonWoong-Park","id":87147136,"node_id":"MDQ6VXNlcjg3MTQ3MTM2","avatar_url":"https://avatars.githubusercontent.com/u/87147136?v=4","gravatar_id":"","url":"https://api.github.com/users/CheonWoong-Park","html_url":"https://github.com/CheonWoong-Park","followers_url":"https://api.github.com/users/CheonWoong-Park/followers","following_url":"https://api.github.com/users/CheonWoong-Park/following{/other_user}","gists_url":"https://api.github.com/users/CheonWoong-Park/gists{/gist_id}","starred_url":"https://api.github.com/users/CheonWoong-Park/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CheonWoong-Park/subscriptions","organizations_url":"https://api.github.com/users/CheonWoong-Park/orgs","repos_url":"https://api.github.com/users/CheonWoong-Park/repos","events_url":"https://api.github.com/users/CheonWoong-Park/events{/privacy}","received_events_url":"https://api.github.com/users/CheonWoong-Park/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter"},{"user":{"login":"stefan6419846","id":96178532,"node_id":"U_kgDOBbuRZA","avatar_url":"https://avatars.githubusercontent.com/u/96178532?v=4","gravatar_id":"","url":"https://api.github.com/users/stefan6419846","html_url":"https://github.com/stefan6419846","followers_url":"https://api.github.com/users/stefan6419846/followers","following_url":"https://api.github.com/users/stefan6419846/following{/other_user}","gists_url":"https://api.github.com/users/stefan6419846/gists{/gist_id}","starred_url":"https://api.github.com/users/stefan6419846/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefan6419846/subscriptions","organizations_url":"https://api.github.com/users/stefan6419846/orgs","repos_url":"https://api.github.com/users/stefan6419846/repos","events_url":"https://api.github.com/users/stefan6419846/events{/privacy}","received_events_url":"https://api.github.com/users/stefan6419846/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"analyst"}],"cvss":{"vector_string":null,"score":null},"epss":{"percentage":0.00184,"percentile":0.07056}},{"ghsa_id":"GHSA-wgvp-vg3v-2xq3","cve_id":"CVE-2026-27025","url":"https://api.github.com/advisories/GHSA-wgvp-vg3v-2xq3","html_url":"https://github.com/advisories/GHSA-wgvp-vg3v-2xq3","summary":"pypdf has possible long runtimes/large memory usage for large /ToUnicode streams","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to long runtimes and large memory consumption. This requires parsing the `/ToUnicode` entry of a font with unusually large values, for example during text extraction.\n\n### Patches\n\nThis has been fixed in [pypdf==6.7.1](https://github.com/py-pdf/pypdf/releases/tag/6.7.1).\n\n### Workarounds\n\nIf you cannot upgrade yet, consider a