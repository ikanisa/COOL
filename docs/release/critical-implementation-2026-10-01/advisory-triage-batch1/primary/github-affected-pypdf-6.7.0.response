[{"ghsa_id":"GHSA-v247-6f48-mgcj","cve_id":"CVE-2026-102999","url":"https://api.github.com/advisories/GHSA-v247-6f48-mgcj","html_url":"https://github.com/advisories/GHSA-v247-6f48-mgcj","summary":"pypdf: Possible long runtimes with large amount of embedded files","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to long runtimes. This requires accessing the embedded files through the dictionary-based API.\n\n### Patches\n\nThis has been fixed in [pypdf==6.19.0](https://github.com/py-pdf/pypdf/releases/tag/6.19.0).\n\n### Workarounds\n\nIf you cannot upgrade yet, consider applying the changes from PR [#4081](https://github.com/py-pdf/pypdf/pull/4081).","type":"reviewed","severity":"high","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-v247-6f48-mgcj","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-v247-6f48-mgcj","type":"GHSA"},{"value":"CVE-2026-102999","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-v247-6f48-mgcj","https://nvd.nist.gov/vuln/detail/CVE-2026-102999","https://github.com/py-pdf/pypdf/pull/4081","https://github.com/py-pdf/pypdf/commit/6b10556d13609a68f9ed18bb29fdd8bba88eb2c3","https://github.com/py-pdf/pypdf/releases/tag/6.19.0","https://github.com/advisories/GHSA-v247-6f48-mgcj"],"published_at":"2026-10-01T15:07:35Z","updated_at":"2026-10-01T15:07:36Z","github_reviewed_at":"2026-10-01T15:07:35Z","nvd_published_at":"2026-09-30T21:17:07Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pypdf"},"vulnerable_version_range":"< 6.19.0","first_patched_version":"6.19.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N","score":8.7}},"cwes":[{"cwe_id":"CWE-400","name":"Uncontrolled Resource Consumption"},{"cwe_id":"CWE-407","name":"Inefficient Algorithmic Complexity"}],"credits":[{"user":{"login":"jungmingi-lab","id":144507497,"node_id":"U_kgDOCJ0CaQ","avatar_url":"https://avatars.githubusercontent.com/u/144507497?v=4","gravatar_id":"","url":"https://api.github.com/users/jungmingi-lab","html_url":"https://github.com/jungmingi-lab","followers_url":"https://api.github.com/users/jungmingi-lab/followers","following_url":"https://api.github.com/users/jungmingi-lab/following{/other_user}","gists_url":"https://api.github.com/users/jungmingi-lab/gists{/gist_id}","starred_url":"https://api.github.com/users/jungmingi-lab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jungmingi-lab/subscriptions","organizations_url":"https://api.github.com/users/jungmingi-lab/orgs","repos_url":"https://api.github.com/users/jungmingi-lab/repos","events_url":"https://api.github.com/users/jungmingi-lab/events{/privacy}","received_events_url":"https://api.github.com/users/jungmingi-lab/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter"}],"cvss":{"vector_string":null,"score":null}},{"ghsa_id":"GHSA-php9-fj8v-98fj","cve_id":"CVE-2026-102998","url":"https://api.github.com/advisories/GHSA-php9-fj8v-98fj","html_url":"https://github.com/advisories/GHSA-php9-fj8v-98fj","summary":"pypdf: Possible long runtimes when generating appearance streams","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to long runtimes. This requires updating form field values with flattening enabled, which triggers appearance stream generation.\n\n### Patches\n\nThis has been fixed in [pypdf==6.19.0](https://github.com/py-pdf/pypdf/releases/tag/6.19.0).\n\n### Workarounds\n\nIf you cannot upgrade yet, consider applying the changes from PR [#4087](https://github.com/py-pdf/pypdf/pull/4087).","type":"reviewed","severity":"high","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-php9-fj8v-98fj","sourc