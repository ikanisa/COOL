ic","site_admin":false},"type":"reporter"}],"cvss":{"vector_string":null,"score":null},"epss":{"percentage":0.00182,"percentile":0.06911}},{"ghsa_id":"GHSA-763m-79hh-57f2","cve_id":"CVE-2026-84311","url":"https://api.github.com/advisories/GHSA-763m-79hh-57f2","html_url":"https://github.com/advisories/GHSA-763m-79hh-57f2","summary":"pypdf: Possible long runtimes/large memory usage when extracting XForm objects","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to long runtimes and large memory consumption. This requires extracting the text of a page with lots of XForm objects, where some of them might be re-used.\n\n### Patches\n\nThis has been fixed in [pypdf==6.16.1](https://github.com/py-pdf/pypdf/releases/tag/6.16.1).\n\n### Workarounds\n\nIf you cannot upgrade yet, consider applying the changes from PR [#3966](https://github.com/py-pdf/pypdf/pull/3966).","type":"reviewed","severity":"medium","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-763m-79hh-57f2","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-763m-79hh-57f2","type":"GHSA"},{"value":"CVE-2026-84311","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-763m-79hh-57f2","https://github.com/py-pdf/pypdf/pull/3966","https://github.com/py-pdf/pypdf/commit/d91ab705fd81ed1a9cec175c6958600dea1a4942","https://github.com/py-pdf/pypdf/releases/tag/6.16.1","https://github.com/advisories/GHSA-763m-79hh-57f2"],"published_at":"2026-09-01T21:27:22Z","updated_at":"2026-09-01T21:27:24Z","github_reviewed_at":"2026-09-01T21:27:22Z","nvd_published_at":null,"withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pypdf"},"vulnerable_version_range":"< 6.16.1","first_patched_version":"6.16.1","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:P/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N","score":4.8}},"cwes":[{"cwe_id":"CWE-834","name":"Excessive Iteration"}],"credits":[{"user":{"login":"zikk090","id":57931368,"node_id":"MDQ6VXNlcjU3OTMxMzY4","avatar_url":"https://avatars.githubusercontent.com/u/57931368?v=4","gravatar_id":"","url":"https://api.github.com/users/zikk090","html_url":"https://github.com/zikk090","followers_url":"https://api.github.com/users/zikk090/followers","following_url":"https://api.github.com/users/zikk090/following{/other_user}","gists_url":"https://api.github.com/users/zikk090/gists{/gist_id}","starred_url":"https://api.github.com/users/zikk090/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zikk090/subscriptions","organizations_url":"https://api.github.com/users/zikk090/orgs","repos_url":"https://api.github.com/users/zikk090/repos","events_url":"https://api.github.com/users/zikk090/events{/privacy}","received_events_url":"https://api.github.com/users/zikk090/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter"},{"user":{"login":"stefan6419846","id":96178532,"node_id":"U_kgDOBbuRZA","avatar_url":"https://avatars.githubusercontent.com/u/96178532?v=4","gravatar_id":"","url":"https://api.github.com/users/stefan6419846","html_url":"https://github.com/stefan6419846","followers_url":"https://api.github.com/users/stefan6419846/followers","following_url":"https://api.github.com/users/stefan6419846/following{/other_user}","gists_url":"https://api.github.com/users/stefan6419846/gists{/gist_id}","starred_url":"https://api.github.com/users/stefan6419846/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefan6419846/subscriptions","organizations_url":"https://api.github.com/users/stefan6419846/orgs","repos_url":"https://api.github.com/users/stefan6419846/repos","events_url":"https://api.github.com/users/stefan6419846/events{/privacy}","received_events_url":"https://api.github.com/users/stefan6419846/received_events","typ