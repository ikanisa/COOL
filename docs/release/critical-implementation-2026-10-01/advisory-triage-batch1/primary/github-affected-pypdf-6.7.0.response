6/gists{/gist_id}","starred_url":"https://api.github.com/users/stefan6419846/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefan6419846/subscriptions","organizations_url":"https://api.github.com/users/stefan6419846/orgs","repos_url":"https://api.github.com/users/stefan6419846/repos","events_url":"https://api.github.com/users/stefan6419846/events{/privacy}","received_events_url":"https://api.github.com/users/stefan6419846/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"analyst"}],"cvss":{"vector_string":null,"score":null},"epss":{"percentage":0.00174,"percentile":0.06037}},{"ghsa_id":"GHSA-52x6-gq3r-vpf4","cve_id":"CVE-2026-54530","url":"https://api.github.com/advisories/GHSA-52x6-gq3r-vpf4","html_url":"https://github.com/advisories/GHSA-52x6-gq3r-vpf4","summary":"pypdf: Possible infinite loop when retrieving fonts for layout-mode text extraction","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to an infinite loop. This requires extracting the text in layout mode.\n\n### Patches\n\nThis has been fixed in [pypdf==6.13.0](https://github.com/py-pdf/pypdf/releases/tag/6.13.0).\n\n### Workarounds\n\nIf you cannot upgrade yet, consider applying the changes from PR [#3830](https://github.com/py-pdf/pypdf/pull/3830).","type":"reviewed","severity":"medium","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-52x6-gq3r-vpf4","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-52x6-gq3r-vpf4","type":"GHSA"},{"value":"CVE-2026-54530","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-52x6-gq3r-vpf4","https://github.com/py-pdf/pypdf/pull/3830","https://github.com/py-pdf/pypdf/releases/tag/6.13.0","https://github.com/advisories/GHSA-52x6-gq3r-vpf4"],"published_at":"2026-06-16T14:05:40Z","updated_at":"2026-06-16T14:05:43Z","github_reviewed_at":"2026-06-16T14: