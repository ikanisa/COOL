:"https://api.github.com/users/stefan6419846/gists{/gist_id}","starred_url":"https://api.github.com/users/stefan6419846/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefan6419846/subscriptions","organizations_url":"https://api.github.com/users/stefan6419846/orgs","repos_url":"https://api.github.com/users/stefan6419846/repos","events_url":"https://api.github.com/users/stefan6419846/events{/privacy}","received_events_url":"https://api.github.com/users/stefan6419846/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"analyst"}],"cvss":{"vector_string":null,"score":null},"epss":{"percentage":0.0062,"percentile":0.47577}},{"ghsa_id":"GHSA-55h5-xmcq-c37v","cve_id":"CVE-2026-59937","url":"https://api.github.com/advisories/GHSA-55h5-xmcq-c37v","html_url":"https://github.com/advisories/GHSA-55h5-xmcq-c37v","summary":"pypdf: Possible long runtimes for repeated malformed cross-reference entries ","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to long runtimes. This requires cross-reference streams with repeated malformed cross-reference streams.\n\n### Patches\n\nThis has been fixed in [pypdf==6.14.0](https://github.com/py-pdf/pypdf/releases/tag/6.14.0).\n\n### Workarounds\n\nIf you cannot upgrade yet, consider applying the changes from PR [#3887](https://github.com/py-pdf/pypdf/pull/3887).","type":"reviewed","severity":"medium","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-55h5-xmcq-c37v","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-55h5-xmcq-c37v","type":"GHSA"},{"value":"CVE-2026-59937","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-55h5-xmcq-c37v","https://nvd.nist.gov/vuln/detail/CVE-2026-59937","https://github.com/py-pdf/pypdf/pull/3887","https://github.com/py-pdf/pypdf/commit/b5fc5aa714f4b696fb9b1deaa35a9e4a4eb50dae","https://github.com/py-pdf/pypdf/releases/tag/6.14.0","https://github.com/advisories/GHSA-55h5-xmcq-c37v"],"published_at":"2026-07-23T15:07:33Z","updated_at":"2026-07-23T15:07:34Z","github_reviewed_at":"2026-07-23T15:07:33Z","nvd_published_at":"2026-07-08T18:16:34Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pypdf"},"vulnerable_version_range":"< 6.14.0","first_patched_version":"6.14.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N","score":6.9}},"cwes":[{"cwe_id":"CWE-400","name":"Uncontrolled Resource Consumption"}],"credits":[{"user":{"login":"akahane0x46","id":28664392,"node_id":"MDQ6VXNlcjI4NjY0Mzky","avatar_url":"https://avatars.githubusercontent.com/u/28664392?v=4","gravatar_id":"","url":"https://api.github.com/users/akahane0x46","html_url":"https://github.com/akahane0x46","followers_url":"https://api.github.com/users/akahane0x46/followers","following_url":"https://api.github.com/users/akahane0x46/following{/other_user}","gists_url":"https://api.github.com/users/akahane0x46/gists{/gist_id}","starred_url":"https://api.github.com/users/akahane0x46/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akahane0x46/subscriptions","organizations_url":"https://api.github.com/users/akahane0x46/orgs","repos_url":"https://api.github.com/users/akahane0x46/repos","events_url":"https://api.github.com/users/akahane0x46/events{/privacy}","received_events_url":"https://api.github.com/users/akahane0x46/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter"},{"user":{"login":"stefan6419846","id":96178532,"node_id":"U_kgDOBbuRZA","avatar_url":"https://avatars.githubusercontent.com/u/96178532?v=4","gravatar_id":"","url":"https://api.github.com/users/stefan6419846","html_url":"https://github.com/stefan6419846","followers_url":"https://api.github.com/users/stefan6419846/followers","following_url":"https://api.github.com/users/stefan6419846/following{/other_user}","gists_url":"https://api.github.com/users/stefan6419846/gists{/gist_id}","starred_url":"https://api.github.com/users/stefan6419846/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stefan6419846/subscriptions","organizations_url":"https://api.github.com/users/stefan6419846/orgs","repos_url":"https://api.github.com/users/stefan6419846/repos","events_url":"https://api.github.com/users/stefan6419846/events{/privacy}","received_events_url":"https://api.github.com/users/stefan6419846/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"analyst"}],"cvss":{"vector_string":null,"score":null},"epss":{"percentage":0.0062,"percentile":0.47577}},{"ghsa_id":"GHSA-5qjq-93h5-hrgp","cve_id":"CVE-2026-59938","url":"https://api.github.com/advisories/GHSA-5qjq-93h5-hrgp","html_url":"https://github.com/advisories/GHSA-5qjq-93h5-hrgp","summary":"pypdf: Possible large memory usage for wrong image dimensions","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to large memory usage. This requires loading images where the declared size values are much too large compared to the actual data.\n\n### Patches\n\nThis has been fixed in [pypdf==6.14.0](https://github.com/py-pdf/pypdf/releases/tag/6.14.0).\n\n### Workarounds\n\nIf you cannot upgrade yet, consider applying the changes from PR [#3888](https://github.com/py-pdf/pypdf/pull/3888).","type":"reviewed","severity":"medium","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-5qjq-93h5-hrgp","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-5qjq-93h5-hrgp","type":"GHSA"},{"value":"CVE-2026-59938","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-5qjq-93h5-hrgp","https://nvd.nist.gov/vuln/detail/CVE-2026-59938","https://github.com/py-pdf/pypdf/pull/3888","https://github.com/py-pdf/pypdf/commit/c64583be16b8e8763d8777075f8ecbf382014b7a","https://github.com/py-pdf/pypdf/releases/tag/6.14.0","https://github.com/advisories/GHSA-5qjq-93h5-hrgp"],"published_at":"2026-07-23T15:06:58Z","updated_at":"2026-07-23T15:06:59Z","github_reviewed_at":"2026-07-23T15:06:58Z","nvd_published_at":"2026-07-08T18:16:35Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pypdf"},"vulnerable_version_range":"< 6.14.0","first_patched_version":"6.14.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N","score":6.9}},"cwes":[{"cwe_id":"CWE-789","name":"Memory Allocation with Excessive Size Value"}],"credits":[{"user":{"login":"MR-SS","id":63229508,"node_id":"MDQ6VXNlcjYzMjI5NTA4","avatar_url":"https://avatars.githubusercontent.com/u/63229508?v=4","gravatar_id":"","url":"https://api.github.com/users/MR-SS","html_url":"https://github.com/MR-SS","followers_url":"https://api.github.com/users/MR-SS/followers","following_url":"https://api.github.com/users/MR-SS/following{/other_user}","gists_url":"https://api.github.com/users/MR-SS/gists{/gist_id}","starred_url":"https://api.github.com/users/MR-SS/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MR-SS/subscriptions","organizations_url":"https://api.github.com/users/MR-SS/orgs","repos_url":"https://api.github.com/users/MR-SS/repos","events_url":"https://api.github.com/users/MR-SS/events{/privacy}","received_events_url":"https://api.github.com/users/MR-SS/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter"},{"user":{"login":"stefan6419846","id":96178532,"node_id":"U_kgDOBbuRZA","avatar_url":"https://avatars.githubusercontent.com/u/96178532?v=4","gravatar_id":"","url":"https://api.github.com/users/stefan6419846","html_url":"https://github.com/stefan6419846","f