n6419846/subscriptions","organizations_url":"https://api.github.com/users/stefan6419846/orgs","repos_url":"https://api.github.com/users/stefan6419846/repos","events_url":"https://api.github.com/users/stefan6419846/events{/privacy}","received_events_url":"https://api.github.com/users/stefan6419846/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"analyst"}],"cvss":{"vector_string":null,"score":null}},{"ghsa_id":"GHSA-g9cg-prrw-2r8q","cve_id":"CVE-2026-102996","url":"https://api.github.com/advisories/GHSA-g9cg-prrw-2r8q","html_url":"https://github.com/advisories/GHSA-g9cg-prrw-2r8q","summary":"pypdf: Possible large memory usage when parsing font data","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to large memory consumption. This requires parsing the `/Widths` entry of a TrueType or Type1 fonts with unusually large values, for example during text extraction.\n\n### Patches\n\nThis has been fixed in [pypdf==6.18.1](https://github.com/py-pdf/pypdf/releases/tag/6.18.1).\n\n### Workarounds\n\nIf you cannot upgrade yet, consider applying the changes from PR [#4072](https://github.com/py-pdf/pypdf/pull/4072).","type":"reviewed","severity":"high","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-g9cg-prrw-2r8q","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-g9cg-prrw-2r8q","type":"GHSA"},{"value":"CVE-2026-102996","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-g9cg-prrw-2r8q","https://nvd.nist.gov/vuln/detail/CVE-2026-102996","https://github.com/py-pdf/pypdf/pull/4072","https://github.com/py-pdf/pypdf/commit/0fb26eb8cdd01c44b3b2c9fe8329751be2f7cfd5","https://github.com/py-pdf/pypdf/releases/tag/6.18.1","https://github.com/advisories/GHSA-g9cg-prrw-2r8q"],"published_at":"2026-10-01T15:06:13Z","updated_at":"2026-10-01T15:06:14Z","github_reviewed_at":"2026-10-01T15:06:13Z