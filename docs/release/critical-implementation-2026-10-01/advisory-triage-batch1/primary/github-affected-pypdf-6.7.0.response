d_events_url":"https://api.github.com/users/stefan6419846/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"analyst"}],"cvss":{"vector_string":null,"score":null}},{"ghsa_id":"GHSA-jw7q-gvrg-4vj3","cve_id":"CVE-2026-102997","url":"https://api.github.com/advisories/GHSA-jw7q-gvrg-4vj3","html_url":"https://github.com/advisories/GHSA-jw7q-gvrg-4vj3","summary":"pypdf: Possible long runtimes for partially malformed FlateDecode streams (Follow-up)","description":"### Impact\n\nAn attacker who uses this vulnerability can craft a PDF which leads to long runtimes. This requires a partially malformed `/FlateDecode` stream, where the byte-by-byte decompression is used.\n\n### Patches\n\nThis has been fixed in [pypdf==6.18.1](https://github.com/py-pdf/pypdf/releases/tag/6.18.1).\n\n### Workarounds\n\nIf you cannot upgrade yet, consider applying the changes from PR [#4073](https://github.com/py-pdf/pypdf/pull/4073).","type":"reviewed","severity":"high","repository_advisory_url":"https://api.github.com/repos/py-pdf/pypdf/security-advisories/GHSA-jw7q-gvrg-4vj3","source_code_location":"https://github.com/py-pdf/pypdf","identifiers":[{"value":"GHSA-jw7q-gvrg-4vj3","type":"GHSA"},{"value":"CVE-2026-102997","type":"CVE"}],"references":["https://github.com/py-pdf/pypdf/security/advisories/GHSA-jw7q-gvrg-4vj3","https://nvd.nist.gov/vuln/detail/CVE-2026-102997","https://github.com/py-pdf/pypdf/pull/4073","https://github.com/py-pdf/pypdf/commit/d9d38cf99b115deb562d3b68f36c33027bc04f79","https://github.com/py-pdf/pypdf/releases/tag/6.18.1","https://github.com/advisories/GHSA-jw7q-gvrg-4vj3"],"published_at":"2026-10-01T15:06:33Z","updated_at":"2026-10-01T15:06:34Z","github_reviewed_at":"2026-10-01T15:06:33Z","nvd_published_at":"2026-09-30T21:17:07Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pypdf"},"vulnerable_version_range":"< 6.18.1","first_patched_version":"6.18.1","vulnerable_functions":[]}],"cvss_severities":{"cvss_v