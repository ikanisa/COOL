[{"ghsa_id":"GHSA-47m2-wp7j-p9vc","cve_id":"CVE-2026-85396","url":"https://api.github.com/advisories/GHSA-47m2-wp7j-p9vc","html_url":"https://github.com/advisories/GHSA-47m2-wp7j-p9vc","summary":"rubyzip path traversal vulnerability","description":"rubyzip versions before 3.4.0 contain a path traversal vulnerability in `Zip::Entry#extract` that fails to properly validate extraction paths using prefix comparison without trailing separators. Attackers can craft archive entries with names like `../upload_backup/owned.sh` to write files outside the intended extraction directory into sibling paths sharing the destination prefix.","type":"reviewed","severity":"high","repository_advisory_url":null,"source_code_location":"https://github.com/rubyzip/rubyzip","identifiers":[{"value":"GHSA-47m2-wp7j-p9vc","type":"GHSA"},{"value":"CVE-2026-85396","type":"CVE"}],"references":["https://nvd.nist.gov/vuln/detail/CVE-2026-85396","https://github.com/rubyzip/rubyzip/commit/17edfbf4423b83211b075acc23a7d8640da63449","https://github.com/geo-chen/oss/blob/main/rubyzip.md","https://github.com/rubyzip/rubyzip/blob/v3.3.1/lib/zip/entry.rb","https://github.com/rubyzip/rubyzip/releases/tag/v3.4.0","https://www.vulncheck.com/advisories/rubyzip-before-3.4.0-path-traversal-in-zip-entry-extract-via-sibling-directory-prefix","https://github.com/rubysec/ruby-advisory-db/blob/master/gems/rubyzip/CVE-2026-85396.yml","https://github.com/advisories/GHSA-47m2-wp7j-p9vc"],"published_at":"2026-09-03T21:31:16Z","updated_at":"2026-09-25T19:25:56Z","github_reviewed_at":"2026-09-25T19:25:52Z","nvd_published_at":"2026-09-03T19:17:31Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"rubygems","name":"rubyzip"},"vulnerable_version_range":"< 3.4.0","first_patched_version":"3.4.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:H/A:N","score":7.5},"cvss_v4":{"vector_string":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:H/VA:N/SC:N/SI:N/S