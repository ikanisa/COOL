+def dependency_names(body, section):
+    """Explicit dependency keys only; no alias or nonempty flow mapping."""
+    raw = yaml_mapping(body).get(section)
+    if raw is None: return []
+    if raw[0].strip() == '{}': return []
+    return list(yaml_mapping(body, (section,)))
+
