+def expected_plugin_platforms(resolved, app_name):
+    """Pinned nativeOrDart selection for this cohort; ambiguous choices fail."""
+    app_body = resolved[app_name]['pubspec']
+    direct = set(dependency_names(app_body, 'dependencies'))
+    dependency_graph = {name: dependency_names(row['pubspec'], 'dependencies') for name, row in resolved.items()}
+    reachable = {app_name}; pending = [*direct, *dependency_names(app_body, 'dev_dependencies')]
+    while pending:
+        name = pending.pop()
+        if name in reachable: continue
+        if name not in resolved: raise ValueError('locked dependency absent from complete configuration')
+        reachable.add(name); pending.extend(dependency_graph[name])
+    # The immutable current cohort has no unused resolved package; omit nothing silently.
+    if reachable != set(resolved): raise ValueError('complete configuration dependency closure differs')
+    plugin_sources = {name: row for name, row in resolved.items()
+                      if yaml_mapping(row['pubspec'], ('flutter', 'plugin'))}
+    expected = {}
+    for platform in ('ios','android','macos','linux','windows','web'):
+        candidates = {}; defaults = {}
+        for name, row in plugin_sources.items():
+            body = row['pubspec']; plugin = yaml_mapping(body, ('flutter','plugin'))
+            if 'platforms' not in plugin: raise ValueError('unreviewed legacy plugin source format')
+            platforms = yaml_mapping(body, ('flutter','plugin','platforms'))
+            if platform not in platforms: continue
+            fields = yaml_mapping(body, ('flutter','plugin','platforms',platform))
+            default = yaml_scalar(body, ('flutter','plugin','platforms',platform,'default_package'))
+            implements = yaml_scalar(body, ('flutter','plugin','implements'))
+            if default is not None:
+                if implements not in (None,'',name): raise ValueError('conflicting source default/implements')
+                # Pinned Plugin._fromMultiPlatformYaml records defaults only for native platforms.
+                if platform != 'web': defaults[name] = default
+                continue
+            # Plugin._providesImplementationForPlatform: present platform without default_package.
+            if not fields: raise ValueError('unreviewed empty plugin platform source')
+            key = implements or name
+            candidates.setdefault(key, []).append(name)
+        selected = []
+        for name, values in candidates.items():
+            # The reviewed actual cohort has one candidate per implementation key.
+            # Conservatively reject future ambiguous/direct/default precedence changes.
+            if len(values) != 1: raise ValueError('ambiguous complete plugin implementation selection')
+            selected.append(values[0])
+        for name, default in defaults.items():
+            if name not in candidates or default not in candidates[name]:
+                raise ValueError('default plugin absent from complete source candidates')
+        expected[platform] = sorted(selected)
+    return expected, plugin_sources
+
