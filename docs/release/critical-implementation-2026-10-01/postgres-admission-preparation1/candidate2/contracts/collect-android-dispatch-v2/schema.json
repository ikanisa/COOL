          "const": "attempt_status"
        },
        "device_id": {
          "$ref": "#/$defs/uuid"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "result": {
          "$ref": "#/$defs/attempt_status_result"
        }
      },
      "additionalProperties": false
    },
    "response_envelope": {
      "oneOf": [
        {
          "$ref": "#/$defs/dispatch_grant_response"
        },
        {
          "$ref": "#/$defs/arm_dispatch_response"
        },
        {
          "$ref": "#/$defs/callback_response"
        },
        {
          "$ref": "#/$defs/reconcile_response"
        },
        {
          "$ref": "#/$defs/attempt_status_response"
        }
      ]
    },
    "owner_automatic_attempt": {
      "type": "object",
      "required": [
        "attempt_id",
        "fence_version",
        "state",
        "segment_count",
        "armed_at",
        "sent_observations",
        "delivery_observations",
        "conflicting_observations",
        "terminal_archive_ack",
        "carrier_proof",
        "device_id",
        "run_id",
        "policy_revision",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/uuid"
        },
        "fence_version": {
          "$ref": "#/$defs/revision"
        },
        "state": {
          "enum": [
            "granted",
            "send_started",
            "observed_sent",
            "uncertain"
          ]
        },
        "segment_count": {
          "$ref": "#/$defs/segment_count"
        },
        "armed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/utc_timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "sent_observations": {
          "$ref": "#/$defs/observation_count"
        },
        "delivery_observations": {
          "$ref": "#/$defs/observation_count"
        },
        "conflicting_observations": {
          "type": "boolean"
        },
        "terminal_archive_ack": {
          "const": false
        },
        "carrier_proof": {
          "const": false
        },
        "device_id": {
          "$ref": "#/$defs/uuid"
        },
        "run_id": {
          "$ref": "#/$defs/uuid"
        },
        "policy_revision": {
          "$ref": "#/$defs/revision"
        },
        "issued_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/utc_timestamp"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed_sent"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "conflicting_observations": {
                "const": false
              },
              "sent_observations": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "granted"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "armed_at": {
                "const": null
              }
            }
          }
        }
      ],
      "$comment": "Redacted verified-owner read; no body/contact/callback plan/SPKI/reservation hash/private request digest. Runtime enforces current owner and positive Rwanda scope."
    },
    "owner_receipt_read": {
      "type": "object",
      "required": [
        "contract_version",
        "receipt_id",
        "checked_at",
        "sample_valid_until",
        "automatic_attempt"
      ],
      "properties": {
        "contract_version": {
          "const": 2
        },
        "receipt_id": {
          "$ref": "#/$defs/uuid"
        },
        "checked_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "sample_valid_until": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "automatic_attempt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/owner_automatic_attempt"
            }
          ]
        }
      },
      "additionalProperties": false,
      "$comment": "Runtime enforces current authority and sample_valid_until===checked_at+60s; this read grants no dispatch or terminal archive authority."
    }
  }
}
