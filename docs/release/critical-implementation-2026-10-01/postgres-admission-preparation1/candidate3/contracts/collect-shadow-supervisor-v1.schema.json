    {
      "$ref": "#/$defs/begin"
    },
    {
      "$ref": "#/$defs/busy"
    },
    {
      "$ref": "#/$defs/sample_result"
    },
    {
      "$ref": "#/$defs/finish"
    },
    {
      "$ref": "#/$defs/get"
    },
    {
      "$ref": "#/$defs/history"
    }
  ],
  "$defs": {
