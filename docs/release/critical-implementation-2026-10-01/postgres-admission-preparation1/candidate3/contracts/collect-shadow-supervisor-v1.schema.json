{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collect:shadow-supervisor:v1",
  "title": "Collect manual shadow supervisor RPC results v1",
  "description": "Shapes only. Cross-field semantics are normative in accompanying contract.md. No actor/session/member/recipient/body/provider-reference is exported.",
