      "type": "object",
      "additionalProperties": false,
      "required": [
        "health_status",
        "alert_counts",
        "sms_queue",
        "checks_recorded",
        "samples_recorded",
        "business_mutations",
        "provider_sends"
      ],
      "properties": {
