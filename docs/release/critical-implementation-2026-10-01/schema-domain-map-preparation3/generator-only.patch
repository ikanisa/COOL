+            if not values or any(t.kind!="id" or text[t.start:t.start+1]=='"' for t in values):return None
+            value=" ".join(t.value.lower() for t in values)
+            return value if value in builtins else None
+        value=known(part)
+        if value is None and len(part)>1 and part[0].kind=="id":value=known(part[1:])
+        if value is None:return None,j
+        result.append(value)
+    return tuple(result),j
