+def sql_static_lineage(definitions, alterations):
+    """Track latest exact-signature declarations through explicit static moves."""
+    state={};uncertain=set()
+    events=[(d["version"],d["definition_offset"],"definition",d) for d in definitions]
+    events += [(a["version"],a["statement_offset"],"alteration",a) for a in alterations]
+    for _,_,kind,event in sorted(events,key=lambda e:(e[0],e[1])):
+        name=(event["schema"],event["name"]);signature=event["signature_types"]
+        if kind=="alteration" and event["operation"]=="drop-name":
+            state={key:value for key,value in state.items() if key[:2]!=name};uncertain.add(name);continue
+        if kind=="definition":
+            if event["routine_kind"]!="function":continue
+            if signature is None:uncertain.add(name);continue
+            state[(*name,signature)]={**event,"static_lineage":[]};continue
+        key=(*name,signature)
+        if name in uncertain or key not in state:continue
+        destination=(event["schema"],event["destination"]) if event["operation"]=="rename" else (event["destination"],event["name"])
+        new_key=(*destination,signature)
+        if destination in uncertain or new_key in state:continue
+        declaration=state.pop(key)
+        proof={k:v for k,v in event.items() if k!="statement_offset"}
+        state[new_key]={**declaration,"static_lineage":[*declaration["static_lineage"],proof]}
+    return state
