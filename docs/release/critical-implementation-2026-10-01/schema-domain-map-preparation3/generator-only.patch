+def sql_signature(text, tokens, opening):
+    """Only explicit builtin input types; unknown modes/types stay unresolved."""
+    if opening >= len(tokens) or tokens[opening].value != "(": return None, opening
+    parts, current, depth, j = [], [], 1, opening+1
+    while j < len(tokens):
+        token=tokens[j]
+        if token.kind=="symbol" and token.value=="(": depth+=1
+        elif token.kind=="symbol" and token.value==")":
+            depth-=1
+            if not depth:
+                if current: parts.append(current)
+                break
