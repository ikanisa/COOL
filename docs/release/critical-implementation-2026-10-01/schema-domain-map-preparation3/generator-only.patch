+        operation=[tokens[j].value.lower(),tokens[j+1].value.lower()]
+        if operation not in (["rename","to"],["set","schema"]) or tokens[j+2].kind!="id" or tokens[j+3].value!=";":continue
+        destination=sql_identifier(text,tokens[j+2])
+        result.append({"path":path,"line":text.count("\n",0,token.start)+1,"version":version,
+                       "statement_offset":token.start,"statement_sha256":sha(text[token.start:tokens[j+3].end].encode()),
+                       "schema":schema,"name":name,"signature_types":signature,
+                       "operation":"rename" if operation[0]=="rename" else "set-schema",
+                       "destination":destination})
+    return result
