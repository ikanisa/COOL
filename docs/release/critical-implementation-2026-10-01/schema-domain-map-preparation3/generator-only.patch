+    builtins={"uuid","bigint","integer","smallint","text","boolean","jsonb","json","bytea","numeric",
+              "real","double precision","date","timestamp","timestamp with time zone","timestamp without time zone",
+              "time","time with time zone","time without time zone"}
+    result=[]
+    for part in parts:
+        if not part:return None,j
+        if part[0].kind=="id" and part[0].value.lower()=="in":part=part[1:]
+        elif part[0].kind=="id" and part[0].value.lower() in {"out","inout","variadic"}:return None,j
+        cut=next((i for i,t in enumerate(part) if t.value=="=" or (t.kind=="id" and t.value.lower()=="default")),len(part))
+        part=part[:cut]
