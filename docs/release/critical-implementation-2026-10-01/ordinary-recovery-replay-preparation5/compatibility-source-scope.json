  "admin_sql": "begin;\ngrant usage on schema graphql,graphql_public to postgres,anon,authenticated,service_role;\ngrant usage on schema graphql,graphql_public to postgres with grant option;\ngrant execute on function graphql._internal_resolve(text,jsonb,text,jsonb),graphql.comment_directive(text),graphql.exception(text),graphql.get_schema_version(),graphql.increment_schema_version(),graphql.resolve(text,jsonb,text,jsonb) to postgres,anon,authenticated,service_role;\ngrant select,update,usage on sequence graphql.seq_schema_version to postgres,anon,authenticated,service_role;\ncreate index if not exists collect_receipt_http_response_id on net._http_response(id);\ncommit;",
  "postgres_sql": "begin;\nalter table public.notification_events drop constraint notification_events_copy_length_check;\nalter table public.notification_events add constraint notification_events_copy_length_check check (\n    char_length(trim(title)) between 1 and 120\n    and char_length(trim(body)) between 1 and 500\n  ) not valid;\nalter table public.provider_finality_requests drop constraint provider_finality_requests_provider_network_check;\nalter table public.provider_finality_requests add constraint provider_finality_requests_provider_network_check check (\n    provider_network is null or (\n      char_length(provider_network) between 2 and 32 and provider_network ~ '^[a-z0-9_]+$'\n    )\n  );\ncommit;",
