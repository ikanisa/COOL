  "create_schema_sql": "create schema graphql_public authorization supabase_admin;",
  "create_function_sql": "        create function graphql_public.graphql(\n            \"operationName\" text default null,\n            query text default null,\n            variables jsonb default null,\n            extensions jsonb default null\n        )\n            returns jsonb\n            language sql\n        as $$\n            select graphql.resolve(\n                query := query,\n                variables := coalesce(variables, '{}'),\n                \"operationName\" := \"operationName\",\n                extensions := extensions\n            );\n        $$;",
  "extension_membership_sql": "alter extension pg_graphql add function graphql_public.graphql(text,text,jsonb,jsonb);",
