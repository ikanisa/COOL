        "Path": "/usr/local/bin/python3.12",
        "Args": [
            "-I",
            "-B",
            "-c",
            "from pathlib import Path\nimport hashlib,json,os,stat\nroot=Path('/usr/local'); rows=[]\nfor path in sorted(root.rglob('*')):\n    info=path.lstat(); row={'path':str(path.relative_to(root)),'mode':stat.S_IMODE(info.st_mode)}\n    if stat.S_ISLNK(info.st_mode): row.update(kind='symlink',target=os.readlink(path))\n    elif stat.S_ISDIR(info.st_mode): row.update(kind='directory')\n    elif stat.S_ISREG(info.st_mode):\n        h=hashlib.sha256()\n        with path.open('rb') as handle:\n            while chunk:=handle.read(1024*1024):h.update(chunk)\n        row.update(kind='file',bytes=info.st_size,sha256=h.hexdigest())\n    else: raise RuntimeError('unsupported runtime inode')\n    rows.append(row)\nprint(json.dumps(rows,sort_keys=True,separators=(',',':')))\n"
        ],
