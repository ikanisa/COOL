+def sql_lineage_uncertainty(text, path, version):
+    """Invalidate unproved effects; do not interpret/evaluate anonymous SQL."""
+    tokens=lex(text,sql=True);result=[]
+    def fence(token,operation,reason,schema=None,name="*",destination=None):
+        result.append({"path":path,"version":version,"line":text.count("\n",0,token.start)+1,
+          "statement_offset":token.start,"schema":schema,"name":name,"signature_types":None,
+          "operation":operation,"destination":destination,"reason":reason,
+          "source_migration_sha256":sha(text.encode())})
+    for i,token in enumerate(tokens):
+        if token.kind!="id":continue
+        command=token.value.lower()
+        if command in {"do","execute","call"} and (i==0 or tokens[i-1].value==";"):
+            if command=="do":
+                if i+1>=len(tokens) or tokens[i+1].kind!="string":raise ValueError("unknown or unterminated DO syntax")
+                block=tokens[i+1];raw=text[block.start:block.end]
+                delimiter=re.match(r"\$(?:[A-Za-z_][A-Za-z_0-9]*)?\$",raw)
+                if not delimiter or not raw.endswith(delimiter[0]) or i+2>=len(tokens) or tokens[i+2].value!=";":raise ValueError("unknown or unterminated DO syntax")
+            fence(token,"drop-all","unproved-anonymous-or-invoked-function-effects")
+            continue
+        if command!="alter" or i+2>=len(tokens) or tokens[i+1].value.lower()!="function":continue
+        j=i+2
+        if tokens[j].kind!="id":
+            fence(token,"drop-all","unsupported-active-ALTER-target");continue
+        schema,name=None,sql_identifier(text,tokens[j]);j+=1
+        if j+1<len(tokens) and tokens[j].value=="." and tokens[j+1].kind=="id":
+            schema,name=name,sql_identifier(text,tokens[j+1]);j+=2
+        signature,closing=sql_signature(text,tokens,j)
+        if signature is not None and schema is not None:continue
+        fence(token,"drop-name","unsupported-or-unqualified-active-ALTER-signature",schema,name)
+        tail=tokens[closing+1:closing+4]
+        if len(tail)==3 and tail[2].kind=="id":
+            if [t.value.lower() for t in tail[:2]]==["rename","to"]:
+                fence(token,"drop-name","unsupported-ALTER-destination",schema,sql_identifier(text,tail[2]))
+            elif [t.value.lower() for t in tail[:2]]==["set","schema"]:
+                fence(token,"drop-name","unsupported-ALTER-destination",sql_identifier(text,tail[2]),name)
+    return result
 
