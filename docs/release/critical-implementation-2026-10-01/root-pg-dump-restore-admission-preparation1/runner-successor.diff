+def group_exists(pgid):
+    try:
+        os.killpg(pgid, 0)
+        return True
+    except ProcessLookupError:
+        return False
+
+
+def cleanup_group(process):
+    """Kill/reap this runner's group and require absence within five seconds."""
+    deadline = time.monotonic() + 5
+    while True:
+        process.poll()  # Reap an already exited parent before signalling its group.
+        if process.returncode is not None and not group_exists(process.pid):
+            return
+        try:
+            os.killpg(process.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        except PermissionError as error:
+            # Reap only within the original cleanup bound. A parent which exits
+            # naturally is not proof of cleanup: its entire group must be absent.
+            # Any surviving/unreaped group retains the original signalling error.
+            try:
+                process.wait(timeout=max(0.001, deadline - time.monotonic()))
+            except subprocess.TimeoutExpired:
+                raise error
+            if group_exists(process.pid):
+                raise error
+        try:
+            process.wait(timeout=max(0.001, deadline - time.monotonic()))
+        except subprocess.TimeoutExpired as error:
+            raise Refused('PG_ARCHIVE_GROUP_CLEANUP_TIMEOUT') from error
+        if not group_exists(process.pid):
+            return
+        left = deadline - time.monotonic()
+        fail(left > 0, 'PG_ARCHIVE_GROUP_CLEANUP_TIMEOUT')
+        time.sleep(min(0.01, left))
 
 
