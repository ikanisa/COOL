+def bounded_base_probe(argv, env, timeout, limit=pg.OUTPUT_LIMIT, inherit_stdin=False):
+    """Keep the base (code, stdout) contract through this adapter's strict runner."""
+    fail(inherit_stdin is False, 'PG_ARCHIVE_BASE_STDIN_UNSUPPORTED')
+    stdout, _ = run(argv, env, timeout, limit)
+    return 0, stdout  # run returns only after a genuine zero exit and group absence.
+
+
+# Only this isolated module copy changes. Maintained base bytes stay exact.
+# Its constructor's first psql probe must have the same cleanup as later probes.
+pg.bounded = bounded_base_probe
 
 
