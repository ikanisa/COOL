+        SchedulerPhase.persistentCallbacks) {
+      if (_scheduled) return;
+      _scheduled = true;
+      WidgetsBinding.instance.addPostFrameCallback((_) {
+        _scheduled = false;
+        if (!_disposed) notifyListeners();
+      });
+      WidgetsBinding.instance.ensureVisualUpdate();
+      return;
+    }
+    notifyListeners();
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
