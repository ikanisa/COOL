  "$defs": {
    "observationRecoveryV2Capability.request": {
      "type": "null"
    },
    "observationRecoveryV2Capability.query": {
      "type": "object",
      "properties": {
        "expectedConsentGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[1-9][0-9]{0,15}(?![\\s\\S])"
        }
      },
      "required": [
        "expectedConsentGeneration"
      ],
      "additionalProperties": false
    },
    "observationRecoveryV2Capability.data": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "const": "burimunsi.held-recovery.v2"
        },
        "groupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
        },
        "sourceSha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "migrationSha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "consentGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "protocol",
        "groupId",
        "sourceSha256",
        "migrationSha256",
        "consentGeneration"
      ],
      "additionalProperties": false
    },
