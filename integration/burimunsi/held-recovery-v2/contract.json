{
  "contractVersion": "burimunsi.native.v1",
  "routes": [
    [
      "GET",
      "^/sms/observations/recovery-v2/capability$",
      "observationRecoveryV2Capability"
    ],
    [
      "POST",
      "^/sms/observations/recovery-v2/hold$",
      "observationRecoveryV2Hold"
    ],
    [
      "POST",
      "^/sms/observations/recovery-v2/ack$",
      "observationRecoveryV2Ack"
    ]
