new file mode 100644
--- /dev/null
+++ b/src/main/kotlin/rw/ikanisa/sms/policy/JournalFormat.kt
@@ -0,0 +1,108 @@
+package rw.ikanisa.sms.policy
+
+import java.security.MessageDigest
+import java.util.Collections
+
+/** Monotone storage history, in addition to each snapshot's structural checks. */
+object JournalHistory {
+    fun initial(s: QueueSnapshot): Boolean = SnapshotIntegrity.valid(s) && s.revision==0L &&
+        s.phase==Phase.READY && s.reason=="CAPTURED" && s.attempts==0 && s.receipts.isEmpty() && s.conflictingReceipts.isEmpty()
+
+    fun follows(old: QueueSnapshot, next: QueueSnapshot): Boolean {
+        if (!SnapshotIntegrity.valid(old) || !SnapshotIntegrity.valid(next) || old.revision==Long.MAX_VALUE ||
+            next.revision != old.revision+1 || next.lastObservedAt < old.lastObservedAt ||
+            !SnapshotCodec.batchBytes(old.batch).contentEquals(SnapshotCodec.batchBytes(next.batch))) return false
+        val allowed=when(old.phase) {
+            Phase.READY -> setOf(Phase.IN_FLIGHT)
+            Phase.IN_FLIGHT -> setOf(Phase.RETRY_WAIT,Phase.HELD,Phase.CONFLICT,Phase.ACK_PENDING)
+            Phase.RETRY_WAIT -> setOf(Phase.IN_FLIGHT,Phase.HELD,Phase.ACK_PENDING)
+            Phase.HELD -> setOf(Phase.RETRY_WAIT,Phase.HELD,Phase.ACK_PENDING)
+            Phase.ACK_PENDING -> setOf(Phase.ACKNOWLEDGED,Phase.REJECTED,Phase.CONFLICT)
+            Phase.ACKNOWLEDGED,Phase.REJECTED -> setOf(Phase.CONFLICT)
+            Phase.CONFLICT -> emptySet()
+        }
+        if(next.phase !in allowed) return false
+        if(next.phase==Phase.IN_FLIGHT) {
+            val a=next.activeAttempt ?: return false
+            if(next.attempts!=old.attempts+1 || a.startedAt!=next.lastObservedAt ||
+                next.firstAttemptAt != (old.firstAttemptAt ?: a.startedAt)) return false
+        } else if(next.attempts!=old.attempts || next.activeAttempt!=old.activeAttempt || next.firstAttemptAt!=old.firstAttemptAt) return false
+        if(old.receipts.isNotEmpty() && next.receipts!=old.receipts) return false
+        if(old.conflictingReceipts.isNotEmpty() && next.conflictingReceipts!=old.conflictingReceipts) return false
+        if(old.outcomeUncertain && next.receipts.isEmpty() && !next.outcomeUncertain) return false
+        return true
+    }
+    /** Atomic admission includes terminal originals and M-Money's separate source/body identity. */
+    fun admission(batch: UploadBatch, retained: Collection<QueueSnapshot>): BatchAdmission {
+        val base=BatchAdmissionPolicy.decide(batch,retained.toList())
+        if(base!=BatchAdmission.NEW) return base
+        val seen=retained.flatMap { it.batch.originals }.toMutableList()
+        for(o in batch.originals) {
+            if(seen.any { it.key==o.key || (o.scope.contract==Contract.MMONEY_LEDGER_V1 &&
+                o.scope==it.scope && o.sourceId==it.sourceId && o.body==it.body) }) return BatchAdmission.ORIGINAL_ALREADY_BOUND
+            seen+=o
+        }
+        return BatchAdmission.NEW
+    }
+}
+
+class JournalState internal constructor(val scope: OwnerScope, val recordCount: Int,
+    val tailHash: String, val contentHash: String, snapshots: Map<String,QueueSnapshot>) {
+    val snapshots: Map<String,QueueSnapshot> = Collections.unmodifiableMap(LinkedHashMap(snapshots))
+    override fun toString() = "JournalState(records=$recordCount,entries=${snapshots.size})"
+}
+
+/** Append-only versioned hash chain. Digests detect corruption; they are NOT authentication. */
+object JournalFormat {
+    const val VERSION=1
+    const val HEADER_BYTES=40
+    const val MAX_BYTES=64*1024*1024
+    const val MAX_RECORDS=10000
+    const val MAX_ENTRIES=1000
+    private const val MAGIC=0x534d534a // SMSJ
+    private fun digest(b: ByteArray)=MessageDigest.getInstance("SHA-256").digest(b)
+    private fun hex(b: ByteArray)=b.joinToString("") { "%02x".format(it.toInt() and 255) }
+    private fun unhex(s: String): ByteArray {
+        requireFormat(s.matches(Regex("[a-f0-9]{64}")))
+        return ByteArray(32) { s.substring(it*2,it*2+2).toInt(16).toByte() }
+    }
+    fun empty(scope: OwnerScope): ByteArray {
+        requireFormat(scope.valid(),DecodeCode.SCOPE)
+        return BinaryWriter(HEADER_BYTES).also { w -> w.int(MAGIC); w.int(VERSION); w.raw(unhex(EvidenceHash.framed(scope.fields()))) }.result()
+    }
+    fun replay(bytes: ByteArray, expectedScope: OwnerScope): JournalState {
+        requireFormat(bytes.size in HEADER_BYTES..MAX_BYTES,DecodeCode.SIZE)
+        val r=BinaryReader(bytes)
+        requireFormat(r.int()==MAGIC,DecodeCode.MAGIC); requireFormat(r.int()==VERSION,DecodeCode.VERSION)
+        requireFormat(expectedScope.valid() && MessageDigest.isEqual(r.raw(32),unhex(EvidenceHash.framed(expectedScope.fields()))),DecodeCode.SCOPE)
+        var tail=digest(bytes.copyOfRange(0,HEADER_BYTES)); var count=0
+        val states=LinkedHashMap<String,QueueSnapshot>()
+        while(r.remaining>0) {
+            requireFormat(++count<=MAX_RECORDS,DecodeCode.SIZE)
+            val length=r.count(32+44+32,32+SnapshotCodec.MAX_BYTES+32)
+            requireFormat(length<=r.remaining,DecodeCode.TRUNCATED)
+            val payload=r.raw(length-32); val check=r.raw(32)
+            requireFormat(MessageDigest.isEqual(check,digest(payload)),DecodeCode.CHECKSUM)
+            requireFormat(MessageDigest.isEqual(payload.copyOfRange(0,32),tail),DecodeCode.HISTORY)
+            val s=SnapshotCodec.decode(payload.copyOfRange(32,payload.size))
+            requireFormat(s.batch.scope==expectedScope,DecodeCode.SCOPE)
+            val old=states[s.batch.key]
+            if(old==null) {
+                requireFormat(states.size<MAX_ENTRIES,DecodeCode.SIZE)
+                requireFormat(JournalHistory.initial(s) && JournalHistory.admission(s.batch,states.values)==BatchAdmission.NEW,DecodeCode.HISTORY)
+            } else requireFormat(JournalHistory.follows(old,s),DecodeCode.HISTORY)
+            states[s.batch.key]=s; tail=check
+        }
+        return JournalState(expectedScope,count,hex(tail),EvidenceHash.sha256(bytes),states)
+    }
+    fun record(previous: JournalState, next: QueueSnapshot): ByteArray {
+        requireFormat(previous.recordCount<MAX_RECORDS,DecodeCode.SIZE)
+        requireFormat(next.batch.scope==previous.scope,DecodeCode.SCOPE)
+        val old=previous.snapshots[next.batch.key]
+        requireFormat(if(old==null) previous.snapshots.size<MAX_ENTRIES && JournalHistory.initial(next) &&
+            JournalHistory.admission(next.batch,previous.snapshots.values)==BatchAdmission.NEW else JournalHistory.follows(old,next),DecodeCode.HISTORY)
+        val snapshot=SnapshotCodec.encode(next)
+        val payload=unhex(previous.tailHash)+snapshot
+        return BinaryWriter(payload.size+36).also { it.int(payload.size+32); it.raw(payload); it.raw(digest(payload)) }.result()
+    }
+}
diff --git a/src/main/kotlin/rw/ikanisa/sms/policy/JournalQueueStore.kt b/src/main/kotlin/rw/ikanisa/sms/policy/JournalQueueStore.kt
new file mode 100644
--- /dev/null
+++ b/src/main/kotlin/rw/ikanisa/sms/policy/JournalQueueStore.kt
@@ -0,0 +1,78 @@
+package rw.ikanisa.sms.policy
+
+sealed class JournalRead {
+    class Bytes(bytes: ByteArray): JournalRead() {
+        private val retained=bytes.copyOf()
+        fun copy(): ByteArray=retained.copyOf()
+        override fun toString()="JournalBytes(length=${retained.size})"
+    }
+    data object Missing: JournalRead()
+    data object Unavailable: JournalRead()
+}
+/**
+ * Integration contract: atomically compare the SHA-256 of ALL existing bytes and append the record
+ * under one exclusive interprocess lock. COMMITTED requires the platform's durable write barrier.
+ * Missing/uninitialized storage must NOT be created. Partial/unknown writes are retained; never
+ * truncate a torn tail, skip a corrupt record, reset an index, or report UNKNOWN as COMMITTED.
+ * The production port must protect confidentiality and bind storage to the installation lifecycle.
+ */
+interface AppendJournalPort {
+    fun read(): JournalRead
+    fun append(expectedContentHash: String, record: ByteArray): StoreWrite
+}
+sealed class JournalInspection {
+    data class Ready(val state: JournalState): JournalInspection()
+    data class Blocked(val reason: String): JournalInspection()
+}
+
+/** QueueStorePort implementation: indexes are derived from the same committed log as the evidence. */
+class JournalQueueStore(private val port: AppendJournalPort, private val scope: OwnerScope): QueueStorePort {
+    fun inspect(): JournalInspection = try {
+        when(val result=port.read()) {
+            is JournalRead.Bytes -> JournalInspection.Ready(JournalFormat.replay(result.copy(),scope))
+            JournalRead.Missing -> JournalInspection.Blocked("JOURNAL_MISSING")
+            JournalRead.Unavailable -> JournalInspection.Blocked("JOURNAL_UNAVAILABLE")
+        }
+    } catch(e: SnapshotFormatException) { JournalInspection.Blocked("JOURNAL_${e.code.name}") }
+      catch(_: Exception) { JournalInspection.Blocked("JOURNAL_UNAVAILABLE") }
+
+    override fun read(key: String): StoreRead = when(val inspection=inspect()) {
+        is JournalInspection.Ready -> inspection.state.snapshots[key]?.let(StoreRead::Present) ?: StoreRead.Missing
+        is JournalInspection.Blocked -> if(inspection.reason in setOf("JOURNAL_MISSING","JOURNAL_UNAVAILABLE")) StoreRead.Unavailable else StoreRead.Corrupt
+    }
+    override fun createIfUnbound(initial: QueueSnapshot): StoreWrite {
+        if(!JournalHistory.initial(initial) || initial.batch.scope!=scope) return StoreWrite.NOT_COMMITTED
+        val state=(inspect() as? JournalInspection.Ready)?.state ?: return StoreWrite.NOT_COMMITTED
+        when(JournalHistory.admission(initial.batch,state.snapshots.values)) {
+            BatchAdmission.NEW -> Unit
+            BatchAdmission.ORIGINAL_ALREADY_BOUND -> return StoreWrite.ORIGINAL_ALREADY_BOUND
+            else -> return StoreWrite.REVISION_CONFLICT
+        }
+        return append(state,initial)
+    }
+    override fun compareAndSet(key: String, expectedRevision: Long, next: QueueSnapshot): StoreWrite {
+        val state=(inspect() as? JournalInspection.Ready)?.state ?: return StoreWrite.NOT_COMMITTED
+        val before=state.snapshots[key] ?: return StoreWrite.REVISION_CONFLICT
+        if(next.batch.key!=key || before.revision!=expectedRevision || !JournalHistory.follows(before,next)) return StoreWrite.REVISION_CONFLICT
+        return append(state,next)
+    }
+    private fun append(state: JournalState, next: QueueSnapshot): StoreWrite {
+        val frame=try { JournalFormat.record(state,next) } catch(_: SnapshotFormatException) { return StoreWrite.NOT_COMMITTED }
+        return try { port.append(state.contentHash,frame) } catch(_: Exception) { StoreWrite.UNKNOWN }
+    }
+}
+
+/**
+ * Additional last-moment gate for R3 callers. The native lifecycle fence MUST cover this check
+ * and request submission together; this pure function is neither a mutex nor a single-use token.
+ */
+object ReservationGate {
+    fun permitted(effect: QueueEffect.UploadOriginal, committed: QueueSnapshot, authority: Authority,
+                  now: Long, machine: QueueMachine): Boolean {
+        val a=effect.attempt
+        return SnapshotIntegrity.valid(committed) && machine.admits(committed.batch) &&
+            DispatchPolicy.permitted(effect,committed,authority,now) &&
+            SnapshotCodec.batchBytes(effect.batch).contentEquals(SnapshotCodec.batchBytes(committed.batch)) &&
+            now>=a.startedAt && now-a.startedAt<machine.limits.leaseMs
+    }
+}
diff --git a/src/main/kotlin/rw/ikanisa/sms/policy/SnapshotCodec.kt b/src/main/kotlin/rw/ikanisa/sms/policy/SnapshotCodec.kt
new file mode 100644
--- /dev/null
+++ b/src/main/kotlin/rw/ikanisa/sms/policy/SnapshotCodec.kt
@@ -0,0 +1,171 @@
+package rw.ikanisa.sms.policy
+
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.io.DataInputStream
+import java.io.DataOutputStream
+import java.io.IOException
+import java.security.MessageDigest
+
+/** Diagnostic codes never interpolate a message body, sender, identity or raw bytes. */
+enum class DecodeCode { SIZE, MAGIC, VERSION, CHECKSUM, TRUNCATED, STRUCTURE, INVARIANT, TRAILING, SCOPE, HISTORY }
+class SnapshotFormatException(val code: DecodeCode): IOException(code.name)
+internal fun requireFormat(ok: Boolean, code: DecodeCode = DecodeCode.STRUCTURE) {
+    if (!ok) throw SnapshotFormatException(code)
+}
+
+/** Bounds are enforced BEFORE allocations. Strings are exact UTF-16 units, not lossy UTF-8. */
+internal class BinaryWriter(private val limit: Int) {
+    private val bytes = ByteArrayOutputStream()
+    private val out = DataOutputStream(bytes)
+    private fun room(n: Int) = requireFormat(n >= 0 && bytes.size().toLong()+n <= limit, DecodeCode.SIZE)
+    fun int(n: Int) { room(4); out.writeInt(n) }
+    fun long(n: Long) { room(8); out.writeLong(n) }
+    fun bool(b: Boolean) { room(1); out.writeByte(if (b) 1 else 0) }
+    fun text(s: String?, max: Int = 128) {
+        if (s == null) { int(-1); return }
+        requireFormat(s.length <= max, DecodeCode.SIZE)
+        room(4 + s.length * 2); out.writeInt(s.length); s.forEach { out.writeChar(it.code) }
+    }
+    fun nullableInt(n: Int?) { bool(n != null); if (n != null) int(n) }
+    fun nullableLong(n: Long?) { bool(n != null); if (n != null) long(n) }
+    fun raw(b: ByteArray) { room(b.size); out.write(b) }
+    fun result(): ByteArray = bytes.toByteArray()
+}
+internal class BinaryReader(bytes: ByteArray) {
+    private val input = DataInputStream(ByteArrayInputStream(bytes))
+    val remaining get() = input.available()
+    private fun need(n: Int) = requireFormat(n >= 0 && n <= remaining, DecodeCode.TRUNCATED)
+    fun int(): Int { need(4); return input.readInt() }
+    fun long(): Long { need(8); return input.readLong() }
+    fun bool(): Boolean { need(1); val n=input.readUnsignedByte(); requireFormat(n in 0..1); return n==1 }
+    fun count(min: Int, max: Int): Int = int().also { requireFormat(it in min..max, DecodeCode.SIZE) }
+    fun text(max: Int = 128): String? {
+        val n=int(); if (n == -1) return null
+        requireFormat(n in 0..max, DecodeCode.SIZE); need(n*2)
+        return CharArray(n) { input.readChar() }.concatToString()
+    }
+    fun required(max: Int = 128): String = text(max) ?: throw SnapshotFormatException(DecodeCode.STRUCTURE)
+    fun nullableInt(): Int? = if (bool()) int() else null
+    fun nullableLong(): Long? = if (bool()) long() else null
+    fun raw(n: Int): ByteArray { need(n); return ByteArray(n).also(input::readFully) }
+    inline fun <reified T: Enum<T>> enum(): T {
+        val name=required(64)
+        return enumValues<T>().firstOrNull { it.name == name } ?: throw SnapshotFormatException(DecodeCode.STRUCTURE)
+    }
+    fun end() = requireFormat(remaining == 0, DecodeCode.TRAILING)
+}
+
+/** Additional persisted-state invariants; no trust in serialized derived fields or receipt lists. */
+object SnapshotIntegrity {
+    fun valid(s: QueueSnapshot): Boolean {
+        if (!s.valid() || !s.batch.originals.all { it.eligible() }) return false
+        if (!s.reason.matches(Regex("[A-Z0-9_]{1,128}"))) return false
+        if (s.phase == Phase.READY && (s.attempts != 0 || s.receipts.isNotEmpty())) return false
+        if (s.phase != Phase.READY && s.activeAttempt == null) return false
+        if (s.phase == Phase.HELD && !s.outcomeUncertain) return false
+        fun receiptsValid(rows: List<VerifiedReceipt>): Boolean {
+            if (rows.size != s.batch.originals.size || rows.map { it.captureId }.toSet() != s.batch.originals.map { it.captureId }.toSet()) return false
+            return rows.all { r -> when (r.outcome) {
+                ReceiptOutcome.RETAINED -> r.rejectionCode == null && r.canonicalId?.let(EvidenceHash::identity) == true &&
+                    if (s.batch.scope.contract == Contract.BURI_COLLECT_V2)
+                        r.bodySha256 == s.batch.originals.single().bodySha256
+                    else r.canonicalId.let(AckPolicy::uuid) && r.bodySha256 == null
+                ReceiptOutcome.REJECTED -> s.batch.scope.contract == Contract.MMONEY_LEDGER_V1 &&
+                    r.canonicalId == null && r.bodySha256 == null && r.rejectionCode?.matches(Regex("[A-Z0-9_]{1,64}")) == true
+            } }
+        }
+        if (s.receipts.isNotEmpty() && !receiptsValid(s.receipts)) return false
+        if (s.conflictingReceipts.isNotEmpty() && (!receiptsValid(s.conflictingReceipts) || s.receipts.isEmpty() || s.conflictingReceipts == s.receipts)) return false
+        if (s.phase == Phase.CONFLICT && s.receipts.isNotEmpty() && s.conflictingReceipts.isEmpty()) return false
+        return true
+    }
+}
+
+/** Version 1 is the FIRST persisted format. R2 defined no persisted wire format to migrate. */
+object SnapshotCodec {
+    const val VERSION = 1
+    const val MAX_BYTES = 8 * 1024 * 1024
+    private const val MAGIC = 0x534d5353 // SMSS
+    private fun digest(b: ByteArray) = MessageDigest.getInstance("SHA-256").digest(b)
+
+    fun encode(s: QueueSnapshot): ByteArray {
+        requireFormat(SnapshotIntegrity.valid(s), DecodeCode.INVARIANT)
+        val w=BinaryWriter(MAX_BYTES-44)
+        writeBatch(w,s.batch)
+        w.long(s.revision); w.text(s.phase.name); w.text(s.reason)
+        w.int(s.attempts); w.nullableLong(s.firstAttemptAt); w.long(s.lastObservedAt); w.nullableLong(s.notBefore)
+        w.bool(s.activeAttempt != null)
+        s.activeAttempt?.let { a -> w.text(a.key); w.text(a.operationId); w.text(a.payloadHash); w.int(a.ordinal); w.long(a.sessionEpoch); w.long(a.startedAt) }
+        w.bool(s.outcomeUncertain); writeReceipts(w,s.receipts); writeReceipts(w,s.conflictingReceipts)
+        val payload=w.result()
+        val frame=BinaryWriter(MAX_BYTES); frame.int(MAGIC); frame.int(VERSION); frame.int(payload.size); frame.raw(payload)
+        val prefix=frame.result(); frame.raw(digest(prefix)); return frame.result()
+    }
+
+    fun decode(bytes: ByteArray): QueueSnapshot {
+        requireFormat(bytes.size in 44..MAX_BYTES, DecodeCode.SIZE)
+        val r=BinaryReader(bytes)
+        requireFormat(r.int()==MAGIC, DecodeCode.MAGIC)
+        requireFormat(r.int()==VERSION, DecodeCode.VERSION)
+        val n=r.int(); requireFormat(n >= 0 && n == r.remaining-32, DecodeCode.SIZE)
+        val payload=r.raw(n); val checksum=r.raw(32); r.end()
+        requireFormat(MessageDigest.isEqual(checksum,digest(bytes.copyOfRange(0,bytes.size-32))), DecodeCode.CHECKSUM)
+        val p=BinaryReader(payload); val batch=readBatch(p)
+        val revision=p.long(); val phase=p.enum<Phase>(); val reason=p.required()
+        val attempts=p.int(); val first=p.nullableLong(); val observed=p.long(); val notBefore=p.nullableLong()
+        val active=if(p.bool()) Attempt(p.required(),p.required(),p.required(),p.int(),p.long(),p.long()) else null
+        val uncertain=p.bool(); val receipts=readReceipts(p); val conflicts=readReceipts(p); p.end()
+        val s=QueueSnapshot(batch,revision,phase,reason,attempts,first,observed,notBefore,active,uncertain,receipts,conflicts)
+        requireFormat(SnapshotIntegrity.valid(s),DecodeCode.INVARIANT)
+        return s
+    }
+
+    internal fun batchBytes(b: UploadBatch): ByteArray = BinaryWriter(MAX_BYTES).also { writeBatch(it,b) }.result()
+    private fun writeBatch(w: BinaryWriter,b: UploadBatch) {
+        w.text(b.operationId); w.int(b.originals.size)
+        for(o in b.originals) {
+            w.text(o.scope.contract.name); w.text(o.scope.ownerId); w.text(o.scope.installationId); w.text(o.scope.generation)
+            w.text(o.binding.id); w.int(o.binding.version); w.nullableInt(o.binding.subscriptionId)
+            w.text(o.captureId); w.text(o.sourceId)
+            val input=o.assembly.input; w.text(input.mode.name); w.text(input.format); w.int(input.parts.size)
+            for(p in input.parts) {
+                w.nullableInt(p.sequence); w.nullableInt(p.total); w.nullableInt(p.reference); w.nullableInt(p.referenceBits)
+                w.text(p.sender,65536); w.text(p.body,65536); w.nullableLong(p.serviceCentreMillis); w.nullableInt(p.subscriptionId)
+                w.nullableInt(p.dcs); w.text(p.applicationPort); w.bool(p.envelopeValidated); w.text(p.pduHex,8192)
+            }
+            val c=o.classification; w.text(c.contract.name); w.text(c.kind.name); w.text(c.reason); w.text(c.policyVersion); w.text(c.evidenceFingerprint)
+            // All derived hashes are redundant checks; they are never accepted in place of recomputation.
+            w.text(o.assembly.completeness.name); w.text(o.assembly.reason); w.text(o.bodySha256); w.text(o.evidenceHash)
+        }
+        w.text(b.key); w.text(b.payloadHash)
+    }
+    private fun readBatch(r: BinaryReader): UploadBatch {
+        val operation=r.required(); val count=r.count(1,20)
+        val originals=List(count) {
+            val scope=OwnerScope(r.enum(),r.required(),r.required(),r.required())
+            val binding=SourceBinding(r.required(),r.int(),r.nullableInt())
+            val capture=r.required(); val source=r.required(); val mode=r.enum<InputMode>(); val format=r.text()
+            val parts=List(r.count(1,MultipartPolicy.MAX_PARTS)) {
+                SmsPart(r.nullableInt(),r.nullableInt(),r.nullableInt(),r.nullableInt(),r.text(65536),r.text(65536),
+                    r.nullableLong(),r.nullableInt(),r.nullableInt(),r.text(),r.bool(),r.text(8192))
+            }
+            val assembly=MultipartPolicy.inspect(SmsInput(mode,format,parts))
+            val classification=Classification(r.enum(),r.enum(),r.required(),r.required(),r.required())
+            val o=Original(scope,binding,capture,source,assembly,classification)
+            requireFormat(r.enum<Completeness>()==assembly.completeness && r.required()==assembly.reason &&
+                r.text()==o.bodySha256 && r.required()==o.evidenceHash, DecodeCode.INVARIANT)
+            o
+        }
+        val b=UploadBatch(operation,originals)
+        requireFormat(b.valid() && r.required()==b.key && r.required()==b.payloadHash,DecodeCode.INVARIANT)
+        return b
+    }
+    private fun writeReceipts(w: BinaryWriter, rows: List<VerifiedReceipt>) {
+        w.int(rows.size)
+        for(r in rows) { w.text(r.captureId); w.text(r.outcome.name); w.text(r.canonicalId); w.text(r.bodySha256); w.text(r.rejectionCode) }
+    }
+    private fun readReceipts(r: BinaryReader): List<VerifiedReceipt> = List(r.count(0,20)) {
+        VerifiedReceipt(r.required(),r.enum(),r.text(),r.text(),r.text())
+    }
+}
diff --git a/host/kotlin/rw/ikanisa/sms/host/HostFileJournal.kt b/host/kotlin/rw/ikanisa/sms/host/HostFileJournal.kt
new file mode 100644
--- /dev/null
+++ b/host/kotlin/rw/ikanisa/sms/host/HostFileJournal.kt
@@ -0,0 +1,92 @@
+package rw.ikanisa.sms.host
+
+import rw.ikanisa.sms.policy.*
+import java.io.IOException
+import java.nio.ByteBuffer
+import java.nio.channels.FileChannel
+import java.nio.file.Files
+import java.nio.file.Path
+import java.nio.file.LinkOption.NOFOLLOW_LINKS
+import java.nio.file.StandardOpenOption.*
+import java.nio.file.attribute.PosixFilePermissions
+
+/** Test injection stages; production adapters must not include selectable faults. */
+enum class HostWriteStage { BEFORE_APPEND, AFTER_PARTIAL_APPEND, AFTER_APPEND, AFTER_FORCE }
+fun interface HostWriteFault { fun at(stage: HostWriteStage) }
+
+/**
+ * JVM/POSIX HOST REFERENCE ONLY. Stores plaintext; never install with real message evidence.
+ * Not an Android/Keystore port. Constructor/read/write never initialize, replace or repair storage.
+ * One JVM monitor covers all instances; an OS file lock covers cooperating processes.
+ * The path checks are not a security boundary against hostile concurrent filesystem replacement.
+ */
+class HostFileJournal(private val directory: Path, private val fault: HostWriteFault = HostWriteFault {}): AppendJournalPort {
+    private val file get()=directory.resolve("queue.journal")
+    override fun read(): JournalRead = synchronized(lock) {
+        try {
+            safe(directory); safe(file)
+            if(Files.notExists(file,NOFOLLOW_LINKS)) return@synchronized JournalRead.Missing
+            FileChannel.open(file,READ,WRITE,NOFOLLOW_LINKS).use { channel ->
+                val lease=channel.tryLock() ?: return@synchronized JournalRead.Unavailable
+                lease.use { JournalRead.Bytes(readAll(channel)) }
+            }
+        } catch(_: Exception) { JournalRead.Unavailable }
+    }
+    override fun append(expectedContentHash: String,record: ByteArray): StoreWrite = synchronized(lock) {
+        var started=false
+        try {
+            safe(directory); safe(file)
+            FileChannel.open(file,READ,WRITE,NOFOLLOW_LINKS).use { channel ->
+                val lease=channel.tryLock() ?: return@synchronized StoreWrite.NOT_COMMITTED
+                lease.use {
+                    val before=readAll(channel)
+                    if(EvidenceHash.sha256(before)!=expectedContentHash) return@synchronized StoreWrite.REVISION_CONFLICT
+                    if(record.isEmpty() || before.size.toLong()+record.size>JournalFormat.MAX_BYTES) return@synchronized StoreWrite.NOT_COMMITTED
+                    fault.at(HostWriteStage.BEFORE_APPEND)
+                    channel.position(channel.size()); started=true
+                    val middle=maxOf(1,record.size/2)
+                    writeAll(channel,ByteBuffer.wrap(record,0,middle))
+                    fault.at(HostWriteStage.AFTER_PARTIAL_APPEND)
+                    writeAll(channel,ByteBuffer.wrap(record,middle,record.size-middle))
+                    fault.at(HostWriteStage.AFTER_APPEND)
+                    channel.force(true)
+                    fault.at(HostWriteStage.AFTER_FORCE)
+                    StoreWrite.COMMITTED
+                }
+            }
+        } catch(_: Exception) { if(started) StoreWrite.UNKNOWN else StoreWrite.NOT_COMMITTED }
+    }
+    companion object {
+        private val lock=Any()
+        private fun safe(path: Path) {
+            val absolute=path.toAbsolutePath()
+            require(absolute==absolute.normalize()) { "UNSAFE_PATH" }
+            var node: Path?=absolute
+            while(node!=null) { require(!Files.isSymbolicLink(node)) { "SYMLINK_PATH" }; node=node.parent }
+        }
+        private fun readAll(channel: FileChannel): ByteArray {
+            val size=channel.size()
+            require(size in 0..JournalFormat.MAX_BYTES.toLong()) { "JOURNAL_SIZE" }
+            val b=ByteBuffer.allocate(size.toInt()); channel.position(0)
+            while(b.hasRemaining()) if(channel.read(b)<=0) throw IOException("SHORT_READ")
+            return b.array()
+        }
+        private fun writeAll(channel: FileChannel, buffer: ByteBuffer) {
+            while(buffer.hasRemaining()) if(channel.write(buffer)<=0) throw IOException("SHORT_WRITE")
+        }
+        /** Explicit provisioning of a NEW directory only. Failure retains all partial artifacts. */
+        fun initializeFresh(directory: Path, scope: OwnerScope) = synchronized(lock) {
+            val header=JournalFormat.empty(scope) // Validate before any filesystem mutation.
+            safe(directory)
+            Files.createDirectory(directory,PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rwx------")))
+            val file=directory.resolve("queue.journal")
+            FileChannel.open(file,setOf(CREATE_NEW,WRITE,NOFOLLOW_LINKS),
+                PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------"))).use {
+                writeAll(it,ByteBuffer.wrap(header)); it.force(true)
+            }
+            // Fail closed on filesystems that cannot honor these host provisioning barriers.
+            FileChannel.open(directory,READ,NOFOLLOW_LINKS).use { it.force(true) }
+            FileChannel.open(directory.toAbsolutePath().parent,READ,NOFOLLOW_LINKS).use { it.force(true) }
+        }
+    }
+}
