{
  "name": "collect-admin-local",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "vars": {
    "ADMIN_ORIGIN": "http://localhost:8795",
    "ENVIRONMENT": "local"
  },
  "d1_databases": [{
    "binding": "ADMIN_DB",
    "database_name": "collect-admin-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "migrations"
  }],
  "assets": {
    "directory": "../../build/admin-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/admin/*"],
    "not_found_handling": "single-page-application"
  },
  "dev": { "port": 8795, "ip": "localhost" },
  "observability": { "enabled": false }
}
