{
  "name": "collect-platform-admin-supabase-qa",
  "main": "src/index.js",
  "compatibility_date": "2026-10-14",
  "account_id": "2209b915a85b1c11cee79b7806c6e73b",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ADMIN_ORIGIN": "https://admin-supabase-qa.collect.ikanisa.com",
    "COLLECT_BACKEND": "supabase",
    "SUPABASE_URL": "https://rrlduytparvsjfmegalh.supabase.co"
  },
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/v1",
      "/v1/*",
      "/functions",
      "/functions/*",
      "/privacy/account-deletion",
      "/privacy/account-deletion/*"
    ]
  },
  "routes": [
    {
      "pattern": "admin-supabase-qa.collect.ikanisa.com",
      "custom_domain": true
    }
  ],
  "compatibility_flags": [
    "enable_request_signal"
  ]
}
