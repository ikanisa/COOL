{
  "$schema": "./admin-api/node_modules/wrangler/config-schema.json",
  "name": "collect-admin-cloudflare",
  "account_id": "2209b915a85b1c11cee79b7806c6e73b",
  "main": "admin-api/src/worker.mjs",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "admin-preview.collect.ikanisa.com", "custom_domain": true}],
  "vars": {
    "ADMIN_ORIGIN": "https://admin-preview.collect.ikanisa.com",
    "ENVIRONMENT": "production",
    "GATEWAY_ALLOWED_IDENTITIES": "[]"
  },
  "d1_databases": [{
    "binding": "ADMIN_DB",
    "database_name": "collect-admin-accounts",
    "database_id": "6944372d-16ff-4c08-8a23-54076adf26db",
    "migrations_dir": "admin-api/migrations"
  }],
  "send_email": [{
    "name": "EMAIL",
    "allowed_sender_addresses": ["info@ikanisa.com"]
  }],
  "r2_buckets": [{"binding": "MEMBER_MEDIA", "bucket_name": "collect-cloudflare-private-media"}, {"binding": "RECEIPT_PAYLOADS", "bucket_name": "collect-admin-receipt-payloads"}],
  "assets": {
    "directory": "../build/admin-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/admin/*", "/api/gateway", "/api/gateway/*"],
    "not_found_handling": "single-page-application"
  },
  "limits": {"cpu_ms": 10000},
  "triggers": {"crons": ["* * * * *"]},
  "observability": {"enabled": true, "redact_query_string": true, "logs": {"enabled": true, "invocation_logs": false}}
}
