# Public client configuration. No server secret belongs in Flutter defines.
COLLECT_API_URL=https://api.collect.ikanisa.com
APP_PUBLIC_URL=https://collect.ikanisa.com
ADMIN_APP_URL=https://platform-admin.collect.ikanisa.com
APP_ENVIRONMENT=production
ENABLE_SMS_READER=false
ENABLE_ANDROID_SMS_ACCESS=false
ENABLE_ADMIN_PANEL=false
ENABLE_ADMIN_DEV_TOOLS=false
AUTH_CAPTCHA_ENABLED=true
AUTH_CAPTCHA_PROVIDER=turnstile
# The fresh challenge page obtains its public site key from the backend.
AUTH_CAPTCHA_SITE_KEY=
APNS_ENVIRONMENT=sandbox
# Public Play Console linked project number; native admission needs server policy.
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=

# Local Apple Developer automation. Keep actual values outside Git.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=

# Server-only Auth, encryption, Turnstile, OTP, Google, AI and push credentials
# belong in Cloudflare Worker secrets. See deploy/platform-api/README.md.
