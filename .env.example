SUPABASE_URL=
SUPABASE_ANON_KEY=
APP_PUBLIC_URL=
ADMIN_APP_URL=
COLLECT_ADMIN_WHATSAPP_PHONE=
ENABLE_SMS_READER=false
ENABLE_ANDROID_SMS_ACCESS=false
ENABLE_ADMIN_PANEL=false
ENABLE_ADMIN_DEV_TOOLS=false
APP_ENVIRONMENT=local
APNS_ENVIRONMENT=sandbox
AUTH_CAPTCHA_ENABLED=false
AUTH_CAPTCHA_PROVIDER=
AUTH_CAPTCHA_SITE_KEY=

# Server-only values such as service-role, OpenAI, WhatsApp, and SMS hook
# secrets belong in Supabase or CI secret stores, never in Flutter dart-defines.
WHATSAPP_GRAPH_API_VERSION=v25.0
# Operator-only Supabase Auth hardening input; never ship as a Dart define.
AUTH_CAPTCHA_SECRET=

# Local Apple Developer/App Store Connect automation only. Keep real values out
# of git; use a local ignored env file or shell exports.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=

# Server-only APNs delivery secrets belong in Supabase secrets. The private key
# value is the base64 encoding of the complete Apple .p8 PEM file.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.cool.mobile
APNS_PRIVATE_KEY_BASE64=

# Server-only Firebase Cloud Messaging credential. Store the complete service
# account JSON value in Supabase secrets; never expose it to Flutter builds.
FCM_SERVICE_ACCOUNT_JSON=
