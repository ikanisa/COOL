# ──────────────────────────────────────────────────────────────
# Cool App — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to `.env` for client-safe Flutter dart-defines only.
# NEVER commit your real .env to version control.
# Server-only function secrets live in `supabase/functions/.env.example`.
# ──────────────────────────────────────────────────────────────

# ── Supabase (client-safe dart-defines only) ─────────────────
# Prefer flavor-specific keys. Build scripts resolve the correct pair based on
# the requested flavor and only fall back to the legacy generic keys when the
# flavor-specific values are missing.
SUPABASE_STAGING_URL=your_staging_supabase_project_url
SUPABASE_STAGING_ANON_KEY=your_staging_supabase_anon_key
SUPABASE_PRODUCTION_URL=your_production_supabase_project_url
SUPABASE_PRODUCTION_ANON_KEY=your_production_supabase_anon_key
# Legacy fallback for older local workflows only. Keep it aligned with
# production until every local/CI environment has moved to the flavor-specific
# keys above.
SUPABASE_URL=your_production_supabase_project_url
SUPABASE_ANON_KEY=your_production_supabase_anon_key
# NOTE: SUPABASE_SERVICE_ROLE_KEY and DATABASE_URL are SERVER-ONLY.
# Never put them in this client-side file. They belong in
# supabase/functions/.env or your CI/CD secrets manager.

# ── MOMO / SMS verification ──────────────────────────────────
# This is a core Android payment capability. Disabling it breaks automatic
# MoMo payment verification and transaction recording.
ENABLE_ANDROID_MOMO_SMS_AUTOREAD=true

# ── Deep links / store handoff ───────────────────────────────
COOL_DEEP_LINK_HOST=cool.app
COOL_PRIVACY_POLICY_URL=https://cool.ikanisa.com/privacy
COOL_TERMS_OF_SERVICE_URL=https://cool.ikanisa.com/terms
COOL_ACCOUNT_DELETION_URL=https://cool.ikanisa.com/account-deletion
COOL_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.cool.mobile
COOL_APP_STORE_URL=https://apps.apple.com/app/id0000000000
COOL_ANDROID_PACKAGE_ID=app.cool.mobile
COOL_ANDROID_PLAY_APP_SIGNING_SHA256_CERT_FINGERPRINT=
COOL_IOS_TEAM_ID=
COOL_IOS_APP_STORE_ID=
COOL_REQUIRE_IOS_RELEASE_METADATA=0

# ── WhatsApp Cloud API (OTP delivery — server-side only) ─────
# These belong in supabase/functions/.env, NOT here.
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_ACCESS_TOKEN=your_access_token

# ── Firebase (push notifications) ────────────────────────────
# All Firebase client config is supplied through dart-defines so no client
# config is baked into Dart source.
FIREBASE_ANDROID_STAGING_API_KEY=
FIREBASE_ANDROID_STAGING_APP_ID=
FIREBASE_ANDROID_STAGING_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_STAGING_PROJECT_ID=
FIREBASE_ANDROID_STAGING_STORAGE_BUCKET=
FIREBASE_ANDROID_PRODUCTION_API_KEY=
FIREBASE_ANDROID_PRODUCTION_APP_ID=
FIREBASE_ANDROID_PRODUCTION_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_PRODUCTION_PROJECT_ID=
FIREBASE_ANDROID_PRODUCTION_STORAGE_BUCKET=
FIREBASE_IOS_STAGING_API_KEY=
FIREBASE_IOS_STAGING_APP_ID=
FIREBASE_IOS_STAGING_MESSAGING_SENDER_ID=
FIREBASE_IOS_STAGING_PROJECT_ID=
FIREBASE_IOS_STAGING_STORAGE_BUCKET=
FIREBASE_IOS_STAGING_BUNDLE_ID=
FIREBASE_IOS_PRODUCTION_API_KEY=
FIREBASE_IOS_PRODUCTION_APP_ID=
FIREBASE_IOS_PRODUCTION_MESSAGING_SENDER_ID=
FIREBASE_IOS_PRODUCTION_PROJECT_ID=
FIREBASE_IOS_PRODUCTION_STORAGE_BUCKET=
FIREBASE_IOS_PRODUCTION_BUNDLE_ID=

# Ticket QR signing secrets are server-only. Configure
# TICKET_QR_HMAC_SECRET in Supabase function secrets or CI/CD secret storage,
# never in client dart-defines.
