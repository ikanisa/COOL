default_platform(:android)

platform :android do
  desc "Upload AAB to Google Play production track"
  lane :upload_to_play do
    upload_to_play_store(
      track: "production",
      aab: "../build/app/outputs/bundle/productionRelease/app-production-release.aab",
      json_key: "../output/play_store/play-store-sa-key.json",
      package_name: "app.cool.mobile",
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      version_name: "1.2.0",
      version_code: 5
    )
  end

  desc "Upload store listing metadata and screenshots"
  lane :upload_metadata do
    upload_to_play_store(
      track: "internal",
      json_key: "../output/play_store/play-store-sa-key.json",
      package_name: "app.cool.mobile",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: false,
      version_code: 5
    )
  end

  desc "Full upload: AAB + metadata + screenshots"
  lane :full_upload do
    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/productionRelease/app-production-release.aab",
      json_key: "../output/play_store/play-store-sa-key.json",
      package_name: "app.cool.mobile",
      release_status: "draft",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: false
    )
  end
end
