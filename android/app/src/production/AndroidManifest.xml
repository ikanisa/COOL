<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- New M-Money messages are captured only after explicit per-user consent.
         Inbox history is not requested by the ordinary app. -->
    <uses-permission android:name="android.permission.READ_SMS" tools:node="remove" />
    <!-- These removal markers request no SMS permission. Repeat the existing
         optional hardware facts here for lint's source-overlay inspection. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.telephony.messaging" android:required="false" />
</manifest>
